/*
 * 「时刻见」设计 token（v7 纸感生活手帐）
 * 墨青负责秩序，纸底与领域马卡龙负责温度；不再使用紫色作为主识别色。
 */
page {
  --c-primary: #2c4a52;
  --c-primary-deep: #243d44;
  --c-primary-soft: #e8eeef;
  --c-accent: #2c4a52;
  --c-accent-2: #9bc4a6;
  --c-accent-3: #f0a868;
  --c-accent-soft: #e8eeef;
  --c-mint-soft: #eef5ef;
  --c-peach-soft: #fdf0e4;
  --c-warm-soft: #fbf3e1;
  --c-blue-soft: #eaf1f7;
  --c-pink-soft: #fcedf0;
  --c-bg: #fdfbf7;
  --c-paper-2: #f6f1e9;
  --c-surface: rgba(255, 254, 250, 0.94);
  --c-surface-strong: #fffefa;
  --c-text: #2e2a28;
  --c-text-2: #6b635c;
  --c-muted: #8d8580;
  --c-faint: #a69e96;
  --c-line: #ebe5da;
  --c-line-strong: #ddd5c8;
  --c-success: #6f9f7d;
  --c-success-soft: #eef5ef;
  --c-warning: #b78024;
  --c-warning-soft: #fbf3e1;
  --c-danger: #d85f78;
  --c-danger-soft: #fcebee;
  --c-shadow: rgba(82, 65, 48, 0.07);
  --r-card: 30rpx;
  --r-card-lg: 40rpx;
  --r-btn: 999rpx;
  --r-pill: 999rpx;
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --fs-caption: 22rpx;
  --fs-body: 28rpx;
  --fs-title: 32rpx;
  --fs-display: 54rpx;
}

page {
  width: 100%;
  max-width: 100%;
  min-height: 100%;
  overflow-x: hidden;
  overscroll-behavior-x: none;
  background-color: #fdfbf7;
  background-image: none;
  color: var(--c-text, #2e2a28);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: var(--fs-body, 28rpx);
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

button {
  font-family: inherit;
}

button::after {
  border: 0;
}

/* 页面装饰元素会刻意越过视口边缘，统一裁掉横向滚动；滚动条只保留滚动能力，不显示轨道。 */
page::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

/* 原生 TabBar 由微信管理安全区，页面只保留内容收尾留白。 */
.tab-page {
  position: relative;
  width: calc(100vw + 2px);
  max-width: calc(100vw + 2px);
  min-height: 100vh;
  box-sizing: border-box;
  padding: 34rpx 36rpx 48rpx;
}

.page-shell {
  position: relative;
  width: calc(100vw + 2px);
  max-width: calc(100vw + 2px);
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 36rpx calc(160rpx + env(safe-area-inset-bottom));
}

.subpage-back {
  display: none;
}

.glass-card {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: var(--r-card, 30rpx);
  background: linear-gradient(145deg, rgba(255, 254, 250, 0.98), rgba(253, 251, 247, 0.94));
  box-shadow:
    0 18rpx 48rpx var(--c-shadow, rgba(68, 61, 76, 0.08)),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.card {
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: var(--r-card, 30rpx);
  background: linear-gradient(145deg, rgba(255, 254, 250, 0.98), rgba(253, 251, 247, 0.94));
  box-shadow:
    0 16rpx 40rpx var(--c-shadow, rgba(68, 61, 76, 0.08)),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
}

.h-display {
  color: var(--c-text, #2e2a28);
  font-size: var(--fs-display, 54rpx);
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -2rpx;
}

.h-title {
  color: var(--c-text, #2e2a28);
  font-size: var(--fs-title, 32rpx);
  font-weight: 600;
  line-height: 1.4;
}

.muted {
  color: var(--c-muted, #8d8580);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 4rpx 16rpx;
}

.section-head__title {
  color: var(--c-text, #2e2a28);
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.section-head__action {
  color: var(--c-muted, #8d8580);
  font-size: 21rpx;
}

/* 数据来源标识的统一摆放位置 */
.sync-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

/* 胶囊式分段切换 */
.segmented {
  display: flex;
  padding: 7rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 999rpx;
  background: rgba(255, 254, 250, 0.72);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
}

.segmented__item {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 66rpx;
  border-radius: 999rpx;
  color: var(--c-muted, #8d8580);
  font-size: 23rpx;
  font-weight: 500;
  transition: color 160ms ease, background 160ms ease;
}

.segmented__item--active {
  background: rgba(255, 254, 250, 0.98);
  color: var(--c-text, #2e2a28);
  box-shadow: 0 8rpx 20rpx rgba(68, 61, 76, 0.08);
}

.segmented__item--active::after {
  display: none;
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  margin: 0;
  border-radius: var(--r-btn, 999rpx);
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.primary-button {
  border: 1rpx solid rgba(255, 255, 255, 0.30);
  background: var(--c-primary, #2c4a52);
  box-shadow: 0 15rpx 32rpx rgba(44, 74, 82, 0.18);
  color: #fffefa;
}

.secondary-button {
  border: 1rpx solid var(--c-line, #ebe5da);
  background: rgba(255, 254, 250, 0.92);
  box-shadow: 0 8rpx 20rpx rgba(82, 65, 48, 0.04);
  color: var(--c-primary, #2c4a52);
}

.danger-button {
  border: 1rpx solid rgba(223, 111, 125, 0.12);
  background: var(--c-danger-soft, #fce9ec);
  color: var(--c-danger, #b96f78);
}

.soft-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: rgba(255, 254, 250, 0.84);
  box-shadow:
    0 8rpx 18rpx rgba(68, 61, 76, 0.07),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.94);
}

.eyebrow {
  color: var(--c-primary, #2c4a52);
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  line-height: 1.4;
}

/* 加载、空态与失败态共用同一套层级，避免各页面出现不同高度的状态块。 */
.state-card {
  display: flex;
  min-height: 320rpx;
  align-items: center;
  justify-content: center;
  padding: 42rpx 30rpx 38rpx;
  border-radius: 34rpx;
  flex-direction: column;
  text-align: center;
}

.state-card--loading {
  min-height: 250rpx;
}

.state-card--error {
  background: linear-gradient(145deg, rgba(255, 252, 251, 0.88), rgba(252, 235, 238, 0.68));
}

.state-card__icon {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 30rpx;
  background: linear-gradient(145deg, #eaf1f7, #eef5ef);
  box-shadow: 0 9rpx 20rpx rgba(68, 61, 76, 0.06);
}

.state-card--error .state-card__icon {
  background: linear-gradient(145deg, #fff4f4, #fbe7ea);
}

.state-card__title {
  margin-top: 18rpx;
  color: var(--c-text, #2e2a28);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.45;
}

.state-card__copy {
  max-width: 490rpx;
  margin-top: 7rpx;
  color: var(--c-muted, #8d8580);
  font-size: 19rpx;
  line-height: 1.65;
}

.state-card__action {
  display: inline-flex;
  min-height: 66rpx;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 999rpx;
  background: rgba(255, 254, 250, 0.86);
  color: var(--c-primary, #2c4a52);
  font-size: 19rpx;
  font-weight: 600;
}

.state-banner {
  display: flex;
  align-items: center;
  padding: 16rpx 18rpx;
  border-radius: 26rpx;
  gap: 13rpx;
}

.state-banner--warm {
  background: linear-gradient(135deg, rgba(255, 252, 249, 0.90), rgba(252, 237, 235, 0.76));
}

.state-banner__icon {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  background: rgba(255, 255, 255, 0.74);
  flex-shrink: 0;
}

.state-banner__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 2rpx;
}

.state-banner__title {
  color: var(--c-text, #2e2a28);
  font-size: 19rpx;
  font-weight: 600;
}

.state-banner__copy {
  color: var(--c-text-2, #6b635c);
  font-size: 16rpx;
  line-height: 1.45;
}

.state-banner__action {
  display: flex;
  min-height: 54rpx;
  align-items: center;
  padding: 0 4rpx 0 10rpx;
  color: var(--c-primary, #2c4a52);
  flex-shrink: 0;
  font-size: 17rpx;
  font-weight: 600;
}

input,
textarea {
  font-family: inherit;
}
