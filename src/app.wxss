/*
 * 「时刻在」设计 token（v4 静默账本）
 * 冷柔光纸面、墨色正文、柔和靛蓝数据强调；装饰退后，层级依靠字号、留白和细线。
 */
page {
  --c-primary: #22242e;
  --c-primary-soft: #eaedfc;
  --c-accent: #5b6ee0;
  --c-accent-soft: #eaedfc;
  --c-bg: #f6f4f9;
  --c-surface: #ffffff;
  --c-text: #22242e;
  --c-text-2: #5c5f6e;
  --c-muted: #9497a6;
  --c-faint: #a8abba;
  --c-line: #e7e6ee;
  --c-line-strong: #d6d5e0;
  --c-success: #4fa87d;
  --c-success-soft: #e8f5ee;
  --c-warning: #e0a038;
  --c-warning-soft: #fdf3e2;
  --c-danger: #e8695c;
  --c-danger-soft: #fdeceb;
  --r-card: 20rpx;
  --r-btn: 999rpx;
  --r-pill: 999rpx;
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --fs-caption: 22rpx;
  --fs-body: 28rpx;
  --fs-title: 32rpx;
  --fs-display: 48rpx;
}

page {
  min-height: 100%;
  background: var(--c-bg, #f6f4f9);
  color: var(--c-text, #22242e);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: var(--fs-body, 28rpx);
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

button {
  font-family: inherit;
}

button::after {
  border: 0;
}

/* 底部 TabBar 约占 104rpx + 安全区 */
.tab-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 44rpx 48rpx calc(170rpx + env(safe-area-inset-bottom));
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 48rpx calc(170rpx + env(safe-area-inset-bottom));
}

.subpage-back {
  display: none;
}

.card {
  border: 1rpx solid var(--c-line, #e7e6ee);
  border-radius: var(--r-card, 20rpx);
  background: var(--c-surface, #ffffff);
}

.h-display {
  color: var(--c-text, #22242e);
  font-size: var(--fs-display, 48rpx);
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: -2rpx;
}

.h-title {
  color: var(--c-text, #22242e);
  font-size: var(--fs-title, 32rpx);
  font-weight: 500;
  line-height: 1.4;
}

.muted {
  color: var(--c-muted, #9497a6);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 0 16rpx;
}

.section-head__title {
  color: var(--c-text, #22242e);
  font-size: 26rpx;
  font-weight: 500;
}

.section-head__action {
  color: var(--c-muted, #9497a6);
  font-size: 22rpx;
}

/* 数据来源标识的统一摆放位置 */
.sync-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

/* 下划线式分段切换，保留给宠物等次级页面使用 */
.segmented {
  display: flex;
  padding: 0;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
  border-radius: 0;
  background: transparent;
}

.segmented__item {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  color: var(--c-muted, #9497a6);
  font-size: 24rpx;
  font-weight: 400;
  transition: color 160ms ease;
}

.segmented__item--active {
  background: transparent;
  color: var(--c-text, #22242e);
  box-shadow: none;
  font-weight: 500;
}

.segmented__item--active::after {
  position: absolute;
  right: 24rpx;
  bottom: -1rpx;
  left: 24rpx;
  height: 1rpx;
  background: var(--c-text, #22242e);
  content: "";
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin: 0;
  border-radius: var(--r-btn, 999rpx);
  font-size: 28rpx;
  font-weight: 500;
}

.primary-button {
  background: var(--c-primary, #22242e);
  color: #fff;
}

.secondary-button {
  border: 1rpx solid var(--c-line-strong, #d6d5e0);
  background: transparent;
  color: var(--c-text, #22242e);
}

.danger-button {
  border: 0;
  background: var(--c-danger-soft, #fdeceb);
  color: var(--c-danger, #e8695c);
}
