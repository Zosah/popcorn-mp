/*
 * 「时刻见」设计 token（v5 柔光生活手帐）
 * 清透玻璃层、低饱和薄荷与薰衣草、暖桃点缀；界面要有呼吸感，也要保持家庭工具的可读性。
 */
page {
  --c-primary: #7569e8;
  --c-primary-deep: #665bd7;
  --c-primary-soft: #ebe8ff;
  --c-accent: #7569e8;
  --c-accent-2: #50b7ae;
  --c-accent-3: #ee9eb4;
  --c-accent-soft: #eeeaff;
  --c-mint-soft: #e4f6ef;
  --c-peach-soft: #fbe8e7;
  --c-warm-soft: #fbf0d9;
  --c-bg: #f5f2fa;
  --c-surface: rgba(255, 255, 255, 0.72);
  --c-surface-strong: rgba(255, 255, 255, 0.90);
  --c-text: #292737;
  --c-text-2: #615f70;
  --c-muted: #9592a4;
  --c-faint: #bbb8c8;
  --c-line: rgba(106, 98, 139, 0.10);
  --c-line-strong: rgba(106, 98, 139, 0.17);
  --c-success: #4ba98d;
  --c-success-soft: #e5f6ef;
  --c-warning: #d99c3f;
  --c-warning-soft: #fdf1df;
  --c-danger: #df6f7d;
  --c-danger-soft: #fce9ec;
  --c-shadow: rgba(92, 77, 132, 0.10);
  --r-card: 32rpx;
  --r-card-lg: 42rpx;
  --r-btn: 999rpx;
  --r-pill: 999rpx;
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --fs-caption: 22rpx;
  --fs-body: 28rpx;
  --fs-title: 32rpx;
  --fs-display: 54rpx;
}

page {
  width: 100%;
  max-width: 100%;
  min-height: 100%;
  overflow-x: hidden;
  overscroll-behavior-x: none;
  background-color: #f5f2fa;
  background-image:
    radial-gradient(circle at 8% 3%, rgba(196, 220, 255, 0.74) 0, rgba(196, 220, 255, 0) 32%),
    radial-gradient(circle at 96% 11%, rgba(191, 238, 217, 0.82) 0, rgba(191, 238, 217, 0) 36%),
    radial-gradient(circle at 2% 58%, rgba(247, 205, 222, 0.56) 0, rgba(247, 205, 222, 0) 31%),
    radial-gradient(circle at 100% 76%, rgba(255, 225, 188, 0.58) 0, rgba(255, 225, 188, 0) 32%),
    linear-gradient(155deg, #f8f5fc 0%, #f1f8f5 42%, #f8f3f6 72%, #fcf3eb 100%);
  color: var(--c-text, #292737);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: var(--fs-body, 28rpx);
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

button {
  font-family: inherit;
}

button::after {
  border: 0;
}

/* 页面装饰元素会刻意越过视口边缘，统一裁掉横向滚动；滚动条只保留滚动能力，不显示轨道。 */
page::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

/* 原生 TabBar 由微信管理安全区，页面只保留内容收尾留白。 */
.tab-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 34rpx 36rpx 48rpx;
}

.page-shell {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 36rpx calc(160rpx + env(safe-area-inset-bottom));
}

.subpage-back {
  display: none;
}

.glass-card {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: var(--r-card, 32rpx);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.80), rgba(255, 255, 255, 0.58));
  box-shadow:
    0 18rpx 56rpx var(--c-shadow, rgba(92, 77, 132, 0.10)),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx);
}

.card {
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: var(--r-card, 32rpx);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.62));
  box-shadow:
    0 16rpx 46rpx rgba(92, 77, 132, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.h-display {
  color: var(--c-text, #292737);
  font-size: var(--fs-display, 54rpx);
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -2rpx;
}

.h-title {
  color: var(--c-text, #292737);
  font-size: var(--fs-title, 32rpx);
  font-weight: 600;
  line-height: 1.4;
}

.muted {
  color: var(--c-muted, #9592a4);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 4rpx 16rpx;
}

.section-head__title {
  color: var(--c-text, #292737);
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.section-head__action {
  color: var(--c-muted, #9592a4);
  font-size: 21rpx;
}

/* 数据来源标识的统一摆放位置 */
.sync-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

/* 胶囊式分段切换 */
.segmented {
  display: flex;
  padding: 7rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.46);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.74);
}

.segmented__item {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 66rpx;
  border-radius: 999rpx;
  color: var(--c-muted, #9592a4);
  font-size: 23rpx;
  font-weight: 500;
  transition: color 160ms ease, background 160ms ease;
}

.segmented__item--active {
  background: rgba(255, 255, 255, 0.90);
  color: var(--c-text, #292737);
  box-shadow: 0 8rpx 22rpx rgba(92, 77, 132, 0.09);
}

.segmented__item--active::after {
  display: none;
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  margin: 0;
  border-radius: var(--r-btn, 999rpx);
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.primary-button {
  border: 1rpx solid rgba(255, 255, 255, 0.26);
  background: linear-gradient(135deg, #8c7cf0 0%, #7164df 55%, #5e9fcf 100%);
  box-shadow: 0 16rpx 34rpx rgba(105, 91, 211, 0.24);
  color: #fff;
}

.secondary-button {
  border: 1rpx solid rgba(113, 100, 223, 0.18);
  background: rgba(255, 255, 255, 0.62);
  color: var(--c-primary-deep, #665bd7);
}

.danger-button {
  border: 1rpx solid rgba(223, 111, 125, 0.12);
  background: var(--c-danger-soft, #fce9ec);
  color: var(--c-danger, #df6f7d);
}

.soft-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow:
    0 8rpx 20rpx rgba(92, 77, 132, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
}

.eyebrow {
  color: var(--c-primary-deep, #665bd7);
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  line-height: 1.4;
}

/* 加载、空态与失败态共用同一套层级，避免各页面出现不同高度的状态块。 */
.state-card {
  display: flex;
  min-height: 320rpx;
  align-items: center;
  justify-content: center;
  padding: 42rpx 30rpx 38rpx;
  border-radius: 34rpx;
  flex-direction: column;
  text-align: center;
}

.state-card--loading {
  min-height: 250rpx;
}

.state-card--error {
  background: linear-gradient(145deg, rgba(255, 252, 251, 0.88), rgba(252, 235, 238, 0.68));
}

.state-card__icon {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 30rpx;
  background: linear-gradient(145deg, #eeeaff, #e5f7ef);
  box-shadow: 0 9rpx 22rpx rgba(92, 77, 132, 0.07);
}

.state-card--error .state-card__icon {
  background: linear-gradient(145deg, #fff4f4, #fbe7ea);
}

.state-card__title {
  margin-top: 18rpx;
  color: var(--c-text, #292737);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.45;
}

.state-card__copy {
  max-width: 490rpx;
  margin-top: 7rpx;
  color: var(--c-muted, #9592a4);
  font-size: 19rpx;
  line-height: 1.65;
}

.state-card__action {
  display: inline-flex;
  min-height: 66rpx;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: var(--c-primary-deep, #665bd7);
  font-size: 19rpx;
  font-weight: 600;
}

.state-banner {
  display: flex;
  align-items: center;
  padding: 16rpx 18rpx;
  border-radius: 26rpx;
  gap: 13rpx;
}

.state-banner--warm {
  background: linear-gradient(135deg, rgba(255, 252, 249, 0.90), rgba(252, 237, 235, 0.76));
}

.state-banner__icon {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  background: rgba(255, 255, 255, 0.74);
  flex-shrink: 0;
}

.state-banner__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 2rpx;
}

.state-banner__title {
  color: var(--c-text, #292737);
  font-size: 19rpx;
  font-weight: 600;
}

.state-banner__copy {
  color: var(--c-text-2, #615f70);
  font-size: 16rpx;
  line-height: 1.45;
}

.state-banner__action {
  display: flex;
  min-height: 54rpx;
  align-items: center;
  padding: 0 4rpx 0 10rpx;
  color: var(--c-primary-deep, #665bd7);
  flex-shrink: 0;
  font-size: 17rpx;
  font-weight: 600;
}

input,
textarea {
  font-family: inherit;
}
