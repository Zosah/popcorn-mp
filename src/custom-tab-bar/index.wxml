<view class="tab-safe-area">
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'tab-item--selected' : ''}}"
      data-index="{{index}}"
      bindtap="onSwitchTab"
    >
      <view class="tab-item__icon">
        <line-icon name="{{item.icon}}" size="{{38}}" tone="{{selected === index ? 'accent' : 'faint'}}" />
      </view>
      <view class="tab-item__label">{{item.label}}</view>
    </view>
  </view>
</view>
