.tab-safe-area {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  padding: 0 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245, 242, 250, 0), rgba(245, 242, 250, 0.82) 42%);
  pointer-events: none;
}

.tab-bar {
  display: flex;
  height: 112rpx;
  align-items: center;
  justify-content: space-around;
  padding: 10rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow:
    0 20rpx 52rpx rgba(80, 68, 116, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  pointer-events: auto;
}

.tab-item {
  position: relative;
  display: flex;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 25rpx;
  flex: 1;
  flex-direction: column;
  color: #aaa7b8;
  transition: color 160ms ease, background 160ms ease;
}

.tab-item--selected {
  background: linear-gradient(145deg, rgba(235, 232, 255, 0.96), rgba(227, 247, 241, 0.78));
  color: var(--c-primary, #7569e8);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
}

.tab-item__label {
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.tab-item--selected .tab-item__label {
  font-weight: 600;
}

.tab-item__icon {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
}
