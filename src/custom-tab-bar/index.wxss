.tab-safe-area {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  background: var(--c-bg, #f6f4f9);
  pointer-events: none;
}

.tab-bar {
  display: flex;
  height: 104rpx;
  align-items: center;
  justify-content: space-around;
  pointer-events: auto;
}

.tab-item {
  display: flex;
  height: 100%;
  align-items: center;
  justify-content: center;
  flex: 1;
  flex-direction: column;
  color: var(--c-line-strong, #c6c9d6);
  transition: color 160ms ease;
}

.tab-item--selected {
  color: var(--c-accent, #5b6ee0);
}

.tab-item__label {
  margin-top: 5rpx;
  font-size: 21rpx;
  font-weight: 400;
}

.tab-item--selected .tab-item__label {
  font-weight: 500;
}

.tab-item__icon {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
}
