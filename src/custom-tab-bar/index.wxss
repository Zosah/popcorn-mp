.tab-safe-area {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  padding: 0 12rpx env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(218, 222, 237, 0.82);
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -10rpx 30rpx rgba(55, 70, 128, 0.08);
  pointer-events: none;
}

.tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 108rpx;
  pointer-events: auto;
}

.tab-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #1b1d31;
  flex: 1;
  flex-direction: column;
  transition: color 160ms ease;
}

.tab-item--selected {
  color: #6690ef;
}

.tab-item__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 45rpx;
  height: 45rpx;
  border: 4rpx solid currentColor;
  border-radius: 16rpx 16rpx 19rpx 19rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  transition: background-color 160ms ease, box-shadow 160ms ease;
}

.tab-item--selected .tab-item__icon {
  background: #eef2ff;
  box-shadow: 0 0 0 9rpx #eef2ff;
}

.tab-item__label {
  margin-top: 5rpx;
  font-size: 19rpx;
  font-weight: 750;
}
