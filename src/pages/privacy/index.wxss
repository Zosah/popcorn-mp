.privacy-page {
  padding: 28rpx 36rpx calc(120rpx + env(safe-area-inset-bottom));
  background: var(--c-paper-grad);
  background-attachment: fixed;
}

.privacy-head {
  padding: 16rpx 4rpx 26rpx;
}

.privacy-head__eyebrow {
  color: var(--c-coral, #c67d6d);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.privacy-head__title {
  display: block;
  margin-top: 10rpx;
  color: var(--c-text, #252b27);
  font-family: var(--font-serif);
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.privacy-head__copy {
  display: block;
  margin-top: 12rpx;
  color: var(--c-text-2, #5f5a53);
  font-size: 25rpx;
  line-height: 1.75;
}

.privacy-head__meta {
  display: block;
  margin-top: 10rpx;
  color: var(--c-muted, #837f76);
  font-size: 22rpx;
}

.privacy-card {
  margin-top: 20rpx;
  padding: 26rpx 26rpx 24rpx;
  border: 1rpx solid var(--c-line, #e9e6e1);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 32rpx -30rpx rgba(92, 74, 61, 0.4);
}

.privacy-card__title {
  display: block;
  margin-bottom: 12rpx;
  color: var(--c-text, #252b27);
  font-size: 29rpx;
  font-weight: 700;
}

.privacy-card__row {
  display: flex;
  align-items: flex-start;
  margin-top: 10rpx;
  gap: 12rpx;
}

.privacy-card__dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: var(--c-coral, #c67d6d);
  flex: 0 0 10rpx;
}

.privacy-card__text {
  color: var(--c-text-2, #5f5a53);
  flex: 1;
  font-size: 24rpx;
  line-height: 1.75;
}

.privacy-card--contact .privacy-card__text {
  display: block;
}

.privacy-footer {
  display: block;
  margin-top: 30rpx;
  color: var(--c-faint, #a29b91);
  font-size: 21rpx;
  text-align: center;
}
