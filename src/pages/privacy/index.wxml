<view class="page-shell privacy-page">
  <view class="privacy-head">
    <text class="privacy-head__eyebrow">PRIVACY</text>
    <text class="privacy-head__title">隐私与数据</text>
    <text class="privacy-head__copy">时刻见只收集「你自己愿意放进来」的东西。这里说明清楚收集了什么、用在哪、存在哪。</text>
    <text class="privacy-head__meta">更新于 {{updatedAt}}</text>
  </view>

  <view wx:for="{{sections}}" wx:key="title" class="privacy-card">
    <text class="privacy-card__title">{{item.title}}</text>
    <view wx:for="{{item.items}}" wx:for-item="line" wx:key="*this" class="privacy-card__row">
      <view class="privacy-card__dot"></view>
      <text class="privacy-card__text">{{line}}</text>
    </view>
  </view>

  <view class="privacy-card privacy-card--contact">
    <text class="privacy-card__title">联系我们</text>
    <text class="privacy-card__text">对隐私有任何疑问，或需要删除账号数据，请发邮件到 zosah1921@gmail.com，标题注明「时刻见 数据申请」。</text>
  </view>

  <text class="privacy-footer">时刻见 · 家庭共同生活记录</text>
</view>
