.feature-list-page {
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  overflow: hidden;
  padding: 34rpx 34rpx calc(70rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 105% -4%, rgba(247, 218, 205, 0.46), transparent 28%),
    radial-gradient(circle at -8% 68%, rgba(222, 235, 226, 0.34), transparent 24%),
    linear-gradient(180deg, #fffaf5 0%, #f8f7f4 48%, #f4f1eb 100%);
  color: var(--c-text);
}

.feature-list-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 8rpx 4rpx 18rpx;
  gap: 18rpx;
}

.feature-list-head__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.feature-list-head__title {
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 54rpx;
  font-weight: 760;
  letter-spacing: -1.4rpx;
  line-height: 1.2;
}

.feature-list-head__description {
  margin-top: 8rpx;
  color: var(--c-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.feature-list-head__config {
  display: flex;
  min-height: 60rpx;
  align-items: center;
  margin-top: 4rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  color: var(--c-text-2);
  flex: 0 0 auto;
  font-size: 22rpx;
  font-weight: 650;
  gap: 7rpx;
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.feature-list-head__config--pressed,
.feature-tile--pressed {
  opacity: 0.6;
}

.feature-group {
  margin-top: 27rpx;
}

.feature-group__head {
  display: flex;
  align-items: center;
  padding: 0 5rpx 12rpx;
  gap: 12rpx;
}

.feature-group__title {
  color: var(--c-text);
  flex: 0 0 auto;
  font-size: 29rpx;
  font-weight: 740;
  line-height: 1.35;
}

.feature-group__rule {
  height: 1rpx;
  background: rgba(213, 205, 195, 0.62);
  flex: 1;
}

.feature-group__description {
  overflow: hidden;
  max-width: 300rpx;
  color: var(--c-faint);
  font-size: 20rpx;
  line-height: 1.4;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.feature-tile {
  display: flex;
  min-width: 0;
  min-height: 108rpx;
  align-items: center;
  padding: 16rpx 17rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 25rpx;
  background: rgba(255, 255, 255, 0.74);
  box-shadow:
    0 14rpx 34rpx -34rpx rgba(81, 67, 57, 0.42),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
  gap: 13rpx;
  transition: opacity 120ms ease;
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.feature-tile__icon {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 18rpx;
  flex: 0 0 auto;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.feature-tile__icon--blue { background: #e5ece9; }
.feature-tile__icon--green { background: #e4eee7; }
.feature-tile__icon--gold { background: #f2e8ce; }
.feature-tile__icon--pink { background: #eee7ec; }
.feature-tile__icon--orange { background: #f3e5df; }

.feature-tile__body {
  min-width: 0;
  flex: 1;
}

.feature-tile__title-line {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 7rpx;
}

.feature-tile__title {
  overflow: hidden;
  color: var(--c-text);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-tile__placement {
  padding: 2rpx 7rpx;
  border-radius: 999rpx;
  background: rgba(229, 238, 231, 0.94);
  color: var(--c-sage);
  flex: 0 0 auto;
  font-size: 16rpx;
  font-weight: 650;
  line-height: 1.35;
}

.feature-tile__description {
  display: block;
  overflow: hidden;
  margin-top: 3rpx;
  color: var(--c-muted);
  font-size: 20rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@media (prefers-reduced-motion: reduce) {
  .feature-tile {
    transition: none;
  }
}
