.feature-list-page {
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  overflow: hidden;
  padding: 38rpx 34rpx calc(70rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 105% -4%, rgba(247, 218, 205, 0.46), transparent 28%),
    linear-gradient(180deg, #fffaf5 0%, #f8f7f4 48%, #f4f1eb 100%);
  color: var(--c-text);
}

.feature-list-head {
  padding: 8rpx 4rpx 34rpx;
}

.feature-list-head__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.feature-list-head__eyebrow {
  color: var(--c-faint);
  font-family: Georgia, "Songti SC", serif;
  font-size: 21rpx;
  font-style: italic;
  letter-spacing: 2rpx;
}

.feature-list-head__config {
  display: flex;
  min-height: 62rpx;
  align-items: center;
  padding: 0 19rpx 0 23rpx;
  border: 1rpx solid rgba(213, 205, 195, 0.9);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: var(--c-text-2);
  font-size: 24rpx;
  font-weight: 650;
  gap: 7rpx;
}

.feature-list-head__config--pressed {
  opacity: 0.58;
}

.feature-list-head__config text:last-child {
  color: var(--c-faint);
  font-size: 31rpx;
  font-weight: 300;
}

.feature-list-head__title {
  display: block;
  margin-top: 20rpx;
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 58rpx;
  font-weight: 760;
  letter-spacing: -1.8rpx;
  line-height: 1.24;
}

.feature-list-head__copy {
  display: block;
  margin-top: 10rpx;
  color: var(--c-muted);
  font-size: 26rpx;
  line-height: 1.62;
}

.feature-group {
  margin-top: 30rpx;
}

.feature-group__head {
  display: flex;
  align-items: center;
  padding: 0 6rpx 14rpx;
  gap: 15rpx;
}

.feature-group__mark {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  flex: 0 0 auto;
}

.feature-group__mark--orange { background: #f7e7e2; }
.feature-group__mark--blue { background: #e2e8e5; }
.feature-group__mark--green { background: #e2eee9; }
.feature-group__mark--gold { background: #f2e8cc; }
.feature-group__mark--pink { background: #e9e5eb; }

.feature-group__copy {
  min-width: 0;
  flex: 1;
}

.feature-group__title-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.feature-group__title {
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 34rpx;
  font-weight: 740;
  line-height: 1.3;
}

.feature-group__eyebrow {
  color: var(--c-faint);
  font-family: Georgia, "Songti SC", serif;
  font-size: 18rpx;
  font-style: italic;
  letter-spacing: 1.6rpx;
}

.feature-group__description {
  display: block;
  margin-top: 2rpx;
  color: var(--c-muted);
  font-size: 23rpx;
  line-height: 1.45;
}

.feature-group__list {
  overflow: hidden;
  padding: 0 21rpx;
  border: 1rpx solid rgba(225, 218, 208, 0.86);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow:
    0 18rpx 44rpx -38rpx rgba(92, 74, 61, 0.32),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
}

.feature-row {
  display: flex;
  min-height: 118rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--c-line);
  gap: 16rpx;
  transition: opacity 120ms ease;
}

.feature-row:last-child {
  border-bottom: 0;
}

.feature-row--pressed {
  opacity: 0.58;
}

.feature-row__icon {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 21rpx;
  flex: 0 0 auto;
}

.feature-row__icon--orange { background: #f7e7e2; }
.feature-row__icon--blue { background: #e2e8e5; }
.feature-row__icon--green { background: #e2eee9; }
.feature-row__icon--gold { background: #f2e8cc; }
.feature-row__icon--pink { background: #e9e5eb; }

.feature-row__body {
  min-width: 0;
  flex: 1;
}

.feature-row__title-line {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 10rpx;
}

.feature-row__title {
  overflow: hidden;
  color: var(--c-text);
  font-size: 29rpx;
  font-weight: 680;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-row__placement {
  padding: 3rpx 9rpx;
  border-radius: 999rpx;
  background: var(--c-sage-soft);
  color: var(--c-sage);
  flex: 0 0 auto;
  font-size: 19rpx;
  font-weight: 650;
  line-height: 1.4;
}

.feature-row__description {
  display: block;
  overflow: hidden;
  margin-top: 4rpx;
  color: var(--c-muted);
  font-size: 23rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-row__arrow {
  margin-left: 4rpx;
  color: #beb7ae;
  flex: 0 0 auto;
  font-size: 38rpx;
  font-weight: 300;
}

.feature-list-note {
  display: flex;
  align-items: flex-start;
  margin-top: 28rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(225, 218, 208, 0.72);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.54);
  color: var(--c-muted);
  gap: 12rpx;
  font-size: 22rpx;
  line-height: 1.58;
}
