.feature-list-page {
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  overflow: hidden;
  padding: 34rpx 30rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 105% -4%, rgba(247, 218, 205, 0.5), transparent 27%),
    radial-gradient(circle at -8% 72%, rgba(222, 235, 226, 0.38), transparent 24%),
    linear-gradient(180deg, #fffaf5 0%, #f8f6f2 50%, #f3f0eb 100%);
  color: var(--c-text);
}

.feature-list-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 6rpx 4rpx 20rpx;
  gap: 18rpx;
}

.feature-list-head__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.feature-list-head__title {
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 62rpx;
  font-weight: 760;
  letter-spacing: -1.8rpx;
  line-height: 1.16;
}

.feature-list-head__description {
  margin-top: 7rpx;
  color: var(--c-muted);
  font-size: 23rpx;
  line-height: 1.45;
}

.feature-list-head__config {
  display: flex;
  min-height: 62rpx;
  align-items: center;
  margin-top: 4rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 16rpx 34rpx -30rpx rgba(80, 65, 53, 0.42);
  color: var(--c-text-2);
  flex: 0 0 auto;
  font-size: 22rpx;
  font-weight: 660;
  gap: 7rpx;
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.feature-list-head__config--pressed,
.feature-tile--pressed {
  opacity: 0.58;
}

.feature-group {
  margin-top: 38rpx;
}

.feature-group__head {
  display: grid;
  grid-template-columns: 58rpx minmax(0, 1fr);
  align-items: start;
  margin-bottom: 17rpx;
  padding: 0 4rpx 16rpx;
  gap: 7rpx;
}

.feature-group__index {
  padding-top: 4rpx;
  color: #b4a79c;
  font-family: Georgia, serif;
  font-size: 19rpx;
  font-style: italic;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.feature-group__copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.feature-group__title-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 13rpx;
}

.feature-group__title {
  color: var(--c-text);
  flex: 0 0 auto;
  font-family: var(--font-serif);
  font-size: 40rpx;
  font-weight: 760;
  letter-spacing: -0.8rpx;
  line-height: 1.12;
}

.feature-group__rule {
  height: 1rpx;
  background: linear-gradient(90deg, rgba(120, 109, 98, 0.2), rgba(120, 109, 98, 0.04));
  flex: 1;
}

.feature-group__count {
  color: #a0958a;
  flex: 0 0 auto;
  font-size: 17rpx;
  font-weight: 650;
  letter-spacing: 0.3rpx;
  line-height: 1.2;
}

.feature-group__description {
  display: block;
  overflow: hidden;
  margin-top: 7rpx;
  color: #9c9389;
  font-size: 21rpx;
  letter-spacing: 0.3rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 13rpx;
}

.feature-tile {
  display: flex;
  overflow: hidden;
  min-width: 0;
  min-height: 204rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 30rpx;
  box-shadow:
    0 18rpx 40rpx -34rpx rgba(81, 67, 57, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.94);
  box-sizing: border-box;
  flex-direction: column;
  transition: opacity 120ms ease;
}

.feature-tile--blue { background: linear-gradient(145deg, #dce9e6, #e7eeeb); }
.feature-tile--green { background: linear-gradient(145deg, #dfeae2, #edf2eb); }
.feature-tile--gold { background: linear-gradient(145deg, #f1e4c8, #f7edda); }
.feature-tile--pink { background: linear-gradient(145deg, #e8e0ea, #f0eaf1); }
.feature-tile--orange { background: linear-gradient(145deg, #f2ddd3, #f7e8e0); }

.feature-tile__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.feature-tile__icon {display: flex; width: 104rpx; height: 104rpx; align-items: center; justify-content: center;}

.feature-tile__arrow {display: flex; width: 38rpx; height: 38rpx; align-items: center; justify-content: center; color: rgba(63, 59, 54, 0.48); font-size: 25rpx; font-weight: 300; line-height: 1;}

.feature-tile__body {
  min-width: 0;
  margin-top: auto;
}

.feature-tile__title-line {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 7rpx;
}

.feature-tile__title {
  overflow: hidden;
  color: #30312e;
  font-family: var(--font-serif);
  font-size: 29rpx;
  font-weight: 760;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-tile__placement {
  padding: 2rpx 7rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.59);
  color: #6e7b72;
  flex: 0 0 auto;
  font-size: 15rpx;
  font-weight: 660;
  line-height: 1.4;
}

.feature-tile__description {
  display: block;
  overflow: hidden;
  margin-top: 4rpx;
  color: rgba(75, 70, 64, 0.66);
  font-size: 19rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@media (prefers-reduced-motion: reduce) {
  .feature-tile {
    transition: none;
  }
}
