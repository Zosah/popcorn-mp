<view class="page-shell menu-page">
  <view class="subpage-back" bindtap="onBack">← 返回家</view>

  <view class="menu-head">
    <view class="menu-head__top">
      <view class="menu-head__title">这周，吃点什么</view>
      <view class="menu-add" bindtap="onCreate">
        <line-icon name="plus" size="22" tone="ink" />
        <text>加一道</text>
      </view>
    </view>
    <view class="menu-head__copy">把想做的菜和步骤留下来，忙的时候也能快速决定。</view>
    <view class="sync-row"><sync-badge state="local" text="本机菜单 · 暂未跨设备同步" /></view>
  </view>

  <view wx:if="{{recipes.length}}" class="menu-list">
    <view wx:for="{{recipes}}" wx:key="id" class="menu-card" data-id="{{item.id}}" bindtap="onOpenRecipe">
      <image wx:if="{{item.image}}" class="menu-card__image" src="{{item.image.src}}" mode="aspectFill" />
      <view wx:else class="menu-card__placeholder"><line-icon name="soup" size="42" tone="muted" /></view>
      <view class="menu-card__body">
        <view class="menu-card__meta">
          <text>{{item.cookingMinutes}} 分钟</text>
          <text>{{item.servings}} 人份</text>
        </view>
        <view class="menu-card__title">{{item.title}}</view>
        <view class="menu-card__copy">{{item.description || '还没有写下这道菜的介绍。'}}</view>
        <view class="menu-card__foot">
          <text>{{item.ingredients.length}} 样食材 · {{item.steps.length}} 步</text>
          <text>打开菜单</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="menu-empty">
    <line-icon name="utensils" size="34" tone="muted" />
    <text class="menu-empty__title">菜单还是空的</text>
    <text class="menu-empty__copy">先收一道常做的菜，下次不知道吃什么时就有答案了。</text>
    <view class="menu-empty__action" bindtap="onCreate">添加第一道菜单</view>
  </view>
</view>
