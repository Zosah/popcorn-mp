<view class="page-shell menu-page">
  <view class="menu-top">
    <view class="menu-top__main">
      <view class="menu-top__title">今天吃什么</view>
      <view class="menu-top__sub">{{recipes.length}} 道常做的</view>
    </view>
    <view class="menu-add" bindtap="onCreate">
      <line-icon name="plus" size="22" tone="white" />
      <text>新建</text>
    </view>
  </view>

  <view class="menu-tabs">
    <view class="menu-tab {{activeTab === 'today' ? 'menu-tab--active' : ''}}" data-value="today" bindtap="onSwitchTab">今天</view>
    <view class="menu-tab {{activeTab === 'all' ? 'menu-tab--active' : ''}}" data-value="all" bindtap="onSwitchTab">常做的</view>
    <view class="menu-tab {{activeTab === 'week' ? 'menu-tab--active' : ''}}" data-value="week" bindtap="onSwitchTab">本周</view>
  </view>

  <block wx:if="{{activeTab === 'today'}}">
    <view wx:if="{{recommended}}" class="menu-recommend">
      <view class="menu-recommend__head">
        <view class="menu-recommend__eyebrow">今晚推荐</view>
        <view class="menu-recommend__shuffle" bindtap="onShuffleRecommendation">换一道</view>
      </view>
      <view class="menu-recommend__main">
        <view class="menu-recommend__thumb">
          <image wx:if="{{recommended.image}}" src="{{recommended.image.src}}" mode="aspectFill" />
          <line-icon wx:else name="soup" size="42" tone="gold" />
        </view>
        <view class="menu-recommend__body">
          <view class="menu-recommend__title">{{recommended.title}}</view>
          <view class="menu-recommend__meta">{{recommended.cookingMinutes}} 分钟 · {{recommended.servings}} 人份 · 家常</view>
        </view>
      </view>
      <view class="menu-recommend__button" bindtap="onOpenRecommended">就吃这个 · 打开菜谱</view>
    </view>

    <view wx:else class="menu-empty">
      <view class="menu-empty__icon"><line-icon name="utensils" size="36" tone="gold" /></view>
      <view class="menu-empty__title">菜单还是空的</view>
      <view class="menu-empty__copy">先收一道常做的菜，下次不知道吃什么时就有答案了。</view>
      <view class="menu-empty__action" bindtap="onCreate">添加第一道菜单</view>
    </view>

    <view class="menu-section-head"><text>快速决定</text><text>按场景</text></view>
    <view class="menu-quick">
      <view class="menu-quick__row" data-value="all" bindtap="onSwitchTab">
        <view class="menu-quick__icon menu-quick__icon--green"><line-icon name="clock-3" size="24" tone="green" /></view>
        <text>30 分钟内能做好</text>
        <text>{{fastCount}} 道</text>
      </view>
      <view class="menu-quick__row" data-value="all" bindtap="onSwitchTab">
        <view class="menu-quick__icon menu-quick__icon--orange"><line-icon name="flame" size="24" tone="orange" /></view>
        <text>从常做的里面挑</text>
        <text>打开菜谱本</text>
      </view>
      <view class="menu-quick__row" data-value="week" bindtap="onSwitchTab">
        <view class="menu-quick__icon menu-quick__icon--blue"><line-icon name="calendar-days" size="24" tone="blue" /></view>
        <text>这周换换口味</text>
        <text>{{recipes.length}} 道可选</text>
      </view>
    </view>
  </block>

  <block wx:elif="{{recipes.length}}">
    <view class="menu-section-head">
      <text>{{activeTab === 'week' ? '本周菜单' : '常做的菜'}}</text>
      <text>{{recipes.length}} 道</text>
    </view>
    <view class="menu-list">
      <view wx:for="{{recipes}}" wx:key="id" class="menu-card" data-id="{{item.id}}" bindtap="onOpenRecipe">
        <view class="menu-card__media">
          <image wx:if="{{item.image}}" src="{{item.image.src}}" mode="aspectFill" />
          <line-icon wx:else name="soup" size="36" tone="gold" />
        </view>
        <view class="menu-card__body">
          <view class="menu-card__title">{{item.title}}</view>
          <view class="menu-card__meta">{{item.cookingMinutes}} 分钟 · {{item.servings}} 人份 · {{item.ingredients.length}} 样食材</view>
          <view class="menu-card__copy">{{item.description || '还没有写下这道菜的介绍。'}}</view>
        </view>
        <view class="menu-card__arrow">›</view>
      </view>
    </view>
  </block>

  <view wx:else class="menu-empty">
    <view class="menu-empty__icon"><line-icon name="utensils" size="36" tone="gold" /></view>
    <view class="menu-empty__title">菜单还是空的</view>
    <view class="menu-empty__copy">先收一道常做的菜，下次不知道吃什么时就有答案了。</view>
    <view class="menu-empty__action" bindtap="onCreate">添加第一道菜单</view>
  </view>
</view>
