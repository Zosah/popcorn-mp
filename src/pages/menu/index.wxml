<view class="page-shell menu-page">
  <page-loading show="{{loading && !hasLoaded}}" title="正在翻菜谱本" copy="今天的点子和常做的菜，很快就来。" />
  <auth-preview-gate />

  <view class="menu-hero">
    <view class="menu-hero__copy">
      <view class="menu-hero__eyebrow">一起吃点好的</view>
      <view class="menu-hero__title">今天吃什么</view>
      <view class="menu-hero__sub">{{allRecipes.length}} 道菜谱 · {{activeOrders.length}} 张待办点单</view>
    </view>
    <view class="menu-hero__mark" aria-hidden="true">
      <view class="menu-hero__steam menu-hero__steam--one"></view>
      <view class="menu-hero__steam menu-hero__steam--two"></view>
      <view class="menu-hero__bowl"><line-icon name="menu-category-soup" size="44" tone="gold" /></view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="menu-loading">
    <view class="menu-loading__dot"></view>
    <view class="menu-loading__dot"></view>
    <view class="menu-loading__dot"></view>
    <text>正在翻菜谱本…</text>
  </view>

  <view wx:elif="{{loadError}}" class="menu-empty menu-empty--error">
    <view class="menu-empty__icon"><line-icon name="system-alert" size="34" tone="orange" /></view>
    <view class="menu-empty__title">菜单没加载出来</view>
    <view class="menu-empty__copy">{{loadError}}</view>
    <view class="menu-empty__action" bindtap="onRetryLoad">再试一次</view>
  </view>

  <block wx:else>
    <view class="menu-tabs" role="tablist">
      <view class="menu-tab {{activeTab === 'eat' ? 'menu-tab--active' : ''}}" data-value="eat" bindtap="onSwitchTab">
        <line-icon name="menu-tab-eat" size="30" tone="accent" />
        <text>吃啥</text>
        <view wx:if="{{activeOrders.length}}" class="menu-tab__count">{{activeOrders.length}}</view>
      </view>
      <view class="menu-tab {{activeTab === 'recipes' ? 'menu-tab--active' : ''}}" data-value="recipes" bindtap="onSwitchTab">
        <line-icon name="menu-tab-recipes" size="30" tone="accent" />
        <text>菜谱本</text>
        <view class="menu-tab__count">{{allRecipes.length}}</view>
      </view>
    </view>

    <view wx:if="{{activeTab === 'eat'}}" class="menu-eat">
      <view wx:if="{{activeOrders.length}}" class="menu-section-head">
        <view>
          <text>正在准备</text>
          <text>点菜单会同步给空间里的每个人</text>
        </view>
        <text>{{activeOrders.length}} 单</text>
      </view>

      <view wx:for="{{activeOrders}}" wx:key="id" class="menu-order menu-order--{{item.status}}">
        <view class="menu-order__head">
          <view class="menu-order__who">
            <view class="menu-order__avatar">
              <image wx:if="{{item.creatorAvatarUrl}}" class="menu-order__avatar-image" src="{{item.creatorAvatarUrl}}" mode="aspectFill" data-id="{{item.id}}" data-role="creator" binderror="onOrderAvatarError" />
              <text wx:else>{{item.creatorInitial}}</text>
            </view>
            <view class="menu-order__meta">
              <text>{{item.dateLabel}} {{item.mealLabel}} · {{item.timeLabel}}</text>
              <text>{{item.createdByName}} 点的菜</text>
            </view>
          </view>
          <view class="menu-order__head-actions">
            <view class="menu-order__status">{{item.statusLabel}}</view>
            <text class="menu-order__delete" data-id="{{item.id}}" data-version="{{item.version}}" catchtap="onDeleteOrder">删除</text>
          </view>
        </view>
        <view wx:if="{{item.updatedBy && item.updatedBy !== item.createdBy}}" class="menu-order__updater">
          <view class="menu-order__updater-avatar">
            <image wx:if="{{item.updaterAvatarUrl}}" class="menu-order__avatar-image" src="{{item.updaterAvatarUrl}}" mode="aspectFill" data-id="{{item.id}}" data-role="updater" binderror="onOrderAvatarError" />
            <text wx:else>{{item.updaterInitial}}</text>
          </view>
          <text>{{item.updatedByName}} 更新</text>
        </view>

        <view class="menu-order__dishes">{{item.itemSummary}}</view>
        <view wx:if="{{item.note}}" class="menu-order__note">“{{item.note}}”</view>

        <view wx:if="{{item.ingredientCount}}" class="menu-order__prep">
          <view class="menu-order__prep-head">
            <text>备菜清单</text>
            <text>{{item.readyIngredientCount}} / {{item.ingredientCount}}</text>
          </view>
          <view wx:for="{{item.items}}" wx:for-item="dish" wx:key="id" class="menu-order__dish {{dish.readyCount === dish.ingredients.length ? 'menu-order__dish--complete' : ''}}">
            <view class="menu-order__dish-head">
              <view class="menu-order__dish-cover">
                <image wx:if="{{dish.imageSrc}}" src="{{dish.imageSrc}}" mode="aspectFill" />
                <view wx:else class="menu-order__dish-cover-empty"><line-icon name="menu-object-ingredient" size="24" tone="muted" /></view>
                <text class="menu-order__dish-index">{{dish.numberLabel}}</text>
              </view>
              <view class="menu-order__dish-title-row">
                <text class="menu-order__dish-name">{{dish.recipeTitle}}</text>
                <text class="menu-order__dish-count">{{dish.readyCount}}/{{dish.ingredients.length}}</text>
              </view>
              <view class="menu-order__dish-actions">
                <view wx:if="{{dish.readyCount === dish.ingredients.length}}" class="menu-order__dish-action" data-order-id="{{item.id}}" data-dish-id="{{dish.id}}" bindtap="onToggleDishIngredients">{{dish.expanded ? '收起' : '食材'}}</view>
                <view class="menu-order__dish-action menu-order__dish-action--steps" data-order-id="{{item.id}}" data-dish-id="{{dish.id}}" bindtap="onOpenRecipeSteps">
                  <line-icon name="menu-tab-recipes" size="17" tone="accent" />
                  <text>看看怎么做</text>
                </view>
              </view>
            </view>
            <view wx:if="{{dish.expanded && dish.ingredients.length}}" class="menu-order__ingredients">
              <view
                wx:for="{{dish.ingredients}}"
                wx:for-item="ingredient"
                wx:key="id"
                class="menu-order__ingredient {{ingredient.ready ? 'menu-order__ingredient--ready' : ''}}"
                data-order-id="{{item.id}}"
                data-ingredient-id="{{ingredient.id}}"
                data-ready="{{ingredient.ready}}"
                bindtap="onToggleIngredient"
              >
                <view class="menu-order__check">{{ingredient.ready ? '✓' : ''}}</view>
                <text class="menu-order__ingredient-name">{{ingredient.name}}</text>
                <text wx:if="{{ingredient.amount}}" class="menu-order__ingredient-amount">{{ingredient.amount}}</text>
                <text wx:if="{{ingredient.source}}" class="menu-order__ingredient-source">{{ingredient.source}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="menu-order__foot">
          <text wx:if="{{item.ingredientCount}}">{{item.readyIngredientCount === item.ingredientCount ? '东西齐了，可以开火' : '边看边准备，不着急'}}</text>
          <text wx:else>这道菜单没有写食材</text>
          <button
            wx:if="{{item.actionLabel}}"
            class="menu-order__action {{orderActionId === item.id ? 'menu-order__action--busy' : ''}}"
            data-id="{{item.id}}"
            data-status="{{item.nextStatus}}"
            disabled="{{orderActionId === item.id}}"
            bindtap="onAdvanceOrder"
          >{{item.actionLabel}}</button>
        </view>
      </view>

      <view wx:if="{{!activeOrders.length}}" class="menu-eat-empty">
        <view class="menu-eat-empty__art" aria-hidden="true">
          <view class="menu-eat-empty__sun"></view>
          <view class="menu-eat-empty__plate">
            <view class="menu-eat-empty__food menu-eat-empty__food--one"></view>
            <view class="menu-eat-empty__food menu-eat-empty__food--two"></view>
            <view class="menu-eat-empty__food menu-eat-empty__food--three"></view>
          </view>
          <view class="menu-eat-empty__leaf menu-eat-empty__leaf--one"></view>
          <view class="menu-eat-empty__leaf menu-eat-empty__leaf--two"></view>
        </view>
        <view class="menu-eat-empty__copy">
          <text class="menu-eat-empty__eyebrow">今天的餐桌</text>
          <text class="menu-eat-empty__title">想吃什么，点两道</text>
          <text class="menu-eat-empty__desc">菜谱本里挑好，提交后空间里的每个人都能看到。</text>
        </view>
        <view class="menu-eat-empty__action" data-value="recipes" bindtap="onSwitchTab">
          <text>去菜谱本点菜</text>
          <line-icon name="system-add" size="20" tone="white" />
        </view>
      </view>

      <view class="menu-history">
        <view class="menu-section-head menu-section-head--history">
          <view>
            <text>吃过的这一桌</text>
            <text>备菜和吃饭都完成后，会收在这里</text>
          </view>
          <text>{{historyOrders.length}} 次</text>
        </view>
        <view wx:if="{{historyOrders.length}}" class="menu-history__list">
          <view
            wx:for="{{visibleHistoryOrders}}"
            wx:key="id"
            class="menu-history__row"
            data-id="{{item.id}}"
            bindtap="onOpenOrderDetail"
          >
            <view class="menu-history__date">
              <text>{{item.dateLabel}}</text>
              <text>{{item.mealLabel}} {{item.timeLabel}}</text>
            </view>
            <view class="menu-history__body">
              <text>{{item.itemSummary}}</text>
              <text>{{item.createdByName}} · {{item.statusLabel}}</text>
            </view>
            <view class="menu-history__arrow">›</view>
          </view>
        </view>
        <view wx:else class="menu-history__empty">
          <view class="menu-history__empty-icon"><line-icon name="system-clock" size="26" tone="muted" /></view>
          <view class="menu-history__empty-copy">
            <text>还没有吃过的这一桌</text>
            <text>完成一次点单后，会在这里留下记录</text>
          </view>
        </view>
        <view wx:if="{{hasMoreHistory}}" class="menu-history__toggle" bindtap="onToggleHistory">
          {{showAllHistory ? '收起一些' : '看看更早的'}}
        </view>
      </view>
    </view>

    <view wx:if="{{activeTab === 'recipes'}}" class="menu-book">
      <view class="menu-categories" role="tablist" aria-label="菜谱分类">
        <view
          wx:for="{{categoryTabs}}"
          wx:key="id"
          class="menu-category {{selectedCategoryId === item.id ? 'menu-category--active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSelectCategory"
        >
          <text class="menu-category__name">{{item.name}}</text>
          <text class="menu-category__count">{{item.count}}</text>
        </view>
      </view>

      <view class="menu-recipes">
        <view class="menu-recipes__head">
          <view>
            <text>菜谱本</text>
            <text>{{categoryRecipes.length}} 道菜</text>
          </view>
          <view class="menu-recipes__actions">
            <view class="menu-add" bindtap="onCreate">
              <line-icon name="system-add" size="20" tone="white" />
              <text>新菜谱</text>
            </view>
          </view>
        </view>

        <view wx:if="{{categoryRecipes.length}}" class="menu-recipe-list">
          <view wx:for="{{categoryRecipes}}" wx:key="id" class="menu-recipe" data-id="{{item.id}}" bindtap="onOpenRecipe">
            <view class="menu-recipe__top">
              <view class="menu-recipe__body">
                <view class="menu-recipe__title">{{item.title}}</view>
                <view wx:if="{{item.description}}" class="menu-recipe__desc">{{item.description}}</view>
                <view wx:if="{{item.ingredients.length}}" class="menu-recipe__ingredients"><block wx:for="{{item.ingredients}}" wx:key="id" wx:for-item="ingredient"><text>{{ingredient.name}}</text><text wx:if="{{index < item.ingredients.length - 1}}" class="menu-recipe__sep">、</text></block></view>
              </view>
              <view class="menu-recipe__media">
                <image wx:if="{{item.image && item.image.src}}" src="{{item.image.src}}" mode="aspectFit" />
                <line-icon wx:else name="menu-category-soup" size="34" tone="gold" />
              </view>
            </view>
            <view class="menu-recipe__foot">
              <text class="menu-recipe__hint">{{item.updatedLabel}}</text>
              <view class="menu-recipe__order" data-id="{{item.id}}" catchtap="onAddToCart" aria-label="添加{{item.title}}">
                <line-icon name="system-add" size="20" tone="white" />
                <text>吃它</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:else class="menu-empty menu-empty--book">
          <view class="menu-empty__icon"><line-icon name="menu-tab-recipes" size="34" tone="orange" /></view>
          <view class="menu-empty__title">{{allRecipes.length ? '这里还没有菜谱' : '菜谱本还是空的'}}</view>
          <view class="menu-empty__copy">{{allRecipes.length ? '换一个分类看看，或者把这道菜放进这里。' : '把常做的菜和拿手菜谱记下来，点菜时会更容易。'}}</view>
          <view class="menu-empty__action" bindtap="onCreate">{{allRecipes.length ? '新建菜谱' : '新建第一道菜谱'}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{cartCount}}" class="menu-cart-bar" bindtap="onOpenCart">
      <view class="menu-cart-bar__left">
        <view class="menu-cart-bar__bag">
          <line-icon name="menu-object-ingredient" size="27" tone="white" />
          <view class="menu-cart-bar__badge">{{cartCount}}</view>
        </view>
        <view class="menu-cart-bar__copy">
          <text>已点 {{cartCount}} 道菜</text>
          <text>看看这一桌想吃什么</text>
        </view>
      </view>
      <view class="menu-cart-bar__action">
        <text>选好了</text>
        <line-icon name="system-check" size="19" tone="white" />
      </view>
    </view>
  </block>

  <view wx:if="{{cartPanelOpen}}" class="menu-cart-mask" bindtap="onCloseCart" catchtouchmove="onStopTap">
    <view class="menu-cart-sheet" catchtap="onStopTap" catchtouchmove="onStopTap">
      <view class="menu-cart-sheet__handle"></view>
      <view class="menu-cart-sheet__head">
        <view>
          <text>这一桌</text>
          <text>{{mealType === 'breakfast' ? '早餐' : mealType === 'lunch' ? '午餐' : mealType === 'dinner' ? '晚餐' : '加餐'}} · {{cartCount}} 道</text>
        </view>
        <view class="menu-cart-sheet__delete" bindtap="onClearCart">删除</view>
      </view>

      <view class="menu-cart-list">
        <view wx:for="{{cartItems}}" wx:key="id" class="menu-cart-item">
          <view class="menu-cart-item__index">{{index < 9 ? '0' : ''}}{{index + 1}}</view>
          <view class="menu-cart-item__body">
            <text>{{item.recipe.title}}</text>
            <text>{{item.recipe.cookingMinutes}} 分钟</text>
          </view>
          <view class="menu-cart-item__remove" data-id="{{item.recipe.id}}" bindtap="onRemoveCartItem">删除</view>
        </view>
      </view>

      <view class="menu-cart-sheet__label">什么时候吃</view>
      <view class="menu-meal-types">
        <view class="menu-meal-type {{mealType === 'breakfast' ? 'menu-meal-type--active' : ''}}" data-value="breakfast" bindtap="onMealTypeSelect">早餐</view>
        <view class="menu-meal-type {{mealType === 'lunch' ? 'menu-meal-type--active' : ''}}" data-value="lunch" bindtap="onMealTypeSelect">午餐</view>
        <view class="menu-meal-type {{mealType === 'dinner' ? 'menu-meal-type--active' : ''}}" data-value="dinner" bindtap="onMealTypeSelect">晚餐</view>
        <view class="menu-meal-type {{mealType === 'snack' ? 'menu-meal-type--active' : ''}}" data-value="snack" bindtap="onMealTypeSelect">加餐</view>
      </view>

      <view class="menu-cart-sheet__label">留句话给厨房</view>
      <input
        class="menu-cart-note"
        value="{{mealNote}}"
        maxlength="100"
        placeholder="比如：少放辣，今晚七点吃"
        placeholder-class="menu-field-placeholder"
        bindinput="onMealNoteInput"
      />

      <button class="menu-cart-submit" loading="{{submittingOrder}}" disabled="{{submittingOrder}}" bindtap="onSubmitOrder">
        {{submittingOrder ? '正在交给大家' : '提交给厨房'}}
      </button>
      <view class="menu-cart-sheet__safe"></view>
    </view>
  </view>

  <view wx:if="{{historyDetailOrder}}" class="menu-order-detail-mask" catchtap="onCloseOrderDetail" catchtouchmove="onStopTap">
    <view class="menu-order-detail-sheet" catchtap="onStopTap" catchtouchmove="onStopTap">
      <view class="menu-cart-sheet__handle"></view>
      <view class="menu-order-detail__head">
        <view class="menu-order-detail__head-copy">
          <text class="menu-order-detail__eyebrow">这一餐</text>
          <text class="menu-order-detail__title">{{historyDetailOrder.dateLabel}} · {{historyDetailOrder.mealLabel}}</text>
        </view>
        <view class="menu-cart-sheet__close sheet-close-icon" bindtap="onCloseOrderDetail" aria-label="关闭"><line-icon name="system-close" size="26" tone="muted" /></view>
      </view>

      <scroll-view class="menu-order-detail__scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="menu-order-detail__summary">
          <text class="menu-order-detail__dishes">{{historyDetailOrder.itemSummary}}</text>
          <view class="menu-order-detail__status menu-order-detail__status--{{historyDetailOrder.status}}">{{historyDetailOrder.statusLabel}}</view>
        </view>

        <view class="menu-order-detail__people">
          <view class="menu-order-detail__person">
            <view class="menu-order-detail__person-avatar">
              <image wx:if="{{historyDetailOrder.creatorAvatarUrl}}" class="menu-order__avatar-image" src="{{historyDetailOrder.creatorAvatarUrl}}" mode="aspectFill" data-id="{{historyDetailOrder.id}}" data-role="creator" binderror="onOrderAvatarError" />
              <text wx:else>{{historyDetailOrder.creatorInitial}}</text>
            </view>
            <text>{{historyDetailOrder.createdByName}} 发起</text>
          </view>
          <view wx:if="{{historyDetailOrder.updatedBy && historyDetailOrder.updatedBy !== historyDetailOrder.createdBy}}" class="menu-order-detail__person">
            <view class="menu-order-detail__person-avatar">
              <image wx:if="{{historyDetailOrder.updaterAvatarUrl}}" class="menu-order__avatar-image" src="{{historyDetailOrder.updaterAvatarUrl}}" mode="aspectFill" data-id="{{historyDetailOrder.id}}" data-role="updater" binderror="onOrderAvatarError" />
              <text wx:else>{{historyDetailOrder.updaterInitial}}</text>
            </view>
            <text>{{historyDetailOrder.updatedByName}} 更新</text>
          </view>
          <text class="menu-order-detail__time">{{historyDetailOrder.timeLabel}}</text>
        </view>
        <view class="menu-order-detail__delete" data-id="{{historyDetailOrder.id}}" data-version="{{historyDetailOrder.version}}" catchtap="onDeleteOrder">删除这张点菜单</view>

        <view wx:if="{{historyDetailOrder.note}}" class="menu-order-detail__note">“{{historyDetailOrder.note}}”</view>

        <view wx:if="{{historyDetailOrder.ingredientCount}}" class="menu-order-detail__section">
          <view class="menu-order-detail__section-head">
            <text>备菜清单</text>
            <text>{{historyDetailOrder.readyIngredientCount}} / {{historyDetailOrder.ingredientCount}}</text>
          </view>
          <view wx:for="{{historyDetailOrder.items}}" wx:for-item="dish" wx:key="id" class="menu-order-detail__dish {{dish.readyCount === dish.ingredients.length ? 'menu-order-detail__dish--complete' : ''}}">
            <view class="menu-order-detail__dish-head">
              <view class="menu-order-detail__dish-cover">
                <image wx:if="{{dish.imageSrc}}" src="{{dish.imageSrc}}" mode="aspectFill" />
                <view wx:else class="menu-order-detail__dish-cover-empty"><line-icon name="menu-object-ingredient" size="23" tone="muted" /></view>
                <text class="menu-order-detail__dish-index">{{dish.numberLabel}}</text>
              </view>
              <view class="menu-order-detail__dish-title-row">
                <text class="menu-order-detail__dish-name">{{dish.recipeTitle}}</text>
                <text class="menu-order-detail__dish-count">{{dish.readyCount}}/{{dish.ingredients.length}}</text>
              </view>
              <view class="menu-order-detail__dish-actions">
                <view wx:if="{{dish.readyCount === dish.ingredients.length}}" class="menu-order-detail__dish-action" data-order-id="{{historyDetailOrder.id}}" data-dish-id="{{dish.id}}" bindtap="onToggleDishIngredients">{{dish.expanded ? '收起' : '食材'}}</view>
                <view class="menu-order-detail__dish-action menu-order-detail__dish-action--steps" data-order-id="{{historyDetailOrder.id}}" data-dish-id="{{dish.id}}" bindtap="onOpenRecipeSteps">
                  <line-icon name="menu-tab-recipes" size="16" tone="accent" />
                  <text>看看怎么做</text>
                </view>
              </view>
            </view>
            <view wx:if="{{dish.expanded && dish.ingredients.length}}" class="menu-order-detail__ingredients">
              <view wx:for="{{dish.ingredients}}" wx:for-item="ingredient" wx:key="id" class="menu-order-detail__ingredient {{ingredient.ready ? 'menu-order-detail__ingredient--ready' : ''}}">
                <view class="menu-order-detail__check {{ingredient.ready ? 'menu-order-detail__check--ready' : ''}}">{{ingredient.ready ? '✓' : ''}}</view>
                <text class="menu-order-detail__ingredient-name">{{ingredient.name}}</text>
                <text wx:if="{{ingredient.amount}}" class="menu-order-detail__ingredient-amount">{{ingredient.amount}}</text>
                <text wx:if="{{ingredient.source}}" class="menu-order-detail__ingredient-source">{{ingredient.source}}</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:else class="menu-order-detail__empty">这次点单没有填写食材</view>
        <view class="menu-order-detail__safe"></view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{recipeStepDish}}" class="menu-recipe-steps-mask" catchtap="onCloseRecipeSteps" catchtouchmove="onStopTap">
    <view class="menu-recipe-steps-sheet" catchtap="onStopTap" catchtouchmove="onStopTap">
      <view class="menu-cart-sheet__handle"></view>
      <view class="menu-recipe-steps__head">
        <view class="menu-recipe-steps__cover">
          <image wx:if="{{recipeStepDish.imageSrc}}" src="{{recipeStepDish.imageSrc}}" mode="aspectFill" />
          <view wx:else class="menu-recipe-steps__cover-empty"><line-icon name="menu-object-ingredient" size="31" tone="muted" /></view>
        </view>
        <view class="menu-recipe-steps__title">
          <text>做法</text>
          <text>{{recipeStepDish.title}}</text>
        </view>
        <view class="menu-recipe-steps__close sheet-close-icon" bindtap="onCloseRecipeSteps" aria-label="关闭"><line-icon name="system-close" size="26" tone="muted" /></view>
      </view>
      <scroll-view class="menu-recipe-steps__scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view wx:for="{{recipeStepDish.steps}}" wx:key="id" class="menu-recipe-step">
          <view class="menu-recipe-step__number">{{index + 1}}</view>
          <view class="menu-recipe-step__body">
            <text class="menu-recipe-step__title">{{item.title || '步骤 ' + (index + 1)}}</text>
            <text class="menu-recipe-step__desc">{{item.description}}</text>
          </view>
        </view>
        <view class="menu-recipe-steps__safe"></view>
      </scroll-view>
    </view>
  </view>

  <app-tab-bar id="app-tab-bar" active="menu" />
</view>
