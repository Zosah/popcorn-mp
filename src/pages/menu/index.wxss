.menu-page {
  --menu-paper: var(--c-paper, #fbf8f1);
  --menu-ink: var(--c-text, #2d332e);
  --menu-ink-2: var(--c-text-2, #665f56);
  --menu-ink-3: var(--c-muted, #948d82);
  --menu-line: var(--c-line, #ebe4d7);
  --menu-sage: var(--c-sage, #718d7f);
  --menu-sage-soft: var(--c-sage-soft, #e8f0ea);
  --menu-pink: var(--c-pink, #d89d95);
  --menu-pink-soft: var(--c-pink-soft, #f8e9e5);
  --menu-gold: var(--c-warning, #ae8245);
  --menu-butter: var(--c-butter-soft, #f4ead2);
  min-height: 100vh;
  padding: 24rpx 28rpx calc(242rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 92% 3%, rgba(237, 207, 181, 0.35), transparent 23%),
    linear-gradient(180deg, #fbf8f1 0%, #f8f5ee 100%);
  color: var(--menu-ink);
}

.menu-field-placeholder {
  color: #b8afa2;
  font-size: 25rpx;
}

.menu-hero {
  position: relative;
  display: flex;
  min-height: 206rpx;
  overflow: hidden;
  align-items: flex-start;
  padding: 34rpx 30rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 38rpx;
  background:
    radial-gradient(circle at 84% 18%, rgba(255, 255, 255, 0.82), transparent 30%),
    linear-gradient(135deg, #f2ead8 0%, #e8efe8 100%);
  box-shadow: 0 18rpx 52rpx rgba(83, 73, 53, 0.09);
  box-sizing: border-box;
}

.menu-hero::before,
.menu-hero::after {
  position: absolute;
  border-radius: 50%;
  content: "";
  pointer-events: none;
}

.menu-hero::before {
  right: -34rpx;
  bottom: -50rpx;
  width: 240rpx;
  height: 240rpx;
  border: 28rpx solid rgba(255, 255, 255, 0.18);
}

.menu-hero::after {
  right: 166rpx;
  bottom: 28rpx;
  width: 11rpx;
  height: 11rpx;
  background: rgba(124, 150, 133, 0.45);
  box-shadow:
    22rpx -20rpx 0 rgba(124, 150, 133, 0.24),
    -15rpx -31rpx 0 rgba(174, 130, 69, 0.31);
}

.menu-hero__copy {
  position: relative;
  z-index: 2;
  max-width: 400rpx;
}

.menu-hero__eyebrow {
  color: var(--menu-sage);
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.menu-hero__title {
  margin-top: 9rpx;
  font-family: var(--font-serif);
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1.5rpx;
  line-height: 1.14;
}

.menu-hero__sub {
  margin-top: 13rpx;
  color: var(--menu-ink-2);
  font-size: 24rpx;
  line-height: 1.5;
}

.menu-hero__mark {
  position: absolute;
  right: 42rpx;
  bottom: 34rpx;
  z-index: 1;
  display: flex;
  width: 116rpx;
  height: 98rpx;
  align-items: center;
  justify-content: flex-end;
  flex-direction: column;
}

.menu-hero__bowl {
  position: relative;
  display: flex;
  width: 105rpx;
  height: 74rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(174, 130, 69, 0.18);
  border-radius: 18rpx 18rpx 52rpx 52rpx;
  background: rgba(255, 255, 255, 0.7);
  box-shadow: inset 0 -10rpx 0 rgba(232, 210, 175, 0.36);
}

.menu-hero__steam {
  position: absolute;
  bottom: 76rpx;
  width: 28rpx;
  height: 41rpx;
  border-left: 4rpx solid rgba(113, 141, 127, 0.42);
  border-radius: 50%;
}

.menu-hero__steam--one {
  right: 54rpx;
  transform: rotate(8deg);
}

.menu-hero__steam--two {
  right: 26rpx;
  bottom: 82rpx;
  height: 31rpx;
  transform: rotate(-10deg);
}

.menu-add {
  position: absolute;
  bottom: 30rpx;
  left: 30rpx;
  z-index: 3;
  display: flex;
  height: 52rpx;
  align-items: center;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--menu-ink);
  box-shadow: 0 8rpx 18rpx rgba(45, 51, 46, 0.18);
  color: #fff;
  gap: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.menu-tabs {
  display: flex;
  margin-top: 24rpx;
  padding: 7rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.66);
  box-shadow: 0 10rpx 28rpx rgba(74, 62, 52, 0.06);
  backdrop-filter: blur(20rpx);
}

.menu-tab {
  display: flex;
  height: 66rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: var(--menu-ink-3);
  flex: 1;
  gap: 8rpx;
  font-size: 27rpx;
  transition: background 140ms ease, color 140ms ease, box-shadow 140ms ease;
}

.menu-tab--active {
  background: #fff;
  box-shadow: 0 7rpx 20rpx rgba(75, 65, 52, 0.09);
  color: var(--menu-ink);
  font-weight: 700;
}

.menu-tab__count {
  display: flex;
  min-width: 34rpx;
  height: 32rpx;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--menu-sage-soft);
  color: var(--menu-sage);
  font-size: 19rpx;
  font-weight: 700;
}

.menu-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 32rpx 4rpx 16rpx;
}

.menu-section-head > view {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 5rpx;
}

.menu-section-head > view > text:first-child {
  font-family: var(--font-serif);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.7rpx;
}

.menu-section-head > view > text:last-child,
.menu-section-head > text:last-child {
  color: var(--menu-ink-3);
  font-size: 21rpx;
}

.menu-order {
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
  padding: 26rpx 24rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 14rpx 38rpx rgba(70, 60, 48, 0.07);
  backdrop-filter: blur(18rpx);
}

.menu-order::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 7rpx;
  background: var(--menu-gold);
  content: "";
}

.menu-order--preparing::before {
  background: var(--menu-pink);
}

.menu-order--ready::before {
  background: var(--menu-sage);
}

.menu-order__head,
.menu-order__who,
.menu-order__prep-head,
.menu-order__foot {
  display: flex;
  align-items: center;
}

.menu-order__head {
  justify-content: space-between;
  gap: 16rpx;
}

.menu-order__who {
  min-width: 0;
  flex: 1;
  gap: 13rpx;
}

.menu-order__avatar {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 19rpx;
  background: var(--menu-pink-soft);
  color: #a55f57;
  flex-shrink: 0;
  font-family: var(--font-serif);
  font-size: 27rpx;
  font-weight: 700;
}

.menu-order__meta {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.menu-order__meta text:first-child {
  overflow: hidden;
  font-size: 25rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-order__meta text:last-child {
  color: var(--menu-ink-3);
  font-size: 21rpx;
}

.menu-order__status {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--menu-butter);
  color: var(--menu-gold);
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
}

.menu-order--preparing .menu-order__status {
  background: var(--menu-pink-soft);
  color: #a65e56;
}

.menu-order--ready .menu-order__status {
  background: var(--menu-sage-soft);
  color: var(--menu-sage);
}

.menu-order__dishes {
  margin-top: 18rpx;
  font-family: var(--font-serif);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.4rpx;
  line-height: 1.45;
}

.menu-order__note {
  margin-top: 9rpx;
  padding: 12rpx 15rpx;
  border-radius: 16rpx;
  background: #faf6ed;
  color: var(--menu-ink-2);
  font-size: 22rpx;
  line-height: 1.55;
}

.menu-order__prep {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed var(--menu-line);
}

.menu-order__prep-head {
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.menu-order__prep-head text:first-child {
  color: var(--menu-ink-2);
  font-size: 22rpx;
  font-weight: 700;
}

.menu-order__prep-head text:last-child {
  color: var(--menu-sage);
  font-size: 21rpx;
  font-weight: 700;
}

.menu-order__dish + .menu-order__dish {
  margin-top: 12rpx;
}

.menu-order__dish-title {
  margin: 10rpx 0 5rpx;
  color: var(--menu-ink-3);
  font-size: 20rpx;
}

.menu-order__ingredient {
  display: grid;
  min-height: 48rpx;
  align-items: center;
  border-bottom: 1rpx solid rgba(235, 228, 215, 0.68);
  color: var(--menu-ink-2);
  grid-template-columns: 34rpx minmax(0, 1fr) auto auto;
  gap: 9rpx;
  font-size: 22rpx;
}

.menu-order__ingredient:last-child {
  border-bottom: 0;
}

.menu-order__ingredient > text:nth-child(2) {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-order__ingredient > text:nth-child(3),
.menu-order__ingredient > text:nth-child(4) {
  color: var(--menu-ink-3);
  font-size: 19rpx;
  text-align: right;
}

.menu-order__ingredient--ready > text:nth-child(2) {
  color: #a2a89f;
  text-decoration: line-through;
}

.menu-order__check {
  display: flex;
  width: 28rpx;
  height: 28rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #c7c0b4;
  border-radius: 50%;
  color: #fff;
  font-size: 18rpx;
}

.menu-order__ingredient--ready .menu-order__check {
  border-color: var(--menu-sage);
  background: var(--menu-sage);
}

.menu-order__foot {
  justify-content: space-between;
  margin-top: 17rpx;
  gap: 18rpx;
}

.menu-order__foot > text {
  color: var(--menu-ink-3);
  flex: 1;
  font-size: 20rpx;
}

.menu-order__action {
  height: 54rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--menu-sage-soft);
  color: var(--menu-sage);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 54rpx;
}

.menu-order__action::after {
  border: 0;
}

.menu-order__action--busy {
  opacity: 0.55;
}

.menu-history {
  margin-top: 12rpx;
}

.menu-section-head--history {
  margin-top: 38rpx;
}

.menu-history__list {
  overflow: hidden;
  border: 1rpx solid var(--menu-line);
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.64);
}

.menu-history__row {
  display: flex;
  min-height: 94rpx;
  align-items: center;
  padding: 16rpx 18rpx;
  border-bottom: 1rpx solid var(--menu-line);
  gap: 16rpx;
}

.menu-history__row:last-child {
  border-bottom: 0;
}

.menu-history__date {
  display: flex;
  width: 108rpx;
  flex-shrink: 0;
  flex-direction: column;
  gap: 4rpx;
}

.menu-history__date text:first-child {
  font-size: 23rpx;
  font-weight: 700;
}

.menu-history__date text:last-child {
  color: var(--menu-ink-3);
  font-size: 18rpx;
}

.menu-history__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.menu-history__body text:first-child {
  overflow: hidden;
  font-size: 23rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-history__body text:last-child {
  color: var(--menu-ink-3);
  font-size: 19rpx;
}

.menu-history__toggle {
  padding: 18rpx 0 2rpx;
  color: var(--menu-sage);
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.menu-recommend {
  display: flex;
  margin-top: 36rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(174, 130, 69, 0.13);
  border-radius: 30rpx;
  background: linear-gradient(135deg, #f7efdc, #fbf5e9);
  flex-direction: column;
}

.menu-recommend__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.menu-recommend__head > view:first-child {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 5rpx;
}

.menu-recommend__eyebrow {
  color: var(--menu-gold);
  font-size: 20rpx;
  font-weight: 700;
}

.menu-recommend__title {
  font-family: var(--font-serif);
  font-size: 31rpx;
  font-weight: 700;
}

.menu-recommend__thumb {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  overflow: hidden;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.75);
  flex-shrink: 0;
}

.menu-recommend__thumb image {
  width: 100%;
  height: 100%;
}

.menu-recommend__meta {
  margin-top: 8rpx;
  color: var(--menu-ink-3);
  font-size: 21rpx;
}

.menu-recommend__action {
  align-self: flex-start;
  margin-top: 15rpx;
  padding: 10rpx 17rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.74);
  color: var(--menu-gold);
  font-size: 21rpx;
  font-weight: 700;
}

.menu-book {
  display: flex;
  align-items: flex-start;
  margin-top: 22rpx;
  gap: 16rpx;
}

.menu-categories {
  position: sticky;
  top: 16rpx;
  display: flex;
  width: 144rpx;
  flex-shrink: 0;
  flex-direction: column;
  gap: 7rpx;
}

.menu-category {
  display: flex;
  min-height: 60rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 15rpx;
  border: 1rpx solid transparent;
  border-radius: 21rpx;
  color: var(--menu-ink-3);
  gap: 6rpx;
  font-size: 22rpx;
  transition: background 120ms ease, color 120ms ease, transform 120ms ease;
}

.menu-category > text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-category > text:last-child {
  color: #b3aa9d;
  font-size: 18rpx;
}

.menu-category--active {
  border-color: rgba(255, 255, 255, 0.92);
  background: #fff;
  box-shadow: 0 10rpx 26rpx rgba(70, 60, 48, 0.09);
  color: var(--menu-ink);
  font-weight: 700;
  transform: translateX(4rpx);
}

.menu-category--active > text:last-child {
  color: var(--menu-sage);
}

.menu-category--add {
  justify-content: center;
  margin-top: 6rpx;
  border: 1rpx dashed #d9cbb7;
  color: var(--menu-gold);
  gap: 3rpx;
  font-size: 20rpx;
}

.menu-recipes {
  min-width: 0;
  flex: 1;
}

.menu-recipes__head {
  display: flex;
  min-height: 52rpx;
  align-items: flex-start;
  justify-content: space-between;
  padding: 0 2rpx;
  gap: 12rpx;
}

.menu-recipes__head > view:first-child {
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}

.menu-recipes__head > view:first-child text:first-child {
  font-family: var(--font-serif);
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.menu-recipes__head > view:first-child text:last-child {
  color: var(--menu-ink-3);
  font-size: 20rpx;
}

.menu-recipes__manage {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  color: var(--menu-sage);
  font-size: 19rpx;
  font-weight: 600;
}

.menu-recipe-list {
  overflow: hidden;
  margin-top: 13rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 14rpx 38rpx rgba(70, 60, 48, 0.06);
}

.menu-recipe {
  display: flex;
  min-height: 126rpx;
  align-items: center;
  padding: 16rpx 14rpx;
  border-bottom: 1rpx solid var(--menu-line);
  gap: 12rpx;
}

.menu-recipe:last-child {
  border-bottom: 0;
}

.menu-recipe__media {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  overflow: hidden;
  align-items: center;
  justify-content: center;
  border-radius: 21rpx;
  background: var(--menu-butter);
  flex-shrink: 0;
}

.menu-recipe__media image {
  width: 100%;
  height: 100%;
}

.menu-recipe__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.menu-recipe__title {
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-recipe__meta {
  color: var(--menu-ink-2);
  font-size: 20rpx;
}

.menu-recipe__ingredients {
  overflow: hidden;
  color: var(--menu-ink-3);
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-recipe__order {
  display: flex;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  padding: 0 13rpx;
  border-radius: 999rpx;
  background: var(--menu-sage);
  box-shadow: 0 7rpx 15rpx rgba(86, 116, 98, 0.17);
  color: #fff;
  flex-shrink: 0;
  gap: 2rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.menu-empty {
  display: flex;
  min-height: 316rpx;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  padding: 36rpx 24rpx;
  border: 1rpx solid var(--menu-line);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.68);
  flex-direction: column;
  text-align: center;
}

.menu-empty--eat {
  margin-top: 8rpx;
}

.menu-empty--book {
  min-height: 340rpx;
  margin-top: 13rpx;
}

.menu-empty__icon {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  border-radius: 25rpx;
  background: var(--menu-butter);
}

.menu-empty__title {
  margin-top: 15rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.menu-empty__copy {
  max-width: 440rpx;
  margin-top: 6rpx;
  color: var(--menu-ink-3);
  font-size: 22rpx;
  line-height: 1.65;
}

.menu-empty__action {
  margin-top: 17rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--menu-sage-soft);
  color: var(--menu-sage);
  font-size: 21rpx;
  font-weight: 700;
}

.menu-empty--error .menu-empty__action {
  background: var(--menu-pink-soft);
  color: #a65e56;
}

.menu-loading {
  display: flex;
  min-height: 420rpx;
  align-items: center;
  justify-content: center;
  color: var(--menu-ink-3);
  gap: 10rpx;
  font-size: 25rpx;
}

.menu-loading__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--menu-gold);
  animation: menu-loading-pulse 1.1s ease-in-out infinite;
}

.menu-loading__dot:nth-child(2) {
  animation-delay: 0.12s;
}

.menu-loading__dot:nth-child(3) {
  margin-right: 7rpx;
  animation-delay: 0.24s;
}

.menu-cart-bar {
  position: fixed;
  right: 34rpx;
  bottom: calc(138rpx + env(safe-area-inset-bottom));
  left: 34rpx;
  z-index: 950;
  display: flex;
  min-height: 82rpx;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 13rpx 10rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 999rpx;
  background: rgba(45, 51, 46, 0.92);
  box-shadow: 0 16rpx 40rpx rgba(45, 51, 46, 0.24);
  box-sizing: border-box;
  color: #fff;
  backdrop-filter: blur(22rpx);
}

.menu-cart-bar__left {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.menu-cart-bar__bag {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--menu-sage);
}

.menu-cart-bar__copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 2rpx;
}

.menu-cart-bar__copy text:first-child {
  font-size: 23rpx;
  font-weight: 700;
}

.menu-cart-bar__copy text:last-child {
  color: rgba(255, 255, 255, 0.62);
  font-size: 18rpx;
}

.menu-cart-bar__action {
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--menu-ink);
  font-size: 22rpx;
  font-weight: 700;
}

.menu-cart-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  display: flex;
  align-items: flex-end;
  background: rgba(35, 38, 34, 0.38);
  backdrop-filter: blur(8rpx);
}

.menu-cart-sheet {
  width: 100%;
  max-height: 84vh;
  overflow-y: auto;
  padding: 14rpx 30rpx 0;
  border-radius: 38rpx 38rpx 0 0;
  background: #fbf8f1;
  box-shadow: 0 -18rpx 64rpx rgba(35, 38, 34, 0.18);
  box-sizing: border-box;
}

.menu-cart-sheet__handle {
  width: 60rpx;
  height: 7rpx;
  margin: 0 auto 20rpx;
  border-radius: 999rpx;
  background: #d9d1c4;
}

.menu-cart-sheet__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.menu-cart-sheet__head > view:first-child {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.menu-cart-sheet__head > view:first-child text:first-child {
  font-family: var(--font-serif);
  font-size: 36rpx;
  font-weight: 700;
}

.menu-cart-sheet__head > view:first-child text:last-child {
  color: var(--menu-ink-3);
  font-size: 21rpx;
}

.menu-cart-sheet__close {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  color: var(--menu-ink-2);
  font-family: Arial, sans-serif;
  font-size: 34rpx;
  line-height: 1;
}

.menu-cart-list {
  overflow: hidden;
  margin-top: 20rpx;
  border: 1rpx solid var(--menu-line);
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.72);
}

.menu-cart-item {
  display: flex;
  min-height: 98rpx;
  align-items: center;
  padding: 13rpx 15rpx;
  border-bottom: 1rpx solid var(--menu-line);
  gap: 11rpx;
}

.menu-cart-item:last-child {
  border-bottom: 0;
}

.menu-cart-item__media {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  overflow: hidden;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: var(--menu-butter);
  flex-shrink: 0;
}

.menu-cart-item__media image {
  width: 100%;
  height: 100%;
}

.menu-cart-item__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 3rpx;
}

.menu-cart-item__body text:first-child {
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-cart-item__body text:last-child {
  color: var(--menu-ink-3);
  font-size: 18rpx;
}

.menu-cart-item__stepper {
  display: flex;
  height: 48rpx;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid var(--menu-line);
  border-radius: 999rpx;
  background: #fff;
}

.menu-cart-item__stepper text {
  display: flex;
  width: 39rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  color: var(--menu-ink-2);
  font-size: 22rpx;
}

.menu-cart-item__stepper text:nth-child(2) {
  width: 34rpx;
  color: var(--menu-ink);
  font-size: 21rpx;
  font-weight: 700;
}

.menu-cart-item__remove {
  display: flex;
  width: 36rpx;
  height: 36rpx;
  align-items: center;
  justify-content: center;
  color: #b5ada1;
  font-family: Arial, sans-serif;
  font-size: 28rpx;
}

.menu-cart-sheet__label {
  margin: 25rpx 3rpx 10rpx;
  color: var(--menu-ink-2);
  font-size: 21rpx;
  font-weight: 700;
}

.menu-meal-types {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 9rpx;
}

.menu-meal-type {
  display: flex;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--menu-line);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.66);
  color: var(--menu-ink-3);
  font-size: 22rpx;
}

.menu-meal-type--active {
  border-color: var(--menu-sage);
  background: var(--menu-sage-soft);
  color: var(--menu-sage);
  font-weight: 700;
}

.menu-cart-note {
  height: 74rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--menu-line);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  color: var(--menu-ink);
  font-size: 24rpx;
}

.menu-cart-submit {
  display: flex;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  margin: 24rpx 0 0;
  border: 0;
  border-radius: 999rpx;
  background: var(--menu-sage);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 76rpx;
}

.menu-cart-submit::after {
  border: 0;
}

.menu-cart-sheet__safe {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

@keyframes menu-loading-pulse {
  0%, 100% { opacity: 0.35; transform: translateY(0); }
  50% { opacity: 1; transform: translateY(-5rpx); }
}

@media (prefers-reduced-motion: reduce) {
  .menu-tab,
  .menu-category {
    transition: none;
  }

  .menu-loading__dot {
    animation: none;
  }
}
