.menu-page {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.menu-head {
  padding: 8rpx 0 28rpx;
  border-bottom: 1rpx solid var(--c-line-strong, #d6d5e0);
}

.menu-head__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.menu-head__title {
  min-width: 0;
  flex: 1;
  color: var(--c-text, #22242e);
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.25;
  letter-spacing: -2rpx;
}

.menu-add {
  display: flex;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--c-text, #22242e);
  border-radius: 999rpx;
  color: var(--c-text, #22242e);
  gap: 7rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

.menu-head__copy {
  max-width: 610rpx;
  margin-top: 12rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 24rpx;
  line-height: 1.65;
}

.menu-list {
  padding-top: 10rpx;
}

.menu-card {
  padding: 28rpx 0 32rpx;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.menu-card__image,
.menu-card__placeholder {
  display: flex;
  width: 100%;
  height: 300rpx;
  align-items: center;
  justify-content: center;
  background: var(--c-primary-soft, #eaedfc);
}

.menu-card__body {
  padding-top: 20rpx;
}

.menu-card__meta {
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
}

.menu-card__meta text + text::before {
  margin-right: 18rpx;
  content: "·";
}

.menu-card__title {
  margin-top: 8rpx;
  color: var(--c-text, #22242e);
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.4;
}

.menu-card__copy {
  margin-top: 8rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 23rpx;
  line-height: 1.65;
}

.menu-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 13rpx;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
}

.menu-card__foot text:last-child {
  color: var(--c-accent, #5b6ee0);
}

.menu-empty {
  display: flex;
  min-height: 500rpx;
  align-items: center;
  justify-content: center;
  color: var(--c-muted, #9497a6);
  flex-direction: column;
}

.menu-empty__title {
  margin-top: 18rpx;
  color: var(--c-text, #22242e);
  font-size: 28rpx;
  font-weight: 500;
}

.menu-empty__copy {
  max-width: 520rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.65;
  text-align: center;
}

.menu-empty__action {
  margin-top: 22rpx;
  padding-bottom: 4rpx;
  border-bottom: 1rpx solid var(--c-accent, #5b6ee0);
  color: var(--c-accent, #5b6ee0);
  font-size: 22rpx;
}
