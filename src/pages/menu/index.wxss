.menu-page {
  --menu-paper: var(--c-paper, #fbf8f1);
  --menu-ink: var(--c-text, #2d332e);
  --menu-ink-2: var(--c-text-2, #665f56);
  --menu-ink-3: var(--c-muted, #948d82);
  --menu-line: var(--c-line, #ebe4d7);
  --menu-sage: var(--c-sage, #718d7f);
  --menu-sage-soft: var(--c-sage-soft, #e8f0ea);
  --menu-pink: var(--c-pink, #d89d95);
  --menu-pink-soft: var(--c-pink-soft, #f8e9e5);
  --menu-gold: var(--c-warning, #ae8245);
  --menu-butter: var(--c-butter-soft, #f4ead2);
  min-height: 100vh;
  padding: 24rpx 28rpx calc(242rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 92% 3%, rgba(237, 207, 181, 0.35), transparent 23%),
    linear-gradient(180deg, #fbf8f1 0%, #f8f5ee 100%);
  color: var(--menu-ink);
}

.menu-field-placeholder {
  color: #b2a89a;
  font-size: 28rpx;
}

.menu-hero {
  position: relative;
  display: flex;
  min-height: 204rpx;
  overflow: hidden;
  align-items: center;
  padding: 34rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 40rpx;
  background:
    radial-gradient(circle at 82% 16%, rgba(255, 255, 255, 0.9), transparent 30%),
    linear-gradient(135deg, #f4ebda 0%, #e9f0e8 100%);
  box-shadow: 0 18rpx 52rpx rgba(83, 73, 53, 0.09);
  box-sizing: border-box;
}

.menu-hero::before,
.menu-hero::after {
  position: absolute;
  border-radius: 50%;
  content: "";
  pointer-events: none;
}

.menu-hero::before {
  right: -34rpx;
  bottom: -50rpx;
  width: 240rpx;
  height: 240rpx;
  border: 28rpx solid rgba(255, 255, 255, 0.18);
}

.menu-hero::after {
  right: 166rpx;
  bottom: 28rpx;
  width: 11rpx;
  height: 11rpx;
  background: rgba(124, 150, 133, 0.45);
  box-shadow:
    22rpx -20rpx 0 rgba(124, 150, 133, 0.24),
    -15rpx -31rpx 0 rgba(174, 130, 69, 0.31);
}

.menu-hero__copy {
  position: relative;
  z-index: 2;
  max-width: 400rpx;
}

.menu-hero__eyebrow {
  color: var(--menu-sage);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2.5rpx;
}

.menu-hero__title {
  margin-top: 9rpx;
  font-family: var(--font-serif);
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: -1.6rpx;
  line-height: 1.12;
}

.menu-hero__sub {
  margin-top: 14rpx;
  color: var(--menu-ink-2);
  font-size: 28rpx;
  line-height: 1.5;
}

.menu-hero__mark {
  position: absolute;
  right: 42rpx;
  bottom: 34rpx;
  z-index: 1;
  display: flex;
  width: 116rpx;
  height: 98rpx;
  align-items: center;
  justify-content: flex-end;
  flex-direction: column;
}

.menu-hero__bowl {
  position: relative;
  display: flex;
  width: 105rpx;
  height: 74rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(174, 130, 69, 0.18);
  border-radius: 18rpx 18rpx 52rpx 52rpx;
  background: rgba(255, 255, 255, 0.7);
  box-shadow: inset 0 -10rpx 0 rgba(232, 210, 175, 0.36);
}

.menu-hero__steam {
  position: absolute;
  bottom: 76rpx;
  width: 28rpx;
  height: 41rpx;
  border-left: 4rpx solid rgba(113, 141, 127, 0.42);
  border-radius: 50%;
}

.menu-hero__steam--one {
  right: 54rpx;
  transform: rotate(8deg);
}

.menu-hero__steam--two {
  right: 26rpx;
  bottom: 82rpx;
  height: 31rpx;
  transform: rotate(-10deg);
}

.menu-add {
  position: static;
  display: flex;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  padding: 0 17rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #829e8d, var(--menu-sage));
  box-shadow: 0 10rpx 24rpx rgba(86, 116, 98, 0.2);
  color: #fff;
  flex-shrink: 0;
  gap: 7rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.menu-tabs {
  display: flex;
  margin-top: 26rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 12rpx 32rpx rgba(74, 62, 52, 0.07);
  backdrop-filter: blur(20rpx);
  gap: 6rpx;
}

.menu-tab {
  display: flex;
  height: 74rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  color: var(--menu-ink-3);
  flex: 1;
  gap: 9rpx;
  font-size: 32rpx;
  transition: background 140ms ease, color 140ms ease, box-shadow 140ms ease;
}

.menu-tab--active {
  border-color: rgba(113, 141, 127, 0.12);
  background: linear-gradient(135deg, #fff, #f4f8f5);
  box-shadow: 0 8rpx 22rpx rgba(75, 65, 52, 0.1);
  color: var(--menu-sage);
  font-weight: 700;
}

.menu-tab__count {
  display: flex;
  min-width: 38rpx;
  height: 36rpx;
  align-items: center;
  justify-content: center;
  padding: 0 9rpx;
  border-radius: 999rpx;
  background: var(--menu-sage-soft);
  color: var(--menu-sage);
  font-size: 24rpx;
  font-weight: 700;
}

.menu-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 32rpx 4rpx 16rpx;
}

.menu-section-head > view {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 5rpx;
}

.menu-section-head > view > text:first-child {
  font-family: var(--font-serif);
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -0.7rpx;
}

.menu-section-head > view > text:last-child,
.menu-section-head > text:last-child {
  color: var(--menu-ink-3);
  font-size: 25rpx;
}

.menu-order {
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
  padding: 26rpx 24rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 14rpx 38rpx rgba(70, 60, 48, 0.07);
  backdrop-filter: blur(18rpx);
}

.menu-order::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 7rpx;
  background: var(--menu-gold);
  content: "";
}

.menu-order--preparing::before {
  background: var(--menu-pink);
}

.menu-order--ready::before {
  background: var(--menu-sage);
}

.menu-order__head,
.menu-order__who,
.menu-order__prep-head,
.menu-order__foot {
  display: flex;
  align-items: center;
}

.menu-order__head {
  justify-content: space-between;
  gap: 16rpx;
}

.menu-order__who {
  min-width: 0;
  flex: 1;
  gap: 13rpx;
}

.menu-order__avatar {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: var(--menu-pink-soft);
  color: #a55f57;
  flex-shrink: 0;
  font-family: var(--font-serif);
  font-size: 29rpx;
  font-weight: 700;
}

.menu-order__meta {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.menu-order__meta text:first-child {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-order__meta text:last-child {
  color: var(--menu-ink-3);
  font-size: 24rpx;
}

.menu-order__status {
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  background: var(--menu-butter);
  color: var(--menu-gold);
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 700;
}

.menu-order--preparing .menu-order__status {
  background: var(--menu-pink-soft);
  color: #a65e56;
}

.menu-order--ready .menu-order__status {
  background: var(--menu-sage-soft);
  color: var(--menu-sage);
}

.menu-order__dishes {
  margin-top: 20rpx;
  font-family: var(--font-serif);
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -0.4rpx;
  line-height: 1.45;
}

.menu-order__note {
  margin-top: 10rpx;
  padding: 13rpx 16rpx;
  border-radius: 17rpx;
  background: #faf6ed;
  color: var(--menu-ink-2);
  font-size: 26rpx;
  line-height: 1.55;
}

.menu-order__prep {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed var(--menu-line);
}

.menu-order__prep-head {
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.menu-order__prep-head text:first-child {
  color: var(--menu-ink-2);
  font-size: 26rpx;
  font-weight: 700;
}

.menu-order__prep-head text:last-child {
  color: var(--menu-sage);
  font-size: 24rpx;
  font-weight: 700;
}

.menu-order__dish + .menu-order__dish {
  margin-top: 12rpx;
}

.menu-order__dish-title {
  margin: 11rpx 0 6rpx;
  color: var(--menu-ink-3);
  font-size: 23rpx;
}

.menu-order__ingredient {
  display: grid;
  min-height: 56rpx;
  align-items: center;
  border-bottom: 1rpx solid rgba(235, 228, 215, 0.68);
  color: var(--menu-ink-2);
  grid-template-columns: 36rpx minmax(0, 1fr) auto auto;
  gap: 9rpx;
  font-size: 25rpx;
}

.menu-order__ingredient:last-child {
  border-bottom: 0;
}

.menu-order__ingredient > text:nth-child(2) {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-order__ingredient > text:nth-child(3),
.menu-order__ingredient > text:nth-child(4) {
  color: var(--menu-ink-3);
  font-size: 22rpx;
  text-align: right;
}

.menu-order__ingredient--ready > text:nth-child(2) {
  color: #a2a89f;
  text-decoration: line-through;
}

.menu-order__check {
  display: flex;
  width: 30rpx;
  height: 30rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #c7c0b4;
  border-radius: 50%;
  color: #fff;
  font-size: 20rpx;
}

.menu-order__ingredient--ready .menu-order__check {
  border-color: var(--menu-sage);
  background: var(--menu-sage);
}

.menu-order__foot {
  justify-content: space-between;
  margin-top: 17rpx;
  gap: 18rpx;
}

.menu-order__foot > text {
  color: var(--menu-ink-3);
  flex: 1;
  font-size: 23rpx;
}

.menu-order__action {
  height: 60rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--menu-sage-soft);
  color: var(--menu-sage);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.menu-order__action::after {
  border: 0;
}

.menu-order__action--busy {
  opacity: 0.55;
}

.menu-history {
  margin-top: 12rpx;
}

.menu-section-head--history {
  margin-top: 38rpx;
}

.menu-history__list {
  overflow: hidden;
  border: 1rpx solid var(--menu-line);
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.64);
}

.menu-history__row {
  display: flex;
  min-height: 94rpx;
  align-items: center;
  padding: 16rpx 18rpx;
  border-bottom: 1rpx solid var(--menu-line);
  gap: 16rpx;
}

.menu-history__row:last-child {
  border-bottom: 0;
}

.menu-history__date {
  display: flex;
  width: 108rpx;
  flex-shrink: 0;
  flex-direction: column;
  gap: 4rpx;
}

.menu-history__date text:first-child {
  font-size: 26rpx;
  font-weight: 700;
}

.menu-history__date text:last-child {
  color: var(--menu-ink-3);
  font-size: 21rpx;
}

.menu-history__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.menu-history__body text:first-child {
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-history__body text:last-child {
  color: var(--menu-ink-3);
  font-size: 22rpx;
}

.menu-history__toggle {
  padding: 20rpx 0 2rpx;
  color: var(--menu-sage);
  font-size: 25rpx;
  font-weight: 600;
  text-align: center;
}

.menu-recommend {
  display: flex;
  min-height: 224rpx;
  overflow: hidden;
  margin-top: 34rpx;
  border: 1rpx solid rgba(174, 130, 69, 0.12);
  border-radius: 34rpx;
  background: linear-gradient(135deg, #fffaf0, #f4f1e6);
  box-shadow: 0 16rpx 38rpx rgba(86, 68, 42, 0.08);
}

.menu-recommend__art {
  position: relative;
  width: 226rpx;
  min-height: 224rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.menu-recommend__art > image {
  width: 100%;
  height: 100%;
}

.menu-recommend__fallback {
  position: relative;
  display: flex;
  width: 100%;
  height: 100%;
  min-height: 224rpx;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 72% 24%, rgba(255, 255, 255, 0.88), transparent 32%),
    linear-gradient(145deg, #ead9b8, #dbe9dc);
}

.menu-recommend__steam {
  position: absolute;
  top: 42rpx;
  left: 94rpx;
  width: 34rpx;
  height: 48rpx;
  border-left: 4rpx solid rgba(113, 141, 127, 0.34);
  border-radius: 50%;
  transform: rotate(9deg);
}

.menu-recommend__badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: var(--menu-gold);
  font-size: 20rpx;
  font-weight: 700;
  backdrop-filter: blur(12rpx);
}

.menu-recommend__body {
  display: flex;
  min-width: 0;
  flex: 1;
  justify-content: center;
  padding: 24rpx 22rpx 22rpx;
  flex-direction: column;
}

.menu-recommend__eyebrow {
  color: var(--menu-gold);
  font-size: 22rpx;
  font-weight: 700;
}

.menu-recommend__title {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 7rpx;
  font-family: var(--font-serif);
  font-size: 35rpx;
  font-weight: 700;
  line-height: 1.25;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.menu-recommend__meta {
  margin-top: 9rpx;
  color: var(--menu-ink-3);
  font-size: 23rpx;
}

.menu-recommend__action {
  display: flex;
  width: fit-content;
  min-height: 54rpx;
  align-items: center;
  margin-top: 16rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--menu-sage);
  color: #fff;
  gap: 5rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.menu-book {
  display: flex;
  align-items: flex-start;
  margin-top: 28rpx;
  gap: 16rpx;
}

.menu-categories {
  position: sticky;
  top: 20rpx;
  display: flex;
  width: 142rpx;
  flex-shrink: 0;
  flex-direction: column;
  gap: 8rpx;
}

.menu-category {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 15rpx;
  border: 1rpx solid transparent;
  border-radius: 21rpx;
  color: var(--menu-ink-3);
  gap: 7rpx;
  font-size: 27rpx;
  transition: background 120ms ease, color 120ms ease, transform 120ms ease;
}

.menu-category > text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-category > text:last-child {
  color: #b3aa9d;
  font-size: 23rpx;
}

.menu-category--active {
  border-color: rgba(113, 141, 127, 0.13);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(232, 240, 234, 0.9));
  box-shadow: 0 10rpx 26rpx rgba(70, 60, 48, 0.09);
  color: var(--menu-sage);
  font-weight: 700;
  transform: translateX(3rpx);
}

.menu-category--active > text:last-child {
  color: var(--menu-sage);
}

.menu-category--add {
  justify-content: center;
  margin-top: 7rpx;
  border: 1rpx dashed #d9cbb7;
  color: var(--menu-gold);
  gap: 4rpx;
  font-size: 25rpx;
}

.menu-recipes {
  min-width: 0;
  flex: 1;
}

.menu-recipes__head {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx;
  gap: 10rpx;
}

.menu-recipes__head > view:first-child {
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}

.menu-recipes__head > view:first-child text:first-child {
  font-family: var(--font-serif);
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.menu-recipes__head > view:first-child text:last-child {
  color: var(--menu-ink-3);
  font-size: 25rpx;
}

.menu-recipes__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
  gap: 8rpx;
}

.menu-recipes__manage {
  display: flex;
  height: 58rpx;
  align-items: center;
  padding: 0 16rpx;
  border: 1rpx solid rgba(113, 141, 127, 0.12);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.74);
  color: var(--menu-sage);
  font-size: 24rpx;
  font-weight: 600;
}

.menu-recipe-list {
  display: flex;
  margin-top: 16rpx;
  flex-direction: column;
  gap: 14rpx;
}

.menu-recipe {
  display: flex;
  min-height: 174rpx;
  align-items: center;
  padding: 15rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 12rpx 30rpx rgba(70, 60, 48, 0.07);
  gap: 14rpx;
  backdrop-filter: blur(18rpx);
}

.menu-recipe__media {
  display: flex;
  width: 138rpx;
  height: 138rpx;
  overflow: hidden;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background:
    radial-gradient(circle at 70% 20%, rgba(255, 255, 255, 0.74), transparent 38%),
    var(--menu-butter);
  flex-shrink: 0;
}

.menu-recipe__media image {
  width: 100%;
  height: 100%;
}

.menu-recipe__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 7rpx;
}

.menu-recipe__title {
  display: -webkit-box;
  overflow: hidden;
  font-family: var(--font-serif);
  font-size: 35rpx;
  font-weight: 700;
  line-height: 1.25;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.menu-recipe__desc {
  display: -webkit-box;
  overflow: hidden;
  color: var(--menu-ink-2);
  font-size: 25rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.menu-recipe__meta {
  display: flex;
  flex-wrap: wrap;
  color: var(--menu-ink-3);
  font-size: 23rpx;
  gap: 4rpx 10rpx;
  line-height: 1.4;
}

.menu-recipe__meta text {
  position: relative;
}

.menu-recipe__meta text + text::before {
  position: absolute;
  top: 50%;
  left: -7rpx;
  width: 3rpx;
  height: 3rpx;
  border-radius: 50%;
  background: #c7beb1;
  content: "";
  transform: translateY(-50%);
}

.menu-recipe__order {
  display: flex;
  width: 70rpx;
  height: 70rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 50%;
  background: linear-gradient(145deg, #88a595, var(--menu-sage));
  box-shadow: 0 9rpx 20rpx rgba(86, 116, 98, 0.24);
  color: #fff;
  flex-shrink: 0;
  flex-direction: column;
  gap: 0;
  font-weight: 700;
  line-height: 1;
}

/* 点菜区的轻量插画空态，避免只剩一块白卡。 */
.menu-eat-empty {
  position: relative;
  display: flex;
  min-height: 500rpx;
  overflow: hidden;
  align-items: center;
  margin-top: 20rpx;
  padding: 40rpx 44rpx 42rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 38rpx;
  background:
    radial-gradient(circle at 88% 16%, rgba(255, 255, 255, 0.86), transparent 28%),
    linear-gradient(140deg, #f7eedc 0%, #edf4ed 100%);
  box-shadow: 0 18rpx 44rpx rgba(74, 62, 52, 0.08);
  box-sizing: border-box;
  flex-direction: column;
  text-align: center;
}

.menu-eat-empty__art {
  position: relative;
  width: 230rpx;
  height: 214rpx;
  flex-shrink: 0;
  transform: scale(0.9);
}

.menu-eat-empty__sun {
  position: absolute;
  top: 6rpx;
  left: 26rpx;
  width: 154rpx;
  height: 154rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.58);
}

.menu-eat-empty__plate {
  position: absolute;
  right: 0;
  bottom: 20rpx;
  width: 210rpx;
  height: 210rpx;
  border: 20rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 50%;
  background: #dce9df;
  box-shadow:
    inset 0 0 0 2rpx rgba(113, 141, 127, 0.08),
    0 20rpx 34rpx rgba(86, 116, 98, 0.15);
  box-sizing: border-box;
}

.menu-eat-empty__food {
  position: absolute;
  border-radius: 50%;
}

.menu-eat-empty__food--one {
  top: 55rpx;
  left: 47rpx;
  width: 64rpx;
  height: 64rpx;
  background: #d8a06c;
  box-shadow: inset -9rpx -8rpx 0 rgba(142, 87, 49, 0.16);
}

.menu-eat-empty__food--two {
  top: 74rpx;
  right: 42rpx;
  width: 52rpx;
  height: 52rpx;
  background: #b6c98f;
  box-shadow: inset -8rpx -7rpx 0 rgba(96, 126, 77, 0.13);
}

.menu-eat-empty__food--three {
  right: 66rpx;
  bottom: 36rpx;
  width: 42rpx;
  height: 42rpx;
  background: #e7c4a7;
}

.menu-eat-empty__leaf {
  position: absolute;
  width: 29rpx;
  height: 56rpx;
  border-radius: 80% 10% 80% 10%;
  background: rgba(113, 141, 127, 0.65);
}

.menu-eat-empty__leaf--one {
  top: 53rpx;
  right: 12rpx;
  transform: rotate(25deg);
}

.menu-eat-empty__leaf--two {
  top: 94rpx;
  right: 2rpx;
  transform: rotate(68deg);
}

.menu-eat-empty__copy {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 18rpx;
  flex: 1;
  flex-direction: column;
  justify-content: center;
}

.menu-eat-empty__eyebrow {
  color: var(--menu-sage);
  font-size: 25rpx;
  font-weight: 700;
  letter-spacing: 1.2rpx;
}

.menu-eat-empty__title {
  margin-top: 10rpx;
  font-family: var(--font-serif);
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
  line-height: 1.2;
}

.menu-eat-empty__desc {
  margin-top: 12rpx;
  color: var(--menu-ink-2);
  font-size: 27rpx;
  line-height: 1.55;
}

.menu-eat-empty__action {
  display: flex;
  width: fit-content;
  min-height: 68rpx;
  align-items: center;
  margin-top: 24rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--menu-sage);
  box-shadow: 0 9rpx 20rpx rgba(86, 116, 98, 0.18);
  color: #fff;
  gap: 6rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.menu-empty {
  display: flex;
  min-height: 316rpx;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  padding: 36rpx 24rpx;
  border: 1rpx solid var(--menu-line);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.68);
  flex-direction: column;
  text-align: center;
}

.menu-empty--eat {
  margin-top: 8rpx;
}

.menu-empty--book {
  min-height: 340rpx;
  margin-top: 13rpx;
}

.menu-empty__icon {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  border-radius: 25rpx;
  background: var(--menu-butter);
}

.menu-empty__title {
  margin-top: 17rpx;
  font-family: var(--font-serif);
  font-size: 34rpx;
  font-weight: 700;
}

.menu-empty__copy {
  max-width: 440rpx;
  margin-top: 8rpx;
  color: var(--menu-ink-3);
  font-size: 26rpx;
  line-height: 1.65;
}

.menu-empty__action {
  margin-top: 19rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: var(--menu-sage-soft);
  color: var(--menu-sage);
  font-size: 25rpx;
  font-weight: 700;
}

.menu-empty--error .menu-empty__action {
  background: var(--menu-pink-soft);
  color: #a65e56;
}

.menu-loading {
  display: flex;
  min-height: 420rpx;
  align-items: center;
  justify-content: center;
  color: var(--menu-ink-3);
  gap: 10rpx;
  font-size: 28rpx;
}

.menu-loading__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--menu-gold);
  animation: menu-loading-pulse 1.1s ease-in-out infinite;
}

.menu-loading__dot:nth-child(2) {
  animation-delay: 0.12s;
}

.menu-loading__dot:nth-child(3) {
  margin-right: 7rpx;
  animation-delay: 0.24s;
}

.menu-cart-bar {
  position: fixed;
  right: 34rpx;
  bottom: calc(138rpx + env(safe-area-inset-bottom));
  left: 34rpx;
  z-index: 950;
  display: flex;
  min-height: 94rpx;
  align-items: center;
  justify-content: space-between;
  padding: 11rpx 13rpx 11rpx 13rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 46rpx rgba(45, 51, 46, 0.17);
  box-sizing: border-box;
  color: var(--menu-ink);
  backdrop-filter: blur(24rpx);
}

.menu-cart-bar__left {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 14rpx;
}

.menu-cart-bar__bag {
  position: relative;
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(145deg, #88a595, var(--menu-sage));
  box-shadow: 0 8rpx 20rpx rgba(86, 116, 98, 0.23);
  flex-shrink: 0;
}

.menu-cart-bar__badge {
  position: absolute;
  top: -5rpx;
  right: -4rpx;
  display: flex;
  min-width: 30rpx;
  height: 30rpx;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 999rpx;
  background: var(--menu-pink);
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
}

.menu-cart-bar__copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 3rpx;
}

.menu-cart-bar__copy text:first-child {
  font-size: 27rpx;
  font-weight: 700;
}

.menu-cart-bar__copy text:last-child {
  color: var(--menu-ink-3);
  font-size: 22rpx;
}

.menu-cart-bar__action {
  display: flex;
  height: 66rpx;
  align-items: center;
  padding: 0 21rpx;
  border-radius: 999rpx;
  background: var(--menu-sage);
  color: #fff;
  flex-shrink: 0;
  gap: 7rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.menu-cart-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  display: flex;
  align-items: flex-end;
  background: rgba(35, 38, 34, 0.38);
  backdrop-filter: blur(8rpx);
}

.menu-cart-sheet {
  width: 100%;
  max-height: 84vh;
  overflow-y: auto;
  padding: 14rpx 30rpx 0;
  border-radius: 38rpx 38rpx 0 0;
  background: #fbf8f1;
  box-shadow: 0 -18rpx 64rpx rgba(35, 38, 34, 0.18);
  box-sizing: border-box;
}

.menu-cart-sheet__handle {
  width: 60rpx;
  height: 7rpx;
  margin: 0 auto 20rpx;
  border-radius: 999rpx;
  background: #d9d1c4;
}

.menu-cart-sheet__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.menu-cart-sheet__head > view:first-child {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.menu-cart-sheet__head > view:first-child text:first-child {
  font-family: var(--font-serif);
  font-size: 40rpx;
  font-weight: 700;
}

.menu-cart-sheet__head > view:first-child text:last-child {
  color: var(--menu-ink-3);
  font-size: 27rpx;
}

.menu-cart-sheet__close {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.84);
  color: var(--menu-ink-2);
  font-family: Arial, sans-serif;
  font-size: 38rpx;
  line-height: 1;
}

.menu-cart-list {
  overflow: hidden;
  margin-top: 20rpx;
  border: 1rpx solid var(--menu-line);
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.72);
}

.menu-cart-item {
  display: flex;
  min-height: 108rpx;
  align-items: center;
  padding: 14rpx 16rpx;
  border-bottom: 1rpx solid var(--menu-line);
  gap: 12rpx;
}

.menu-cart-item:last-child {
  border-bottom: 0;
}

.menu-cart-item__media {
  display: flex;
  width: 70rpx;
  height: 70rpx;
  overflow: hidden;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: var(--menu-butter);
  flex-shrink: 0;
}

.menu-cart-item__media image {
  width: 100%;
  height: 100%;
}

.menu-cart-item__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 3rpx;
}

.menu-cart-item__body text:first-child {
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-cart-item__body text:last-child {
  color: var(--menu-ink-3);
  font-size: 24rpx;
}

.menu-cart-item__stepper {
  display: flex;
  height: 52rpx;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid var(--menu-line);
  border-radius: 999rpx;
  background: #fff;
}

.menu-cart-item__stepper text {
  display: flex;
  width: 42rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  color: var(--menu-ink-2);
  font-size: 25rpx;
}

.menu-cart-item__stepper text:nth-child(2) {
  width: 36rpx;
  color: var(--menu-ink);
  font-size: 24rpx;
  font-weight: 700;
}

.menu-cart-item__remove {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  color: #b5ada1;
  font-family: Arial, sans-serif;
  font-size: 31rpx;
}

.menu-cart-sheet__label {
  margin: 27rpx 3rpx 11rpx;
  color: var(--menu-ink-2);
  font-size: 27rpx;
  font-weight: 700;
}

.menu-meal-types {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 9rpx;
}

.menu-meal-type {
  display: flex;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--menu-line);
  border-radius: 19rpx;
  background: rgba(255, 255, 255, 0.66);
  color: var(--menu-ink-3);
  font-size: 27rpx;
}

.menu-meal-type--active {
  border-color: var(--menu-sage);
  background: var(--menu-sage-soft);
  color: var(--menu-sage);
  font-weight: 700;
}

.menu-cart-note {
  height: 82rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--menu-line);
  border-radius: 21rpx;
  background: rgba(255, 255, 255, 0.72);
  color: var(--menu-ink);
  font-size: 29rpx;
}

.menu-cart-submit {
  display: flex;
  height: 82rpx;
  align-items: center;
  justify-content: center;
  margin: 26rpx 0 0;
  border: 0;
  border-radius: 999rpx;
  background: var(--menu-sage);
  color: #fff;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 82rpx;
}

.menu-cart-submit::after {
  border: 0;
}

.menu-cart-sheet__safe {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

@keyframes menu-loading-pulse {
  0%, 100% { opacity: 0.35; transform: translateY(0); }
  50% { opacity: 1; transform: translateY(-5rpx); }
}

@media (prefers-reduced-motion: reduce) {
  .menu-tab,
  .menu-category {
    transition: none;
  }

  .menu-loading__dot {
    animation: none;
  }
}
