.menu-detail-page {
  --md-paper: var(--c-paper, #fbf8f1);
  --md-ink: var(--c-text, #2d332e);
  --md-ink-2: var(--c-text-2, #665f56);
  --md-ink-3: var(--c-muted, #948d82);
  --md-line: var(--c-line, #ebe4d7);
  --md-sage: var(--c-sage, #718d7f);
  --md-sage-soft: var(--c-sage-soft, #e8f0ea);
  --md-gold: var(--c-warning, #ae8245);
  --md-butter: var(--c-butter-soft, #f4ead2);
  min-height: 100vh;
  padding: 24rpx 30rpx calc(70rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 90% 2%, rgba(232, 213, 180, 0.3), transparent 22%),
    var(--md-paper);
  color: var(--md-ink);
}

.md-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 8rpx 3rpx 20rpx;
  gap: 16rpx;
}

.md-top__main {
  min-width: 0;
  flex: 1;
}

.md-top__category {
  display: inline-flex;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: var(--md-sage-soft);
  color: var(--md-sage);
  font-size: 19rpx;
  font-weight: 700;
}

.md-top__title {
  margin-top: 9rpx;
  font-family: var(--font-serif);
  font-size: 41rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.25;
}

.md-top__sub {
  margin-top: 7rpx;
  color: var(--md-ink-3);
  font-size: 22rpx;
}

.md-edit {
  display: flex;
  height: 54rpx;
  align-items: center;
  padding: 0 15rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: var(--md-ink-2);
  flex-shrink: 0;
  gap: 4rpx;
  font-size: 21rpx;
}

.md-hero {
  position: relative;
  min-height: 315rpx;
  overflow: hidden;
  border-radius: 35rpx;
  background: #ddd5c9;
  box-shadow: 0 18rpx 48rpx rgba(70, 60, 48, 0.12);
}

.md-hero__image {
  width: 100%;
  height: 315rpx;
}

.md-hero__shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 35%, rgba(35, 39, 34, 0.68));
}

.md-hero__copy {
  position: absolute;
  right: 24rpx;
  bottom: 22rpx;
  left: 24rpx;
  z-index: 2;
  color: #fff;
}

.md-hero__title {
  font-family: var(--font-serif);
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -0.7rpx;
}

.md-hero__meta {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
}

.md-hero--plain {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background:
    radial-gradient(circle at 86% 18%, rgba(255, 255, 255, 0.86), transparent 30%),
    linear-gradient(135deg, #f2ead8, #e6eee8);
  box-sizing: border-box;
}

.md-hero--plain .md-hero__copy {
  position: relative;
  right: auto;
  bottom: auto;
  left: auto;
  z-index: 2;
  padding-left: 22rpx;
  color: var(--md-ink);
}

.md-hero--plain .md-hero__meta {
  color: var(--md-ink-2);
}

.md-hero__illustration {
  position: relative;
  display: flex;
  width: 145rpx;
  height: 145rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 44rpx 44rpx 68rpx 68rpx;
  background: rgba(255, 255, 255, 0.58);
  flex-shrink: 0;
}

.md-hero__steam {
  position: absolute;
  bottom: 112rpx;
  width: 28rpx;
  height: 42rpx;
  border-left: 4rpx solid rgba(113, 141, 127, 0.44);
  border-radius: 50%;
}

.md-hero__steam--one {
  right: 73rpx;
  transform: rotate(9deg);
}

.md-hero__steam--two {
  right: 42rpx;
  bottom: 119rpx;
  height: 31rpx;
  transform: rotate(-11deg);
}

.md-intro {
  margin: 20rpx 5rpx 0;
  color: var(--md-ink-2);
  font-size: 25rpx;
  line-height: 1.8;
}

.md-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 34rpx 5rpx 13rpx;
}

.md-section-head > view:first-child {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.md-section-head > view:first-child text:first-child {
  font-family: var(--font-serif);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.md-section-head > view:first-child text:last-child {
  color: var(--md-ink-3);
  font-size: 20rpx;
}

.md-stepper {
  display: flex;
  height: 52rpx;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid var(--md-line);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.75);
}

.md-stepper text {
  display: flex;
  width: 47rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  color: var(--md-ink-2);
  font-size: 24rpx;
}

.md-stepper text:nth-child(2) {
  width: 82rpx;
  color: var(--md-ink);
  font-size: 20rpx;
  font-weight: 700;
}

.md-ingredients,
.md-steps {
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.74);
  box-shadow: 0 12rpx 34rpx rgba(70, 60, 48, 0.06);
}

.md-ingredient {
  display: flex;
  min-height: 82rpx;
  align-items: center;
  padding: 12rpx 18rpx;
  border-bottom: 1rpx solid var(--md-line);
  gap: 12rpx;
}

.md-ingredient:last-child {
  border-bottom: 0;
}

.md-ingredient__check {
  display: flex;
  width: 30rpx;
  height: 30rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #c8c0b3;
  border-radius: 50%;
  color: #fff;
  flex-shrink: 0;
  font-size: 18rpx;
}

.md-ingredient--ready {
  background: rgba(232, 240, 234, 0.72);
}

.md-ingredient--ready .md-ingredient__check {
  border-color: var(--md-sage);
  background: var(--md-sage);
}

.md-ingredient__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 2rpx;
}

.md-ingredient__body text:first-child {
  font-size: 26rpx;
  font-weight: 600;
}

.md-ingredient__body text:last-child {
  color: var(--md-ink-3);
  font-size: 20rpx;
}

.md-ingredient__amount {
  color: var(--md-ink-2);
  font-size: 22rpx;
  text-align: right;
}

.md-note-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 9rpx;
}

.md-note-image {
  position: relative;
  overflow: hidden;
  padding-top: 100%;
  border-radius: 19rpx;
  background: #eee7dc;
}

.md-note-image image {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.md-step {
  display: flex;
  padding: 18rpx;
  border-bottom: 1rpx solid var(--md-line);
  gap: 13rpx;
}

.md-step:last-child {
  border-bottom: 0;
}

.md-step__number {
  display: flex;
  width: 36rpx;
  height: 36rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--md-butter);
  color: var(--md-gold);
  flex-shrink: 0;
  font-family: "Helvetica Neue", Arial, sans-serif;
  font-size: 20rpx;
  font-weight: 700;
}

.md-step__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.md-step__body text:first-child {
  font-size: 26rpx;
  font-weight: 700;
}

.md-step__body text:last-child {
  color: var(--md-ink-2);
  font-size: 23rpx;
  line-height: 1.7;
}

.md-start {
  display: flex;
  width: 100%;
  height: 74rpx;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--md-sage);
  box-shadow: 0 13rpx 26rpx rgba(86, 116, 98, 0.18);
  color: #fff;
  gap: 7rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 74rpx;
}

.md-start::after,
.md-delete::after {
  border: 0;
}

.md-delete {
  height: 62rpx;
  margin-top: 13rpx;
  border: 0;
  background: transparent;
  color: #b16e65;
  font-size: 22rpx;
  line-height: 62rpx;
}

.md-loading,
.md-error {
  display: flex;
  min-height: 560rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  text-align: center;
}

.md-loading {
  color: var(--md-ink-3);
  gap: 18rpx;
  font-size: 25rpx;
}

.md-loading__dish {display: flex; width: 96rpx; height: 96rpx; align-items: center; justify-content: center; animation: md-breathe 1.5s ease-in-out infinite;}

.md-error__title {
  margin-top: 18rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.md-error__copy {
  max-width: 480rpx;
  margin-top: 8rpx;
  color: var(--md-ink-3);
  font-size: 23rpx;
  line-height: 1.65;
}

.md-error__action {
  margin-top: 22rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--md-sage-soft);
  color: var(--md-sage);
  font-size: 22rpx;
  font-weight: 700;
}

.md-stepper--busy,
.md-ingredient--busy,
.md-start--busy {
  opacity: 0.55;
}

.md-start--busy {
  pointer-events: none;
}

@keyframes md-breathe {
  0%, 100% { opacity: 0.55; transform: scale(0.94); }
  50% { opacity: 1; transform: scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .md-loading__dish {animation: none;}
}
