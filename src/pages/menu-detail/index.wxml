<view class="page-shell menu-detail-page">
  <view wx:if="{{loading}}" class="md-loading">
    <view class="md-loading__dish"><line-icon name="soup" size="46" tone="gold" /></view>
    <text>正在把菜谱翻出来…</text>
  </view>

  <view wx:elif="{{loadError}}" class="md-error">
    <line-icon name="circle-alert" size="36" tone="orange" />
    <view class="md-error__title">菜单没加载出来</view>
    <view class="md-error__copy">{{loadError}}</view>
    <view class="md-error__action" bindtap="onRetryLoad">再试一次</view>
  </view>

  <block wx:elif="{{recipe}}">
  <view class="md-top">
    <view class="md-top__main">
      <view class="md-top__title">{{recipe.title}}</view>
      <view class="md-top__sub">{{recipe.cookingMinutes}} 分钟 · {{recipe.servings}} 人份</view>
    </view>
    <view class="md-edit" bindtap="onEdit"><line-icon name="pen-line" size="19" tone="ink" /><text>编辑</text></view>
  </view>

  <view wx:if="{{recipe.image && recipe.image.src}}" class="md-hero">
    <image class="md-hero__image" src="{{recipe.image.src}}" mode="aspectFill" />
    <view class="md-hero__shade"></view>
    <view class="md-hero__copy">
      <view class="md-hero__title">{{recipe.title}}</view>
      <view class="md-hero__meta">{{recipe.cookingMinutes}} 分钟 · {{recipe.servings}} 人份</view>
    </view>
  </view>
  <view wx:else class="md-hero md-hero--plain">
    <line-icon name="soup" size="55" tone="gold" />
    <view class="md-hero__copy">
      <view class="md-hero__title">{{recipe.title}}</view>
      <view class="md-hero__meta">家常菜单 · {{recipe.cookingMinutes}} 分钟</view>
    </view>
  </view>

  <view wx:if="{{recipe.description}}" class="md-intro">{{recipe.description}}</view>

  <view class="md-section-head">
    <view>
      <text>准备食材</text>
      <text>{{readyCount}} / {{recipe.ingredients.length}} 已备好</text>
    </view>
    <view class="md-stepper {{mutating ? 'md-stepper--busy' : ''}}">
      <text data-delta="-1" bindtap="onChangeServings">−</text>
      <text>{{recipe.servings}} 人份</text>
      <text data-delta="1" bindtap="onChangeServings">＋</text>
    </view>
  </view>

  <view class="md-ingredients">
    <view wx:for="{{recipe.ingredients}}" wx:key="id" class="md-ingredient {{item.ready ? 'md-ingredient--ready' : ''}} {{activeIngredientId === item.id ? 'md-ingredient--busy' : ''}}" data-id="{{item.id}}" bindtap="onToggleIngredient">
      <view class="md-ingredient__check">{{item.ready ? '✓' : ''}}</view>
      <view class="md-ingredient__body">
        <text>{{item.name}}</text>
        <text>{{item.source || '来源未填写'}}</text>
      </view>
      <view class="md-ingredient__amount">{{item.amount}}</view>
    </view>
  </view>

  <view class="md-section-head">
    <view><text>做法</text><text>{{recipe.steps.length}} 个步骤</text></view>
  </view>
  <view class="md-steps">
    <view wx:for="{{recipe.steps}}" wx:key="id" class="md-step">
      <view class="md-step__number">{{index + 1}}</view>
      <view class="md-step__body"><text>{{item.title}}</text><text>{{item.description}}</text></view>
    </view>
  </view>

  <button class="md-start {{mutating ? 'md-start--busy' : ''}}" bindtap="onStartCooking">
    <line-icon name="flame" size="23" tone="white" />
    <text>开始做饭 · 看看还差什么</text>
  </button>
  <button class="md-delete" disabled="{{mutating}}" bindtap="onDelete">删除这份菜单</button>
  </block>
</view>
