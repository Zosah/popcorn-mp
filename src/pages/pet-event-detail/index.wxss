.pet-event-detail {
  --event-ink: var(--c-text, #252b27);
  --event-ink-2: var(--c-text-2, #5f5a53);
  --event-ink-3: var(--c-muted, #837f76);
  --event-line: var(--c-line, #e9e6e1);
  --event-pink-soft: var(--c-coral-soft, #f7e7e2);
  padding: 28rpx 36rpx calc(104rpx + env(safe-area-inset-bottom));
  background: var(--c-paper, #f8f7f4);
  color: var(--event-ink);
}
.event-state {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  margin-bottom: 22rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--event-line);
  border-radius: 26rpx;
  background: #fff;
  color: var(--event-ink-3);
  gap: 14rpx;
  font-size: 24rpx;
}
.event-state--error { border-color: #f0cbc5; background: #fff7f5; color: var(--event-ink-2); }
.event-state__copy { min-width: 0; flex: 1; }
.event-state__copy text { display: block; }
.event-state__copy text:first-child { color: var(--event-ink); font-size: 26rpx; font-weight: 600; }
.event-state__copy text:last-child { margin-top: 4rpx; font-size: 22rpx; line-height: 1.5; }
.event-state__action { flex-shrink: 0; color: var(--c-primary-link, #b86757); font-size: 22rpx; font-weight: 600; }
.event-hero { display: flex; align-items: flex-start; padding: 8rpx 2rpx 29rpx; gap: 18rpx; }
.event-hero__mark { display: flex; width: 80rpx; height: 80rpx; align-items: center; justify-content: center; border-radius: 26rpx; background: var(--event-pink-soft); flex-shrink: 0; }
.event-hero__body { min-width: 0; flex: 1; }
.event-hero__title {
  font-family: var(--font-serif); margin-top: 8rpx; color: var(--event-ink); font-size: 45rpx; font-weight: 700; line-height: 1.32; letter-spacing: -1.4rpx; }
.event-hero__copy { margin-top: 9rpx; color: var(--event-ink-3); font-size: 24rpx; line-height: 1.55; }

.paper-card { box-sizing: border-box; border: 1rpx solid var(--event-line); border-radius: 30rpx; background: #ffffff; box-shadow: 0 12rpx 30rpx rgba(42, 62, 50, 0.045); }
.event-detail-card { overflow: hidden; padding: 0 22rpx; }
.event-detail-row { display: flex; align-items: center; justify-content: space-between; min-height: 80rpx; border-bottom: 1rpx solid var(--event-line); gap: 20rpx; }
.event-detail-row text:first-child { color: var(--event-ink-3); font-size: 23rpx; }
.event-detail-row text:last-child { max-width: 68%; color: var(--event-ink); font-size: 26rpx; font-weight: 600; text-align: right; }
.event-detail-note { margin: 18rpx 0 20rpx; padding: 18rpx; border-radius: 22rpx; background: #fff7f8; }
.event-detail-note__label { display: flex; align-items: center; color: #b56d7d; gap: 7rpx; }
.event-detail-note__label text { font-size: 22rpx; font-weight: 600; }
.event-detail-note > text { display: block; margin-top: 10rpx; color: var(--event-ink-2); font-size: 27rpx; line-height: 1.75; white-space: pre-wrap; }
.event-actions { margin-top: 26rpx; }
.event-actions button { width: 100%; gap: 9rpx; }
.event-delete { margin-top: 13rpx; }
.event-tip { display: flex; align-items: center; justify-content: center; margin-top: 16rpx; color: var(--event-ink-3); gap: 6rpx; font-size: 22rpx; }
