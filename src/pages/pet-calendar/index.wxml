<view class="page-shell pet-calendar-page">
  <view class="subpage-back" bindtap="onBack">← 返回{{petName}}的档案</view>
  <view class="calendar-head">
    <view class="calendar-head__title-row"><view class="calendar-head__mark"><line-icon name="calendar-days" size="30" tone="accent" /></view><view class="calendar-head__title">{{petName}}的照护月历</view></view>
    <view class="calendar-head__copy">历史记录、下次计划和内外驱推算放在同一张月历里。</view>
  </view>

  <view class="calendar-card">
    <view class="calendar-nav"><view bindtap="onPreviousMonth">‹</view><text>{{monthLabel}}</text><view bindtap="onNextMonth">›</view></view>
    <view class="calendar-week"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view>
    <view class="calendar-grid">
      <view wx:for="{{cells}}" wx:key="date" class="calendar-cell {{item.inCurrentMonth ? '' : 'calendar-cell--muted'}} {{item.isToday ? 'calendar-cell--today' : ''}} {{selectedDate === item.date ? 'calendar-cell--selected' : ''}}" data-date="{{item.date}}" bindtap="onSelectDate">
        <text>{{item.day}}</text>
        <view wx:if="{{item.eventCount}}" class="calendar-cell__dot"><text>{{item.eventCount}}</text></view>
      </view>
    </view>
  </view>

  <view class="calendar-events-head"><view><text>{{selectedDate}}</text><text>{{selectedEvents.length ? selectedEvents.length + ' 项安排' : '这天没有记录'}}</text></view><view class="calendar-events-head__add" bindtap="onAddEvent"><line-icon name="plus" size="20" tone="ink" /><text>记录事件</text></view></view>
  <view wx:if="{{selectedEvents.length}}" class="calendar-events">
    <view wx:for="{{selectedEvents}}" wx:key="id" class="calendar-event-row" data-id="{{item.eventId}}" bindtap="onOpenEvent">
      <view class="calendar-event-row__mark"><line-icon name="{{item.iconName}}" size="24" tone="accent" /></view>
      <view><text>{{item.title}}</text><text>{{item.kindLabel}}</text></view>
    </view>
  </view>
  <view wx:else class="calendar-empty">
    <image class="calendar-empty__illustration" src="../../images/ink-cat.png" mode="aspectFit" />
    <text>可以为这一天补一条疫苗、洗护、就诊或外出记录。</text>
  </view>
</view>
