<view class="page-shell pet-calendar-page">
  <view class="calendar-hero">
    <view class="calendar-hero__mark"><line-icon name="system-calendar" size="30" tone="pink" /></view>
    <view class="calendar-hero__body">
      <view class="eyebrow">DAILY · CARE</view>
      <view class="calendar-hero__title">{{petName}}的月历</view>
      <view class="calendar-hero__copy">日常、护理历史和下次计划都在这里。</view>
    </view>
  </view>

  <view wx:if="{{errorText}}" class="calendar-sync-state calendar-sync-state--error"><text>{{errorText}}</text><text bindtap="onShow">点按重试</text></view>
  <view wx:elif="{{loading}}" class="calendar-sync-state">正在同步照护月历…</view>

  <view class="paper-card calendar-card">
    <view class="calendar-nav">
      <view class="calendar-nav__button" bindtap="onPreviousMonth">‹</view>
      <view class="calendar-nav__month"><text>{{monthLabel}}</text><text>日常与照护</text></view>
      <view class="calendar-nav__button" bindtap="onNextMonth">›</view>
    </view>
    <view class="calendar-week"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view>
    <view class="calendar-grid">
      <view wx:for="{{cells}}" wx:key="date" class="calendar-cell {{item.inCurrentMonth ? '' : 'calendar-cell--muted'}} {{item.isToday ? 'calendar-cell--today' : ''}} {{selectedDate === item.date ? 'calendar-cell--selected' : ''}}" data-date="{{item.date}}" bindtap="onSelectDate">
        <text>{{item.day}}</text>
        <view wx:if="{{item.eventCount}}" class="calendar-cell__dot"><text>{{item.eventCount}}</text></view>
      </view>
    </view>
  </view>

  <view class="calendar-events-head">
    <view><text>{{selectedDateLabel}}</text><text>{{selectedEvents.length ? selectedEvents.length + ' 条记录' : '这天还没有记录'}}</text></view>
    <view class="calendar-events-head__add" bindtap="onAddEvent"><line-icon name="system-add" size="19" tone="pink" /><text>记护理</text></view>
  </view>

  <view wx:if="{{selectedEvents.length}}" class="calendar-events paper-card">
    <view wx:for="{{selectedEvents}}" wx:key="id" class="calendar-event-row calendar-event-row--{{item.source}}" data-id="{{item.eventId}}" bindtap="onOpenEvent">
      <view class="calendar-event-row__mark"><line-icon name="{{item.iconName}}" size="23" tone="color" /></view>
      <view class="calendar-event-row__body">
        <block wx:if="{{item.source === 'daily'}}">
          <view class="calendar-event-row__badges"><text class="calendar-event-row__action">{{item.actionLabel}}</text><text class="calendar-event-row__status">{{item.statusLabel}}</text></view>
          <text wx:if="{{item.note}}" class="calendar-event-row__note">{{item.note}}</text>
          <text class="calendar-event-row__time">{{item.timeLabel}}</text>
        </block>
        <block wx:else><text>{{item.title}}</text><text>{{item.kindLabel}}{{item.note ? ' · ' + item.note : ''}}</text></block>
      </view>
      <view wx:if="{{item.eventId}}" class="calendar-event-row__arrow">›</view>
    </view>
  </view>

  <view wx:else class="calendar-empty paper-card">
    <image class="calendar-empty__illustration" src="../../images/ink-cat.png" mode="aspectFit" />
    <view class="calendar-empty__copy"><text>这一天还没有日常或护理记录</text><text>日常在宠物页记，护理可以单独补一条。</text></view>
    <view class="calendar-empty__action" bindtap="onAddEvent">记护理</view>
  </view>
</view>
