.pet-calendar-page {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.calendar-head {
  padding: 8rpx 0 32rpx;
}

.calendar-head__title-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.calendar-head__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 9rpx;
  flex-shrink: 0;
}

.calendar-head__title {
  color: var(--c-text, #22242e);
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: -2rpx;
}

.calendar-head__copy {
  max-width: 610rpx;
  margin-top: 12rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 24rpx;
  line-height: 1.65;
}

.calendar-card {
  padding: 20rpx 0 18rpx;
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
  border-radius: 0;
  background: transparent;
}

.calendar-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 20rpx;
}

.calendar-nav view {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: var(--c-text-2, #5c5f6e);
  font-size: 34rpx;
}

.calendar-nav text {
  color: var(--c-text, #22242e);
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  font-weight: 400;
}

.calendar-week,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.calendar-week text {
  padding: 10rpx 0;
  color: var(--c-muted, #9497a6);
  font-size: 19rpx;
  font-weight: 400;
  text-align: center;
}

.calendar-cell {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 78rpx;
  border-radius: 50%;
  color: var(--c-text, #22242e);
  font-size: 21rpx;
}

.calendar-cell--muted {
  color: #c6c9d6;
}

.calendar-cell--today {
  background: transparent;
  color: var(--c-accent, #5b6ee0);
  font-weight: 500;
}

.calendar-cell--today::after {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: var(--c-accent, #5b6ee0);
  content: "";
  transform: translateX(-50%);
}

.calendar-cell--selected {
  background: var(--c-text, #22242e);
  color: #fff;
  font-weight: 500;
}

.calendar-cell--selected::after {
  display: none;
}

.calendar-cell__dot {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 22rpx;
  height: 22rpx;
  padding: 0 3rpx;
  border-radius: 50%;
  background: var(--c-accent, #5b6ee0);
  box-sizing: border-box;
  color: #fff;
  font-size: 12rpx;
  font-weight: 500;
}

.calendar-cell--selected .calendar-cell__dot {
  background: var(--c-bg, #f6f4f9);
  color: var(--c-text, #22242e);
}

.calendar-events-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 38rpx;
  padding: 0 0 14rpx;
}

.calendar-events-head text {
  display: block;
  color: var(--c-text, #22242e);
  font-size: 27rpx;
  font-weight: 500;
}

.calendar-events-head text + text {
  margin-top: 5rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
  font-weight: 400;
}

.calendar-events-head__add {
  display: flex;
  align-items: center;
  gap: 6rpx;
  border-bottom: 1rpx solid var(--c-text, #22242e);
  color: var(--c-text, #22242e);
  font-size: 21rpx;
  line-height: 1.8;
}

.calendar-events {
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.calendar-event-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 96rpx;
  padding: 0;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.calendar-event-row:last-child {
  border-bottom: 0;
}

.calendar-event-row__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border-radius: 0;
  background: transparent;
  color: var(--c-accent, #5b6ee0);
  flex-shrink: 0;
}

.calendar-event-row > view:last-child text {
  display: block;
  color: var(--c-text, #22242e);
  font-size: 23rpx;
  font-weight: 500;
}

.calendar-event-row > view:last-child text + text {
  margin-top: 4rpx;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
  font-weight: 400;
}

.calendar-empty {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 20rpx;
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
  border-radius: 0;
  color: var(--c-muted, #9497a6);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: left;
}

.calendar-empty__illustration {
  width: 126rpx;
  height: 72rpx;
  opacity: 0.82;
  flex-shrink: 0;
}

.calendar-empty text {
  min-width: 0;
  flex: 1;
}
