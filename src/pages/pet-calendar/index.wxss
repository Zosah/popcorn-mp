.pet-calendar-page {
  --calendar-deep: var(--c-primary, #252b27);
  --calendar-pink: var(--c-coral, #c67d6d);
  --calendar-pink-soft: var(--c-coral-soft, #f7e7e2);
  --calendar-ink: var(--c-text, #252b27);
  --calendar-ink-2: var(--c-text-2, #5f5a53);
  --calendar-ink-3: var(--c-muted, #837f76);
  --calendar-line: var(--c-line, #e9e6e1);
  padding: 28rpx 36rpx calc(104rpx + env(safe-area-inset-bottom));
  background: var(--c-paper, #f8f7f4);
  color: var(--calendar-ink);
}
.calendar-hero { display: flex; align-items: flex-start; padding: 8rpx 2rpx 29rpx; gap: 18rpx; }
.calendar-hero__mark { display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border-radius: 24rpx; background: var(--calendar-pink-soft); flex-shrink: 0; }
.calendar-hero__body { min-width: 0; flex: 1; }
.calendar-hero__title {
  font-family: var(--font-serif); margin-top: 8rpx; color: var(--calendar-ink); font-size: 45rpx; font-weight: 700; line-height: 1.3; letter-spacing: -1.4rpx; }
.calendar-hero__copy { margin-top: 9rpx; color: var(--calendar-ink-2); font-size: 25rpx; line-height: 1.6; }

.paper-card { box-sizing: border-box; border: 1rpx solid var(--calendar-line); border-radius: 30rpx; background: #ffffff; box-shadow: 0 12rpx 30rpx rgba(42, 62, 50, 0.045); }
.calendar-card { padding: 20rpx 16rpx 18rpx; }
.calendar-nav { display: flex; align-items: center; justify-content: space-between; padding: 0 2rpx 18rpx; }
.calendar-nav__button { display: flex; width: 54rpx; height: 54rpx; align-items: center; justify-content: center; border-radius: 18rpx; background: #f7f2ea; color: var(--calendar-deep); font-size: 37rpx; line-height: 1; }
.calendar-nav__month { text-align: center; }
.calendar-nav__month text { display: block; }
.calendar-nav__month text:first-child { color: var(--calendar-ink); font-family: "Songti SC", "STSong", serif; font-size: 33rpx; font-weight: 600; }
.calendar-nav__month text:last-child { margin-top: 2rpx; color: var(--calendar-ink-3); font-size: 20rpx; letter-spacing: 1rpx; }

.calendar-week, .calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
.calendar-week { padding: 7rpx 0 5rpx; border-top: 1rpx solid var(--c-paper-2, #f1ede7); border-bottom: 1rpx solid var(--c-paper-2, #f1ede7); }
.calendar-week text { padding: 9rpx 0; color: var(--calendar-ink-3); font-size: 21rpx; text-align: center; }
.calendar-grid { padding-top: 7rpx; }
.calendar-cell { position: relative; display: flex; min-height: 74rpx; align-items: center; justify-content: center; border-radius: 20rpx; color: var(--calendar-ink); font-size: 24rpx; }
.calendar-cell--muted { color: #c9c1b8; }
.calendar-cell--today { border: 1rpx solid #efc2ca; color: var(--c-primary-link, #b86757); font-weight: 700; }
.calendar-cell--today::after { position: absolute; bottom: 7rpx; left: 50%; width: 5rpx; height: 5rpx; border-radius: 50%; background: var(--calendar-pink); content: ""; transform: translateX(-50%); }
.calendar-cell--selected { background: var(--calendar-deep); color: #ffffff; font-weight: 700; }
.calendar-cell--selected::after { display: none; }
.calendar-cell__dot { position: absolute; top: 6rpx; right: 8rpx; display: flex; min-width: 21rpx; height: 21rpx; align-items: center; justify-content: center; padding: 0 3rpx; border-radius: 999rpx; background: var(--calendar-pink); box-sizing: border-box; color: #fff; font-size: 15rpx; }
.calendar-cell--selected .calendar-cell__dot { background: #ffffff; color: var(--calendar-deep); }

.calendar-events-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 30rpx 4rpx 12rpx; gap: 16rpx; }
.calendar-events-head > view:first-child text { display: block; }
.calendar-events-head > view:first-child text:first-child { color: var(--calendar-ink); font-size: 30rpx; font-weight: 700; }
.calendar-events-head > view:first-child text:last-child { margin-top: 3rpx; color: var(--calendar-ink-3); font-size: 22rpx; }
.calendar-events-head__add { display: flex; min-height: 60rpx; align-items: center; padding: 0 18rpx; border-radius: 999rpx; background: var(--calendar-deep); color: #fff; gap: 5rpx; font-size: 22rpx; }
.calendar-events-head__add text { color: #fff; }

.calendar-events { overflow: hidden; padding: 0 18rpx; }
.calendar-event-row { display: flex; min-height: 96rpx; align-items: center; border-bottom: 1rpx solid var(--calendar-line); gap: 14rpx; }
.calendar-event-row:last-child { border-bottom: 0; }
.calendar-event-row__mark { display: flex; width: 52rpx; height: 52rpx; align-items: center; justify-content: center; border-radius: 17rpx; background: var(--calendar-pink-soft); flex-shrink: 0; }
.calendar-event-row__body { min-width: 0; flex: 1; }
.calendar-event-row__body text { display: block; color: var(--calendar-ink); font-size: 26rpx; font-weight: 600; }
.calendar-event-row__body text + text { margin-top: 3rpx; color: var(--calendar-ink-3); font-size: 21rpx; font-weight: 400; }
.calendar-event-row__arrow { color: var(--c-faint, #a29b91); font-size: 36rpx; }

.calendar-empty { display: flex; align-items: center; padding: 22rpx 18rpx; gap: 15rpx; }
.calendar-empty__illustration { width: 112rpx; height: 68rpx; flex-shrink: 0; }
.calendar-empty__copy { min-width: 0; flex: 1; }
.calendar-empty__copy text { display: block; }
.calendar-empty__copy text:first-child { color: var(--calendar-ink); font-size: 25rpx; font-weight: 600; }
.calendar-empty__copy text:last-child { margin-top: 4rpx; color: var(--calendar-ink-3); font-size: 21rpx; line-height: 1.55; }
.calendar-empty__action { padding: 9rpx 14rpx; border-radius: 999rpx; background: var(--calendar-pink-soft); color: var(--c-primary-link, #b86757); flex-shrink: 0; font-size: 21rpx; font-weight: 600; }
