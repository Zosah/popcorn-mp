.reminder-page {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.reminder-head {
  padding: 8rpx 0 34rpx;
}

.reminder-head__title {
  max-width: 620rpx;
  color: var(--c-text, #22242e);
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: -2rpx;
}

.reminder-head__copy {
  max-width: 610rpx;
  margin-top: 12rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 24rpx;
  line-height: 1.65;
}

.reminder-list {
  padding: 0;
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
  border-radius: 0;
  background: transparent;
}

.reminder-row {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.reminder-row:last-child {
  border-bottom: 0;
}

.reminder-row__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--c-accent, #5b6ee0);
  flex-shrink: 0;
}

.reminder-row__body {
  min-width: 0;
  flex: 1;
  margin-left: 16rpx;
}

.reminder-row__body text {
  display: block;
  color: var(--c-text, #22242e);
  font-size: 25rpx;
  font-weight: 500;
}

.reminder-row__body text + text {
  margin-top: 5rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
  font-weight: 400;
}

.reminder-row switch {
  transform: scale(0.78);
  transform-origin: right center;
}

.reminder-section-title {
  margin: 44rpx 0 14rpx;
  color: var(--c-text, #22242e);
  font-size: 27rpx;
  font-weight: 500;
}

.time-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
  border-radius: 0;
  background: transparent;
}

.time-card__main {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.time-card__main text {
  display: block;
  color: var(--c-text, #22242e);
  font-family: "Songti SC", "STSong", serif;
  font-size: 42rpx;
  font-weight: 400;
  line-height: 1.2;
}

.time-card__main text + text {
  margin-top: 6rpx;
  color: var(--c-muted, #9497a6);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 21rpx;
  font-weight: 400;
}

.time-card > text {
  color: var(--c-text, #22242e);
  font-size: 21rpx;
}

.permission-note {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 18rpx 0 0 18rpx;
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-left: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-radius: 0;
  background: transparent;
}

.permission-note__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-radius: 50%;
  background: transparent;
  color: var(--c-text-2, #5c5f6e);
  flex-shrink: 0;
}

.permission-note text {
  flex: 1;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
  line-height: 1.6;
}
