.reminder-page {
  --reminder-paper: var(--c-paper, #f8f7f4);
  --reminder-surface: #ffffff;
  --reminder-ink: var(--c-text, #252b27);
  --reminder-ink-2: var(--c-text-2, #5f5a53);
  --reminder-ink-3: var(--c-muted, #837f76);
  --reminder-line: var(--c-line, #e9e6e1);
  --reminder-deep: var(--c-primary, #252b27);
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 36rpx calc(90rpx + env(safe-area-inset-bottom));
  background: var(--reminder-paper);
  color: var(--reminder-ink);
}

.reminder-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 5rpx 2rpx 26rpx;
  gap: 18rpx;
}

.reminder-head__copy {
  min-width: 0;
  flex: 1;
}

.reminder-head__title {
  font-family: var(--font-serif);
  display: block;
  color: var(--reminder-ink);
  font-size: 46rpx;
  font-weight: 750;
  letter-spacing: -1.5rpx;
  line-height: 1.35;
}

.reminder-head__desc {
  display: block;
  max-width: 510rpx;
  margin-top: 10rpx;
  color: var(--reminder-ink-3);
  font-size: 24rpx;
  line-height: 1.65;
}

.reminder-head__auth {
  display: flex;
  min-width: 104rpx;
  height: 66rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid var(--reminder-line);
  border-radius: 999rpx;
  background: var(--reminder-surface);
  box-shadow: 0 8rpx 20rpx rgba(42, 62, 50, 0.04);
  color: var(--reminder-ink);
  flex-shrink: 0;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1;
}

.reminder-head__auth[disabled] {
  color: var(--reminder-ink-3);
  opacity: 0.72;
}

.reminder-list {
  overflow: hidden;
  padding: 0 21rpx;
  border: 1rpx solid var(--reminder-line);
  border-radius: 34rpx;
  background: var(--reminder-surface);
  box-shadow: 0 12rpx 34rpx rgba(42, 62, 50, 0.045);
}

.reminder-row {
  display: flex;
  min-height: 116rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--reminder-line);
  gap: 15rpx;
}

.reminder-row:last-child {
  border-bottom: 0;
}

.reminder-row__icon {
  display: flex;
  width: 66rpx;
  height: 66rpx;
  align-items: center;
  justify-content: center;
  border-radius: 21rpx;
  flex-shrink: 0;
}

.reminder-row__icon--orange { background: var(--c-coral-soft, #f7e7e2); }
.reminder-row__icon--pink { background: var(--c-coral-soft, #f7e7e2); }
.reminder-row__icon--green { background: var(--c-sage-soft, #e2eee9); }
.reminder-row__icon--blue { background: var(--c-sage-soft, #e2eee9); }

.reminder-row__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.reminder-row__body text:first-child {
  color: var(--reminder-ink);
  font-size: 29rpx;
  font-weight: 650;
}

.reminder-row__body text:last-child {
  color: var(--reminder-ink-3);
  font-size: 23rpx;
  line-height: 1.45;
}

.reminder-row switch {
  transform: scale(0.77);
  transform-origin: right center;
}

.reminder-row__time {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 8rpx;
}

.reminder-row__time text:first-child {
  color: var(--reminder-ink-2);
  font-family: "Helvetica Neue", Arial, sans-serif;
  font-size: 29rpx;
  font-weight: 700;
}

.reminder-row__time text:last-child {
  color: #c7beb5;
  font-size: 34rpx;
  font-weight: 300;
}

.reminder-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 36rpx 4rpx 13rpx;
}

.reminder-section-head text:first-child {
  color: var(--reminder-ink);
  font-size: 33rpx;
  font-weight: 750;
  letter-spacing: -0.5rpx;
}

.reminder-section-head text:last-child {
  color: var(--reminder-ink-3);
  font-size: 23rpx;
}

.reminder-method {
  padding: 22rpx;
  border: 1rpx solid var(--reminder-line);
  border-radius: 31rpx;
  background: var(--reminder-surface);
}

.reminder-subscription__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.reminder-subscription__head > view {
  min-width: 0;
  flex: 1;
}

.reminder-subscription__dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--reminder-line);
  box-shadow: 0 0 0 7rpx rgba(131, 127, 118, 0.08);
  flex-shrink: 0;
}

.reminder-subscription__dot--ready {
  background: var(--c-sage, #668478);
  box-shadow: 0 0 0 7rpx rgba(102, 132, 120, 0.12);
}

.reminder-subscription__detail {
  display: block;
  margin-top: 6rpx;
  color: var(--reminder-ink-3);
  font-size: 23rpx;
  line-height: 1.62;
}

.reminder-subscription__error {
  display: block;
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: var(--c-coral-soft, #f7e7e2);
  color: #8c4f43;
  font-size: 22rpx;
  line-height: 1.5;
}

.reminder-method__copy {
  display: block;
  color: var(--reminder-ink-2);
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.8;
}

.reminder-method__tip {
  display: flex;
  align-items: flex-start;
  margin-top: 15rpx;
  padding: 13rpx 15rpx;
  border-radius: 18rpx;
  background: var(--c-butter-soft, #f2e8cc);
  gap: 9rpx;
}

.reminder-method__dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #d9a536;
  flex-shrink: 0;
}

.reminder-method__tip text:last-child {
  color: #8a7a5e;
  font-size: 23rpx;
  line-height: 1.55;
}

.reminder-weekly {
  padding: 24rpx 22rpx 21rpx;
  border: 1rpx solid var(--reminder-line);
  border-radius: 33rpx;
  background: var(--reminder-surface);
  transition: opacity 160ms ease;
}

.reminder-weekly--off {
  opacity: 0.62;
}

.reminder-weekly__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.reminder-weekly__title {
  display: block;
  color: var(--reminder-ink);
  font-size: 30rpx;
  font-weight: 700;
}

.reminder-weekly__meta {
  display: block;
  margin-top: 5rpx;
  color: var(--reminder-ink-3);
  font-size: 23rpx;
}

.reminder-weekly__status {
  padding: 5rpx 11rpx;
  border-radius: 999rpx;
  background: var(--c-sage-soft, #e2eee9);
  color: var(--c-sage, #668478);
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 650;
}

.reminder-weekly--off .reminder-weekly__status {
  background: var(--c-paper-2, #f1ede7);
  color: var(--reminder-ink-3);
}

.reminder-weekly__stats {
  display: grid;
  margin-top: 19rpx;
  gap: 10rpx;
  grid-template-columns: repeat(3, 1fr);
}

.reminder-weekly__stat {
  display: flex;
  min-height: 104rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  flex-direction: column;
}

.reminder-weekly__stat--gold { background: var(--c-butter-soft, #f2e8cc); }
.reminder-weekly__stat--pink { background: var(--c-coral-soft, #f7e7e2); }
.reminder-weekly__stat--blue { background: var(--c-sage-soft, #e2eee9); }

.reminder-weekly__stat text:first-child {
  font-family: "Helvetica Neue", Arial, sans-serif;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  line-height: 1.1;
}

.reminder-weekly__stat--gold text:first-child { color: var(--c-warning, #a18448); }
.reminder-weekly__stat--pink text:first-child { color: var(--c-primary-link, #b86757); }
.reminder-weekly__stat--blue text:first-child { color: var(--c-sage, #668478); }

.reminder-weekly__stat text:last-child {
  margin-top: 5rpx;
  color: var(--reminder-ink-2);
  font-size: 22rpx;
}

.reminder-footnote {
  display: flex;
  align-items: flex-start;
  margin-top: 22rpx;
  padding: 0 5rpx;
  gap: 9rpx;
}

.reminder-footnote text {
  color: var(--reminder-ink-3);
  flex: 1;
  font-size: 22rpx;
  line-height: 1.65;
}

.reminder-head__eyebrow {
  margin-bottom: 13rpx;
}

.reminder-error {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  padding: 18rpx 19rpx;
  border: 1rpx solid rgba(184, 103, 87, 0.18);
  border-radius: 24rpx;
  background: var(--c-coral-soft, #f7e7e2);
  gap: 16rpx;
}

.reminder-error__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.reminder-error__title {
  color: #8c4f43;
  font-size: 25rpx;
  font-weight: 700;
}

.reminder-error__text {
  color: #9b6a61;
  font-size: 22rpx;
  line-height: 1.5;
}

.reminder-error__action {
  min-width: 92rpx;
  height: 54rpx;
  margin: 0;
  padding: 0 17rpx;
  border: 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #8c4f43;
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 54rpx;
}

.reminder-loading {
  display: flex;
  min-height: 280rpx;
  align-items: flex-start;
  justify-content: center;
  padding: 42rpx 25rpx;
  border: 1rpx solid var(--reminder-line);
  border-radius: 34rpx;
  background: var(--reminder-surface);
  box-sizing: border-box;
  flex-direction: column;
  gap: 18rpx;
}

.reminder-loading__line {
  width: 72%;
  height: 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #f1ede7 20%, #faf8f5 50%, #f1ede7 80%);
  background-size: 200% 100%;
  animation: reminder-shimmer 1.3s ease-in-out infinite;
}

.reminder-loading__line--short {
  width: 42%;
  height: 18rpx;
}

.reminder-loading text {
  margin-top: 8rpx;
  color: var(--reminder-ink-3);
  font-size: 23rpx;
}

@keyframes reminder-shimmer {
  from { background-position: 100% 0; }
  to { background-position: -100% 0; }
}
