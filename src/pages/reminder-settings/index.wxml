<view class="reminder-page">
  <view class="subpage-back" bindtap="onBack">← 返回我的</view>

  <view class="reminder-head">
    <view class="reminder-head__copy">
      <view class="reminder-head__eyebrow">
        <sync-badge state="{{syncState}}" text="{{syncText}}" />
      </view>
      <text class="reminder-head__title">该记得的事，轻轻提醒</text>
      <text class="reminder-head__desc">
        {{mode === 'demo' ? '先把偏好留在这台设备上。' : '每个空间成员各自设置，不覆盖对方。'}}
      </text>
    </view>
    <button
      class="reminder-head__auth"
      loading="{{authorizing}}"
      disabled="{{authorizing || (!subscription.configured && !subscriptionErrorText)}}"
      bindtap="onAuthorize"
    >
      {{mode === 'demo' ? '本机说明' : subscriptionActionText}}
    </button>
  </view>

  <view wx:if="{{errorText}}" class="reminder-error">
    <view class="reminder-error__body">
      <text class="reminder-error__title">这次没有同步成功</text>
      <text class="reminder-error__text">{{errorText}}</text>
    </view>
    <button class="reminder-error__action" bindtap="onRetry">重试</button>
  </view>

  <view wx:if="{{loading}}" class="reminder-loading">
    <view class="reminder-loading__line"></view>
    <view class="reminder-loading__line reminder-loading__line--short"></view>
    <text>正在读取你的提醒偏好…</text>
  </view>

  <block wx:else>
    <view class="reminder-list">
      <view class="reminder-row">
        <view class="reminder-row__icon reminder-row__icon--orange">
          <line-icon name="bell" size="29" tone="orange" />
        </view>
        <view class="reminder-row__body">
          <text>库存临期提醒</text>
          <text>有物品 3 天内到期时提醒</text>
        </view>
        <switch
          checked="{{settings.expiry}}"
          color="#252b27"
          data-key="expiry"
          disabled="{{saving}}"
          bindchange="onToggle"
        />
      </view>

      <view class="reminder-row">
        <view class="reminder-row__icon reminder-row__icon--pink">
          <line-icon name="paw-print" size="29" tone="pink" />
        </view>
        <view class="reminder-row__body">
          <text>宠物照护提醒</text>
          <text>驱虫、疫苗和每天的小任务</text>
        </view>
        <switch
          checked="{{settings.petCare}}"
          color="#252b27"
          data-key="petCare"
          disabled="{{saving}}"
          bindchange="onToggle"
        />
      </view>

      <view class="reminder-row">
        <view class="reminder-row__icon reminder-row__icon--green">
          <line-icon name="calendar-days" size="29" tone="green" />
        </view>
        <view class="reminder-row__body">
          <text>每周回顾</text>
          <text>周日晚看看这一周的生活</text>
        </view>
        <switch
          checked="{{settings.weeklyReview}}"
          color="#252b27"
          data-key="weeklyReview"
          disabled="{{saving}}"
          bindchange="onToggle"
        />
      </view>

      <picker
        mode="time"
        value="{{settings.reminderTime}}"
        disabled="{{saving}}"
        bindchange="onTimeChange"
      >
        <view class="reminder-row reminder-row--time">
          <view class="reminder-row__icon reminder-row__icon--blue">
            <line-icon name="clock-3" size="29" tone="blue" />
          </view>
          <view class="reminder-row__body">
            <text>默认提醒时间</text>
            <text>采用 Asia/Shanghai 时间</text>
          </view>
          <view class="reminder-row__time">
            <text>{{settings.reminderTime}}</text>
            <text>›</text>
          </view>
        </view>
      </picker>
    </view>

    <view class="reminder-section-head">
      <text>推送方式</text>
      <text>{{mode === 'demo' ? '本机偏好' : '服务通知'}}</text>
    </view>
    <view class="reminder-method">
      <view class="reminder-subscription__head">
        <view>
          <text class="reminder-method__copy">{{subscriptionLabel}}</text>
          <text class="reminder-subscription__detail">{{subscriptionDetail}}</text>
        </view>
        <text class="reminder-subscription__dot {{subscription.configured && subscription.availableCount > 0 ? 'reminder-subscription__dot--ready' : ''}}"></text>
      </view>
      <text wx:if="{{subscriptionErrorText}}" class="reminder-subscription__error">{{subscriptionErrorText}}</text>
      <view class="reminder-method__tip">
        <text class="reminder-method__dot"></text>
        <text>
          {{mode === 'demo'
            ? '切换 Demo 模式后，偏好会保留在这台设备'
            : subscription.configured
              ? '微信一次性订阅按次授权；服务端每日最多聚合发送一条，发送成功后消费一次机会。'
              : '配置模板 ID 并开启 Worker 后，才具备真实发送能力。'}}
        </text>
      </view>
    </view>

    <view class="reminder-section-head">
      <text>每周回顾</text>
      <text>每周日 {{settings.reminderTime}}</text>
    </view>
    <view class="reminder-weekly {{settings.weeklyReview ? '' : 'reminder-weekly--off'}}">
      <view class="reminder-weekly__head">
        <view>
          <text class="reminder-weekly__title">这周你们一起过了 5 天</text>
          <text class="reminder-weekly__meta">示例回顾 · 上周日</text>
        </view>
        <text class="reminder-weekly__status">{{settings.weeklyReview ? '已开启' : '未开启'}}</text>
      </view>
      <view class="reminder-weekly__stats">
        <view class="reminder-weekly__stat reminder-weekly__stat--gold">
          <text>3</text>
          <text>顿饭</text>
        </view>
        <view class="reminder-weekly__stat reminder-weekly__stat--pink">
          <text>5</text>
          <text>照护</text>
        </view>
        <view class="reminder-weekly__stat reminder-weekly__stat--blue">
          <text>4</text>
          <text>瞬间</text>
        </view>
      </view>
    </view>

    <view class="reminder-footnote">
      <line-icon name="lock" size="21" tone="muted" />
      <text wx:if="{{mode === 'demo'}}">Demo 模式：提醒偏好只保存在当前设备，不会上传服务端。</text>
      <text wx:else>提醒偏好按“空间 + 个人”保存；当前状态只表示授权机会与服务端配置，不代表通知已经发送。</text>
    </view>
  </block>
</view>
