.journal-form-page {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.journal-form-head {
  padding: 8rpx 0 32rpx;
}

.journal-form-head__title {
  max-width: 620rpx;
  color: var(--c-text, #22242e);
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: -2rpx;
}

.journal-form-head__copy {
  max-width: 610rpx;
  margin-top: 12rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 24rpx;
  line-height: 1.65;
}

.journal-form-page .card {
  border: 0;
  border-radius: 0;
  background: transparent;
}

.journal-form-card {
  padding: 0;
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.journal-field {
  padding: 25rpx 0;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.journal-field--last {
  border-bottom: 0;
}

.journal-field > text {
  color: var(--c-muted, #9497a6);
  font-size: 22rpx;
  font-weight: 400;
}

.journal-field input {
  height: 70rpx;
  margin-top: 5rpx;
  color: var(--c-text, #22242e);
  font-size: 31rpx;
  font-weight: 500;
}

.journal-field input::placeholder {
  color: #a8abba;
  font-weight: 400;
}

.journal-category-picker {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  color: var(--c-text, #22242e);
  font-size: 26rpx;
}

.journal-field textarea {
  width: 100%;
  height: 238rpx;
  box-sizing: border-box;
  margin-top: 12rpx;
  padding: 16rpx 0 16rpx 18rpx;
  border: 0;
  border-left: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-radius: 0;
  background: transparent;
  color: var(--c-text, #22242e);
  font-size: 25rpx;
  line-height: 1.7;
}

.visibility-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.visibility-card {
  position: relative;
  padding: 22rpx 20rpx 22rpx 24rpx;
  border: 1rpx solid var(--c-line, #e7e6ee);
  border-radius: 2rpx;
  background: transparent;
  transition: border-color 160ms ease, background-color 160ms ease;
}

.visibility-card--active {
  border-color: var(--c-text, #22242e);
  background: rgba(34, 36, 46, 0.025);
}

.visibility-card--active::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: -1rpx;
  width: 3rpx;
  background: var(--c-text, #22242e);
  content: "";
}

.visibility-card__title {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.visibility-card__title text {
  color: var(--c-text, #22242e);
  font-size: 25rpx;
  font-weight: 500;
}

.visibility-card__copy {
  display: block;
  margin-top: 6rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
  font-weight: 400;
}

.visibility-card--active .visibility-card__copy {
  color: var(--c-text-2, #5c5f6e);
}

.journal-save {
  width: 100%;
  margin-top: 36rpx;
  gap: 10rpx;
}

.journal-form-head__storage {
  margin-top: 12rpx;
  color: var(--c-muted, #8a8693);
  font-size: 20rpx;
  line-height: 1.6;
}

.journal-form-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 58rpx 34rpx;
  margin-bottom: 24rpx;
  color: var(--c-muted, #8a8693);
  text-align: center;
}

.journal-form-state > view {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(139, 121, 183, 0.12);
  color: var(--c-accent, #8b79b7);
  font-weight: 600;
}

.journal-image-card {
  padding: 18rpx;
  border-radius: 30rpx;
}

.journal-image-preview {
  position: relative;
  overflow: hidden;
  width: 100%;
  height: 330rpx;
  border-radius: 24rpx;
  background: #ece8e1;
  box-shadow: 0 12rpx 30rpx rgba(75, 67, 91, 0.10);
}

.journal-image-preview image {
  width: 100%;
  height: 100%;
  filter: saturate(0.62) contrast(0.96) sepia(0.05);
}

.journal-image-preview__badge {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  display: flex;
  align-items: center;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(37, 34, 49, 0.58);
  color: #fff;
  gap: 7rpx;
  font-size: 18rpx;
  backdrop-filter: blur(10rpx);
}

.journal-image-placeholder {
  display: flex;
  min-height: 220rpx;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  box-sizing: border-box;
  border: 1rpx dashed rgba(111, 101, 137, 0.24);
  border-radius: 24rpx;
  background: linear-gradient(150deg, rgba(246, 243, 251, 0.86), rgba(245, 250, 246, 0.80));
  color: var(--c-text-2, #615f70);
  flex-direction: column;
  gap: 9rpx;
  text-align: center;
}

.journal-image-placeholder text:nth-of-type(1) {
  color: var(--c-text, #292737);
  font-size: 25rpx;
  font-weight: 600;
}

.journal-image-placeholder text:nth-of-type(2) {
  max-width: 500rpx;
  color: var(--c-muted, #8a8693);
  font-size: 19rpx;
  line-height: 1.55;
}

.journal-image-placeholder__icon {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 8rpx 22rpx rgba(68, 61, 76, 0.09);
}

.journal-image-placeholder--loading {
  opacity: 0.82;
}

.journal-image-tools {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  gap: 12rpx;
}

.journal-image-tools input {
  min-width: 0;
  height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(111, 101, 137, 0.12);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.70);
  color: var(--c-text, #292737);
  flex: 1;
  font-size: 22rpx;
}

.journal-image-remove {
  padding: 16rpx 8rpx 16rpx 12rpx;
  color: var(--c-danger, #b96f78);
  flex-shrink: 0;
  font-size: 21rpx;
}
