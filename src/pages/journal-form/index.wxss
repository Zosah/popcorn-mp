.journal-form-page { padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); }
.journal-form-head { padding: 8rpx 6rpx 28rpx; }
.journal-form-head__meta { color: #a2aacb; font-size: 18rpx; font-weight: 750; }
.journal-form-head__title { margin-top: 12rpx; color: #18255f; font-size: 48rpx; font-weight: 850; line-height: 1.3; }
.journal-form-head__copy { margin-top: 12rpx; color: #929bc0; font-size: 22rpx; line-height: 1.6; }
.journal-form-card { padding: 8rpx 26rpx; }
.journal-field { padding: 26rpx 0; border-bottom: 1rpx solid #eef0f7; }
.journal-field--last { border-bottom: 0; }
.journal-field > text { color: #59658e; font-size: 22rpx; font-weight: 750; }
.journal-field input { height: 66rpx; margin-top: 10rpx; color: #202d64; font-size: 29rpx; }
.journal-field textarea { width: 100%; height: 230rpx; box-sizing: border-box; margin-top: 16rpx; padding: 20rpx; border-radius: 26rpx; background: #f5f6fb; color: #28356b; font-size: 25rpx; line-height: 1.6; }
.visibility-title { margin: 38rpx 6rpx 16rpx; color: #1e2b63; font-size: 28rpx; font-weight: 800; }
.visibility-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.visibility-card { padding: 24rpx; border: 3rpx solid transparent; border-radius: 30rpx; background: #fff; }
.visibility-card--active { border-color: #7898ed; background: #eef2ff; }
.visibility-card text { display: block; color: #26336a; font-size: 23rpx; font-weight: 750; }
.visibility-card text + text { margin-top: 7rpx; color: #99a2c3; font-size: 18rpx; font-weight: 500; }
.journal-save { width: 100%; margin-top: 34rpx; }
