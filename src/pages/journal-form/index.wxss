.journal-form-page {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.journal-form-head {
  padding: 8rpx 0 32rpx;
}

.journal-form-head__title {
  max-width: 620rpx;
  color: var(--c-text, #22242e);
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: -2rpx;
}

.journal-form-head__copy {
  max-width: 610rpx;
  margin-top: 12rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 24rpx;
  line-height: 1.65;
}

.journal-form-page .card {
  border: 0;
  border-radius: 0;
  background: transparent;
}

.journal-form-card {
  padding: 0;
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.journal-field {
  padding: 25rpx 0;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.journal-field--last {
  border-bottom: 0;
}

.journal-field > text {
  color: var(--c-muted, #9497a6);
  font-size: 22rpx;
  font-weight: 400;
}

.journal-field input {
  height: 70rpx;
  margin-top: 5rpx;
  color: var(--c-text, #22242e);
  font-size: 31rpx;
  font-weight: 500;
}

.journal-field input::placeholder {
  color: #a8abba;
  font-weight: 400;
}

.journal-category-picker {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  color: var(--c-text, #22242e);
  font-size: 26rpx;
}

.journal-field textarea {
  width: 100%;
  height: 238rpx;
  box-sizing: border-box;
  margin-top: 12rpx;
  padding: 16rpx 0 16rpx 18rpx;
  border: 0;
  border-left: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-radius: 0;
  background: transparent;
  color: var(--c-text, #22242e);
  font-size: 25rpx;
  line-height: 1.7;
}

.visibility-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.visibility-card {
  position: relative;
  padding: 22rpx 20rpx 22rpx 24rpx;
  border: 1rpx solid var(--c-line, #e7e6ee);
  border-radius: 2rpx;
  background: transparent;
  transition: border-color 160ms ease, background-color 160ms ease;
}

.visibility-card--active {
  border-color: var(--c-text, #22242e);
  background: rgba(34, 36, 46, 0.025);
}

.visibility-card--active::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: -1rpx;
  width: 3rpx;
  background: var(--c-text, #22242e);
  content: "";
}

.visibility-card__title {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.visibility-card__title text {
  color: var(--c-text, #22242e);
  font-size: 25rpx;
  font-weight: 500;
}

.visibility-card__copy {
  display: block;
  margin-top: 6rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
  font-weight: 400;
}

.visibility-card--active .visibility-card__copy {
  color: var(--c-text-2, #5c5f6e);
}

.journal-save {
  width: 100%;
  margin-top: 36rpx;
  gap: 10rpx;
}
