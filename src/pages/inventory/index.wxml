<view class="tab-page inventory-page">
  <view class="inv-head">
    <view class="inv-head__main">
      <view class="eyebrow">HOME PANTRY</view>
      <view class="inv-head__title">家里还有什么</view>
      <view class="inv-head__meta">{{spaceName}} · 把每一样都照顾好</view>
    </view>
    <view class="inv-add" bindtap="onAddItem">
      <line-icon name="plus" size="23" tone="white" />
      <text>添加</text>
    </view>
  </view>

  <view class="inv-summary glass-card">
    <view class="inv-summary__glow inv-summary__glow--mint"></view>
    <view class="inv-summary__glow inv-summary__glow--peach"></view>
    <view class="inv-summary__top">
      <view>
        <view class="inv-summary__eyebrow">家里今天</view>
        <view class="inv-summary__headline">
          <text>{{summary.total}}</text>
          <text>件在库</text>
        </view>
      </view>
      <view class="inv-summary__copy">
        <text>{{summary.expired ? '先照顾快过期的东西' : '家里的节奏刚刚好'}}</text>
        <sync-badge state="{{syncState}}" text="{{syncText}}" />
      </view>
    </view>

    <view class="stats">
      <view class="stat stat--danger" data-value="expired" bindtap="onSelectExpiry">
        <text class="stat__value">{{summary.expired}}</text>
        <text class="stat__label">已过期</text>
      </view>
      <view class="stat stat--warm" data-value="due" bindtap="onSelectExpiry">
        <text class="stat__value">{{summary.dueWithin3Days}}</text>
        <text class="stat__label">三天内</text>
      </view>
      <view class="stat stat--mint" data-value="normal" bindtap="onSelectExpiry">
        <text class="stat__value">{{summary.normal}}</text>
        <text class="stat__label">还安心</text>
      </view>
      <view class="stat stat--violet" data-value="all" bindtap="onSelectExpiry">
        <text class="stat__value">{{summary.total}}</text>
        <text class="stat__label">全部</text>
      </view>
    </view>
  </view>

  <view class="inv-controls glass-card">
    <view class="tabs">
      <view class="tab {{viewMode === 'active' ? 'tab--active' : ''}}" data-value="active" bindtap="onSwitchView">正在库存</view>
      <view class="tab {{viewMode === 'history' ? 'tab--active' : ''}}" data-value="history" bindtap="onSwitchView">历史记录</view>
    </view>

    <view class="search">
      <view class="search__icon"><line-icon name="search" size="27" tone="muted" /></view>
      <input class="search__input" value="{{query}}" placeholder="找找家里的东西" placeholder-class="search__placeholder" bindinput="onSearchInput" />
      <text wx:if="{{query}}" class="search__clear" bindtap="onClearSearch">清除</text>
    </view>

    <scroll-view wx:if="{{viewMode === 'active'}}" class="chips" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="chips__row">
        <view class="chip {{selectedExpiry === 'all' ? 'chip--active' : ''}}" data-value="all" bindtap="onSelectExpiry">全部</view>
        <view class="chip {{selectedExpiry === 'expired' ? 'chip--active' : ''}}" data-value="expired" bindtap="onSelectExpiry">已过期</view>
        <view class="chip {{selectedExpiry === 'due' ? 'chip--active' : ''}}" data-value="due" bindtap="onSelectExpiry">三天内</view>
        <view class="chip {{selectedExpiry === 'soon' ? 'chip--active' : ''}}" data-value="soon" bindtap="onSelectExpiry">七天内</view>
        <view class="chip {{selectedExpiry === 'none' ? 'chip--active' : ''}}" data-value="none" bindtap="onSelectExpiry">无有效期</view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{loading}}" class="state glass-card">正在翻家里的清单…</view>

  <view wx:elif="{{errorMessage}}" class="empty empty--error glass-card">
    <view class="empty__icon empty__icon--error"><line-icon name="circle-alert" size="40" tone="accent" /></view>
    <view class="empty__title">库存暂时没连上</view>
    <view class="empty__copy">{{errorMessage}}</view>
    <view class="empty__action" bindtap="onRetry">
      <line-icon name="rotate-ccw" size="21" tone="white" />
      <text>重新加载</text>
    </view>
  </view>

  <block wx:elif="{{hasResults}}">
    <view wx:for="{{sections}}" wx:key="key" class="group">
      <view class="group__head">
        <view>
          <text class="group__title">{{item.title}}</text>
          <text class="group__count">{{item.items.length}} 件</text>
        </view>
        <text class="group__hint">{{item.hint}}</text>
      </view>
      <view class="group__list glass-card">
        <inventory-card wx:for="{{item.items}}" wx:for-item="inventoryItem" wx:key="id" item="{{inventoryItem}}" bind:cardtap="onOpenItem" />
      </view>
    </view>
  </block>

  <view wx:else class="empty glass-card">
    <view class="empty__icon"><line-icon name="package" size="40" tone="accent" /></view>
    <view class="empty__title">{{viewMode === 'history' ? '还没有历史记录' : '这里没有找到东西'}}</view>
    <view class="empty__copy">{{viewMode === 'history' ? '用完、丢弃或归档的物品会出现在这里。' : '换个条件，或者把家里第一件物品记下来。'}}</view>
    <view wx:if="{{viewMode === 'active'}}" class="empty__action" bindtap="onAddItem">
      <line-icon name="plus" size="22" tone="white" />
      <text>添加物品</text>
    </view>
  </view>
</view>
