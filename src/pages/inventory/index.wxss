.inventory-page {
  padding-top: 28rpx;
}

.inv-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 0 4rpx 22rpx;
}

.inv-head__main {
  min-width: 0;
  flex: 1;
}

.inv-head__title {
  margin-top: 4rpx;
  color: var(--c-text, #292737);
  font-size: 45rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  line-height: 1.25;
}

.inv-head__meta {
  margin-top: 7rpx;
  color: var(--c-text-2, #615f70);
  font-size: 20rpx;
}

.inv-add {
  display: flex;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  margin-top: 7rpx;
  margin-left: 18rpx;
  padding: 0 23rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #8c7cf0, #6d63db 68%, #68accd);
  box-shadow: 0 12rpx 28rpx rgba(105, 91, 211, 0.22);
  color: #fff;
  gap: 7rpx;
  font-size: 21rpx;
  font-weight: 600;
  white-space: nowrap;
}

.inv-summary {
  padding: 28rpx 24rpx 22rpx;
  border-radius: 40rpx;
  background: linear-gradient(140deg, rgba(255, 255, 255, 0.86), rgba(230, 246, 239, 0.65) 56%, rgba(251, 234, 235, 0.68));
}

.inv-summary__glow {
  position: absolute;
  border-radius: 50%;
}

.inv-summary__glow--mint {
  top: -120rpx;
  right: -20rpx;
  width: 290rpx;
  height: 290rpx;
  background: radial-gradient(circle, rgba(174, 234, 212, 0.72), rgba(174, 234, 212, 0));
}

.inv-summary__glow--peach {
  bottom: -130rpx;
  left: -80rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(248, 200, 209, 0.54), rgba(248, 200, 209, 0));
}

.inv-summary__top,
.stats {
  position: relative;
  z-index: 1;
}

.inv-summary__top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.inv-summary__eyebrow {
  color: var(--c-muted, #9592a4);
  font-size: 17rpx;
}

.inv-summary__headline {
  display: flex;
  align-items: baseline;
  margin-top: 2rpx;
}

.inv-summary__headline text:first-child {
  color: var(--c-primary-deep, #665bd7);
  font-size: 62rpx;
  font-weight: 600;
  letter-spacing: -3rpx;
  line-height: 1;
}

.inv-summary__headline text:last-child {
  margin-left: 11rpx;
  color: var(--c-text, #292737);
  font-size: 23rpx;
  font-weight: 600;
}

.inv-summary__copy {
  display: flex;
  align-items: flex-end;
  padding-bottom: 3rpx;
  flex-direction: column;
  gap: 3rpx;
}

.inv-summary__copy > text {
  color: var(--c-text-2, #615f70);
  font-size: 17rpx;
}

.stats {
  display: grid;
  margin-top: 21rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(106, 98, 139, 0.10);
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.stat {
  display: flex;
  min-height: 91rpx;
  align-items: flex-start;
  justify-content: center;
  padding-top: 11rpx;
  box-sizing: border-box;
  border-radius: 21rpx;
  flex-direction: column;
}

.stat + .stat {
  padding-left: 17rpx;
  border-left: 1rpx solid rgba(106, 98, 139, 0.09);
}

.stat__value {
  color: var(--c-text, #292737);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1;
}

.stat--danger .stat__value {
  color: var(--c-danger, #df6f7d);
}

.stat--warm .stat__value {
  color: var(--c-warning, #d99c3f);
}

.stat--mint .stat__value {
  color: var(--c-success, #4ba98d);
}

.stat--violet .stat__value {
  color: var(--c-primary-deep, #665bd7);
}

.stat__label {
  margin-top: 8rpx;
  color: var(--c-muted, #9592a4);
  font-size: 17rpx;
}

.inv-controls {
  margin-top: 18rpx;
  padding: 14rpx;
  border-radius: 34rpx;
}

.tabs {
  display: flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.44);
}

.tab {
  display: flex;
  height: 59rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: var(--c-muted, #9592a4);
  flex: 1;
  font-size: 21rpx;
  font-weight: 500;
}

.tab--active {
  background: rgba(255, 255, 255, 0.90);
  box-shadow: 0 7rpx 20rpx rgba(92, 77, 132, 0.08);
  color: var(--c-text, #292737);
  font-weight: 600;
}

.tab--active::after {
  display: none;
}

.search {
  display: flex;
  height: 76rpx;
  align-items: center;
  margin-top: 11rpx;
  padding: 0 17rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 23rpx;
  background: rgba(255, 255, 255, 0.54);
}

.search__icon {
  display: flex;
  width: 27rpx;
  height: 27rpx;
  margin-right: 13rpx;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search__input {
  min-width: 0;
  flex: 1;
  color: var(--c-text, #292737);
  font-size: 22rpx;
}

.search__placeholder {
  color: var(--c-muted, #9592a4);
}

.search__clear {
  padding-left: 14rpx;
  color: var(--c-primary-deep, #665bd7);
  font-size: 18rpx;
}

.chips {
  margin-top: 11rpx;
  white-space: nowrap;
}

.chips__row {
  display: inline-flex;
  gap: 9rpx;
}

.chip {
  padding: 9rpx 15rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.42);
  color: var(--c-muted, #9592a4);
  font-size: 18rpx;
}

.chip--active {
  border-color: rgba(117, 105, 232, 0.20);
  background: rgba(238, 234, 255, 0.86);
  color: var(--c-primary-deep, #665bd7);
  font-weight: 600;
}

.state {
  margin-top: 20rpx;
  padding: 54rpx 0;
  border-radius: 30rpx;
  color: var(--c-muted, #9592a4);
  font-size: 21rpx;
  text-align: center;
}

.group {
  margin-top: 25rpx;
}

.group__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 5rpx 10rpx;
}

.group__head > view {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.group__title {
  color: var(--c-text, #292737);
  font-size: 25rpx;
  font-weight: 600;
}

.group__count,
.group__hint {
  color: var(--c-muted, #9592a4);
  font-size: 17rpx;
}

.group__list {
  padding: 2rpx 20rpx;
  border-radius: 32rpx;
}

.empty {
  display: flex;
  margin-top: 20rpx;
  padding: 45rpx 24rpx 38rpx;
  align-items: center;
  border-radius: 34rpx;
  flex-direction: column;
  text-align: center;
}

.empty__icon {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #eeeaff, #e5f7ef);
}

.empty__title {
  margin-top: 17rpx;
  color: var(--c-text, #292737);
  font-size: 26rpx;
  font-weight: 600;
}

.empty__copy {
  max-width: 480rpx;
  margin-top: 7rpx;
  color: var(--c-muted, #9592a4);
  font-size: 19rpx;
  line-height: 1.6;
}

.empty__action {
  display: inline-flex;
  height: 66rpx;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #8c7cf0, #6d63db);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}
