.inv-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 26rpx;
}

.inv-head__main {
  min-width: 0;
  flex: 1;
}

.inv-head__title {
  color: var(--c-text, #22242e);
  font-size: 48rpx;
  font-weight: 500;
  letter-spacing: -2rpx;
  line-height: 1.25;
}

.inv-head__meta {
  margin-top: 10rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 24rpx;
}

.inv-add {
  display: flex;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
  margin-left: 20rpx;
  padding: 0 26rpx;
  border: 1rpx solid var(--c-text, #22242e);
  border-radius: 999rpx;
  color: var(--c-text, #22242e);
  gap: 7rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

.tabs {
  display: flex;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.tab {
  position: relative;
  padding: 0 0 20rpx;
  color: var(--c-muted, #9497a6);
  font-size: 24rpx;
}

.tab + .tab {
  margin-left: 48rpx;
}

.tab--active {
  color: var(--c-text, #22242e);
  font-weight: 500;
}

.tab--active::after {
  position: absolute;
  right: 0;
  bottom: -1rpx;
  left: 0;
  height: 1rpx;
  background: var(--c-text, #22242e);
  content: "";
}

.stats {
  display: flex;
  margin-top: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.stat {
  display: flex;
  align-items: center;
  flex: 1;
  flex-direction: column;
}

.stat + .stat {
  border-left: 1rpx solid var(--c-line, #e7e6ee);
}

.stat__value {
  color: var(--c-text, #22242e);
  font-family: "Songti SC", "STSong", serif;
  font-size: 50rpx;
  font-weight: 500;
  line-height: 1;
}

.stat__value--danger {
  color: var(--c-danger, #e8695c);
}

.stat__label {
  margin-top: 10rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.search {
  display: flex;
  height: 80rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--c-line-strong, #d6d5e0);
}

.search__icon {
  display: flex;
  width: 30rpx;
  height: 30rpx;
  margin-right: 18rpx;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search__input {
  min-width: 0;
  flex: 1;
  color: var(--c-text, #22242e);
  font-size: 24rpx;
}

.search__placeholder {
  color: var(--c-muted, #9497a6);
}

.search__clear {
  padding-left: 16rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 21rpx;
}

.chips {
  margin-top: 22rpx;
  white-space: nowrap;
}

.chips__row {
  display: inline-flex;
}

.chip {
  position: relative;
  margin-right: 40rpx;
  padding-bottom: 8rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.chip--active {
  color: var(--c-text, #22242e);
  font-weight: 500;
}

.chip--active::before {
  position: absolute;
  top: 10rpx;
  left: -14rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--c-accent, #5b6ee0);
  content: "";
}

.state {
  padding: 96rpx 0;
  color: var(--c-muted, #9497a6);
  font-size: 24rpx;
  text-align: center;
}

.group {
  margin-top: 28rpx;
}

.group__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 14rpx 0 10rpx;
}

.group__title {
  color: var(--c-text, #22242e);
  font-size: 25rpx;
  font-weight: 500;
}

.group__count {
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.group__list {
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.empty {
  padding: 72rpx 24rpx 100rpx;
  text-align: center;
}

.empty__illustration {
  display: block;
  width: 260rpx;
  height: 190rpx;
  margin: 0 auto 20rpx;
  opacity: 0.82;
}

.empty__title {
  color: var(--c-text, #22242e);
  font-size: 30rpx;
  font-weight: 500;
}

.empty__copy {
  margin-top: 12rpx;
  color: var(--c-muted, #9497a6);
  font-size: 23rpx;
  line-height: 1.6;
}

.empty__action {
  display: inline-flex;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  margin-top: 28rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: var(--c-text, #22242e);
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
}
