.inventory-page {
  --inv-paper: var(--c-paper, #f8f7f4);
  --inv-ink: var(--c-text, #252b27);
  --inv-ink-2: var(--c-text-2, #5f5a53);
  --inv-ink-3: var(--c-muted, #837f76);
  --inv-line: var(--c-line, #e9e6e1);
  --inv-deep: var(--c-primary, #252b27);
  --inv-orange: #9a7250;
  --inv-gold: var(--c-warning, #a18448);
  --inv-red: var(--c-primary-link, #b86757);
  padding: 34rpx 36rpx calc(176rpx + env(safe-area-inset-bottom));
  background: var(--inv-paper);
  color: var(--inv-ink);
}

.inv-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 2rpx 26rpx;
}

.inv-top__title {
  font-family: var(--font-serif);
  font-size: 45rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.inv-top__sub {
  margin-top: 8rpx;
  color: var(--inv-ink-3);
  font-size: 26rpx;
}

.inv-add {
  display: flex;
  height: 64rpx;
  align-items: center;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--inv-deep);
  color: #fff;
  gap: 7rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.inv-stats {
  display: flex;
  overflow: hidden;
  padding: 24rpx 8rpx 21rpx;
  border: 1rpx solid var(--inv-line);
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(42, 62, 50, 0.04);
}

.inv-stat {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  flex-direction: column;
  gap: 5rpx;
}

.inv-stat + .inv-stat::before {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 0;
  width: 1rpx;
  background: var(--inv-line);
  content: "";
}

.inv-stat__value {
  font-family: "Helvetica Neue", Arial, sans-serif;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.1;
}

.inv-stat__label {
  color: var(--inv-ink-2);
  font-size: 25rpx;
}

.inv-stat--danger .inv-stat__value { color: var(--inv-red); }
.inv-stat--warm .inv-stat__value { color: var(--inv-gold); }
.inv-stat--muted .inv-stat__value { color: var(--c-sage, #668478); }
.inv-stat--ink .inv-stat__value { color: var(--inv-deep); }

.inv-view-tabs {
  display: flex;
  margin: 26rpx 0 0;
  border-bottom: 1rpx solid var(--inv-line);
  gap: 38rpx;
}

.inv-view-tab {
  position: relative;
  padding: 15rpx 0 17rpx;
  color: var(--inv-ink-3);
  font-size: 28rpx;
  font-weight: 500;
}

.inv-view-tab--active {
  color: var(--inv-ink);
  font-weight: 700;
}

.inv-view-tab--active::after {
  position: absolute;
  right: 0;
  bottom: -1rpx;
  left: 0;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--inv-deep);
  content: "";
}

.inv-search {
  display: flex;
  height: 76rpx;
  align-items: center;
  margin-top: 24rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--inv-line);
  border-radius: 999rpx;
  background: #ffffff;
  gap: 13rpx;
  transition: box-shadow 160ms ease;
}

.inv-search--focused {
  box-shadow: 0 0 0 3rpx rgba(45, 74, 58, 0.10);
}

.inv-search__input {
  min-width: 0;
  height: 76rpx;
  color: var(--inv-ink);
  flex: 1;
  font-size: 29rpx;
}

.inv-search__placeholder {
  color: var(--inv-ink-3);
}

.inv-search__clear {
  color: var(--inv-deep);
  font-size: 25rpx;
  font-weight: 600;
}

.inv-chips {
  width: calc(100% + 72rpx);
  margin: 20rpx -36rpx 0;
  white-space: nowrap;
}

.inv-chips__row {
  display: inline-flex;
  padding: 0 36rpx 5rpx;
  gap: 12rpx;
}

.inv-chip {
  display: flex;
  height: 58rpx;
  align-items: center;
  padding: 0 22rpx;
  border: 1rpx solid var(--inv-line);
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--inv-ink-2);
  font-size: 25rpx;
  white-space: nowrap;
}

.inv-chip--active {
  border-color: var(--inv-deep);
  background: var(--inv-deep);
  color: #fff;
  font-weight: 600;
}

.inv-group {
  margin-top: 32rpx;
}

.inv-group__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 4rpx 13rpx;
}

.inv-group__title-wrap {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.inv-group__title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.inv-group__title--expired { color: var(--inv-red); }
.inv-group__title--due { color: var(--inv-gold); }
.inv-group__title--normal { color: var(--c-sage, #668478); }
.inv-group__title--consumed,
.inv-group__title--discarded,
.inv-group__title--archived { color: var(--inv-ink-2); }

.inv-group__count,
.inv-group__hint {
  color: var(--inv-ink-3);
  font-size: 24rpx;
}

.inv-group__list {
  overflow: hidden;
  padding: 0 22rpx;
  border: 1rpx solid var(--inv-line);
  border-radius: 30rpx;
  background: #ffffff;
}

.inv-state {
  display: flex;
  min-height: 360rpx;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  padding: 42rpx 30rpx;
  border: 1rpx solid var(--inv-line);
  border-radius: 30rpx;
  background: #ffffff;
  flex-direction: column;
  text-align: center;
}

.inv-state__icon {
  display: flex;
  width: 86rpx;
  height: 86rpx;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
}

.inv-state__icon--orange { background: var(--c-coral-soft, #f7e7e2); }
.inv-state__icon--red { background: var(--c-coral-soft, #f7e7e2); }

.inv-state__title {
  margin-top: 18rpx;
  font-size: 31rpx;
  font-weight: 700;
}

.inv-state__copy {
  max-width: 500rpx;
  margin-top: 8rpx;
  color: var(--inv-ink-3);
  font-size: 25rpx;
  line-height: 1.7;
}

.inv-state__action {
  display: flex;
  height: 62rpx;
  align-items: center;
  margin-top: 22rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--inv-deep);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.inv-banner {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: var(--c-coral-soft, #f7e7e2);
  gap: 12rpx;
}

.inv-banner__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 2rpx;
}

.inv-banner__body text:first-child {
  font-size: 25rpx;
  font-weight: 700;
}

.inv-banner__body text:last-child {
  color: var(--inv-ink-2);
  font-size: 22rpx;
}

.inv-banner__action {
  color: var(--inv-red);
  font-size: 24rpx;
  font-weight: 700;
}
