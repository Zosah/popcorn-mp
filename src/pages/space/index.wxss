.space-page {
  --space-paper: #fdfbf7;
  --space-surface: #fffefa;
  --space-ink: #2e2a28;
  --space-ink-2: #6b635c;
  --space-ink-3: #a69e96;
  --space-line: #ebe5da;
  --space-deep: #2c4a52;
  --space-blue: #5b8fb9;
  --space-green: #6f9f7d;
  --space-orange: #d98a45;
  --space-pink: #d87592;
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 36rpx calc(88rpx + env(safe-area-inset-bottom));
  background: var(--space-paper);
  color: var(--space-ink);
}

.space-hero {
  padding: 38rpx 28rpx 26rpx;
  border: 1rpx solid var(--space-line);
  border-radius: 40rpx;
  background: var(--space-surface);
  box-shadow: 0 14rpx 38rpx rgba(82, 65, 48, 0.05);
  text-align: center;
}

.space-hero__icon {
  display: flex;
  width: 105rpx;
  height: 105rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  border-radius: 32rpx;
  background: #eaf1f7;
}

.space-hero__title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
}

.space-hero__title {
  min-width: 0;
  overflow: hidden;
  max-width: 460rpx;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.space-hero__edit {
  padding: 8rpx 17rpx;
  border-radius: 999rpx;
  background: #f6f1e9;
  color: var(--space-ink-2);
  flex-shrink: 0;
  font-size: 19rpx;
  font-weight: 600;
}

.space-hero__copy {
  max-width: 570rpx;
  margin: 8rpx auto 0;
  color: var(--space-ink-3);
  font-size: 21rpx;
  line-height: 1.65;
}

.space-stats {
  display: grid;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--space-line);
  grid-template-columns: 1fr 1fr 1fr;
}

.space-stat {
  display: flex;
  min-width: 0;
  align-items: center;
  flex-direction: column;
  justify-content: center;
}

.space-stat + .space-stat {
  border-left: 1rpx solid var(--space-line);
}

.space-stat__value {
  font-family: "Helvetica Neue", Arial, sans-serif;
  font-size: 39rpx;
  font-weight: 800;
  letter-spacing: -1.5rpx;
  line-height: 1.15;
}

.space-stat__value--deep { color: var(--space-deep); }
.space-stat__value--green { color: var(--space-green); font-size: 31rpx; letter-spacing: -0.5rpx; }
.space-stat__value--orange { color: var(--space-orange); }

.space-stat__label {
  margin-top: 6rpx;
  color: var(--space-ink-3);
  font-size: 19rpx;
}

.space-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 38rpx 3rpx 14rpx;
}

.space-section-head--spaced {
  margin-top: 40rpx;
}

.space-section-head__label {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.space-section-head__label text {
  color: var(--space-ink);
  font-size: 29rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.space-section-head > text {
  color: var(--space-ink-3);
  font-size: 19rpx;
}

.member-list {
  overflow: hidden;
  padding: 2rpx 20rpx;
  border: 1rpx solid var(--space-line);
  border-radius: 30rpx;
  background: var(--space-surface);
  box-shadow: 0 10rpx 28rpx rgba(82, 65, 48, 0.035);
}

.member-row {
  display: flex;
  min-height: 104rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--space-line);
  gap: 15rpx;
}

.member-row:last-child {
  border-bottom: 0;
}

.member-row__avatar {
  width: 66rpx;
  height: 66rpx;
  border: 3rpx solid var(--space-surface);
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 0 2rpx #f1ebe3;
}

.member-row__body {
  min-width: 0;
  flex: 1;
}

.member-row__name-line {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.member-row__name-line > text:first-child {
  overflow: hidden;
  font-size: 25rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-row__role {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  font-size: 15rpx;
  font-weight: 650;
}

.member-row__role--owner {
  background: #eaf1f7;
  color: #4b7fa7;
}

.member-row__role--member {
  background: #fcedf0;
  color: var(--space-pink);
}

.member-row__meta {
  display: block;
  overflow: hidden;
  margin-top: 4rpx;
  color: var(--space-ink-3);
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-row__arrow {
  color: #ccc3ba;
  flex-shrink: 0;
  font-size: 33rpx;
  font-weight: 300;
}

.invite-sheet {
  padding: 25rpx 24rpx 22rpx;
  border: 1rpx solid #f6dce2;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #fdf1f4, #fcedf0);
  box-shadow: 0 12rpx 30rpx rgba(216, 117, 146, 0.06);
}

.invite-sheet__label {
  color: var(--space-pink);
  font-size: 19rpx;
  font-weight: 650;
  letter-spacing: 0.5rpx;
}

.invite-sheet__code {
  overflow: hidden;
  margin-top: 9rpx;
  color: var(--space-deep);
  font-family: Georgia, "Songti SC", serif;
  font-size: 49rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.invite-sheet__copy {
  margin-top: 10rpx;
  color: var(--space-ink-2);
  font-size: 20rpx;
  line-height: 1.7;
}

.invite-sheet__actions {
  display: grid;
  margin-top: 20rpx;
  gap: 12rpx;
  grid-template-columns: 0.78fr 1.22fr;
}

.invite-sheet__actions--single {
  grid-template-columns: 1fr;
}

.invite-sheet__actions button {
  display: flex;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1;
}

.invite-sheet__copy-button {
  border: 1rpx solid rgba(44, 74, 82, 0.08);
  background: rgba(255, 254, 250, 0.92);
  color: var(--space-ink);
}

.invite-sheet__share-button,
.invite-sheet__actions .primary-button {
  border: 0;
  background: var(--space-deep);
  color: #fffefa;
  box-shadow: 0 9rpx 20rpx rgba(44, 74, 82, 0.15);
}

.invite-sheet__links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  color: var(--space-ink-2);
  font-size: 19rpx;
}

.invite-sheet__links text {
  border-bottom: 1rpx solid rgba(107, 99, 92, 0.45);
  line-height: 1.7;
}

.privacy-note {
  display: flex;
  align-items: flex-start;
  margin-top: 22rpx;
  padding: 19rpx 20rpx;
  border: 1rpx solid var(--space-line);
  border-radius: 28rpx;
  background: rgba(255, 254, 250, 0.72);
  gap: 14rpx;
}

.privacy-note__mark {
  display: flex;
  width: 46rpx;
  height: 46rpx;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  background: #f6f1e9;
  flex-shrink: 0;
}

.privacy-note__body {
  min-width: 0;
  flex: 1;
}

.privacy-note__body text {
  display: block;
  color: var(--space-ink);
  font-size: 22rpx;
  font-weight: 650;
}

.privacy-note__body text + text {
  margin-top: 5rpx;
  color: var(--space-ink-3);
  font-size: 19rpx;
  font-weight: 400;
  line-height: 1.7;
}
