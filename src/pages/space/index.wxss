.space-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 48rpx calc(90rpx + env(safe-area-inset-bottom));
}

.space-head {
  padding: 8rpx 0 32rpx;
}

.space-head__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.space-head__title {
  min-width: 0;
  overflow: hidden;
  color: var(--c-text, #22242e);
  font-size: 48rpx;
  font-weight: 500;
  letter-spacing: -2rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.space-head__edit {
  padding: 8rpx 22rpx;
  border: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-radius: 999rpx;
  color: var(--c-text, #22242e);
  flex-shrink: 0;
  font-size: 21rpx;
}

.space-head__copy {
  max-width: 620rpx;
  margin-top: 12rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 24rpx;
  line-height: 1.65;
}

.space-page .card {
  border: 0;
  border-radius: 0;
  background: transparent;
}

.space-stats {
  display: grid;
  grid-template-columns: 1fr 1.3fr 1fr;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.space-stats view {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  flex-direction: column;
  justify-content: center;
}

.space-stats view + view {
  border-left: 1rpx solid var(--c-line, #e7e6ee);
}

.space-stats text:first-child {
  color: var(--c-text, #22242e);
  font-family: "Songti SC", "STSong", serif;
  font-size: 40rpx;
  font-weight: 400;
  line-height: 1.1;
}

.space-stats text:last-child {
  margin-top: 6rpx;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
}

.space-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 44rpx;
  padding: 0 0 14rpx;
}

.space-section-head--spaced {
  margin-top: 48rpx;
}

.space-section-head__label {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.space-section-head__label text {
  color: var(--c-text, #22242e);
  font-size: 27rpx;
  font-weight: 500;
}

.space-section-head > text {
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.member-list {
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.member-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.member-row:last-child {
  border-bottom: 0;
}

.member-row__initial {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-radius: 50%;
  color: var(--c-text-2, #5c5f6e);
  flex-shrink: 0;
  font-family: "Songti SC", "STSong", serif;
  font-size: 23rpx;
}

.member-row__initial--owner {
  color: var(--c-accent, #5b6ee0);
}

.member-row__initial--lavender {
  background: linear-gradient(145deg, #e7e2ff, #c9c1fb);
}

.member-row__initial--mint {
  background: linear-gradient(145deg, #dcf5ed, #b8e7d9);
}

.member-row__initial--peach {
  background: linear-gradient(145deg, #ffe5e5, #f6c7cf);
}

.member-row__initial--sun {
  background: linear-gradient(145deg, #fff0ce, #f5d89a);
}

.member-row__body {
  min-width: 0;
  flex: 1;
}

.member-row__body text {
  display: block;
  color: var(--c-text, #22242e);
  font-size: 25rpx;
  font-weight: 500;
}

.member-row__body text + text {
  margin-top: 5rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
  font-weight: 400;
}

.member-row__role {
  color: var(--c-muted, #9497a6);
  flex-shrink: 0;
  font-size: 20rpx;
}

.invite-sheet {
  padding: 28rpx 0 30rpx;
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.invite-sheet__label {
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.invite-sheet__code {
  margin-top: 8rpx;
  color: var(--c-accent, #5b6ee0);
  font-family: "Songti SC", "STSong", serif;
  font-size: 52rpx;
  font-weight: 400;
  letter-spacing: 7rpx;
  line-height: 1.25;
}

.invite-sheet__copy {
  max-width: 610rpx;
  margin-top: 10rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 22rpx;
  line-height: 1.6;
}

.invite-sheet__actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 24rpx;
}

.invite-sheet__actions--single {
  grid-template-columns: 1fr;
}

.invite-sheet__actions button {
  width: 100%;
  min-height: 78rpx;
  font-size: 23rpx;
}

.invite-sheet__preview {
  display: inline-block;
  margin-top: 24rpx;
  border-bottom: 1rpx solid var(--c-text, #22242e);
  color: var(--c-text, #22242e);
  font-size: 22rpx;
  line-height: 1.8;
}

.invite-sheet__refresh {
  display: inline-block;
  margin-top: 16rpx;
  margin-left: 28rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.privacy-note {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 28rpx;
  padding: 4rpx 0 4rpx 18rpx;
  border-left: 1rpx solid var(--c-line-strong, #d6d5e0);
}

.privacy-note__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-radius: 50%;
  color: var(--c-text-2, #5c5f6e);
  flex-shrink: 0;
}

.privacy-note view:last-child {
  flex: 1;
}

.privacy-note text {
  display: block;
  color: var(--c-text, #22242e);
  font-size: 23rpx;
  font-weight: 500;
}

.privacy-note text + text {
  margin-top: 6rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
  font-weight: 400;
  line-height: 1.6;
}
