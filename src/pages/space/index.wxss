/* 共同空间：把“关系”放在视觉中心，头像、成员与邀请都保持安静克制。 */
.space-page {
  --space-paper: var(--c-paper, #f8f7f4);
  --space-surface: rgba(255, 255, 255, 0.88);
  --space-ink: var(--c-text, #252b27);
  --space-ink-2: var(--c-text-2, #5f5a53);
  --space-ink-3: var(--c-muted, #837f76);
  --space-line: var(--c-line, #e9e6e1);
  --space-deep: var(--c-primary, #252b27);
  --space-sage: var(--c-sage, #668478);
  --space-coral: var(--c-primary-link, #b86757);
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  padding: 28rpx 34rpx calc(82rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 92% 2%, rgba(245, 219, 208, 0.82), transparent 27%),
    radial-gradient(circle at 2% 44%, rgba(220, 235, 228, 0.72), transparent 25%),
    linear-gradient(180deg, #fbfaf7 0%, var(--space-paper) 46%, #f5f2ec 100%);
  color: var(--space-ink);
}

.space-hero {
  position: relative;
  overflow: hidden;
  padding: 38rpx 30rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 44rpx;
  background: linear-gradient(155deg, rgba(255, 255, 255, 0.94), rgba(247, 240, 232, 0.82));
  box-shadow:
    0 24rpx 54rpx -34rpx rgba(78, 62, 49, 0.34),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
  text-align: center;
}

.space-hero__glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(2rpx);
  pointer-events: none;
}

.space-hero__glow--one {
  top: -84rpx;
  right: -40rpx;
  width: 220rpx;
  height: 220rpx;
  background: rgba(238, 192, 177, 0.26);
}

.space-hero__glow--two {
  bottom: -92rpx;
  left: -48rpx;
  width: 210rpx;
  height: 210rpx;
  background: rgba(177, 206, 191, 0.25);
}

.space-avatar {
  position: relative;
  z-index: 1;
  width: 136rpx;
  height: 136rpx;
  margin: 0 auto 22rpx;
  border: 7rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 42rpx;
  background: linear-gradient(145deg, #f2e9df, #e3eee8);
  box-shadow:
    0 16rpx 32rpx -18rpx rgba(74, 58, 46, 0.45),
    0 0 0 1rpx rgba(122, 105, 91, 0.08);
  box-sizing: border-box;
  transition: transform 120ms ease, opacity 120ms ease;
}

.space-avatar--pressed {
  transform: scale(0.97);
}

.space-avatar--uploading {
  opacity: 0.78;
}

.space-avatar__image,
.space-avatar__fallback {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 34rpx;
}

.space-avatar__image {
  display: block;
}

.space-avatar__fallback {
  background:
    radial-gradient(circle at 72% 26%, rgba(255, 255, 255, 0.94), transparent 27%),
    linear-gradient(145deg, #edf4f0, #f4ede5);
}

.space-avatar__action {
  position: absolute;
  right: -9rpx;
  bottom: -9rpx;
  display: flex;
  width: 46rpx;
  height: 46rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fbf9f5;
  border-radius: 50%;
  background: var(--space-deep);
  box-sizing: border-box;
  box-shadow: 0 7rpx 14rpx rgba(37, 43, 39, 0.2);
}

.space-avatar__spinner {
  width: 19rpx;
  height: 19rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: space-avatar-spin 720ms linear infinite;
}

.space-hero__title-row {
  position: relative;
  z-index: 1;
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
  gap: 13rpx;
}

.space-hero__title {
  overflow: hidden;
  max-width: 470rpx;
  color: var(--space-ink);
  font-family: var(--font-serif, "Songti SC", serif);
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1.2rpx;
  line-height: 1.32;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.space-hero__edit {
  padding: 8rpx 17rpx;
  border: 1rpx solid rgba(97, 82, 69, 0.08);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: var(--space-ink-2);
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 600;
  transition: opacity 120ms ease;
}

.space-hero__edit--pressed {
  opacity: 0.56;
}

.space-role-pill {
  position: relative;
  z-index: 1;
  display: inline-flex;
  min-height: 43rpx;
  align-items: center;
  margin-top: 12rpx;
  padding: 0 17rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 650;
  letter-spacing: 0.6rpx;
}

.space-role-pill--owner {
  background: rgba(102, 132, 120, 0.13);
  color: var(--space-sage);
}

.space-role-pill--member {
  background: rgba(184, 103, 87, 0.11);
  color: var(--space-coral);
}

.space-hero__copy {
  position: relative;
  z-index: 1;
  display: block;
  max-width: 560rpx;
  margin: 10rpx auto 0;
  color: var(--space-ink-3);
  font-size: 25rpx;
  line-height: 1.65;
}

.space-facts {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: stretch;
  margin-top: 27rpx;
  padding-top: 23rpx;
  border-top: 1rpx solid rgba(116, 102, 89, 0.1);
}

.space-fact {
  display: flex;
  min-width: 0;
  align-items: center;
  flex: 1;
  flex-direction: column;
}

.space-fact__value {
  color: var(--space-deep);
  font-family: "Helvetica Neue", Arial, sans-serif;
  font-size: 35rpx;
  font-weight: 750;
  letter-spacing: -0.8rpx;
  line-height: 1.18;
}

.space-fact__label {
  margin-top: 5rpx;
  color: var(--space-ink-3);
  font-size: 22rpx;
  line-height: 1.35;
}

.space-facts__divider {
  width: 1rpx;
  background: rgba(116, 102, 89, 0.12);
}

.login-hint {
  display: flex;
  min-height: 116rpx;
  align-items: center;
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(225, 218, 208, 0.86);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.76);
  gap: 15rpx;
}

.login-hint__mark {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: rgba(102, 132, 120, 0.12);
  flex-shrink: 0;
}

.login-hint__body {
  min-width: 0;
  flex: 1;
}

.login-hint__body text {
  display: block;
  font-size: 28rpx;
  font-weight: 650;
}

.login-hint__body text + text {
  margin-top: 5rpx;
  color: var(--space-ink-3);
  font-size: 23rpx;
  font-weight: 400;
  line-height: 1.55;
}

.login-hint__arrow {
  color: #b8afa5;
  font-size: 40rpx;
  font-weight: 300;
}

.space-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 38rpx 3rpx 14rpx;
}

.space-section-head--spaced {
  margin-top: 42rpx;
}

.space-section-head__label {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.space-section-head__label text {
  color: var(--space-ink);
  font-size: 33rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.space-section-head > text {
  color: var(--space-ink-3);
  font-size: 23rpx;
}

.space-section-head__action {
  display: inline-flex;
  min-height: 54rpx;
  align-items: center;
  padding: 0 16rpx;
  border: 1rpx solid rgba(225, 218, 208, 0.9);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: var(--space-coral);
  gap: 5rpx;
  font-size: 22rpx;
  font-weight: 650;
  transition: transform 120ms ease, opacity 120ms ease;
}

.space-section-head__action--pressed {
  opacity: 0.62;
  transform: scale(0.97);
}

.space-switch-list {
  overflow: hidden;
  padding: 2rpx 18rpx;
  border: 1rpx solid rgba(225, 218, 208, 0.9);
  border-radius: 32rpx;
  background: var(--space-surface);
  box-shadow: 0 12rpx 30rpx -25rpx rgba(56, 44, 34, 0.24);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.space-switch-row {
  display: flex;
  min-height: 116rpx;
  align-items: center;
  border-bottom: 1rpx solid rgba(225, 218, 208, 0.76);
  gap: 14rpx;
}

.space-switch-row:last-child {
  border-bottom: 0;
}

.space-switch-row--active {
  margin: 7rpx -12rpx;
  padding: 0 12rpx;
  border-bottom: 0;
  border-radius: 25rpx;
  background: linear-gradient(105deg, rgba(226, 238, 233, 0.76), rgba(247, 237, 229, 0.68));
}

.space-switch-row__mark {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.78);
  flex-shrink: 0;
  box-shadow: 0 6rpx 14rpx -10rpx rgba(56, 44, 34, 0.35);
}

.space-switch-row__body {
  min-width: 0;
  flex: 1;
}

.space-switch-row__name-line {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 8rpx;
}

.space-switch-row__name {
  overflow: hidden;
  max-width: 280rpx;
  color: var(--space-ink);
  font-size: 29rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.space-switch-row__role {
  padding: 3rpx 9rpx;
  border-radius: 999rpx;
  background: rgba(184, 103, 87, 0.09);
  color: var(--space-coral);
  flex-shrink: 0;
  font-size: 19rpx;
  font-weight: 650;
}

.space-switch-row__meta {
  display: block;
  overflow: hidden;
  margin-top: 6rpx;
  color: var(--space-ink-3);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.space-switch-row__current {
  padding: 10rpx 13rpx;
  border-radius: 999rpx;
  background: rgba(102, 132, 120, 0.13);
  color: var(--space-sage);
  flex-shrink: 0;
  font-size: 21rpx;
  font-weight: 650;
}

.space-switch-row__switch {
  display: flex;
  min-width: 106rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: var(--space-deep);
  box-sizing: border-box;
  color: #ffffff;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 650;
  transition: opacity 120ms ease, transform 120ms ease;
}

.space-switch-row__switch--pressed {
  opacity: 0.7;
  transform: scale(0.97);
}

.space-switch-row__spinner {
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.34);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: space-avatar-spin 720ms linear infinite;
}

.member-list {
  overflow: hidden;
  padding: 2rpx 21rpx;
  border: 1rpx solid rgba(225, 218, 208, 0.9);
  border-radius: 32rpx;
  background: var(--space-surface);
  box-shadow: 0 12rpx 30rpx -25rpx rgba(56, 44, 34, 0.24);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.member-row {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  border-bottom: 1rpx solid rgba(225, 218, 208, 0.76);
  gap: 16rpx;
}

.member-row:last-child {
  border-bottom: 0;
}

.member-row__avatar {
  width: 68rpx;
  height: 68rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 0 2rpx rgba(225, 218, 208, 0.82);
}

.member-row__body {
  min-width: 0;
  flex: 1;
}

.member-row__name-line {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.member-row__name {
  overflow: hidden;
  max-width: 320rpx;
  font-size: 29rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-row__role {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  font-size: 19rpx;
  font-weight: 650;
}

.member-row__role--owner {
  background: rgba(102, 132, 120, 0.13);
  color: var(--space-sage);
}

.member-row__role--member {
  background: rgba(184, 103, 87, 0.11);
  color: var(--space-coral);
}

.member-row__meta {
  display: block;
  overflow: hidden;
  margin-top: 5rpx;
  color: var(--space-ink-3);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-row__remove {
  padding: 13rpx 17rpx;
  border-radius: 999rpx;
  color: var(--space-coral);
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 600;
  transition: background 120ms ease, opacity 120ms ease;
}

.member-row__remove--pressed {
  background: rgba(184, 103, 87, 0.08);
  opacity: 0.68;
}

.invite-card {
  position: relative;
  overflow: hidden;
  padding: 26rpx 25rpx 23rpx;
  border: 1rpx solid rgba(244, 213, 220, 0.92);
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 92% 3%, rgba(255, 255, 255, 0.72), transparent 32%),
    linear-gradient(145deg, #fdf4f5, #f6e7e4);
  box-shadow: 0 15rpx 34rpx -27rpx rgba(168, 86, 78, 0.34);
}

.invite-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.invite-card__label {
  color: var(--space-coral);
  font-size: 23rpx;
  font-weight: 650;
  letter-spacing: 0.5rpx;
}

.invite-card__expiry {
  color: rgba(95, 90, 83, 0.66);
  font-size: 21rpx;
}

.invite-card__code {
  overflow: hidden;
  margin-top: 10rpx;
  color: var(--space-deep);
  font-family: Georgia, "Songti SC", serif;
  font-size: 45rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.invite-card__copy {
  display: block;
  margin-top: 8rpx;
  color: var(--space-ink-2);
  font-size: 24rpx;
  line-height: 1.65;
}

.invite-card__actions {
  display: grid;
  margin-top: 20rpx;
  gap: 12rpx;
  grid-template-columns: 0.78fr 1.22fr;
}

.invite-card__actions--single {
  grid-template-columns: 1fr;
}

.invite-card__actions button {
  display: flex;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1;
}

.invite-card__secondary {
  border: 1rpx solid rgba(45, 74, 58, 0.08);
  background: rgba(255, 255, 255, 0.9);
  color: var(--space-ink);
}

.invite-card__primary {
  border: 0;
  background: var(--space-deep);
  color: #ffffff;
  box-shadow: 0 9rpx 20rpx rgba(45, 74, 58, 0.15);
}

.invite-card__links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  color: var(--space-ink-2);
  font-size: 23rpx;
}

.invite-card__links text {
  border-bottom: 1rpx solid rgba(107, 99, 92, 0.34);
  line-height: 1.7;
}

.leave-panel {
  display: flex;
  align-items: center;
  margin-top: 36rpx;
  padding: 21rpx 20rpx;
  border: 1rpx solid rgba(225, 218, 208, 0.88);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.7);
  gap: 14rpx;
}

.leave-panel__mark {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: rgba(184, 103, 87, 0.09);
  flex-shrink: 0;
}

.leave-panel__body {
  min-width: 0;
  flex: 1;
}

.leave-panel__title {
  display: block;
  color: var(--space-ink);
  font-size: 26rpx;
  font-weight: 650;
}

.leave-panel__copy {
  display: block;
  margin-top: 4rpx;
  color: var(--space-ink-3);
  font-size: 22rpx;
  line-height: 1.5;
}

.leave-panel__button {
  display: flex;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid rgba(184, 103, 87, 0.17);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  color: var(--space-coral);
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1;
}

.leave-panel__button[disabled] {
  opacity: 0.56;
}

@keyframes space-avatar-spin {
  to { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
  .space-avatar,
  .space-avatar__spinner,
  .space-hero__edit,
  .space-section-head__action,
  .space-switch-row__switch,
  .member-row__remove {
    animation: none;
    transition: none;
  }
}
