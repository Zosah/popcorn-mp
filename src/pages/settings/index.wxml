<view class="settings-page">
  <view class="settings-head">
    <text class="settings-head__title">设置</text>
    <text class="settings-head__description">账号、空间与常用功能</text>
  </view>

  <view class="settings-hero">
    <view class="settings-hero__icon">
      <line-icon name="system-settings" size="38" tone="ink" />
    </view>
    <view class="settings-hero__copy">
      <text class="settings-hero__title">让时刻见更适合你们</text>
      <text class="settings-hero__description">账号、空间和常用入口都在这里。</text>
    </view>
  </view>

  <view class="settings-card">
    <view class="settings-row" hover-class="settings-row--pressed" bindtap="onOpenProfile">
      <view class="settings-row__icon settings-row__icon--blue">
        <line-icon name="system-user" size="30" tone="blue" />
      </view>
      <view class="settings-row__body">
        <text class="settings-row__title">账号与管理</text>
        <text class="settings-row__description">{{isLoggedIn ? (displayName || '昵称、头像与登录状态') : '登录后同步你的记录'}}</text>
      </view>
      <text class="settings-row__arrow">›</text>
    </view>

    <view class="settings-row" hover-class="settings-row--pressed" bindtap="onOpenSpace">
      <view class="settings-row__icon settings-row__icon--green">
        <line-icon name="system-space" size="30" tone="green" />
      </view>
      <view class="settings-row__body">
        <text class="settings-row__title">共同空间</text>
        <text class="settings-row__description">{{isLoggedIn ? spaceName : '创建、加入或切换空间'}}</text>
      </view>
      <text class="settings-row__arrow">›</text>
    </view>

    <view class="settings-row" hover-class="settings-row--pressed" bindtap="onOpenPrivacy">
      <view class="settings-row__icon settings-row__icon--blue">
        <line-icon name="system-lock" size="30" tone="blue" />
      </view>
      <view class="settings-row__body">
        <text class="settings-row__title">隐私与数据</text>
        <text class="settings-row__description">我们收集什么、存在哪、怎么删</text>
      </view>
      <text class="settings-row__arrow">›</text>
    </view>

    <view class="settings-row" hover-class="settings-row--pressed" bindtap="onOpenFeatureSettings">
      <view class="settings-row__icon settings-row__icon--gold">
        <line-icon name="todo-status-pending" size="30" tone="gold" />
      </view>
      <view class="settings-row__body">
        <text class="settings-row__title">功能配置</text>
        <text class="settings-row__description">底部导航三个入口</text>
      </view>
      <text class="settings-row__arrow">›</text>
    </view>
  </view>

  <text class="settings-footer">时刻见 {{versionLabel}}</text>
</view>
