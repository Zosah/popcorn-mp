<view class="settings-page">
  <view class="settings-head">
    <text class="settings-head__title">设置</text>
    <text class="settings-head__copy">管理账号、共同空间和使用偏好。</text>
  </view>

  <view class="settings-section">
    <text class="settings-section__label">账号与空间</text>
    <view class="settings-card">
      <view class="settings-row" hover-class="settings-row--pressed" bindtap="onOpenProfile">
        <view class="settings-row__icon">
          <line-icon name="user-round" size="30" tone="muted" />
        </view>
        <view class="settings-row__body">
          <text class="settings-row__title">个人资料</text>
          <text class="settings-row__description">{{isLoggedIn ? (displayName || '完善头像和昵称') : '登录后同步你的记录'}}</text>
        </view>
        <text class="settings-row__arrow">›</text>
      </view>

      <view class="settings-row" hover-class="settings-row--pressed" bindtap="onOpenSpace">
        <view class="settings-row__icon">
          <line-icon name="house" size="30" tone="muted" />
        </view>
        <view class="settings-row__body">
          <text class="settings-row__title">共同空间</text>
          <text class="settings-row__description">{{isLoggedIn ? spaceName : '切换、加入或创建空间'}}</text>
        </view>
        <text class="settings-row__arrow">›</text>
      </view>
    </view>
  </view>

  <view class="settings-section">
    <text class="settings-section__label">使用偏好</text>
    <view class="settings-card">
      <view class="settings-row" hover-class="settings-row--pressed" bindtap="onOpenFeatureSettings">
        <view class="settings-row__icon">
          <line-icon name="list-todo" size="30" tone="muted" />
        </view>
        <view class="settings-row__body">
          <text class="settings-row__title">功能配置</text>
          <text class="settings-row__description">设置首页快捷和底部导航</text>
        </view>
        <text class="settings-row__arrow">›</text>
      </view>

      <view class="settings-row" hover-class="settings-row--pressed" bindtap="onOpenReminders">
        <view class="settings-row__icon">
          <line-icon name="bell" size="30" tone="muted" />
        </view>
        <view class="settings-row__body">
          <text class="settings-row__title">提醒设置</text>
          <text class="settings-row__description">管理通知与订阅偏好</text>
        </view>
        <text class="settings-row__arrow">›</text>
      </view>
    </view>
  </view>
</view>
