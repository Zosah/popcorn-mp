.settings-page {
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  overflow: hidden;
  padding: 34rpx 30rpx calc(54rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 102% -1%, rgba(247, 219, 207, 0.55), transparent 27%),
    radial-gradient(circle at -10% 70%, rgba(222, 235, 226, 0.4), transparent 24%),
    linear-gradient(180deg, #fff9f3 0%, #f8f4ee 100%);
  box-sizing: border-box;
  color: var(--c-text);
}

.settings-head {
  display: flex;
  min-height: 118rpx;
  padding: 2rpx 6rpx 22rpx;
  box-sizing: border-box;
  flex-direction: column;
}

.settings-head__title {
  font-family: var(--font-serif);
  font-size: 62rpx;
  font-weight: 760;
  letter-spacing: -1.8rpx;
  line-height: 1.18;
}

.settings-head__description {
  margin-top: 5rpx;
  color: var(--c-muted);
  font-size: 23rpx;
  line-height: 1.45;
}

.settings-hero {
  display: flex;
  min-height: 156rpx;
  align-items: center;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 38rpx;
  background:
    radial-gradient(circle at 100% 0, rgba(221, 235, 226, 0.68), transparent 35%),
    linear-gradient(125deg, #f6e4d9, #f7eee3 54%, #e6efe8);
  box-shadow:
    0 24rpx 52rpx -46rpx rgba(80, 64, 51, 0.44),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
  box-sizing: border-box;
  gap: 20rpx;
}

.settings-hero__icon {
  display: flex;
  width: 90rpx;
  height: 90rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.62);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  flex: 0 0 auto;
  transform: rotate(-3deg);
}

.settings-hero__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.settings-hero__title {
  color: #2c2d29;
  font-family: var(--font-serif);
  font-size: 34rpx;
  font-weight: 760;
  line-height: 1.3;
}

.settings-hero__description {
  overflow: hidden;
  margin-top: 7rpx;
  color: #746b63;
  font-size: 22rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.settings-card {
  overflow: hidden;
  margin-top: 22rpx;
  padding: 0 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow:
    0 24rpx 58rpx -50rpx rgba(78, 63, 50, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.settings-row {
  display: flex;
  min-height: 132rpx;
  align-items: center;
  border-bottom: 1rpx solid rgba(221, 214, 205, 0.66);
  gap: 18rpx;
  transition: opacity 120ms ease;
}

.settings-row:last-child {
  border-bottom: 0;
}

.settings-row--pressed {
  opacity: 0.54;
}

.settings-row__icon {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 24rpx;
  flex: 0 0 auto;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.94),
    0 10rpx 20rpx -18rpx rgba(79, 67, 55, 0.38);
}

.settings-row__icon--blue { background: #dce9e5; }
.settings-row__icon--green { background: #efdfd7; }
.settings-row__icon--gold { background: #f1e4c6; }

.settings-row__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 5rpx;
}

.settings-row__title {
  color: var(--c-text);
  font-size: 30rpx;
  font-weight: 720;
  line-height: 1.35;
}

.settings-row__description {
  overflow: hidden;
  color: var(--c-muted);
  font-size: 22rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.settings-row__arrow {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(239, 234, 228, 0.7);
  color: #aaa198;
  flex: 0 0 auto;
  font-size: 28rpx;
  font-weight: 300;
  line-height: 1;
}

.settings-footer {
  display: block;
  margin-top: 32rpx;
  color: #b1a89f;
  font-size: 20rpx;
  line-height: 1.4;
  text-align: center;
}

@media (prefers-reduced-motion: reduce) {
  .settings-row {
    transition: none;
  }
}
