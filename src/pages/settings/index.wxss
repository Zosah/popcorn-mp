.settings-page {
  position: relative;
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  overflow: hidden;
  padding: 36rpx 34rpx calc(64rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 100% 0, rgba(242, 217, 204, 0.46), transparent 28%),
    linear-gradient(180deg, #fffaf5 0%, #f5f1eb 100%);
  box-sizing: border-box;
  color: var(--c-text);
}

.settings-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.settings-glow--top {
  width: 310rpx;
  height: 310rpx;
  border: 1rpx solid rgba(120, 139, 126, 0.12);
  right: -154rpx;
  top: 70rpx;
}

.settings-glow--bottom {
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(242, 225, 194, 0.36), transparent 68%);
  left: -130rpx;
  bottom: 8%;
}

.settings-head {
  position: relative;
  z-index: 1;
  display: flex;
  min-height: 142rpx;
  align-items: center;
  padding: 4rpx 5rpx 38rpx;
  gap: 24rpx;
}

.settings-head__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.settings-head__title {
  font-family: var(--font-serif);
  font-size: 58rpx;
  font-weight: 760;
  letter-spacing: -1.8rpx;
  line-height: 1.24;
}

.settings-head__description {
  max-width: 470rpx;
  margin-top: 12rpx;
  color: var(--c-muted);
  font-size: 24rpx;
  line-height: 1.58;
}

.settings-head__seal {
  position: relative;
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(196, 185, 172, 0.6);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.64);
  box-shadow:
    0 20rpx 38rpx -34rpx rgba(80, 65, 53, 0.6),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  flex: 0 0 auto;
  transform: rotate(5deg);
}

.settings-head__seal::before {
  position: absolute;
  border: 1rpx solid rgba(102, 132, 120, 0.2);
  border-radius: 36rpx;
  content: "";
  inset: 8rpx;
}

.settings-head__seal-inner {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-5deg);
}

.settings-head__seal-dot {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid #fffaf5;
  border-radius: 50%;
  background: var(--c-coral);
  right: -3rpx;
  top: -3rpx;
}

.settings-section + .settings-section {
  margin-top: 34rpx;
}

.settings-section__head {
  display: flex;
  align-items: center;
  padding: 0 8rpx 12rpx;
  gap: 14rpx;
}

.settings-section__label {
  color: var(--c-faint);
  font-size: 21rpx;
  font-weight: 650;
  letter-spacing: 1.2rpx;
  line-height: 1.4;
}

.settings-section__rule {
  height: 1rpx;
  background: linear-gradient(90deg, rgba(210, 201, 190, 0.7), transparent);
  flex: 1;
}

.settings-card {
  position: relative;
  z-index: 1;
  overflow: hidden;
  padding: 0 22rpx;
  border: 1rpx solid rgba(225, 218, 208, 0.9);
  border-radius: 32rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.72));
  box-shadow:
    0 22rpx 50rpx -44rpx rgba(88, 70, 57, 0.42),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.settings-row {
  display: flex;
  min-height: 120rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--c-line);
  gap: 17rpx;
  transition: opacity 120ms ease;
}

.settings-row:last-child {
  border-bottom: 0;
}

.settings-row--pressed {
  opacity: 0.56;
}

.settings-row__icon {
  position: relative;
  display: flex;
  width: 66rpx;
  height: 66rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 21rpx;
  flex: 0 0 auto;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82),
    0 8rpx 16rpx -14rpx rgba(79, 67, 55, 0.4);
}

.settings-row__icon::after {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border: 3rpx solid rgba(255, 250, 245, 0.95);
  border-radius: 50%;
  content: "";
  right: 4rpx;
  top: 4rpx;
}

.settings-row__icon--blue {
  background: linear-gradient(145deg, #e8eded, #dce6e3);
}

.settings-row__icon--blue::after {
  background: #7d9891;
}

.settings-row__icon--green {
  background: linear-gradient(145deg, #e5efe7, #d8e8dd);
}

.settings-row__icon--green::after {
  background: #78947f;
}

.settings-row__icon--gold {
  background: linear-gradient(145deg, #f5edd9, #eee1bf);
}

.settings-row__icon--gold::after {
  background: #b39355;
}

.settings-row__icon--pink {
  background: linear-gradient(145deg, #f1e9ed, #e9dfe6);
}

.settings-row__icon--pink::after {
  background: #a77c91;
}

.settings-row__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 2rpx;
}

.settings-row__title {
  color: var(--c-text);
  font-size: 30rpx;
  font-weight: 680;
  line-height: 1.4;
}

.settings-row__description {
  overflow: hidden;
  color: var(--c-muted);
  font-size: 23rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.settings-row__arrow {
  color: #beb7ae;
  flex: 0 0 auto;
  font-size: 40rpx;
  font-weight: 300;
}

@media (prefers-reduced-motion: reduce) {
  .settings-row {
    transition: none;
  }
}
