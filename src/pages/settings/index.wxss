.settings-page {
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  overflow: hidden;
  padding: 34rpx 30rpx calc(64rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 102% -1%, rgba(245, 218, 208, 0.5), transparent 27%),
    radial-gradient(circle at -10% 70%, rgba(224, 235, 226, 0.34), transparent 24%),
    linear-gradient(180deg, #fffaf5 0%, #f6f2ec 100%);
  box-sizing: border-box;
  color: var(--c-text);
}

.settings-head {
  display: flex;
  min-height: 126rpx;
  align-items: center;
  padding: 2rpx 5rpx 24rpx;
  gap: 20rpx;
}

.settings-head__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.settings-head__title {
  font-family: var(--font-serif);
  font-size: 54rpx;
  font-weight: 760;
  letter-spacing: -1.5rpx;
  line-height: 1.22;
}

.settings-head__description {
  margin-top: 7rpx;
  color: var(--c-muted);
  font-size: 23rpx;
  line-height: 1.5;
}

.settings-head__mark {
  display: flex;
  width: 82rpx;
  height: 82rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.64);
  box-shadow:
    0 18rpx 36rpx -32rpx rgba(80, 65, 53, 0.55),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  flex: 0 0 auto;
  transform: rotate(3deg);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.settings-card {
  overflow: hidden;
  padding: 0 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 100% 0, rgba(244, 228, 217, 0.38), transparent 35%),
    rgba(255, 255, 255, 0.72);
  box-shadow:
    0 25rpx 58rpx -50rpx rgba(78, 63, 50, 0.46),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.settings-row {
  display: flex;
  min-height: 118rpx;
  align-items: center;
  border-bottom: 1rpx solid rgba(219, 212, 202, 0.62);
  gap: 16rpx;
  transition: opacity 120ms ease;
}

.settings-row:last-child {
  border-bottom: 0;
}

.settings-row--pressed {
  opacity: 0.56;
}

.settings-row__icon {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 21rpx;
  flex: 0 0 auto;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9),
    0 8rpx 18rpx -16rpx rgba(79, 67, 55, 0.42);
}

.settings-row__icon--blue { background: linear-gradient(145deg, #e8eded, #dce6e3); }
.settings-row__icon--green { background: linear-gradient(145deg, #e5efe7, #d8e8dd); }
.settings-row__icon--gold { background: linear-gradient(145deg, #f5edd9, #eee1bf); }

.settings-row__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 3rpx;
}

.settings-row__title {
  color: var(--c-text);
  font-size: 29rpx;
  font-weight: 690;
  line-height: 1.4;
}

.settings-row__description {
  overflow: hidden;
  color: var(--c-muted);
  font-size: 22rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.settings-row__arrow {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(242, 237, 230, 0.82);
  color: #b1a89f;
  flex: 0 0 auto;
  font-size: 27rpx;
  font-weight: 300;
  line-height: 1;
}

@media (prefers-reduced-motion: reduce) {
  .settings-row {
    transition: none;
  }
}
