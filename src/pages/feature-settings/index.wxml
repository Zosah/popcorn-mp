<page-meta page-style="overflow: hidden; height: 100%;" />

<view class="feature-settings-page {{dragActive ? 'feature-settings-page--dragging' : ''}}">
  <page-loading show="{{initialLoading}}" title="正在整理功能" copy="把常用功能放到顺手的位置。" />

  <view class="config-head">
    <view class="config-head__back" hover-class="config-head__back--pressed" aria-role="button" aria-label="返回" bindtap="onBack">
      <text class="config-head__back-icon">‹</text>
    </view>
    <view class="config-head__copy">
      <text class="config-head__title">功能配置</text>
      <text class="config-head__description">长按拖动，松开换位</text>
    </view>
    <view class="config-head__reset" hover-class="config-head__reset--pressed" bindtap="onResetDefault">
      <line-icon name="rotate-ccw" size="18" tone="muted" />
      <text>恢复</text>
    </view>
  </view>

  <view wx:if="{{saveError}}" class="config-error">
    <line-icon name="circle-alert" size="22" tone="danger" />
    <text class="config-error__copy">{{saveError}}</text>
    <text wx:if="{{versionConflict}}" class="config-error__action" bindtap="onReloadSettings">载入最新</text>
  </view>

  <view class="config-guide">
    <view class="config-guide__icon">
      <line-icon name="list-todo" size="27" tone="green" />
    </view>
    <view class="config-guide__copy">
      <text class="config-guide__title">首页 4 格，底部导航 3 格</text>
      <text class="config-guide__description">每个功能只能占一个位置</text>
    </view>
    <text class="config-guide__count">{{featureCount}} / 7</text>
  </view>

  <view class="feature-pool">
    <view class="section-heading">
      <view class="section-heading__copy">
        <text class="section-heading__title">全部功能</text>
        <text class="section-heading__description">长按拖到下方</text>
      </view>
      <text class="section-heading__meta">已用 {{featureCount}} / 8</text>
    </view>

    <view class="feature-category-grid">
      <view wx:for="{{featureGroups}}" wx:key="key" class="feature-category feature-category--{{item.category.tone}}">
        <text class="feature-category__title">{{item.category.title}}</text>
        <view class="feature-category__items">
          <view
            wx:for="{{item.items}}"
            wx:for-item="feature"
            wx:key="id"
            class="feature-tile {{feature.occupied ? 'feature-tile--occupied' : ''}}"
            hover-class="{{feature.occupied ? 'none' : 'feature-tile--pressed'}}"
            data-source="pool"
            data-id="{{feature.id}}"
            aria-role="button"
            aria-disabled="{{feature.occupied}}"
            aria-label="{{feature.occupied ? feature.shortLabel + '已用于' + feature.placementLabel : '拖动' + feature.shortLabel}}"
            bindtap="onFeatureTap"
            catchtouchstart="onDragTouchStart"
            catchtouchmove="onDragTouchMove"
            catchtouchend="onDragTouchEnd"
            catchtouchcancel="onDragTouchCancel"
          >
            <view class="feature-tile__icon feature-tile__icon--{{feature.tone}}">
              <line-icon name="{{feature.icon}}" size="24" tone="{{feature.tone}}" />
            </view>
            <text class="feature-tile__label">{{feature.shortLabel}}</text>
            <text wx:if="{{feature.occupied}}" class="feature-tile__placement">{{feature.placementLabel}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="placement placement--home">
    <view class="section-heading">
      <view class="section-heading__copy">
        <text class="section-heading__title">首页快捷</text>
        <text class="section-heading__description">长按可调整顺序</text>
      </view>
      <text class="section-heading__meta">4 格</text>
    </view>

    <view class="home-drop-grid">
      <view
        wx:for="{{homeSlots}}"
        wx:key="id"
        class="drop-slot drop-slot--home {{dropRegion === 'home' && dropIndex === index ? (dropBlocked ? 'drop-slot--blocked' : 'drop-slot--active') : ''}}"
        data-source="slot"
        data-id="{{item.id}}"
        data-region="home"
        data-index="{{index}}"
        aria-role="button"
        aria-label="首页第{{item.order}}个位置，{{item.shortLabel}}"
        bindtap="onSlotTap"
        catchtouchstart="onDragTouchStart"
        catchtouchmove="onDragTouchMove"
        catchtouchend="onDragTouchEnd"
        catchtouchcancel="onDragTouchCancel"
      >
        <text class="drop-slot__order">{{item.order}}</text>
        <view class="drop-slot__icon feature-tile__icon--{{item.tone}}">
          <line-icon name="{{item.icon}}" size="28" tone="{{item.tone}}" />
        </view>
        <text class="drop-slot__title">{{item.shortLabel}}</text>
      </view>
    </view>
  </view>

  <view class="placement placement--tab">
    <view class="section-heading">
      <view class="section-heading__copy">
        <text class="section-heading__title">底部导航</text>
        <text class="section-heading__description">家与「我的」固定</text>
      </view>
      <text class="section-heading__meta">3 格</text>
    </view>

    <view class="tab-drop-preview">
      <view class="tab-fixed-item">
        <line-icon name="house" size="23" tone="muted" />
        <text>家</text>
      </view>

      <view
        wx:for="{{tabSlots}}"
        wx:key="id"
        class="drop-slot drop-slot--tab {{dropRegion === 'tab' && dropIndex === index ? (dropBlocked ? 'drop-slot--blocked' : 'drop-slot--active') : ''}}"
        data-source="slot"
        data-id="{{item.id}}"
        data-region="tab"
        data-index="{{index}}"
        aria-role="button"
        aria-label="导航第{{item.order}}个位置，{{item.shortLabel}}"
        bindtap="onSlotTap"
        catchtouchstart="onDragTouchStart"
        catchtouchmove="onDragTouchMove"
        catchtouchend="onDragTouchEnd"
        catchtouchcancel="onDragTouchCancel"
      >
        <line-icon name="{{item.icon}}" size="24" tone="{{item.tone}}" />
        <text class="drop-slot__tab-label">{{item.shortLabel}}</text>
      </view>

      <view class="tab-fixed-item">
        <line-icon name="user-round" size="23" tone="muted" />
        <text>我的</text>
      </view>
    </view>
  </view>

  <view class="save-dock">
    <text class="save-dock__status">{{dirty ? '有未保存修改' : syncText}}</text>
    <button
      class="save-dock__button {{dirty ? 'save-dock__button--ready' : ''}}"
      hover-class="save-dock__button--pressed"
      disabled="{{saving || !dirty}}"
      loading="{{saving}}"
      bindtap="onSave"
    >保存配置</button>
  </view>

  <view
    wx:if="{{dragActive}}"
    class="drag-ghost drag-ghost--{{dragTone}}"
    style="left: {{dragX}}px; top: {{dragY}}px;"
  >
    <line-icon name="{{dragIcon}}" size="26" tone="{{dragTone}}" />
    <text>{{dragLabel}}</text>
  </view>
</view>
