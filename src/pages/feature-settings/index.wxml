<page-meta page-style="{{dragActive ? 'overflow: hidden;' : ''}}" />

<view class="feature-settings-page">
  <page-loading show="{{initialLoading}}" title="正在整理功能" copy="把常用功能放到顺手的位置。" />

  <view class="config-head">
    <view class="config-head__copy">
      <text class="config-head__title">把常用功能，放到手边</text>
      <text class="config-head__description">长按上方功能，拖进首页快捷或底部导航。</text>
    </view>
    <view class="config-head__reset" hover-class="config-head__reset--pressed" bindtap="onResetDefault">
      <line-icon name="rotate-ccw" size="22" tone="muted" />
      <text>恢复默认</text>
    </view>
  </view>

  <view wx:if="{{saveError}}" class="config-error">
    <line-icon name="circle-alert" size="28" tone="danger" />
    <text class="config-error__copy">{{saveError}}</text>
    <text wx:if="{{versionConflict}}" class="config-error__action" bindtap="onReloadSettings">载入最新</text>
  </view>

  <view class="feature-pool">
    <view class="section-heading">
      <view class="section-heading__copy">
        <text class="section-heading__title">全部功能</text>
        <text class="section-heading__description">按住任意功能拖到下方</text>
      </view>
      <text class="section-heading__meta">{{features.length}} 个</text>
    </view>

    <view class="feature-grid">
      <view
        wx:for="{{features}}"
        wx:key="id"
        class="feature-tile"
        hover-class="feature-tile--pressed"
        data-source="pool"
        data-id="{{item.id}}"
        aria-role="button"
        aria-label="拖动{{item.shortLabel}}"
        bindtap="onFeatureTap"
        bindtouchstart="onDragTouchStart"
        bindtouchmove="onDragTouchMove"
        bindtouchend="onDragTouchEnd"
        bindtouchcancel="onDragTouchCancel"
      >
        <view class="feature-tile__icon feature-tile__icon--{{item.tone}}">
          <line-icon name="{{item.icon}}" size="34" tone="{{item.tone}}" />
        </view>
        <text class="feature-tile__label">{{item.shortLabel}}</text>
        <text wx:if="{{!item.tabEligible}}" class="feature-tile__limit">仅首页</text>
      </view>
    </view>
  </view>

  <view class="placement placement--home">
    <view class="section-heading">
      <view class="section-heading__copy">
        <text class="section-heading__title">首页快捷</text>
        <text class="section-heading__description">打开首页，第一眼就能用到</text>
      </view>
      <text class="section-heading__meta">4 个位置</text>
    </view>

    <view class="home-drop-grid">
      <view
        wx:for="{{homeSlots}}"
        wx:key="id"
        class="drop-slot drop-slot--home {{dropRegion === 'home' && dropIndex === index ? (dropBlocked ? 'drop-slot--blocked' : 'drop-slot--active') : ''}}"
        data-source="slot"
        data-id="{{item.id}}"
        data-region="home"
        data-index="{{index}}"
        aria-role="button"
        aria-label="首页第{{item.order}}个位置，{{item.shortLabel}}"
        bindtap="onSlotTap"
        bindtouchstart="onDragTouchStart"
        bindtouchmove="onDragTouchMove"
        bindtouchend="onDragTouchEnd"
        bindtouchcancel="onDragTouchCancel"
      >
        <text class="drop-slot__order">{{item.order}}</text>
        <view class="drop-slot__icon feature-tile__icon--{{item.tone}}">
          <line-icon name="{{item.icon}}" size="37" tone="{{item.tone}}" />
        </view>
        <view class="drop-slot__body">
          <text class="drop-slot__title">{{item.shortLabel}}</text>
          <text class="drop-slot__copy">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="placement placement--tab">
    <view class="section-heading">
      <view class="section-heading__copy">
        <text class="section-heading__title">底部导航</text>
        <text class="section-heading__description">中间三个位置，放最常去的地方</text>
      </view>
      <text class="section-heading__meta">3 个位置</text>
    </view>

    <view class="tab-drop-preview">
      <view class="tab-fixed-item">
        <line-icon name="house" size="30" tone="muted" />
        <text>家</text>
        <text class="tab-fixed-item__note">固定</text>
      </view>

      <view
        wx:for="{{tabSlots}}"
        wx:key="id"
        class="drop-slot drop-slot--tab {{dropRegion === 'tab' && dropIndex === index ? (dropBlocked ? 'drop-slot--blocked' : 'drop-slot--active') : ''}}"
        data-source="slot"
        data-id="{{item.id}}"
        data-region="tab"
        data-index="{{index}}"
        aria-role="button"
        aria-label="导航第{{item.order}}个位置，{{item.shortLabel}}"
        bindtap="onSlotTap"
        bindtouchstart="onDragTouchStart"
        bindtouchmove="onDragTouchMove"
        bindtouchend="onDragTouchEnd"
        bindtouchcancel="onDragTouchCancel"
      >
        <line-icon name="{{item.icon}}" size="31" tone="{{item.tone}}" />
        <text class="drop-slot__tab-label">{{item.shortLabel}}</text>
      </view>

      <view class="tab-fixed-item">
        <line-icon name="user-round" size="30" tone="muted" />
        <text>我的</text>
        <text class="tab-fixed-item__note">固定</text>
      </view>
    </view>
  </view>

  <view class="save-dock">
    <view class="save-dock__meta">
      <text class="save-dock__status">{{dirty ? '有未保存修改' : syncText}}</text>
      <text class="save-dock__hint">{{dirty ? '确认位置后统一保存' : '当前配置已是最新'}}</text>
    </view>
    <button
      class="save-dock__button {{dirty ? 'save-dock__button--ready' : ''}}"
      hover-class="save-dock__button--pressed"
      disabled="{{saving || !dirty}}"
      loading="{{saving}}"
      bindtap="onSave"
    >保存配置</button>
  </view>

  <view
    wx:if="{{dragActive}}"
    class="drag-ghost drag-ghost--{{dragTone}}"
    style="left: {{dragX}}px; top: {{dragY}}px;"
  >
    <line-icon name="{{dragIcon}}" size="32" tone="{{dragTone}}" />
    <text>{{dragLabel}}</text>
  </view>
</view>
