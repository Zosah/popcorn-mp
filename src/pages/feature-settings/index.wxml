<page-meta page-style="overflow: hidden; height: 100%;" />

<view class="feature-settings-page {{dragActive ? 'feature-settings-page--dragging' : ''}}">
  <page-loading show="{{initialLoading}}" title="正在整理功能" copy="把常用功能放到顺手的位置。" />

  <view class="config-head">
    <view class="config-head__back" hover-class="config-head__back--pressed" aria-role="button" aria-label="返回" bindtap="onBack">
      <text class="config-head__back-icon">‹</text>
    </view>
    <view class="config-head__copy">
      <text class="config-head__eyebrow">MAKE IT YOURS</text>
      <text class="config-head__title">功能配置</text>
      <text class="config-head__description">把常用功能放到顺手的位置</text>
    </view>
    <view class="config-head__reset" hover-class="config-head__reset--pressed" bindtap="onResetDefault">
      <line-icon name="rotate-ccw" size="16" tone="muted" />
      <text>恢复</text>
    </view>
  </view>

  <view wx:if="{{saveError}}" class="config-error">
    <line-icon name="circle-alert" size="22" tone="danger" />
    <text class="config-error__copy">{{saveError}}</text>
    <text wx:if="{{versionConflict}}" class="config-error__action" bindtap="onReloadSettings">载入最新</text>
  </view>

  <view class="config-guide">
    <view class="config-guide__icon">
      <line-icon name="settings" size="24" tone="green" />
    </view>
    <view class="config-guide__copy">
      <text class="config-guide__title">安排常用入口</text>
      <text class="config-guide__description">首页 4 格，底栏 3 格</text>
    </view>
    <view class="config-guide__progress">
      <view class="config-guide__count">
        <text class="config-guide__count-value">{{featureCount}}</text>
        <text class="config-guide__count-total">/ 7</text>
      </view>
      <view class="config-guide__track">
        <view class="config-guide__track-fill" style="width: {{featureProgress}}%;"></view>
      </view>
    </view>
  </view>

  <view class="feature-library">
    <view class="section-heading">
      <text class="section-heading__title">全部功能</text>
      <text class="section-heading__meta">长按拖动，放进下方入口</text>
    </view>

    <view class="feature-pool-grid">
      <view
        wx:for="{{featurePool}}"
        wx:for-item="feature"
        wx:key="id"
        class="feature-tile {{feature.occupied ? 'feature-tile--occupied' : ''}}"
        hover-class="{{feature.occupied ? 'none' : 'feature-tile--pressed'}}"
        data-source="pool"
        data-id="{{feature.id}}"
        aria-role="button"
        aria-disabled="{{feature.occupied}}"
        aria-label="{{feature.occupied ? feature.shortLabel + '已用于' + feature.placementLabel : '拖动' + feature.shortLabel}}"
        bindtap="onFeatureTap"
        catchtouchstart="onDragTouchStart"
        catchtouchmove="onDragTouchMove"
        catchtouchend="onDragTouchEnd"
        catchtouchcancel="onDragTouchCancel"
      >
        <view class="feature-tile__icon feature-tile__icon--{{feature.tone}}">
          <line-icon name="{{feature.icon}}" size="28" tone="{{feature.tone}}" />
        </view>
        <view class="feature-tile__copy">
          <text class="feature-tile__label">{{feature.shortLabel}}</text>
          <text class="feature-tile__category">{{feature.categoryTitle}}</text>
        </view>
        <view class="feature-tile__state {{feature.occupied ? 'feature-tile__state--placed' : ''}}">
          <text wx:if="{{feature.occupied}}" class="feature-tile__state-dot">✓</text>
          <text>{{feature.occupied ? feature.placementLabel : '待安排'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="quick-preview">
    <view class="section-heading">
      <text class="section-heading__title">当前布局</text>
      <text class="section-heading__meta">长按已选功能调整顺序</text>
    </view>

    <view class="preview-caption">
      <view class="preview-caption__title">
        <text class="preview-caption__index">01</text>
        <text class="preview-caption__label">首页快捷</text>
      </view>
      <text class="preview-caption__meta">4 个入口</text>
    </view>
    <view class="home-drop-grid">
      <view
        wx:for="{{homeSlots}}"
        wx:for-item="slotItem"
        wx:key="id"
        class="drop-slot drop-slot--home {{dropRegion === 'home' && dropIndex === index ? (dropBlocked ? 'drop-slot--blocked' : 'drop-slot--active') : ''}}"
        data-source="slot"
        data-id="{{slotItem.id}}"
        data-region="home"
        data-index="{{index}}"
        aria-role="button"
        aria-label="首页第{{slotItem.order}}个位置，{{slotItem.shortLabel}}"
        bindtap="onSlotTap"
        catchtouchstart="onDragTouchStart"
        catchtouchmove="onDragTouchMove"
        catchtouchend="onDragTouchEnd"
        catchtouchcancel="onDragTouchCancel"
      >
        <text class="drop-slot__order">{{slotItem.order}}</text>
        <view class="drop-slot__icon feature-tile__icon--{{slotItem.tone}}">
          <line-icon name="{{slotItem.icon}}" size="27" tone="{{slotItem.tone}}" />
        </view>
        <text class="drop-slot__title">{{slotItem.shortLabel}}</text>
      </view>
    </view>

    <view class="preview-caption preview-caption--tab">
      <view class="preview-caption__title">
        <text class="preview-caption__index">02</text>
        <text class="preview-caption__label">底部导航</text>
      </view>
      <text class="preview-caption__meta">家与「我的」固定</text>
    </view>
    <view class="tab-drop-preview">
      <view class="tab-fixed-item">
        <line-icon name="house" size="21" tone="muted" />
        <text>家</text>
      </view>

      <view
        wx:for="{{tabSlots}}"
        wx:for-item="slotItem"
        wx:key="id"
        class="drop-slot drop-slot--tab {{dropRegion === 'tab' && dropIndex === index ? (dropBlocked ? 'drop-slot--blocked' : 'drop-slot--active') : ''}}"
        data-source="slot"
        data-id="{{slotItem.id}}"
        data-region="tab"
        data-index="{{index}}"
        aria-role="button"
        aria-label="导航第{{slotItem.order}}个位置，{{slotItem.shortLabel}}"
        bindtap="onSlotTap"
        catchtouchstart="onDragTouchStart"
        catchtouchmove="onDragTouchMove"
        catchtouchend="onDragTouchEnd"
        catchtouchcancel="onDragTouchCancel"
      >
        <line-icon name="{{slotItem.icon}}" size="22" tone="{{slotItem.tone}}" />
        <text class="drop-slot__tab-label">{{slotItem.shortLabel}}</text>
      </view>

      <view class="tab-fixed-item">
        <line-icon name="user-round" size="21" tone="muted" />
        <text>我的</text>
      </view>
    </view>
  </view>

  <view class="save-dock">
    <view class="save-dock__inner">
      <view class="save-dock__copy">
        <text class="save-dock__status">{{dirty ? '有未保存的调整' : syncText}}</text>
        <text class="save-dock__hint">{{dirty ? '保存后同步到共同空间' : '布局会保持现在的样子'}}</text>
      </view>
      <button
        class="save-dock__button {{dirty ? 'save-dock__button--ready' : ''}}"
        hover-class="save-dock__button--pressed"
        disabled="{{saving || !dirty}}"
        loading="{{saving}}"
        bindtap="onSave"
      >{{dirty ? '保存' : '已保存'}}</button>
    </view>
  </view>

  <view
    wx:if="{{dragActive}}"
    class="drag-ghost drag-ghost--{{dragTone}}"
    style="left: {{dragX}}px; top: {{dragY}}px;"
  >
    <line-icon name="{{dragIcon}}" size="26" tone="{{dragTone}}" />
    <text>{{dragLabel}}</text>
  </view>
</view>
