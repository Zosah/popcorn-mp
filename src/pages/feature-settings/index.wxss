/*
 * 功能配置：八项功能在一屏内完成分类、占用提示与拖拽布置。
 */
.feature-settings-page {
  display: flex;
  width: 100%;
  max-width: 100%;
  height: 100vh;
  overflow: hidden;
  padding: 18rpx 24rpx calc(116rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 96% 0, rgba(244, 216, 207, 0.46), transparent 24%),
    radial-gradient(circle at 0 72%, rgba(219, 234, 224, 0.36), transparent 25%),
    linear-gradient(180deg, #fffaf5 0%, #f7f4ef 100%);
  box-sizing: border-box;
  color: var(--c-text);
  flex-direction: column;
  touch-action: none;
}

.feature-settings-page--dragging {
  user-select: none;
}

.config-head {
  display: flex;
  min-height: 68rpx;
  align-items: center;
  padding: 0 3rpx 12rpx;
  flex: 0 0 auto;
  gap: 12rpx;
}

.config-head__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.config-head__title {
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 38rpx;
  font-weight: 760;
  letter-spacing: -0.7rpx;
  line-height: 1.2;
}

.config-head__description {
  margin-top: 4rpx;
  color: var(--c-muted);
  font-size: 22rpx;
  line-height: 1.35;
}

.config-head__reset {
  display: flex;
  min-height: 48rpx;
  align-items: center;
  padding: 0 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.66);
  color: var(--c-muted);
  flex: 0 0 auto;
  gap: 5rpx;
  font-size: 20rpx;
  font-weight: 620;
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.config-head__reset--pressed {
  opacity: 0.58;
}

.config-error {
  display: flex;
  align-items: flex-start;
  margin: 0 2rpx 9rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid rgba(184, 111, 95, 0.18);
  border-radius: 17rpx;
  background: rgba(250, 235, 230, 0.94);
  flex: 0 0 auto;
  gap: 8rpx;
}

.config-error__copy {
  color: #725d55;
  flex: 1;
  font-size: 19rpx;
  line-height: 1.45;
}

.config-error__action {
  color: var(--c-primary-link);
  flex: 0 0 auto;
  font-size: 19rpx;
  font-weight: 680;
}

.feature-pool,
.placement {
  position: relative;
  padding: 12rpx 14rpx 13rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 25rpx;
  background: rgba(255, 255, 255, 0.68);
  box-shadow:
    0 18rpx 44rpx -40rpx rgba(69, 57, 47, 0.46),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
  flex: 0 0 auto;
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.placement {
  margin-top: 10rpx;
}

.placement--home {
  background:
    radial-gradient(circle at 100% 0, rgba(225, 236, 228, 0.54), transparent 36%),
    rgba(255, 255, 255, 0.68);
}

.placement--tab {
  background:
    radial-gradient(circle at 0 100%, rgba(242, 229, 210, 0.54), transparent 38%),
    rgba(255, 255, 255, 0.64);
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.section-heading__copy {
  display: flex;
  min-width: 0;
  align-items: baseline;
  flex: 1;
  gap: 8rpx;
}

.section-heading__title {
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 28rpx;
  font-weight: 740;
  line-height: 1.3;
  white-space: nowrap;
}

.section-heading__description {
  overflow: hidden;
  color: var(--c-muted);
  font-size: 20rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-heading__meta {
  color: var(--c-faint);
  flex: 0 0 auto;
  font-size: 19rpx;
  font-weight: 620;
}

.feature-category-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 12rpx;
  gap: 9rpx;
}

.feature-category {
  min-width: 0;
  padding: 10rpx 10rpx 9rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 19rpx;
  background: rgba(248, 245, 240, 0.76);
}

.feature-category--orange {
  background: linear-gradient(145deg, rgba(251, 240, 234, 0.92), rgba(248, 245, 240, 0.7));
}

.feature-category--green {
  background: linear-gradient(145deg, rgba(237, 245, 239, 0.94), rgba(248, 245, 240, 0.7));
}

.feature-category--blue {
  background: linear-gradient(145deg, rgba(239, 244, 242, 0.94), rgba(248, 245, 240, 0.7));
}

.feature-category--pink {
  background: linear-gradient(145deg, rgba(246, 239, 243, 0.94), rgba(248, 245, 240, 0.7));
}

.feature-category__title {
  display: block;
  padding: 0 2rpx 7rpx;
  color: var(--c-muted);
  font-size: 21rpx;
  font-weight: 720;
  letter-spacing: 0.5rpx;
  line-height: 1.3;
}

.feature-category__items {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.feature-tile {
  position: relative;
  display: flex;
  min-width: 0;
  height: 62rpx;
  align-items: center;
  padding: 6rpx 8rpx;
  border: 1rpx solid rgba(222, 214, 204, 0.74);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
  gap: 8rpx;
  transition: transform 120ms ease, opacity 120ms ease;
}

.feature-tile--pressed {
  opacity: 0.62;
  transform: scale(0.97);
}

.feature-tile--occupied {
  border-color: rgba(219, 213, 205, 0.42);
  background: rgba(236, 234, 229, 0.76);
  filter: grayscale(0.72);
  opacity: 0.58;
}

.feature-tile__icon,
.drop-slot__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 11rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.84);
  flex: 0 0 auto;
}

.feature-tile__icon {
  width: 40rpx;
  height: 40rpx;
}

.feature-tile__icon--blue { background: #e4ebe8; }
.feature-tile__icon--green { background: #e3eee7; }
.feature-tile__icon--gold { background: #f2e8cf; }
.feature-tile__icon--pink { background: #eee7ec; }
.feature-tile__icon--orange { background: #f3e5df; }

.feature-tile__label {
  overflow: hidden;
  min-width: 0;
  color: var(--c-text-2);
  font-size: 22rpx;
  font-weight: 690;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-tile__placement {
  position: absolute;
  padding: 0 5rpx;
  border-radius: 999rpx;
  background: rgba(228, 234, 230, 0.96);
  color: #718277;
  font-size: 15rpx;
  font-weight: 680;
  line-height: 1.5;
  right: 5rpx;
  top: 4rpx;
}

.home-drop-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 9rpx;
  gap: 7rpx;
}

.drop-slot {
  position: relative;
  border: 1rpx solid rgba(219, 211, 201, 0.86);
  background: rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
  transition:
    border-color 140ms ease,
    box-shadow 140ms ease,
    transform 140ms ease,
    background 140ms ease;
}

.drop-slot--home {
  display: flex;
  min-width: 0;
  min-height: 94rpx;
  align-items: center;
  justify-content: center;
  padding: 7rpx 4rpx 6rpx;
  border-radius: 17rpx;
  flex-direction: column;
  gap: 3rpx;
}

.drop-slot--active {
  border-color: rgba(83, 119, 95, 0.72);
  background: #f3f8f4;
  box-shadow:
    0 0 0 4rpx rgba(89, 125, 101, 0.1),
    0 12rpx 24rpx -24rpx rgba(66, 91, 75, 0.7);
  transform: translateY(-1rpx);
}

.drop-slot--blocked {
  border-color: rgba(172, 105, 88, 0.55);
  background: #fbf1ed;
  box-shadow: 0 0 0 4rpx rgba(172, 105, 88, 0.08);
}

.drop-slot__order {
  position: absolute;
  color: #bbb4aa;
  font-family: Georgia, serif;
  font-size: 12rpx;
  font-style: italic;
  right: 6rpx;
  top: 3rpx;
}

.drop-slot__icon {
  width: 44rpx;
  height: 44rpx;
}

.drop-slot__title {
  overflow: hidden;
  max-width: 100%;
  color: var(--c-text);
  font-size: 21rpx;
  font-weight: 690;
  line-height: 1.2;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-drop-preview {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  align-items: stretch;
  margin-top: 9rpx;
  padding: 6rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 21rpx;
  background: rgba(248, 245, 239, 0.9);
  box-shadow:
    0 13rpx 30rpx -30rpx rgba(59, 50, 42, 0.5),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  gap: 4rpx;
}

.tab-fixed-item,
.drop-slot--tab {
  display: flex;
  min-width: 0;
  min-height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  flex-direction: column;
  gap: 1rpx;
}

.tab-fixed-item {
  color: #aaa39a;
  font-size: 19rpx;
  font-weight: 620;
}

.drop-slot--tab {
  background: rgba(255, 255, 255, 0.95);
  color: var(--c-text-2);
  font-size: 20rpx;
  font-weight: 650;
}

.drop-slot__tab-label {
  overflow: hidden;
  max-width: 100%;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.save-dock {
  position: fixed;
  z-index: 50;
  display: flex;
  align-items: center;
  padding: 10rpx 26rpx calc(10rpx + env(safe-area-inset-bottom));
  background: rgba(251, 248, 243, 0.92);
  box-shadow: 0 -14rpx 40rpx -36rpx rgba(55, 46, 39, 0.55);
  gap: 18rpx;
  inset: auto 0 0;
  backdrop-filter: blur(28rpx);
  -webkit-backdrop-filter: blur(28rpx);
}

.save-dock__meta {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 1rpx;
}

.save-dock__status {
  color: var(--c-text-2);
  font-size: 22rpx;
  font-weight: 680;
}

.save-dock__button {
  width: 176rpx;
  height: 66rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #eadbd7;
  color: #9a837c;
  font-size: 23rpx;
  font-weight: 720;
  line-height: 66rpx;
}

.save-dock__button::after {
  border: 0;
}

.save-dock__button--ready {
  background: linear-gradient(135deg, #f3d7d1, #e7bfb4);
  box-shadow: 0 12rpx 26rpx -20rpx rgba(157, 94, 80, 0.58);
  color: #744f47;
}

.save-dock__button--pressed {
  opacity: 0.68;
}

.drag-ghost {
  position: fixed;
  z-index: 90;
  display: flex;
  min-width: 100rpx;
  min-height: 66rpx;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 45rpx -22rpx rgba(58, 47, 39, 0.5);
  color: var(--c-text);
  gap: 7rpx;
  font-size: 21rpx;
  font-weight: 700;
  pointer-events: none;
  transform: translate(-50%, -115%) rotate(-2deg);
}

.drag-ghost text {
  white-space: nowrap;
}
