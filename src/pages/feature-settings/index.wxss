/*
 * 功能配置：八项功能、首页四格和底栏三格必须在一屏内完成。
 * 拖拽坐标依赖 .drop-slot--home / .drop-slot--tab，不可改名。
 */
.feature-settings-page {
  display: flex;
  width: 100%;
  max-width: 100%;
  height: 100vh;
  overflow: hidden;
  padding: 14rpx 24rpx calc(132rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 100% 0, rgba(247, 217, 204, 0.54), transparent 24%),
    radial-gradient(circle at -4% 70%, rgba(219, 235, 226, 0.42), transparent 24%),
    linear-gradient(180deg, #fff9f3 0%, #f7f4ee 100%);
  box-sizing: border-box;
  color: var(--c-text);
  flex-direction: column;
  touch-action: none;
}

.feature-settings-page--dragging {
  user-select: none;
}

.config-head {
  display: flex;
  min-height: 74rpx;
  align-items: center;
  padding: 0 2rpx 8rpx;
  flex: 0 0 auto;
  gap: 12rpx;
}

.config-head__back {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.74);
  box-shadow: 0 12rpx 26rpx -24rpx rgba(73, 61, 50, 0.42);
  flex: 0 0 auto;
}

.config-head__back-icon {
  margin-top: -4rpx;
  color: #4d4b46;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
}

.config-head__back--pressed,
.config-head__reset--pressed,
.feature-tile--pressed {
  opacity: 0.55;
}

.config-head__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.config-head__title {
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 40rpx;
  font-weight: 760;
  letter-spacing: -0.8rpx;
  line-height: 1.16;
}

.config-head__description {
  margin-top: 2rpx;
  color: var(--c-muted);
  font-size: 20rpx;
  line-height: 1.3;
}

.config-head__reset {
  display: flex;
  min-height: 50rpx;
  align-items: center;
  padding: 0 15rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.74);
  color: var(--c-muted);
  flex: 0 0 auto;
  gap: 5rpx;
  font-size: 20rpx;
  font-weight: 650;
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.config-error {
  display: flex;
  align-items: flex-start;
  margin: 0 0 8rpx;
  padding: 8rpx 12rpx;
  border: 1rpx solid rgba(184, 111, 95, 0.18);
  border-radius: 17rpx;
  background: rgba(250, 235, 230, 0.96);
  flex: 0 0 auto;
  gap: 8rpx;
}

.config-error__copy {
  color: #725d55;
  flex: 1;
  font-size: 18rpx;
  line-height: 1.35;
}

.config-error__action {
  color: var(--c-primary-link);
  flex: 0 0 auto;
  font-size: 18rpx;
  font-weight: 680;
}

.config-guide {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  padding: 12rpx 17rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 26rpx;
  background: linear-gradient(115deg, rgba(218, 235, 227, 0.92), rgba(232, 241, 235, 0.72));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.94);
  box-sizing: border-box;
  flex: 0 0 auto;
  gap: 11rpx;
}

.config-guide__icon {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.58);
  flex: 0 0 auto;
}

.config-guide__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.config-guide__title {
  color: #38483f;
  font-size: 21rpx;
  font-weight: 720;
  line-height: 1.3;
}

.config-guide__description {
  color: rgba(62, 79, 69, 0.64);
  font-size: 17rpx;
  line-height: 1.3;
}

.config-guide__count {
  color: #567164;
  flex: 0 0 auto;
  font-size: 20rpx;
  font-weight: 740;
}

.feature-pool,
.placement {
  position: relative;
  padding: 11rpx 13rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.68);
  box-shadow:
    0 18rpx 42rpx -40rpx rgba(69, 57, 47, 0.42),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
  box-sizing: border-box;
  flex: 0 0 auto;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.feature-pool {
  margin-top: 9rpx;
}

.placement {
  margin-top: 8rpx;
}

.placement--home {
  background:
    radial-gradient(circle at 100% 0, rgba(225, 236, 228, 0.48), transparent 38%),
    rgba(255, 255, 255, 0.7);
}

.placement--tab {
  background:
    radial-gradient(circle at 0 100%, rgba(243, 229, 212, 0.48), transparent 38%),
    rgba(255, 255, 255, 0.68);
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 9rpx;
}

.section-heading__copy {
  display: flex;
  min-width: 0;
  align-items: baseline;
  flex: 1;
  gap: 8rpx;
}

.section-heading__title {
  color: var(--c-text);
  flex: 0 0 auto;
  font-family: var(--font-serif);
  font-size: 27rpx;
  font-weight: 760;
  line-height: 1.25;
  white-space: nowrap;
}

.section-heading__description {
  overflow: hidden;
  color: var(--c-faint);
  font-size: 18rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-heading__meta {
  color: var(--c-faint);
  flex: 0 0 auto;
  font-size: 18rpx;
  font-weight: 620;
}

.feature-category-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 8rpx;
  gap: 7rpx;
}

.feature-category {
  min-width: 0;
  padding: 8rpx 8rpx 7rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  box-sizing: border-box;
}

.feature-category--orange { background: linear-gradient(145deg, rgba(248, 230, 220, 0.82), rgba(252, 247, 242, 0.8)); }
.feature-category--green { background: linear-gradient(145deg, rgba(225, 238, 230, 0.88), rgba(248, 250, 247, 0.8)); }
.feature-category--blue { background: linear-gradient(145deg, rgba(225, 237, 234, 0.88), rgba(248, 250, 248, 0.8)); }
.feature-category--pink { background: linear-gradient(145deg, rgba(237, 228, 239, 0.86), rgba(250, 248, 250, 0.8)); }

.feature-category__title {
  display: block;
  padding: 0 3rpx 6rpx;
  color: var(--c-muted);
  font-size: 18rpx;
  font-weight: 730;
  letter-spacing: 0.2rpx;
  line-height: 1.3;
}

.feature-category__items {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.feature-tile {
  position: relative;
  display: flex;
  min-width: 0;
  height: 49rpx;
  align-items: center;
  padding: 5rpx 7rpx;
  border: 1rpx solid rgba(229, 222, 213, 0.7);
  border-radius: 15rpx;
  background: rgba(255, 255, 255, 0.92);
  box-sizing: border-box;
  gap: 7rpx;
  transition: transform 120ms ease, opacity 120ms ease;
}

.feature-tile--pressed {
  transform: scale(0.97);
}

.feature-tile--occupied {
  border-color: rgba(219, 213, 205, 0.4);
  background: rgba(237, 235, 230, 0.78);
  filter: grayscale(0.68);
  opacity: 0.55;
}

.feature-tile__icon,
.drop-slot__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 11rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
  flex: 0 0 auto;
}

.feature-tile__icon {
  width: 34rpx;
  height: 34rpx;
}

.feature-tile__icon--blue { background: #dce8e5; }
.feature-tile__icon--green { background: #dfeae2; }
.feature-tile__icon--gold { background: #efe3c7; }
.feature-tile__icon--pink { background: #e8e0ea; }
.feature-tile__icon--orange { background: #f0ded5; }

.feature-tile__label {
  overflow: hidden;
  min-width: 0;
  color: var(--c-text-2);
  font-size: 20rpx;
  font-weight: 690;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-tile__placement {
  position: absolute;
  padding: 0 5rpx;
  border-radius: 999rpx;
  background: rgba(228, 234, 230, 0.98);
  color: #718277;
  font-size: 14rpx;
  font-weight: 680;
  line-height: 1.45;
  right: 4rpx;
  top: 3rpx;
}

.home-drop-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 7rpx;
  gap: 7rpx;
}

.drop-slot {
  position: relative;
  border: 1rpx solid rgba(221, 214, 204, 0.82);
  background: rgba(255, 255, 255, 0.94);
  box-sizing: border-box;
  transition:
    border-color 140ms ease,
    box-shadow 140ms ease,
    transform 140ms ease,
    background 140ms ease;
}

.drop-slot--home {
  display: flex;
  min-width: 0;
  min-height: 91rpx;
  align-items: center;
  justify-content: center;
  padding: 7rpx 4rpx 6rpx;
  border-radius: 19rpx;
  flex-direction: column;
  gap: 3rpx;
}

.drop-slot--active {
  border-color: rgba(83, 119, 95, 0.76);
  background: #f2f8f4;
  box-shadow:
    0 0 0 4rpx rgba(89, 125, 101, 0.1),
    0 12rpx 24rpx -24rpx rgba(66, 91, 75, 0.7);
  transform: translateY(-1rpx);
}

.drop-slot--blocked {
  border-color: rgba(172, 105, 88, 0.58);
  background: #fbf1ed;
  box-shadow: 0 0 0 4rpx rgba(172, 105, 88, 0.08);
}

.drop-slot__order {
  position: absolute;
  color: #bbb4aa;
  font-family: Georgia, serif;
  font-size: 11rpx;
  font-style: italic;
  right: 6rpx;
  top: 2rpx;
}

.drop-slot__icon {
  width: 42rpx;
  height: 42rpx;
}

.drop-slot__title {
  overflow: hidden;
  max-width: 100%;
  color: var(--c-text);
  font-size: 19rpx;
  font-weight: 690;
  line-height: 1.2;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-drop-preview {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  align-items: stretch;
  margin-top: 7rpx;
  padding: 5rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 22rpx;
  background: rgba(245, 241, 235, 0.94);
  box-shadow:
    0 12rpx 28rpx -28rpx rgba(59, 50, 42, 0.48),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  gap: 3rpx;
}

.tab-fixed-item,
.drop-slot--tab {
  display: flex;
  min-width: 0;
  min-height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  flex-direction: column;
  gap: 1rpx;
}

.tab-fixed-item {
  color: #aaa39a;
  font-size: 18rpx;
  font-weight: 620;
}

.drop-slot--tab {
  background: rgba(255, 255, 255, 0.96);
  color: var(--c-text-2);
  font-size: 19rpx;
  font-weight: 650;
}

.drop-slot__tab-label {
  overflow: hidden;
  max-width: 100%;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.save-dock {
  position: fixed;
  z-index: 50;
  display: flex;
  align-items: stretch;
  padding: 8rpx 26rpx calc(9rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(251, 248, 243, 0), rgba(251, 248, 243, 0.94) 25%, rgba(251, 248, 243, 0.98));
  box-sizing: border-box;
  flex-direction: column;
  gap: 3rpx;
  inset: auto 0 0;
  pointer-events: none;
}

.save-dock__status {
  color: #8d857c;
  font-size: 18rpx;
  line-height: 1.25;
  text-align: center;
}

.save-dock__button {
  width: 100%;
  height: 76rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 26rpx;
  background: #ded9d1;
  color: #9a938a;
  font-size: 24rpx;
  font-weight: 720;
  line-height: 76rpx;
  pointer-events: auto;
}

.save-dock__button::after {
  border: 0;
}

.save-dock__button--ready {
  background: #29312d;
  box-shadow: 0 16rpx 32rpx -20rpx rgba(37, 45, 41, 0.58);
  color: #fffdf8;
}

.save-dock__button--pressed {
  opacity: 0.7;
}

.drag-ghost {
  position: fixed;
  z-index: 90;
  display: flex;
  min-width: 100rpx;
  min-height: 66rpx;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 45rpx -22rpx rgba(58, 47, 39, 0.5);
  color: var(--c-text);
  gap: 7rpx;
  font-size: 21rpx;
  font-weight: 700;
  pointer-events: none;
  transform: translate(-50%, -115%) rotate(-2deg);
}

.drag-ghost text {
  white-space: nowrap;
}
