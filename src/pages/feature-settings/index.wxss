.feature-settings-page {
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  padding: 30rpx 30rpx calc(180rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 92% 2%, rgba(236, 215, 202, 0.38), transparent 24%),
    linear-gradient(180deg, #fbf8f3 0%, #f4f1eb 100%);
  box-sizing: border-box;
  color: var(--c-text);
}

.config-head {
  display: flex;
  align-items: flex-start;
  padding: 4rpx 4rpx 28rpx;
  gap: 20rpx;
}

.config-head__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.config-head__title {
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 48rpx;
  font-weight: 760;
  letter-spacing: -1.4rpx;
  line-height: 1.24;
}

.config-head__description {
  margin-top: 10rpx;
  color: var(--c-muted);
  font-size: 25rpx;
  line-height: 1.55;
}

.config-head__reset {
  display: flex;
  min-height: 58rpx;
  align-items: center;
  margin-top: 4rpx;
  padding: 0 17rpx;
  border: 1rpx solid rgba(214, 206, 196, 0.86);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.68);
  color: var(--c-muted);
  flex: 0 0 auto;
  gap: 7rpx;
  font-size: 22rpx;
  font-weight: 620;
}

.config-head__reset--pressed {
  opacity: 0.58;
}

.config-error {
  display: flex;
  align-items: flex-start;
  margin-bottom: 22rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(184, 111, 95, 0.18);
  border-radius: 24rpx;
  background: rgba(250, 235, 230, 0.9);
  gap: 12rpx;
}

.config-error__copy {
  color: #725d55;
  flex: 1;
  font-size: 23rpx;
  line-height: 1.55;
}

.config-error__action {
  color: var(--c-primary-link);
  flex: 0 0 auto;
  font-size: 23rpx;
  font-weight: 680;
}

.feature-pool,
.placement {
  position: relative;
  padding: 25rpx 24rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.64);
  box-shadow:
    0 25rpx 64rpx -52rpx rgba(69, 57, 47, 0.5),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
  backdrop-filter: blur(26rpx);
  -webkit-backdrop-filter: blur(26rpx);
}

.placement {
  margin-top: 22rpx;
}

.placement--home {
  background:
    radial-gradient(circle at 100% 0, rgba(222, 234, 225, 0.65), transparent 33%),
    rgba(255, 255, 255, 0.66);
}

.placement--tab {
  background:
    radial-gradient(circle at 0 100%, rgba(239, 226, 205, 0.58), transparent 36%),
    rgba(255, 255, 255, 0.62);
}

.section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.section-heading__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.section-heading__title {
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 36rpx;
  font-weight: 740;
  line-height: 1.3;
}

.section-heading__description {
  margin-top: 4rpx;
  color: var(--c-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.section-heading__meta {
  padding-top: 7rpx;
  color: var(--c-faint);
  flex: 0 0 auto;
  font-family: Georgia, serif;
  font-size: 20rpx;
  font-style: italic;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 22rpx;
  gap: 11rpx;
}

.feature-tile {
  position: relative;
  display: flex;
  min-width: 0;
  min-height: 126rpx;
  align-items: center;
  justify-content: center;
  padding: 13rpx 7rpx 12rpx;
  border: 1rpx solid rgba(222, 214, 204, 0.84);
  border-radius: 23rpx;
  background: rgba(255, 255, 255, 0.84);
  box-sizing: border-box;
  flex-direction: column;
  gap: 8rpx;
  transition: transform 120ms ease, opacity 120ms ease;
}

.feature-tile--pressed {
  opacity: 0.62;
  transform: scale(0.97);
}

.feature-tile__icon,
.drop-slot__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}

.feature-tile__icon {
  width: 51rpx;
  height: 51rpx;
}

.feature-tile__icon--blue { background: #e6ebe8; }
.feature-tile__icon--green { background: #e4eee8; }
.feature-tile__icon--gold { background: #f3e9cf; }
.feature-tile__icon--pink { background: #eee8ed; }
.feature-tile__icon--orange { background: #f5e5df; }

.feature-tile__label {
  overflow: hidden;
  max-width: 100%;
  color: var(--c-text-2);
  font-size: 23rpx;
  font-weight: 680;
  line-height: 1.3;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-tile__limit {
  position: absolute;
  padding: 1rpx 6rpx;
  border-radius: 999rpx;
  background: rgba(242, 233, 219, 0.94);
  color: #9b8060;
  font-size: 14rpx;
  font-weight: 650;
  line-height: 1.45;
  right: 6rpx;
  top: 6rpx;
}

.home-drop-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 21rpx;
  gap: 12rpx;
}

.drop-slot {
  position: relative;
  border: 1rpx solid rgba(219, 211, 201, 0.9);
  background: rgba(255, 255, 255, 0.88);
  box-sizing: border-box;
  transition:
    border-color 140ms ease,
    box-shadow 140ms ease,
    transform 140ms ease,
    background 140ms ease;
}

.drop-slot--home {
  display: flex;
  min-width: 0;
  min-height: 136rpx;
  align-items: center;
  padding: 17rpx 16rpx;
  border-radius: 25rpx;
  gap: 13rpx;
}

.drop-slot--active {
  border-color: rgba(83, 119, 95, 0.7);
  background: #f3f8f4;
  box-shadow:
    0 0 0 5rpx rgba(89, 125, 101, 0.1),
    0 16rpx 30rpx -28rpx rgba(66, 91, 75, 0.7);
  transform: translateY(-2rpx);
}

.drop-slot--blocked {
  border-color: rgba(172, 105, 88, 0.55);
  background: #fbf1ed;
  box-shadow: 0 0 0 5rpx rgba(172, 105, 88, 0.08);
}

.drop-slot__order {
  position: absolute;
  color: #bbb4aa;
  font-family: Georgia, serif;
  font-size: 17rpx;
  font-style: italic;
  right: 11rpx;
  top: 8rpx;
}

.drop-slot__icon {
  width: 61rpx;
  height: 61rpx;
  flex: 0 0 auto;
}

.drop-slot__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 2rpx;
}

.drop-slot__title {
  overflow: hidden;
  color: var(--c-text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drop-slot__copy {
  overflow: hidden;
  color: var(--c-muted);
  font-size: 20rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-drop-preview {
  display: grid;
  grid-template-columns: 1fr repeat(3, 1.15fr) 1fr;
  align-items: stretch;
  margin-top: 21rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 29rpx;
  background: rgba(248, 245, 239, 0.88);
  box-shadow:
    0 17rpx 42rpx -38rpx rgba(59, 50, 42, 0.5),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  gap: 7rpx;
}

.tab-fixed-item,
.drop-slot--tab {
  display: flex;
  min-width: 0;
  min-height: 112rpx;
  align-items: center;
  justify-content: center;
  border-radius: 21rpx;
  flex-direction: column;
  gap: 5rpx;
}

.tab-fixed-item {
  color: #aaa39a;
  font-size: 19rpx;
  font-weight: 620;
}

.tab-fixed-item__note {
  color: #c4bdb4;
  font-size: 14rpx;
  font-weight: 560;
}

.drop-slot--tab {
  background: rgba(255, 255, 255, 0.94);
  color: var(--c-text-2);
  font-size: 20rpx;
  font-weight: 650;
}

.drop-slot__tab-label {
  overflow: hidden;
  max-width: 100%;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.save-dock {
  position: fixed;
  z-index: 50;
  display: flex;
  align-items: center;
  padding: 17rpx 30rpx calc(17rpx + env(safe-area-inset-bottom));
  background: rgba(251, 248, 243, 0.9);
  box-shadow: 0 -18rpx 50rpx -42rpx rgba(55, 46, 39, 0.55);
  gap: 22rpx;
  inset: auto 0 0;
  backdrop-filter: blur(28rpx);
  -webkit-backdrop-filter: blur(28rpx);
}

.save-dock__meta {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 2rpx;
}

.save-dock__status {
  color: var(--c-text-2);
  font-size: 24rpx;
  font-weight: 680;
}

.save-dock__hint {
  color: var(--c-faint);
  font-size: 19rpx;
  line-height: 1.4;
}

.save-dock__button {
  width: 218rpx;
  min-height: 82rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 0;
  border-radius: 999rpx;
  background: #dfdcd5;
  color: #9c968e;
  flex: 0 0 auto;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 82rpx;
}

.save-dock__button::after {
  border: 0;
}

.save-dock__button--ready {
  background: var(--c-primary);
  color: #fff;
  box-shadow: 0 15rpx 32rpx -24rpx rgba(58, 82, 66, 0.9);
}

.save-dock__button--pressed {
  opacity: 0.78;
}

.drag-ghost {
  position: fixed;
  z-index: 90;
  display: flex;
  min-height: 74rpx;
  align-items: center;
  padding: 0 21rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 24rpx 54rpx -26rpx rgba(48, 43, 37, 0.58);
  color: var(--c-text);
  gap: 9rpx;
  font-size: 25rpx;
  font-weight: 700;
  pointer-events: none;
  transform: translate(-50%, calc(-100% - 18rpx)) rotate(-2deg);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.drag-ghost--blue { border-color: rgba(117, 139, 127, 0.38); }
.drag-ghost--green { border-color: rgba(101, 141, 112, 0.42); }
.drag-ghost--gold { border-color: rgba(173, 143, 76, 0.38); }
.drag-ghost--pink { border-color: rgba(150, 115, 142, 0.34); }
.drag-ghost--orange { border-color: rgba(177, 119, 96, 0.36); }

@media (prefers-reduced-motion: reduce) {
  .feature-tile,
  .drop-slot {
    transition: none;
  }
}
