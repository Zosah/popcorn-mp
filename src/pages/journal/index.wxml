<view class="tab-page journal-page">
  <view class="journal-top">
    <view class="journal-top__main">
      <view class="journal-top__title">生活记录</view>
      <view class="journal-top__sub">{{entries.length + notesCount}} 篇 · 把普通的日子留下</view>
    </view>
    <view class="journal-write" bindtap="onCreate">
      <line-icon name="plus" size="23" tone="white" />
      <text>写</text>
    </view>
  </view>

  <scroll-view class="journal-filters" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="journal-filters__row">
      <view wx:for="{{filterOptions}}" wx:key="key" class="journal-filter {{activeFilter === item.key ? 'journal-filter--active' : ''}}" data-value="{{item.key}}" bindtap="onSelectFilter">
        <text>{{item.label}}</text>
        <text>{{item.count}}</text>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{loadError && (entries.length || notesCount)}}" class="journal-banner">
    <line-icon name="circle-alert" size="22" tone="danger" />
    <view class="journal-banner__body">
      <text>记录刷新没完成</text>
      <text>先保留已经读到的内容，稍后可以再试。</text>
    </view>
    <view class="journal-banner__action" bindtap="onRetryLoad">重试</view>
  </view>

  <block wx:if="{{activeView === 'moments'}}">
    <view wx:if="{{loading && !entries.length}}" class="journal-state">
      <view class="journal-state__icon journal-state__icon--blue"><line-icon name="notebook-tabs" size="34" tone="blue" /></view>
      <view class="journal-state__title">正在把日子轻轻翻出来</view>
      <view class="journal-state__copy">稍等一下，马上就好。</view>
    </view>

    <view wx:elif="{{loadError && !entries.length}}" class="journal-state">
      <view class="journal-state__icon journal-state__icon--red"><line-icon name="circle-alert" size="34" tone="danger" /></view>
      <view class="journal-state__title">暂时没有连上</view>
      <view class="journal-state__copy">{{loadError}}</view>
      <view class="journal-state__action" bindtap="onRetryLoad">重新加载</view>
    </view>

    <view wx:elif="{{entries.length}}" class="journal-timeline">
      <view wx:for="{{entries}}" wx:key="id" class="journal-entry journal-entry--tone{{index % 4}}" data-id="{{item.id}}" bindtap="onOpenEntry">
        <view class="journal-entry__dot"></view>
        <view class="journal-entry__meta">{{item.monthLabel}}{{item.day}} · {{item.timeLabel}} · {{item.authorName}}</view>
        <view class="journal-entry__title">{{item.title}}</view>
        <view wx:if="{{item.content}}" class="journal-entry__copy">{{item.content}}</view>
        <image wx:if="{{item.image && (item.image.thumbSrc || item.image.src)}}" class="journal-entry__photo" src="{{item.image.thumbSrc || item.image.src}}" mode="aspectFill" lazy-load />
        <view wx:if="{{item.image && item.image.caption}}" class="journal-entry__caption">{{item.image.caption}}</view>
        <view class="journal-entry__tags">
          <text class="journal-entry__tag">{{item.visibilityLabel}}</text>
          <text wx:if="{{item.updatedAt}}" class="journal-entry__tag journal-entry__tag--warm">已编辑</text>
        </view>
      </view>
    </view>

    <view wx:else class="journal-state">
      <view class="journal-state__icon journal-state__icon--blue"><line-icon name="pen-line" size="34" tone="blue" /></view>
      <view class="journal-state__title">还没有留下记录</view>
      <view class="journal-state__copy">写下一句话，平常的一天也会有一个落点。</view>
      <view class="journal-state__action" bindtap="onCreate">记下第一笔</view>
    </view>

    <view wx:if="{{noteGroups.length}}" class="journal-notes-preview">
      <view class="journal-section-head">
        <text>重要记录</text>
        <text>长期保存的资料</text>
      </view>
      <view class="journal-note-groups">
        <view wx:for="{{noteGroups}}" wx:key="key" wx:for-item="group" class="journal-note-group" data-value="{{group.key}}" bindtap="onSelectFilter">
          <view class="journal-note-group__icon journal-note-group__icon--{{group.key}}"><line-icon name="{{group.icon}}" size="28" tone="{{group.key === 'health' ? 'pink' : group.key === 'pet' ? 'gold' : 'blue'}}" /></view>
          <view class="journal-note-group__body">
            <text>{{group.label}}</text>
            <text>{{group.entries.length}} 项资料</text>
          </view>
          <view class="journal-note-group__arrow">›</view>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="journal-notes-view">
    <view wx:if="{{loading && !notesCount}}" class="journal-state">
      <view class="journal-state__icon journal-state__icon--blue"><line-icon name="file-text" size="34" tone="blue" /></view>
      <view class="journal-state__title">正在整理重要记录</view>
      <view class="journal-state__copy">稍等一下，马上就好。</view>
    </view>

    <view wx:elif="{{loadError && !notesCount}}" class="journal-state">
      <view class="journal-state__icon journal-state__icon--red"><line-icon name="circle-alert" size="34" tone="danger" /></view>
      <view class="journal-state__title">暂时没有连上</view>
      <view class="journal-state__copy">{{loadError}}</view>
      <view class="journal-state__action" bindtap="onRetryLoad">重新加载</view>
    </view>

    <block wx:elif="{{visibleNoteGroups.length}}">
      <view wx:for="{{visibleNoteGroups}}" wx:key="key" wx:for-item="group" class="journal-note-section">
        <view class="journal-section-head">
          <view class="journal-section-head__title"><line-icon name="{{group.icon}}" size="23" tone="blue" /><text>{{group.label}}</text></view>
          <text>{{group.entries.length}} 项</text>
        </view>
        <view class="journal-note-list">
          <view wx:for="{{group.entries}}" wx:key="id" wx:for-item="entry" class="journal-note-row" data-id="{{entry.id}}" bindtap="onOpenEntry">
            <view class="journal-note-row__body">
              <text class="journal-note-row__title">{{entry.title}}</text>
              <text class="journal-note-row__copy">{{entry.content}}</text>
              <text class="journal-note-row__meta">{{entry.dateLabel}} · {{entry.visibilityLabel}}{{entry.updatedAt ? ' · 已编辑' : ''}}</text>
            </view>
            <view class="journal-note-row__arrow">›</view>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="journal-state">
      <view class="journal-state__icon journal-state__icon--blue"><line-icon name="file-text" size="34" tone="blue" /></view>
      <view class="journal-state__title">这里还没有资料</view>
      <view class="journal-state__copy">把证件、家规和照护资料收在这里，需要时随时能找到。</view>
      <view class="journal-state__action" bindtap="onCreate">存一份记录</view>
    </view>
  </view>
  <app-tab-bar active="journal" />
</view>
