.journal-page {
  padding-top: 28rpx;
}

.journal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 22rpx;
}

.journal-head__title {
  margin-top: 4rpx;
  color: var(--c-text, #292737);
  font-size: 45rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}

.journal-hero {
  display: flex;
  min-height: 310rpx;
  padding: 30rpx 26rpx;
  border-radius: 40rpx;
  background: linear-gradient(145deg, rgba(255, 254, 250, 0.97), rgba(244, 241, 248, 0.88));
}

.journal-hero__glow {
  position: absolute;
  top: -110rpx;
  right: 30rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201, 223, 215, 0.44), rgba(201, 223, 215, 0));
}

.journal-hero__copy {
  position: relative;
  z-index: 1;
  min-width: 0;
  flex: 1;
}

.journal-hero__label {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 254, 250, 0.84);
  color: var(--c-primary-deep, #665c9c);
  font-size: 15rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.journal-hero__title {
  max-width: 420rpx;
  margin-top: 16rpx;
  color: var(--c-text, #292737);
  font-size: 43rpx;
  font-weight: 600;
  letter-spacing: -2rpx;
  line-height: 1.3;
}

.journal-hero__desc {
  max-width: 405rpx;
  margin-top: 10rpx;
  color: var(--c-text-2, #615f70);
  font-size: 19rpx;
  line-height: 1.65;
}

.journal-hero__button {
  display: inline-flex;
  height: 67rpx;
  align-items: center;
  justify-content: center;
  margin-top: 21rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #8177ba, #6f65a7 62%, #7f9e94);
  box-shadow: 0 12rpx 24rpx rgba(92, 82, 134, 0.22);
  color: #fff;
  gap: 8rpx;
  font-size: 21rpx;
  font-weight: 600;
}

.journal-hero__visual {
  position: relative;
  z-index: 1;
  width: 180rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.journal-hero__image {
  position: absolute;
  top: 8rpx;
  right: 0;
  width: 170rpx;
  height: 212rpx;
  border: 8rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 34rpx;
  background: #f4eee5;
  box-shadow: 0 14rpx 30rpx rgba(68, 61, 76, 0.12);
  filter: saturate(0.72) contrast(0.97) sepia(0.03);
  transform: rotate(4deg);
}

.journal-hero__pin {
  position: absolute;
  right: 143rpx;
  bottom: 12rpx;
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border: 5rpx solid rgba(255, 255, 255, 0.90);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 7rpx 18rpx rgba(68, 61, 76, 0.09);
}

.journal-tabs {
  display: flex;
  margin-top: 18rpx;
  padding: 7rpx;
  border-radius: 999rpx;
}

.journal-state-banner {
  margin-top: 18rpx;
}

.journal-tab {
  display: flex;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: var(--c-muted, #8a8693);
  flex: 1;
  gap: 8rpx;
  font-size: 21rpx;
  font-weight: 500;
}

.journal-tab text:last-child {
  display: flex;
  min-width: 30rpx;
  height: 30rpx;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: rgba(255, 254, 250, 0.76);
  font-size: 15rpx;
}

.journal-tab--active {
  background: rgba(255, 254, 250, 0.98);
  box-shadow: 0 7rpx 18rpx rgba(68, 61, 76, 0.08);
  color: var(--c-text, #292737);
  font-weight: 600;
}

.timeline {
  display: flex;
  padding-top: 18rpx;
  flex-direction: column;
  gap: 16rpx;
}

.entry {
  padding: 22rpx;
  border-radius: 34rpx;
}

.entry__head {
  display: flex;
  align-items: center;
}

.entry__date {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #f0edf7, #e6f7f1);
  color: var(--c-primary-deep, #665c9c);
  flex-direction: column;
  flex-shrink: 0;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1;
}

.entry__date text:last-child {
  margin-top: 4rpx;
  color: var(--c-muted, #8a8693);
  font-size: 14rpx;
  font-weight: 400;
}

.entry__meta {
  display: flex;
  min-width: 0;
  margin-left: 14rpx;
  flex: 1;
  flex-direction: column;
}

.entry__meta text:first-child {
  color: var(--c-text, #292737);
  font-size: 20rpx;
  font-weight: 600;
}

.entry__meta text:last-child {
  margin-top: 3rpx;
  color: var(--c-muted, #8a8693);
  font-size: 16rpx;
}

.entry__more {
  color: var(--c-faint, #b7b2bb);
  flex-shrink: 0;
  font-size: 19rpx;
  letter-spacing: 2rpx;
}

.entry__title {
  margin-top: 17rpx;
  color: var(--c-text, #292737);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
}

.entry__photo {
  display: block;
  width: 100%;
  height: 288rpx;
  margin-top: 14rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.84);
  border-radius: 28rpx;
  background: #ece8e1;
  box-shadow: 0 12rpx 28rpx rgba(89, 76, 111, 0.10);
  filter: saturate(0.62) contrast(0.96) sepia(0.05);
}

.entry__caption {
  margin-top: 7rpx;
  color: var(--c-muted, #8a8693);
  font-size: 16rpx;
  text-align: right;
}

.entry__copy {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--c-text-2, #615f70);
  font-size: 21rpx;
  line-height: 1.68;
  white-space: pre-wrap;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.entry__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 15rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(87, 80, 93, 0.09);
}

.entry__visibility {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: var(--c-muted, #8a8693);
  font-size: 16rpx;
}

.entry__open {
  color: var(--c-primary-deep, #665c9c);
  font-size: 17rpx;
  font-weight: 500;
}

.notes-group {
  margin-top: 24rpx;
}

.notes-group__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 5rpx 10rpx;
  color: var(--c-muted, #8a8693);
  font-size: 17rpx;
}

.notes-group__head > view {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.notes-group__head > view text {
  color: var(--c-text, #292737);
  font-size: 23rpx;
  font-weight: 600;
}

.notes-list {
  padding: 2rpx 20rpx;
  border-radius: 32rpx;
}

.note-row {
  display: flex;
  min-height: 105rpx;
  align-items: center;
  border-bottom: 1rpx solid rgba(87, 80, 93, 0.09);
}

.note-row:last-child {
  border-bottom: 0;
}

.note-row__main {
  display: flex;
  min-width: 0;
  padding: 17rpx 0;
  flex: 1;
  flex-direction: column;
}

.note-row__title {
  color: var(--c-text, #292737);
  font-size: 24rpx;
  font-weight: 600;
}

.note-row__copy {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 4rpx;
  color: var(--c-text-2, #615f70);
  font-size: 18rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.note-row__meta {
  margin-top: 6rpx;
  color: var(--c-muted, #8a8693);
  font-size: 16rpx;
}

.note-row__arrow {
  margin-left: 12rpx;
  color: var(--c-faint, #b7b2bb);
  flex-shrink: 0;
  font-size: 29rpx;
}
