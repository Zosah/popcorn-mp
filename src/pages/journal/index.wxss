.journal-head {
  padding-bottom: 26rpx;
}

.journal-head__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.journal-head__title {
  min-width: 0;
  flex: 1;
  color: var(--c-text, #22242e);
  font-size: 48rpx;
  font-weight: 500;
  letter-spacing: -2rpx;
  line-height: 1.25;
}

.journal-add {
  display: flex;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
  margin-left: 20rpx;
  padding: 0 26rpx;
  border: 1rpx solid var(--c-text, #22242e);
  border-radius: 999rpx;
  color: var(--c-text, #22242e);
  gap: 7rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

.journal-head__copy {
  max-width: 610rpx;
  margin-top: 12rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 24rpx;
  line-height: 1.65;
}

.tabs {
  display: flex;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.tab {
  position: relative;
  padding: 0 0 20rpx;
  color: var(--c-muted, #9497a6);
  font-size: 24rpx;
}

.tab + .tab {
  margin-left: 48rpx;
}

.tab--active {
  color: var(--c-text, #22242e);
  font-weight: 500;
}

.tab--active::after {
  position: absolute;
  right: 0;
  bottom: -1rpx;
  left: 0;
  height: 1rpx;
  background: var(--c-text, #22242e);
  content: "";
}

.timeline {
  padding-top: 6rpx;
}

.entry {
  display: flex;
  padding: 30rpx 0 34rpx;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.entry__date {
  display: flex;
  width: 88rpx;
  padding-top: 2rpx;
  flex-shrink: 0;
  flex-direction: column;
  color: var(--c-text, #22242e);
  font-family: "Songti SC", "STSong", serif;
}

.entry__day {
  font-size: 40rpx;
  line-height: 1;
}

.entry__month {
  margin-top: 6rpx;
  color: var(--c-muted, #9497a6);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 20rpx;
}

.entry__body {
  min-width: 0;
  flex: 1;
}

.entry__meta {
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
}

.entry__title {
  margin-top: 10rpx;
  color: var(--c-text, #22242e);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
}

.entry__copy {
  margin-top: 10rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 24rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.entry__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.entry__visibility {
  display: flex;
  align-items: center;
  gap: 7rpx;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
}

.entry__open {
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
}

.entry__photo {
  display: block;
  width: 100%;
  height: 300rpx;
  margin-top: 16rpx;
}

.entry__caption {
  margin-top: 8rpx;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
  text-align: right;
}

.entry__note {
  display: flex;
  margin-top: 16rpx;
  padding: 12rpx 0 12rpx 18rpx;
  border-left: 1rpx solid var(--c-line-strong, #d6d5e0);
  color: var(--c-text-2, #5c5f6e);
  flex-direction: column;
  font-size: 23rpx;
  line-height: 1.7;
}

.notes-group {
  margin-top: 28rpx;
}

.notes-group__head {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0 10rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.notes-list {
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.note-row {
  display: flex;
  min-height: 104rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.note-row:last-child {
  border-bottom: 0;
}

.note-row__icon {
  display: flex;
  width: 30rpx;
  height: 30rpx;
  margin-right: 18rpx;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.note-row__main {
  display: flex;
  min-width: 0;
  flex: 1;
  padding: 20rpx 0;
  flex-direction: column;
}

.note-row__copy {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 5rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 21rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.note-row__title {
  color: var(--c-text, #22242e);
  font-size: 25rpx;
  font-weight: 500;
}

.note-row__meta {
  margin-top: 7rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.note-row__chevron {
  width: 10rpx;
  height: 10rpx;
  margin-left: 16rpx;
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-right: 1rpx solid var(--c-line-strong, #d6d5e0);
  transform: rotate(45deg);
}

.journal-empty {
  display: flex;
  min-height: 360rpx;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
  color: var(--c-muted, #9497a6);
  flex-direction: column;
}

.journal-empty__title {
  margin-top: 18rpx;
  color: var(--c-text, #22242e);
  font-size: 26rpx;
  font-weight: 500;
}

.journal-empty__copy {
  max-width: 500rpx;
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.65;
  text-align: center;
}
