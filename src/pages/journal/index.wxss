.journal-page {
  --journal-paper: #fdfbf7;
  --journal-ink: #2e2a28;
  --journal-ink-2: #6b635c;
  --journal-ink-3: #a69e96;
  --journal-line: #ebe5da;
  --journal-deep: #2c4a52;
  --journal-blue: #5b8fb9;
  --journal-red: #d85f78;
  padding: 34rpx 36rpx calc(190rpx + env(safe-area-inset-bottom));
  background: var(--journal-paper);
  color: var(--journal-ink);
}

.journal-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 2rpx 25rpx;
}

.journal-top__title {
  font-size: 45rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.journal-top__sub {
  margin-top: 7rpx;
  color: var(--journal-ink-3);
  font-size: 26rpx;
}

.journal-write {
  display: flex;
  height: 64rpx;
  align-items: center;
  padding: 0 21rpx;
  border-radius: 999rpx;
  background: var(--journal-deep);
  color: #fff;
  gap: 7rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.journal-filters {
  width: calc(100% + 72rpx);
  margin: 0 -36rpx;
  white-space: nowrap;
}

.journal-filters__row {
  display: inline-flex;
  padding: 0 36rpx 8rpx;
  gap: 12rpx;
}

.journal-filter {
  display: flex;
  height: 60rpx;
  align-items: center;
  padding: 0 21rpx;
  border: 1rpx solid var(--journal-line);
  border-radius: 999rpx;
  background: #fffefa;
  color: var(--journal-ink-2);
  gap: 8rpx;
  font-size: 25rpx;
}

.journal-filter text:last-child {
  color: var(--journal-ink-3);
  font-size: 22rpx;
}

.journal-filter--active {
  border-color: #2e2a28;
  background: #2e2a28;
  color: #fff;
  font-weight: 600;
}

.journal-filter--active text:last-child { color: rgba(255, 255, 255, 0.72); }

.journal-banner {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: #fcebee;
  gap: 12rpx;
}

.journal-banner__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.journal-banner__body text:first-child { font-size: 25rpx; font-weight: 700; }
.journal-banner__body text:last-child { margin-top: 2rpx; color: var(--journal-ink-2); font-size: 22rpx; }
.journal-banner__action { color: var(--journal-red); font-size: 24rpx; font-weight: 700; }

.journal-timeline {
  position: relative;
  margin-top: 26rpx;
  padding-left: 31rpx;
}

.journal-timeline::before {
  position: absolute;
  top: 10rpx;
  bottom: 8rpx;
  left: 5rpx;
  width: 2rpx;
  background: linear-gradient(180deg, var(--journal-line), rgba(235, 229, 218, 0));
  content: "";
}

.journal-entry {
  position: relative;
  padding: 0 0 34rpx 7rpx;
}

.journal-entry:last-child { padding-bottom: 0; }

.journal-entry__dot {
  position: absolute;
  top: 7rpx;
  left: -31rpx;
  width: 15rpx;
  height: 15rpx;
  border: 4rpx solid #fffefa;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 0 2rpx var(--journal-blue);
}

.journal-entry--tone1 .journal-entry__dot { box-shadow: 0 0 0 2rpx #f09aae; }
.journal-entry--tone2 .journal-entry__dot { box-shadow: 0 0 0 2rpx #9bc4a6; }
.journal-entry--tone3 .journal-entry__dot { box-shadow: 0 0 0 2rpx #dfa93c; }

.journal-entry__meta {
  color: var(--journal-ink-3);
  font-size: 24rpx;
  line-height: 1.45;
}

.journal-entry__title {
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.4rpx;
  line-height: 1.5;
}

.journal-entry__copy {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 6rpx;
  color: var(--journal-ink-2);
  font-size: 27rpx;
  line-height: 1.75;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.journal-entry__photo {
  width: 100%;
  height: 250rpx;
  margin-top: 14rpx;
  border-radius: 25rpx;
}

.journal-entry__caption {
  margin-top: 7rpx;
  color: var(--journal-ink-3);
  font-size: 22rpx;
}

.journal-entry__tags {
  display: flex;
  margin-top: 12rpx;
  gap: 9rpx;
}

.journal-entry__tag {
  display: flex;
  height: 38rpx;
  align-items: center;
  padding: 0 14rpx;
  border: 1rpx solid var(--journal-line);
  border-radius: 999rpx;
  background: #fffefa;
  color: var(--journal-ink-3);
  font-size: 21rpx;
}

.journal-entry__tag--warm { background: #fbf3e1; color: #a8751e; }

.journal-notes-preview {
  margin-top: 34rpx;
}

.journal-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 4rpx 13rpx;
}

.journal-section-head > text:first-child,
.journal-section-head__title text {
  color: var(--journal-ink);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.4rpx;
}

.journal-section-head > text:last-child {
  color: var(--journal-ink-3);
  font-size: 23rpx;
}

.journal-section-head__title {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.journal-note-groups,
.journal-note-list {
  overflow: hidden;
  border: 1rpx solid var(--journal-line);
  border-radius: 30rpx;
  background: #fffefa;
}

.journal-note-group {
  display: flex;
  min-height: 104rpx;
  align-items: center;
  padding: 0 23rpx;
  border-bottom: 1rpx solid var(--journal-line);
  gap: 15rpx;
}

.journal-note-group:last-child { border-bottom: 0; }
.journal-note-group__icon { display: flex; width: 63rpx; height: 63rpx; align-items: center; justify-content: center; border-radius: 20rpx; background: #eaf1f7; flex-shrink: 0; }
.journal-note-group__icon--health { background: #fcedf0; }
.journal-note-group__icon--pet { background: #fbf3e1; }
.journal-note-group__icon--home { background: #eaf1f7; }
.journal-note-group__icon--other { background: #f6f1e9; }
.journal-note-group__body { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 3rpx; }
.journal-note-group__body text:first-child { font-size: 29rpx; font-weight: 700; }
.journal-note-group__body text:last-child { color: var(--journal-ink-3); font-size: 23rpx; }
.journal-note-group__arrow { color: #cfc6bd; font-size: 40rpx; font-weight: 300; }

.journal-notes-view { margin-top: 26rpx; }
.journal-note-section + .journal-note-section { margin-top: 30rpx; }

.journal-note-row {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  padding: 20rpx 23rpx;
  border-bottom: 1rpx solid var(--journal-line);
  gap: 15rpx;
}

.journal-note-row:last-child { border-bottom: 0; }
.journal-note-row__body { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 3rpx; }
.journal-note-row__title { font-size: 29rpx; font-weight: 700; }
.journal-note-row__copy { overflow: hidden; color: var(--journal-ink-2); font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.journal-note-row__meta { color: var(--journal-ink-3); font-size: 22rpx; }
.journal-note-row__arrow { color: #cfc6bd; font-size: 40rpx; }

.journal-state {
  display: flex;
  min-height: 360rpx;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  padding: 42rpx 30rpx;
  border: 1rpx solid var(--journal-line);
  border-radius: 30rpx;
  background: #fffefa;
  flex-direction: column;
  text-align: center;
}

.journal-state__icon { display: flex; width: 86rpx; height: 86rpx; align-items: center; justify-content: center; border-radius: 28rpx; }
.journal-state__icon--blue { background: #eaf1f7; }
.journal-state__icon--red { background: #fcebee; }
.journal-state__title { margin-top: 18rpx; font-size: 31rpx; font-weight: 700; }
.journal-state__copy { max-width: 500rpx; margin-top: 7rpx; color: var(--journal-ink-3); font-size: 25rpx; line-height: 1.7; }
.journal-state__action { margin-top: 20rpx; padding: 14rpx 24rpx; border-radius: 999rpx; background: var(--journal-deep); color: #fff; font-size: 25rpx; font-weight: 600; }
