<view class="page-shell auth-page">
  <view class="subpage-back" bindtap="onBack">{{backLabel}}</view>

  <block wx:if="{{mode === 'login'}}">
    <view class="auth-hero">
      <view class="auth-hero__mark"><line-icon name="user-round" size="30" tone="blue" /></view>
      <view class="auth-hero__body">
        <view class="eyebrow">WELCOME HOME</view>
        <view class="auth-hero__title">回来就好</view>
        <view class="auth-hero__copy">登录后认领你的空间身份，和朋友一起维护同一份生活。</view>
      </view>
    </view>

    <view class="paper-card auth-vignette">
      <view class="auth-vignette__copy">
        <text>一封写给共同生活的信</text>
        <text>从今天开始，把普通日子轻轻收好。</text>
        <view class="auth-vignette__rule"></view>
        <text class="auth-vignette__note">{{loginVignetteNote}}</text>
      </view>
      <image class="auth-vignette__image" src="../../images/ink-letter.png" mode="aspectFit" />
    </view>

    <view wx:if="{{hasAccount}}" class="detected-account paper-card">
      <view class="user-avatar detected-account__avatar user-avatar--{{accountAvatarTone}}">{{accountAvatarText}}</view>
      <view class="detected-account__body">
        <text class="detected-account__label">检测到本机账号</text>
        <text class="detected-account__name">{{accountNickname}}</text>
        <text class="detected-account__meta">继续登录后，空间身份会恢复</text>
      </view>
      <view class="detected-account__mark"><line-icon name="check" size="22" tone="blue" /></view>
    </view>

    <view wx:else class="login-promises">
      <view class="login-promise"><view class="login-promise__mark"><line-icon name="user-round" size="24" tone="blue" /></view><text>取一个称呼</text></view>
      <view class="login-promise"><view class="login-promise__mark"><line-icon name="pen-line" size="24" tone="pink" /></view><text>选一个头像色</text></view>
      <view class="login-promise"><view class="login-promise__mark"><line-icon name="house" size="24" tone="green" /></view><text>回到共同空间</text></view>
    </view>

    <button class="primary-button auth-primary" bindtap="onWechatLogin"><line-icon name="{{hasAccount ? 'user-round' : 'plus'}}" size="24" tone="white" /><text>{{hasAccount ? '微信一键登录' : '微信快捷注册'}}</text></button>
    <view class="auth-secondary" bindtap="onBack">先随便看看</view>
    <view class="auth-note"><line-icon name="lock" size="19" tone="muted" /><text>{{loginFootnote}}</text></view>
  </block>

  <block wx:elif="{{mode === 'register'}}">
    <view class="auth-hero auth-hero--form">
      <view class="auth-hero__mark"><line-icon name="pen-line" size="30" tone="pink" /></view>
      <view class="auth-hero__body">
        <view class="eyebrow">{{isEditing ? 'ABOUT YOU' : 'NICE TO MEET YOU'}}</view>
        <view class="auth-hero__title">{{isEditing ? '换个喜欢的称呼' : '先给自己取个名字'}}</view>
        <view class="auth-hero__copy">{{isEditing ? registerCopy : (isDemoMode ? '不用填写手机号，先把这个 Demo 身份创建起来。' : '登录已完成，取一个昵称就可以开始。')}}</view>
      </view>
    </view>

    <view class="paper-card profile-preview">
      <view class="user-avatar profile-preview__avatar user-avatar--{{selectedTone}}">{{nicknamePreview}}</view>
      <view class="profile-preview__body">
        <text class="profile-preview__label">{{profilePreviewLabel}}</text>
        <text class="profile-preview__name">{{nicknameInput || '还没取名字'}}</text>
        <text class="profile-preview__meta">加入「{{spaceName}}」 · {{profilePreviewMeta}}</text>
      </view>
      <view class="profile-preview__mark"><line-icon name="heart-pulse" size="23" tone="pink" /></view>
    </view>

    <view class="paper-card profile-form">
      <view class="profile-form__group">
        <text class="profile-form__label">怎么称呼你</text>
        <input class="profile-form__input" type="nickname" maxlength="16" value="{{nicknameInput}}" placeholder="例如：小满" placeholder-class="profile-form__placeholder" bindinput="onNicknameInput" />
        <view wx:if="{{nicknameError}}" class="profile-form__error">{{nicknameError}}</view>
      </view>

      <view class="profile-form__group profile-form__group--tones">
        <text class="profile-form__label">头像颜色</text>
        <view class="tone-options">
          <view wx:for="{{avatarOptions}}" wx:key="value" class="tone-option {{selectedTone === item.value ? 'tone-option--active' : ''}}" data-tone="{{item.value}}" bindtap="onSelectTone">
            <view class="tone-option__dot user-avatar--{{item.value}}"><line-icon wx:if="{{selectedTone === item.value}}" name="check" size="18" tone="ink" /></view>
            <text>{{item.label}}</text>
          </view>
        </view>
        <view class="profile-form__hint">头像暂时使用昵称首字，后续可以换成自定义插画。</view>
      </view>
    </view>

    <button class="primary-button auth-primary" bindtap="onSubmitProfile"><line-icon name="check" size="24" tone="white" /><text>{{isEditing ? '保存资料' : '创建账号并回家'}}</text></button>
    <view wx:if="{{!isEditing}}" class="auth-secondary" bindtap="onBackToLogin">已经注册过？去登录</view>
  </block>

  <block wx:else>
    <view class="auth-hero">
      <view class="auth-hero__mark"><line-icon name="user-round" size="30" tone="blue" /></view>
      <view class="auth-hero__body">
        <view class="eyebrow">MY ACCOUNT</view>
        <view class="auth-hero__title">嗨，{{accountNickname}}</view>
        <view class="auth-hero__copy">{{accountHeadCopy}}</view>
      </view>
    </view>

    <view class="paper-card account-hero">
      <view class="user-avatar account-hero__avatar user-avatar--{{accountAvatarTone}}">{{accountAvatarText}}</view>
      <view class="account-hero__body">
        <text class="account-hero__name">{{accountNickname}}</text>
        <text class="account-hero__id">ID · {{accountId}}</text>
        <view class="account-hero__tags"><text>{{accountTypeLabel}}</text><text>已登录</text></view>
      </view>
      <view class="account-hero__mark"><line-icon name="heart-pulse" size="25" tone="pink" /></view>
    </view>

    <view class="paper-card account-info">
      <view class="account-row" bindtap="onOpenSpace">
        <view class="account-row__icon"><line-icon name="house" size="25" tone="blue" /></view>
        <view class="account-row__body"><text>当前空间</text><text>{{spaceName}}</text></view>
        <view class="account-row__chevron"></view>
      </view>
      <view class="account-row">
        <view class="account-row__icon"><line-icon name="calendar-days" size="25" tone="green" /></view>
        <view class="account-row__body"><text>加入时间</text><text>{{accountCreatedAt}}</text></view>
      </view>
      <view class="account-row">
        <view class="account-row__icon"><line-icon name="lock" size="25" tone="gold" /></view>
        <view class="account-row__body"><text>数据范围</text><text>{{accountScopeCopy}}</text></view>
      </view>
    </view>

    <button class="secondary-button account-action" bindtap="onEditAccount"><line-icon name="pen-line" size="23" tone="ink" /><text>编辑昵称与头像</text></button>
    <button class="danger-button account-action" bindtap="onLogout"><line-icon name="rotate-ccw" size="23" tone="danger" /><text>退出登录</text></button>
    <view class="clear-account" bindtap="onClearAccount">{{clearAccountLabel}}</view>
  </block>
</view>
