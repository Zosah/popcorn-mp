<view class="page-shell auth-page">
  <block wx:if="{{mode === 'login'}}">
    <view class="auth-login">
      <view class="auth-intro">
        <view class="auth-intro__illustration">
          <view class="auth-intro__halo auth-intro__halo--peach"></view>
          <view class="auth-intro__halo auth-intro__halo--sage"></view>
          <view class="auth-intro__mark">
            <line-icon name="feature-journal" size="104" active="{{true}}" />
          </view>
          <view class="auth-intro__spark auth-intro__spark--one"></view>
          <view class="auth-intro__spark auth-intro__spark--two"></view>
        </view>
        <text class="auth-intro__title">把日子，放在一起</text>
        <text class="auth-intro__copy">和重要的人共享日常，也保留彼此的片刻。</text>
      </view>

      <view class="auth-panel">
        <view wx:if="{{loginNotice}}" class="auth-notice">
          <line-icon name="system-alert" size="24" tone="gold" />
          <text>{{loginNotice}}</text>
        </view>

        <view wx:if="{{hasAccount}}" class="known-account">
          <view class="user-avatar known-account__avatar user-avatar--{{accountAvatarTone}}">
            <image wx:if="{{accountAvatarUrl}}" class="user-avatar__image" src="{{accountAvatarUrl}}" mode="aspectFill" binderror="onAccountAvatarError" />
            <text wx:else>{{accountAvatarText}}</text>
          </view>
          <view class="known-account__body">
            <text class="known-account__label">上次登录</text>
            <text class="known-account__name">{{accountNickname}}</text>
          </view>
          <view class="known-account__mark"><line-icon name="system-check" size="24" tone="green" /></view>
        </view>

        <button
          class="auth-primary"
          hover-class="auth-primary--pressed"
          bindtap="onWechatLogin"
          loading="{{loginSubmitting}}"
          disabled="{{loginSubmitting}}"
        >
          <text>{{loginSubmitting ? '正在登录' : '登录并继续'}}</text>
          <line-icon wx:if="{{!loginSubmitting}}" class="auth-arrow-forward" name="system-back" size="24" tone="white" />
        </button>
        <text class="auth-primary-note">登录后设置头像和名字，让空间成员认出你</text>
        <view class="auth-privacy-link" bindtap="onOpenPrivacy">《隐私与数据说明》</view>
        <view class="auth-secondary" bindtap="onBack">{{returnToInvite ? '返回邀请' : '稍后再说'}}</view>
      </view>

      <view class="auth-footnote">
        <line-icon name="system-lock" size="22" tone="muted" />
        <text>你的记录只对共同空间成员可见</text>
      </view>
    </view>
  </block>

  <block wx:elif="{{mode === 'register'}}">
    <view class="auth-form-page">
      <view class="form-heading">
        <text class="form-heading__label">个人资料</text>
        <text class="form-heading__title">{{profileTitle}}</text>
        <text class="form-heading__copy">{{profileCopy}}</text>
      </view>

      <view class="identity-editor">
        <view class="avatar-stage">
          <view class="avatar-stage__ring avatar-stage__ring--outer"></view>
          <view class="avatar-stage__ring avatar-stage__ring--inner"></view>
          <view class="avatar-editor__preview user-avatar--{{selectedTone}}" bindtap="onPreviewAvatar">
            <image wx:if="{{avatarPreviewUrl}}" class="user-avatar__image" src="{{avatarPreviewUrl}}" mode="aspectFill" binderror="onAvatarImageError" />
            <text wx:else>{{nicknamePreview}}</text>
            <view wx:if="{{avatarUploading}}" class="avatar-editor__loading">
              <view class="avatar-editor__spinner"></view>
              <text>正在处理</text>
            </view>
          </view>
        </view>

        <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <line-icon name="system-image" size="25" tone="pink" />
          <text>{{avatarMediaId ? '获取新的微信头像' : '获取微信头像'}}</text>
        </button>
        <text wx:if="{{avatarError}}" class="profile-form__error profile-form__error--center">{{avatarError}}</text>
        <text wx:if="{{avatarUploadError}}" class="profile-form__error profile-form__error--center">{{avatarUploadError}}</text>
      </view>

      <view class="name-field">
        <view class="name-field__label-row">
          <text class="name-field__label">名字</text>
          <text class="name-field__hint">最多 16 个字</text>
        </view>
        <input
          class="name-field__input"
          type="nickname"
          maxlength="16"
          value="{{nicknameInput}}"
          placeholder="填写你的名字"
          placeholder-class="name-field__placeholder"
          confirm-type="done"
          bindinput="onNicknameInput"
        />
        <view wx:if="{{nicknameError}}" class="profile-form__error">{{nicknameError}}</view>
      </view>

      <button class="auth-primary auth-primary--profile" hover-class="auth-primary--pressed" bindtap="onSubmitProfile">
        <text>{{profileSubmitLabel}}</text>
        <line-icon class="auth-arrow-forward" name="system-back" size="24" tone="white" />
      </button>
    </view>
  </block>

  <block wx:else>
    <view class="account-page">
      <view class="account-identity">
        <view class="account-identity__wash account-identity__wash--one"></view>
        <view class="account-identity__wash account-identity__wash--two"></view>
        <view class="account-identity__top">
          <text class="account-identity__label">我的账号</text>
          <view class="account-identity__online">
            <view class="account-identity__dot"></view>
            <text>已登录</text>
          </view>
        </view>

        <view class="account-identity__person">
          <view class="user-avatar account-summary__avatar user-avatar--{{accountAvatarTone}}">
            <image wx:if="{{accountAvatarUrl}}" class="user-avatar__image" src="{{accountAvatarUrl}}" mode="aspectFill" binderror="onAccountAvatarError" />
            <text wx:else>{{accountAvatarText}}</text>
          </view>
          <view class="account-summary__body">
            <text class="account-summary__name">{{accountNickname}}</text>
            <text class="account-summary__caption">在 {{spaceName}} 一起生活</text>
          </view>
        </view>

        <view class="account-identity__meta">
          <text>加入于 {{accountCreatedAt}}</text>
          <text>{{accountTypeLabel}}</text>
        </view>
      </view>

      <button class="account-edit" hover-class="account-edit--pressed" bindtap="onEditAccount">
        <view class="account-edit__icon"><line-icon name="system-edit" size="26" tone="pink" /></view>
        <view class="account-edit__body">
          <text>修改头像与名字</text>
          <text>让朋友更容易认出你</text>
        </view>
        <line-icon class="auth-arrow-forward" name="system-back" size="21" tone="muted" />
      </button>

      <view class="account-info">
        <view class="account-row" hover-class="account-row--pressed" bindtap="onOpenSpace">
          <view class="account-row__icon"><line-icon name="system-space" size="26" tone="green" /></view>
          <view class="account-row__body"><text>共同空间</text><text>{{spaceName}}</text></view>
          <line-icon class="auth-arrow-forward" name="system-back" size="20" tone="muted" />
        </view>
        <view class="account-row">
          <view class="account-row__icon"><line-icon name="system-calendar" size="26" tone="blue" /></view>
          <view class="account-row__body"><text>加入时间</text><text>{{accountCreatedAt}}</text></view>
        </view>
      </view>

      <button class="account-logout" bindtap="onLogout">退出登录</button>
    </view>
  </block>
</view>
