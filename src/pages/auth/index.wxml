<view class="page-shell auth-page">
  <view class="subpage-back" bindtap="onBack">{{backLabel}}</view>

  <block wx:if="{{mode === 'login'}}">
    <view class="auth-login">
      <view class="auth-intro">
        <view class="auth-intro__mark"><line-icon name="user-round" size="48" tone="blue" /></view>
        <view class="auth-intro__title">登录时刻见</view>
        <view class="auth-intro__copy">和重要的人，一起记录日常。</view>
      </view>

      <view class="auth-panel">
        <view wx:if="{{loginNotice}}" class="auth-notice">
          <line-icon name="circle-alert" size="24" tone="gold" />
          <text>{{loginNotice}}</text>
        </view>

        <view wx:if="{{hasAccount}}" class="known-account">
          <view class="user-avatar known-account__avatar user-avatar--{{accountAvatarTone}}">
            <image wx:if="{{accountAvatarUrl}}" class="user-avatar__image" src="{{accountAvatarUrl}}" mode="aspectFill" binderror="onAccountAvatarError" />
            <text wx:else>{{accountAvatarText}}</text>
          </view>
          <view class="known-account__body">
            <text class="known-account__label">上次登录</text>
            <text class="known-account__name">{{accountNickname}}</text>
          </view>
          <view class="known-account__mark"><line-icon name="check" size="24" tone="blue" /></view>
        </view>

        <button class="primary-button auth-primary" bindtap="onWechatLogin">
          <line-icon name="user-round" size="28" tone="white" />
          <text>{{hasAccount ? '继续登录' : '微信一键登录'}}</text>
        </button>
        <view class="auth-secondary" bindtap="onBack">先看看，不登录</view>
      </view>

      <view class="auth-footnote">
        <line-icon name="lock" size="24" tone="muted" />
        <text>{{loginFootnote}}</text>
      </view>
    </view>
  </block>

  <block wx:elif="{{mode === 'register'}}">
    <view class="auth-form-page">
      <view class="form-heading">
        <view class="form-heading__mark"><line-icon name="pen-line" size="34" tone="pink" /></view>
        <view class="form-heading__body">
          <view class="form-heading__title">{{isEditing ? '编辑资料' : '完善资料'}}</view>
          <view class="form-heading__copy">{{isEditing ? registerCopy : '设置头像和昵称，方便朋友认出你。'}}</view>
        </view>
      </view>

      <view class="paper-card profile-form">
        <view class="profile-form__group profile-form__group--avatar">
          <view class="profile-form__heading">
            <text class="profile-form__label">头像</text>
            <text class="profile-form__hint">使用微信官方头像选择器</text>
          </view>
          <view class="avatar-editor">
            <view class="avatar-editor__preview user-avatar--{{selectedTone}}" bindtap="onPreviewAvatar">
              <image wx:if="{{avatarPreviewUrl}}" class="user-avatar__image" src="{{avatarPreviewUrl}}" mode="aspectFill" binderror="onAvatarImageError" />
              <text wx:else>{{nicknamePreview}}</text>
              <view wx:if="{{avatarUploading}}" class="avatar-editor__loading">上传中</view>
            </view>
            <view class="avatar-editor__actions">
              <button class="avatar-editor__action" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
                <line-icon name="image" size="24" tone="blue" />
                <text>{{avatarMediaId ? '更换微信头像' : '选择微信头像'}}</text>
              </button>
              <view wx:if="{{avatarMediaId && !avatarUploading}}" class="avatar-editor__remove" bindtap="onRemoveAvatar">移除头像</view>
            </view>
          </view>
          <view wx:if="{{avatarUploadError}}" class="profile-form__error">{{avatarUploadError}}</view>
        </view>

        <view class="profile-form__group profile-form__group--nickname">
          <text class="profile-form__label">昵称</text>
          <input class="profile-form__input" type="nickname" maxlength="16" value="{{nicknameInput}}" placeholder="你的微信昵称" placeholder-class="profile-form__placeholder" bindinput="onNicknameInput" />
          <view wx:if="{{nicknameError}}" class="profile-form__error">{{nicknameError}}</view>
        </view>
      </view>

      <button class="primary-button auth-primary" bindtap="onSubmitProfile">
        <line-icon name="check" size="28" tone="white" />
        <text>{{isEditing ? '保存资料' : '完成并进入空间'}}</text>
      </button>
      <view wx:if="{{!isEditing}}" class="auth-secondary" bindtap="onBack">先预览，稍后再完善</view>
    </view>
  </block>

  <block wx:else>
    <view class="account-page">
      <view class="paper-card account-summary">
        <view class="user-avatar account-summary__avatar user-avatar--{{accountAvatarTone}}">
          <image wx:if="{{accountAvatarUrl}}" class="user-avatar__image" src="{{accountAvatarUrl}}" mode="aspectFill" binderror="onAccountAvatarError" />
          <text wx:else>{{accountAvatarText}}</text>
        </view>
        <view class="account-summary__body">
          <text class="account-summary__name">{{accountNickname}}</text>
          <view class="account-summary__meta">
            <text>{{accountTypeLabel}}</text>
            <text>已登录</text>
          </view>
        </view>
      </view>

      <view class="paper-card account-info">
        <view class="account-row" bindtap="onOpenSpace">
          <view class="account-row__icon"><line-icon name="house" size="26" tone="blue" /></view>
          <view class="account-row__body"><text>当前空间</text><text>{{spaceName}}</text></view>
          <view class="account-row__chevron"></view>
        </view>
        <view class="account-row">
          <view class="account-row__icon"><line-icon name="calendar-days" size="26" tone="green" /></view>
          <view class="account-row__body"><text>加入时间</text><text>{{accountCreatedAt}}</text></view>
        </view>
      </view>

      <button class="secondary-button account-action" bindtap="onEditAccount">
        <line-icon name="pen-line" size="28" tone="ink" />
        <text>编辑昵称与头像</text>
      </button>
      <button class="danger-button account-action" bindtap="onLogout">
        <line-icon name="rotate-ccw" size="28" tone="danger" />
        <text>退出登录</text>
      </button>
    </view>
  </block>
</view>
