<view class="page-shell auth-page">
  <view class="auth-ambient auth-ambient--one"></view>
  <view class="auth-ambient auth-ambient--two"></view>

  <view class="subpage-back" bindtap="onBack">{{backLabel}}</view>

  <block wx:if="{{mode === 'login'}}">
    <view class="auth-head">
      <view class="eyebrow">WELCOME HOME</view>
      <view class="auth-head__title">回来就好，<text>家里有人等你。</text></view>
      <view class="auth-head__copy">登录后认领你的空间身份，和朋友一起维护同一份生活。</view>
    </view>

    <view class="auth-vignette glass-card">
      <view class="auth-vignette__copy">
        <text>一封写给共同生活的信</text>
        <text>从今天开始，把普通日子轻轻收好。</text>
        <view class="auth-vignette__rule"></view>
        <text class="auth-vignette__note">{{loginVignetteNote}}</text>
      </view>
      <image class="auth-vignette__image" src="../../images/ink-letter.png" mode="aspectFit" />
    </view>

    <view wx:if="{{hasAccount}}" class="detected-account glass-card">
      <view class="user-avatar user-avatar--{{accountAvatarTone}}">{{accountAvatarText}}</view>
      <view class="detected-account__body">
        <view class="detected-account__label">检测到本机账号</view>
        <view class="detected-account__name">{{accountNickname}}</view>
        <view class="detected-account__meta">继续登录后，空间身份会恢复</view>
      </view>
      <view class="detected-account__mark"><line-icon name="check" size="24" tone="accent" /></view>
    </view>

    <view wx:else class="login-promise">
      <view class="login-promise__item"><line-icon name="user-round" size="26" tone="accent" /><text>取一个称呼</text></view>
      <view class="login-promise__item"><line-icon name="pen-line" size="26" tone="accent" /><text>选一个头像色</text></view>
      <view class="login-promise__item"><line-icon name="house" size="26" tone="accent" /><text>回到共同空间</text></view>
    </view>

    <button class="primary-button auth-primary" bindtap="onWechatLogin">
      <line-icon name="{{hasAccount ? 'user-round' : 'plus'}}" size="25" tone="white" />
      <text>{{hasAccount ? '微信一键登录' : '微信快捷注册'}}</text>
    </button>
    <view class="auth-secondary" bindtap="onBack">先随便看看</view>

    <view class="auth-note">
      <line-icon name="lock" size="22" tone="muted" />
      <text>{{loginFootnote}}</text>
    </view>
  </block>

  <block wx:elif="{{mode === 'register'}}">
    <view class="auth-head auth-head--form">
      <view class="eyebrow">{{isEditing ? 'ABOUT YOU' : 'NICE TO MEET YOU'}}</view>
      <view class="auth-head__title">{{isEditing ? '换个你喜欢的称呼。' : '先给自己取个名字。'}}</view>
      <view class="auth-head__copy">{{isEditing ? registerCopy : (isDemoMode ? '不用填写手机号，先把这个 Demo 身份创建起来。' : '登录已完成，取一个昵称就可以开始。')}}</view>
    </view>

    <view class="profile-preview glass-card">
      <view class="user-avatar profile-preview__avatar user-avatar--{{selectedTone}}">{{nicknamePreview}}</view>
      <view class="profile-preview__body">
        <view class="profile-preview__label">{{profilePreviewLabel}}</view>
        <view class="profile-preview__name">{{nicknameInput || '还没取名字'}}</view>
        <view class="profile-preview__meta">加入「{{spaceName}}」 · {{profilePreviewMeta}}</view>
      </view>
      <view class="profile-preview__mark"><line-icon name="heart-pulse" size="26" tone="accent" /></view>
    </view>

    <view class="profile-form glass-card">
      <view class="profile-form__label">怎么称呼你</view>
      <input
        class="profile-form__input"
        type="nickname"
        maxlength="16"
        value="{{nicknameInput}}"
        placeholder="例如：小满"
        placeholder-class="profile-form__placeholder"
        bindinput="onNicknameInput"
      />
      <view wx:if="{{nicknameError}}" class="profile-form__error">{{nicknameError}}</view>

      <view class="profile-form__label profile-form__label--tones">头像颜色</view>
      <view class="tone-options">
        <view
          wx:for="{{avatarOptions}}"
          wx:key="value"
          class="tone-option {{selectedTone === item.value ? 'tone-option--active' : ''}}"
          data-tone="{{item.value}}"
          bindtap="onSelectTone"
        >
          <view class="tone-option__dot user-avatar--{{item.value}}"></view>
          <text>{{item.label}}</text>
        </view>
      </view>
      <view class="profile-form__hint">头像暂时使用昵称首字，后续可替换为自定义插画。</view>
    </view>

    <button class="primary-button auth-primary" bindtap="onSubmitProfile">
      <line-icon name="check" size="25" tone="white" />
      <text>{{isEditing ? '保存资料' : '创建账号并回家'}}</text>
    </button>
    <view wx:if="{{!isEditing}}" class="auth-secondary" bindtap="onBackToLogin">已经注册过？去登录</view>
  </block>

  <block wx:else>
    <view class="account-head">
      <view class="eyebrow">MY ACCOUNT</view>
      <view class="account-head__title">嗨，{{accountNickname}}</view>
      <view class="account-head__copy">{{accountHeadCopy}}</view>
    </view>

    <view class="account-hero glass-card">
      <view class="account-hero__halo account-hero__halo--one"></view>
      <view class="account-hero__halo account-hero__halo--two"></view>
      <view class="user-avatar account-hero__avatar user-avatar--{{accountAvatarTone}}">{{accountAvatarText}}</view>
      <view class="account-hero__body">
        <view class="account-hero__name">{{accountNickname}}</view>
        <view class="account-hero__id">ID · {{accountId}}</view>
        <view class="account-hero__tags">
          <text>{{accountTypeLabel}}</text>
          <text>已登录</text>
        </view>
      </view>
      <view class="account-hero__mark"><line-icon name="user-round" size="28" tone="accent" /></view>
    </view>

    <view class="account-info glass-card">
      <view class="account-row" bindtap="onOpenSpace">
        <view class="account-row__icon"><line-icon name="house" size="27" tone="accent" /></view>
        <view class="account-row__body"><text>当前空间</text><text>{{spaceName}}</text></view>
        <view class="account-row__chevron"></view>
      </view>
      <view class="account-row">
        <view class="account-row__icon"><line-icon name="calendar-days" size="27" tone="accent" /></view>
        <view class="account-row__body"><text>加入时间</text><text>{{accountCreatedAt}}</text></view>
      </view>
      <view class="account-row">
        <view class="account-row__icon"><line-icon name="lock" size="27" tone="accent" /></view>
        <view class="account-row__body"><text>数据范围</text><text>{{accountScopeCopy}}</text></view>
      </view>
    </view>

    <button class="secondary-button account-action" bindtap="onEditAccount"><line-icon name="pen-line" size="24" tone="ink" /><text>编辑昵称与头像</text></button>
    <button class="danger-button account-action" bindtap="onLogout"><line-icon name="rotate-ccw" size="24" tone="danger" /><text>退出登录</text></button>
    <view class="clear-account" bindtap="onClearAccount">{{clearAccountLabel}}</view>
  </block>
</view>
