.auth-page {
  overflow: hidden;
  padding: 36rpx 36rpx calc(72rpx + env(safe-area-inset-bottom));
}

.auth-ambient {
  position: absolute;
  border-radius: 50%;
  filter: blur(4rpx);
  pointer-events: none;
}

.auth-ambient--one {
  top: 40rpx;
  right: -150rpx;
  width: 420rpx;
  height: 420rpx;
  background: radial-gradient(circle, rgba(214, 206, 255, 0.64), rgba(214, 206, 255, 0));
}

.auth-ambient--two {
  top: 620rpx;
  left: -190rpx;
  width: 460rpx;
  height: 460rpx;
  background: radial-gradient(circle, rgba(197, 239, 225, 0.64), rgba(197, 239, 225, 0));
}

.auth-head {
  position: relative;
  z-index: 1;
  padding: 14rpx 4rpx 28rpx;
}

.auth-head--form {
  padding-bottom: 24rpx;
}

.auth-head__title,
.account-head__title {
  max-width: 650rpx;
  margin-top: 12rpx;
  color: var(--c-text, #292737);
  font-family: "Songti SC", "STSong", serif;
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: -2rpx;
  line-height: 1.32;
}

.auth-head__title text {
  display: block;
  color: var(--c-primary-deep, #665bd7);
}

.auth-head__copy,
.account-head__copy {
  max-width: 610rpx;
  margin-top: 14rpx;
  color: var(--c-text-2, #615f70);
  font-size: 23rpx;
  line-height: 1.7;
}

.auth-vignette {
  display: flex;
  min-height: 310rpx;
  align-items: stretch;
  padding: 28rpx 24rpx 24rpx;
  border-radius: 40rpx;
  background: linear-gradient(142deg, rgba(255, 255, 255, 0.88), rgba(244, 237, 225, 0.74));
}

.auth-vignette__copy {
  display: flex;
  min-width: 0;
  padding: 5rpx 2rpx;
  flex: 1;
  flex-direction: column;
}

.auth-vignette__copy > text:first-child {
  color: var(--c-text, #292737);
  font-family: "Songti SC", "STSong", serif;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
}

.auth-vignette__copy > text:nth-child(2) {
  margin-top: 9rpx;
  color: var(--c-text-2, #615f70);
  font-size: 20rpx;
  line-height: 1.6;
}

.auth-vignette__rule {
  width: 54rpx;
  height: 2rpx;
  margin-top: 24rpx;
  background: rgba(117, 105, 232, 0.34);
}

.auth-vignette__note {
  margin-top: auto;
  color: var(--c-muted, #9592a4);
  font-size: 17rpx;
  line-height: 1.65;
}

.auth-vignette__image {
  width: 176rpx;
  height: 250rpx;
  margin-left: 22rpx;
  border: 8rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.52);
  box-shadow: 0 14rpx 32rpx rgba(92, 77, 132, 0.11);
  flex-shrink: 0;
  transform: rotate(1.5deg);
}

.detected-account {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.88), rgba(232, 247, 241, 0.72));
}

.user-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 5rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 28rpx;
  box-shadow: 0 10rpx 24rpx rgba(92, 77, 132, 0.11);
  color: #4f476f;
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.user-avatar--lavender {
  background: linear-gradient(145deg, #e7e2ff, #c9c1fb);
}

.user-avatar--mint {
  background: linear-gradient(145deg, #dcf5ed, #b8e7d9);
}

.user-avatar--peach {
  background: linear-gradient(145deg, #ffe5e5, #f6c7cf);
}

.user-avatar--sun {
  background: linear-gradient(145deg, #fff0ce, #f5d89a);
}

.detected-account .user-avatar {
  width: 78rpx;
  height: 78rpx;
}

.detected-account__body {
  min-width: 0;
  margin-left: 17rpx;
  flex: 1;
}

.detected-account__label {
  color: var(--c-muted, #9592a4);
  font-size: 17rpx;
}

.detected-account__name {
  margin-top: 3rpx;
  color: var(--c-text, #292737);
  font-size: 27rpx;
  font-weight: 600;
}

.detected-account__meta {
  margin-top: 4rpx;
  color: var(--c-text-2, #615f70);
  font-size: 18rpx;
}

.detected-account__mark {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.62);
}

.login-promise {
  display: grid;
  margin-top: 20rpx;
  padding: 22rpx 10rpx;
  border-top: 1rpx solid rgba(106, 98, 139, 0.10);
  border-bottom: 1rpx solid rgba(106, 98, 139, 0.10);
  grid-template-columns: repeat(3, 1fr);
}

.login-promise__item {
  display: flex;
  align-items: center;
  color: var(--c-text-2, #615f70);
  flex-direction: column;
  font-size: 17rpx;
  gap: 8rpx;
}

.auth-primary {
  width: 100%;
  margin-top: 26rpx;
}

.auth-secondary {
  margin-top: 18rpx;
  color: var(--c-muted, #9592a4);
  font-size: 21rpx;
  text-align: center;
}

.auth-note {
  display: flex;
  align-items: flex-start;
  margin-top: 26rpx;
  padding: 18rpx 4rpx 0;
  border-top: 1rpx solid rgba(106, 98, 139, 0.08);
  color: var(--c-muted, #9592a4);
  font-size: 18rpx;
  gap: 10rpx;
  line-height: 1.65;
}

.auth-note text {
  flex: 1;
}

.profile-preview {
  display: flex;
  align-items: center;
  padding: 25rpx 24rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.88), rgba(238, 234, 255, 0.72));
}

.profile-preview__avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 34rpx;
  font-size: 38rpx;
}

.profile-preview__body {
  min-width: 0;
  margin-left: 20rpx;
  flex: 1;
}

.profile-preview__label {
  color: var(--c-muted, #9592a4);
  font-size: 17rpx;
}

.profile-preview__name {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--c-text, #292737);
  font-size: 30rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-preview__meta {
  margin-top: 5rpx;
  color: var(--c-text-2, #615f70);
  font-size: 18rpx;
}

.profile-preview__mark {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.64);
}

.profile-form {
  margin-top: 20rpx;
  padding: 27rpx 24rpx 24rpx;
  border-radius: 38rpx;
}

.profile-form__label {
  color: var(--c-text-2, #615f70);
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.profile-form__label--tones {
  margin-top: 28rpx;
}

.profile-form__input {
  height: 82rpx;
  margin-top: 10rpx;
  padding: 0 2rpx;
  border-bottom: 1rpx solid rgba(106, 98, 139, 0.22);
  box-sizing: border-box;
  color: var(--c-text, #292737);
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 600;
}

.profile-form__placeholder {
  color: var(--c-faint, #bbb8c8);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 25rpx;
  font-weight: 400;
}

.profile-form__error {
  margin-top: 9rpx;
  color: var(--c-danger, #df6f7d);
  font-size: 19rpx;
}

.tone-options {
  display: grid;
  margin-top: 15rpx;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.tone-option {
  display: flex;
  min-width: 0;
  align-items: center;
  padding: 12rpx 8rpx;
  border: 1rpx solid transparent;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.46);
  flex-direction: column;
  gap: 8rpx;
}

.tone-option--active {
  border-color: rgba(117, 105, 232, 0.30);
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 8rpx 18rpx rgba(92, 77, 132, 0.07);
}

.tone-option__dot {
  width: 38rpx;
  height: 38rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 15rpx;
  box-shadow: 0 5rpx 12rpx rgba(92, 77, 132, 0.09);
}

.tone-option text {
  color: var(--c-text-2, #615f70);
  font-size: 16rpx;
}

.profile-form__hint {
  margin-top: 17rpx;
  color: var(--c-muted, #9592a4);
  font-size: 17rpx;
  line-height: 1.6;
}

.account-head {
  position: relative;
  z-index: 1;
  padding: 12rpx 4rpx 25rpx;
}

.account-head__title {
  font-size: 48rpx;
}

.account-hero {
  display: flex;
  align-items: center;
  padding: 30rpx 26rpx;
  border-radius: 40rpx;
  background: linear-gradient(138deg, rgba(255, 255, 255, 0.88), rgba(233, 246, 241, 0.72));
}

.account-hero__halo {
  position: absolute;
  border-radius: 50%;
}

.account-hero__halo--one {
  top: -70rpx;
  right: -50rpx;
  width: 220rpx;
  height: 220rpx;
  background: rgba(203, 195, 255, 0.28);
}

.account-hero__halo--two {
  bottom: -100rpx;
  left: 120rpx;
  width: 230rpx;
  height: 230rpx;
  background: rgba(190, 234, 218, 0.28);
}

.account-hero__avatar {
  position: relative;
  z-index: 1;
  width: 116rpx;
  height: 116rpx;
  border-radius: 40rpx;
  font-size: 42rpx;
}

.account-hero__body {
  position: relative;
  z-index: 1;
  min-width: 0;
  margin-left: 22rpx;
  flex: 1;
}

.account-hero__name {
  color: var(--c-text, #292737);
  font-size: 32rpx;
  font-weight: 600;
}

.account-hero__id {
  margin-top: 4rpx;
  color: var(--c-muted, #9592a4);
  font-size: 16rpx;
  letter-spacing: 1rpx;
}

.account-hero__tags {
  display: flex;
  margin-top: 13rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}

.account-hero__tags text {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.58);
  color: var(--c-text-2, #615f70);
  font-size: 16rpx;
}

.account-hero__mark {
  position: relative;
  z-index: 1;
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 21rpx;
  background: rgba(255, 255, 255, 0.62);
}

.account-info {
  margin-top: 20rpx;
  padding: 2rpx 24rpx;
  border-radius: 38rpx;
}

.account-row {
  display: flex;
  min-height: 108rpx;
  align-items: center;
  border-bottom: 1rpx solid rgba(106, 98, 139, 0.09);
}

.account-row:last-child {
  border-bottom: 0;
}

.account-row__icon {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.68);
  flex-shrink: 0;
}

.account-row__body {
  min-width: 0;
  margin-left: 16rpx;
  flex: 1;
}

.account-row__body text {
  display: block;
  color: var(--c-text, #292737);
  font-size: 23rpx;
  font-weight: 600;
}

.account-row__body text + text {
  margin-top: 4rpx;
  color: var(--c-muted, #9592a4);
  font-size: 18rpx;
  font-weight: 400;
}

.account-row__chevron {
  width: 10rpx;
  height: 10rpx;
  border-top: 1rpx solid var(--c-faint, #bbb8c8);
  border-right: 1rpx solid var(--c-faint, #bbb8c8);
  transform: rotate(45deg);
}

.account-action {
  width: 100%;
  margin-top: 18rpx;
}

.clear-account {
  margin-top: 24rpx;
  color: var(--c-faint, #bbb8c8);
  font-size: 18rpx;
  text-align: center;
}
