.auth-page {
  --auth-deep: var(--c-primary, #252b27);
  --auth-blue-soft: var(--c-sage-soft, #e2eee9);
  --auth-ink: var(--c-text, #252b27);
  --auth-ink-2: var(--c-text-2, #5f5a53);
  --auth-ink-3: var(--c-muted, #837f76);
  --auth-line: var(--c-line, #e9e6e1);
  padding: 28rpx 36rpx calc(104rpx + env(safe-area-inset-bottom));
  background: var(--c-paper, #f8f7f4);
  color: var(--auth-ink);
}
.paper-card { box-sizing: border-box; border: 1rpx solid var(--auth-line); border-radius: 30rpx; background: #ffffff; box-shadow: 0 12rpx 30rpx rgba(42, 62, 50, 0.045); }

.auth-hero { display: flex; align-items: flex-start; padding: 8rpx 2rpx 27rpx; gap: 18rpx; }
.auth-hero--form { padding-bottom: 29rpx; }
.auth-hero__mark { display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border-radius: 24rpx; background: var(--auth-blue-soft); flex-shrink: 0; }
.auth-hero__body { min-width: 0; flex: 1; }
.auth-hero__title {
  font-family: var(--font-serif); margin-top: 8rpx; color: var(--auth-ink); font-size: 45rpx; font-weight: 700; line-height: 1.3; letter-spacing: -1.4rpx; }
.auth-hero__copy { margin-top: 9rpx; color: var(--auth-ink-2); font-size: 25rpx; line-height: 1.62; }

.auth-vignette { display: flex; align-items: center; overflow: hidden; min-height: 230rpx; padding: 21rpx 19rpx 21rpx 24rpx; background: linear-gradient(145deg, #f7fafc, #ffffff); gap: 12rpx; }
.auth-vignette__copy { min-width: 0; flex: 1; }
.auth-vignette__copy > text { display: block; }
.auth-vignette__copy > text:first-child { color: var(--auth-ink); font-family: "Songti SC", "STSong", serif; font-size: 32rpx; font-weight: 600; line-height: 1.5; }
.auth-vignette__copy > text:nth-child(2) { margin-top: 7rpx; color: var(--auth-ink-2); font-size: 22rpx; line-height: 1.6; }
.auth-vignette__rule { width: 42rpx; height: 3rpx; margin: 17rpx 0 12rpx; border-radius: 999rpx; background: #b8cfdf; }
.auth-vignette__note { color: var(--auth-ink-3); font-size: 21rpx; line-height: 1.55; }
.auth-vignette__image { width: 176rpx; height: 218rpx; flex-shrink: 0; transform: rotate(1.4deg); }

.detected-account { display: flex; align-items: center; margin-top: 18rpx; padding: 18rpx; gap: 13rpx; }
.user-avatar { display: flex; align-items: center; justify-content: center; border: 2rpx solid rgba(255, 255, 255, 0.9); box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.75); color: var(--auth-ink); font-family: "Songti SC", "STSong", serif; font-weight: 600; }
.user-avatar--lavender { background: #d7e2e8; }
.user-avatar--mint { background: var(--c-sage-soft, #e2eee9); }
.user-avatar--peach { background: #e8cbc6; }
.user-avatar--sun { background: var(--c-butter-soft, #f2e8cc); }
.detected-account__avatar { width: 76rpx; height: 76rpx; border-radius: 25rpx; flex-shrink: 0; font-size: 32rpx; }
.detected-account__body { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.detected-account__label { color: var(--auth-ink-3); font-size: 20rpx; }
.detected-account__name { margin-top: 2rpx; color: var(--auth-ink); font-size: 29rpx; font-weight: 700; }
.detected-account__meta { margin-top: 2rpx; color: var(--auth-ink-2); font-size: 21rpx; }
.detected-account__mark { display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; border-radius: 15rpx; background: var(--auth-blue-soft); flex-shrink: 0; }

.login-promises { display: grid; margin-top: 17rpx; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; }
.login-promise { display: flex; min-height: 108rpx; align-items: center; padding: 12rpx 8rpx; border: 1rpx solid var(--auth-line); border-radius: 23rpx; background: #ffffff; flex-direction: column; gap: 7rpx; text-align: center; }
.login-promise__mark { display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; border-radius: 15rpx; background: var(--c-paper-2, #f1ede7); }
.login-promise text { color: var(--auth-ink-2); font-size: 21rpx; }
.auth-primary { width: 100%; margin-top: 23rpx; gap: 9rpx; }
.auth-secondary { margin-top: 16rpx; color: var(--auth-ink-2); font-size: 23rpx; text-align: center; }
.auth-note { display: flex; align-items: flex-start; margin: 20rpx 8rpx 0; padding: 13rpx 15rpx; border-radius: 20rpx; background: var(--c-paper-2, #f1ede7); color: var(--auth-ink-3); gap: 7rpx; font-size: 21rpx; line-height: 1.55; }
.auth-note text { flex: 1; }

.profile-preview { display: flex; align-items: center; padding: 19rpx; gap: 14rpx; background: linear-gradient(145deg, #ffffff, var(--c-paper-2, #f1ede7)); }
.profile-preview__avatar { width: 88rpx; height: 88rpx; border-radius: 30rpx; flex-shrink: 0; font-size: 37rpx; }
.profile-preview__body { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.profile-preview__label { color: var(--auth-ink-3); font-size: 20rpx; }
.profile-preview__name { margin-top: 2rpx; color: var(--auth-ink); font-size: 30rpx; font-weight: 700; }
.profile-preview__meta { margin-top: 4rpx; color: var(--auth-ink-2); font-size: 21rpx; }
.profile-preview__mark { display: flex; width: 48rpx; height: 48rpx; align-items: center; justify-content: center; border-radius: 16rpx; background: #fbf0ee; flex-shrink: 0; }

.profile-form { margin-top: 17rpx; padding: 20rpx 22rpx; }
.profile-form__group { padding: 4rpx 0 18rpx; border-bottom: 1rpx solid var(--auth-line); }
.profile-form__group--tones { padding-top: 20rpx; padding-bottom: 0; border-bottom: 0; }
.profile-form__label { color: var(--auth-ink-3); font-size: 22rpx; font-weight: 600; }
.profile-form__input { height: 76rpx; margin-top: 5rpx; padding: 0 14rpx; border-radius: 19rpx; background: var(--c-paper-2, #f1ede7); box-sizing: border-box; color: var(--auth-ink); font-family: "Songti SC", "STSong", serif; font-size: 35rpx; font-weight: 600; }
.profile-form__placeholder { color: var(--c-muted, #837f76); font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 27rpx; font-weight: 400; }
.profile-form__error { margin-top: 7rpx; color: var(--c-primary-link, #b86757); font-size: 22rpx; }
.tone-options { display: grid; margin-top: 13rpx; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 9rpx; }
.tone-option { display: flex; min-width: 0; align-items: center; padding: 10rpx 5rpx; border: 1rpx solid var(--auth-line); border-radius: 19rpx; background: var(--c-paper, #f8f7f4); flex-direction: column; gap: 6rpx; }
.tone-option--active { border-color: #b7cbd5; background: var(--c-paper-2, #f1ede7); }
.tone-option__dot { display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; border: 2rpx solid rgba(255, 255, 255, 0.92); border-radius: 14rpx; }
.tone-option text { color: var(--auth-ink-2); font-size: 20rpx; }
.profile-form__hint { margin-top: 13rpx; color: var(--auth-ink-3); font-size: 20rpx; line-height: 1.55; }

.account-hero { display: flex; align-items: center; padding: 24rpx 21rpx; gap: 16rpx; background: linear-gradient(145deg, #ffffff, var(--c-paper-2, #f1ede7)); }
.account-hero__avatar { width: 102rpx; height: 102rpx; border-radius: 34rpx; flex-shrink: 0; font-size: 41rpx; }
.account-hero__body { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.account-hero__name { color: var(--auth-ink); font-size: 34rpx; font-weight: 700; }
.account-hero__id { margin-top: 3rpx; color: var(--auth-ink-3); font-size: 19rpx; letter-spacing: 1rpx; }
.account-hero__tags { display: flex; margin-top: 10rpx; flex-wrap: wrap; gap: 6rpx; }
.account-hero__tags text { padding: 5rpx 10rpx; border-radius: 999rpx; background: rgba(255, 255, 255, 0.8); color: var(--auth-ink-2); font-size: 19rpx; }
.account-hero__mark { display: flex; width: 48rpx; height: 48rpx; align-items: center; justify-content: center; border-radius: 16rpx; background: #fbf0ee; flex-shrink: 0; }
.account-info { margin-top: 17rpx; padding: 0 20rpx; }
.account-row { display: flex; min-height: 98rpx; align-items: center; border-bottom: 1rpx solid var(--auth-line); gap: 12rpx; }
.account-row:last-child { border-bottom: 0; }
.account-row__icon { display: flex; width: 50rpx; height: 50rpx; align-items: center; justify-content: center; border-radius: 17rpx; background: var(--c-paper-2, #f1ede7); flex-shrink: 0; }
.account-row__body { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.account-row__body text:first-child { color: var(--auth-ink); font-size: 25rpx; font-weight: 600; }
.account-row__body text:last-child { margin-top: 3rpx; color: var(--auth-ink-3); font-size: 21rpx; }
.account-row__chevron { width: 10rpx; height: 10rpx; border-top: 1rpx solid #bdb4aa; border-right: 1rpx solid #bdb4aa; transform: rotate(45deg); }
.account-action { width: 100%; margin-top: 15rpx; }
.clear-account { margin-top: 20rpx; color: var(--auth-ink-3); font-size: 21rpx; text-align: center; }
