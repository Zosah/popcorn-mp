.auth-page {
  --auth-deep: var(--c-primary, #252b27);
  --auth-blue-soft: var(--c-sage-soft, #e2eee9);
  --auth-ink: var(--c-text, #252b27);
  --auth-ink-2: var(--c-text-2, #5f5a53);
  --auth-ink-3: var(--c-muted, #837f76);
  --auth-line: var(--c-line, #e9e6e1);
  padding: 28rpx 36rpx calc(72rpx + env(safe-area-inset-bottom));
  background: var(--c-paper, #f8f7f4);
  color: var(--auth-ink);
}

.paper-card {
  box-sizing: border-box;
  border: 1rpx solid var(--auth-line);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 36rpx -30rpx rgba(42, 62, 50, 0.16);
}

/* 登录：一个身份锚点、一个主操作，不再重复解释登录能力。 */
.auth-login {
  display: flex;
  min-height: calc(100vh - 190rpx);
  box-sizing: border-box;
  flex-direction: column;
}

.auth-intro {
  display: flex;
  align-items: center;
  padding: 96rpx 0 58rpx;
  flex-direction: column;
  text-align: center;
}

.auth-intro__mark {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 36rpx;
  background: linear-gradient(145deg, #eef6f2, #dfeae5);
  box-shadow: 0 18rpx 36rpx -24rpx rgba(73, 106, 92, 0.4);
}

.auth-intro__title {
  margin-top: 28rpx;
  color: var(--auth-ink);
  font-family: var(--font-serif);
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: -1.4rpx;
  line-height: 1.3;
}

.auth-intro__copy {
  margin-top: 12rpx;
  color: var(--auth-ink-2);
  font-size: 27rpx;
  line-height: 1.6;
}

.auth-panel {
  width: 100%;
}

.auth-notice {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(201, 167, 100, 0.22);
  border-radius: 22rpx;
  background: rgba(242, 232, 204, 0.62);
  color: #7e693e;
  gap: 10rpx;
}

.auth-notice text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.5;
}

.known-account {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--auth-line);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.78);
  gap: 14rpx;
}

.user-avatar {
  display: flex;
  overflow: hidden;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.75);
  color: var(--auth-ink);
  font-family: "Songti SC", "STSong", serif;
  font-weight: 600;
}

.user-avatar--lavender { background: #d7e2e8; }
.user-avatar--mint { background: var(--c-sage-soft, #e2eee9); }
.user-avatar--peach { background: #e8cbc6; }
.user-avatar--sun { background: var(--c-butter-soft, #f2e8cc); }

.user-avatar__image {
  display: block;
  width: 100%;
  height: 100%;
}

.known-account__avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  font-size: 28rpx;
}

.known-account__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.known-account__label {
  color: var(--auth-ink-3);
  font-size: 23rpx;
  line-height: 1.35;
}

.known-account__name {
  margin-top: 2rpx;
  overflow: hidden;
  color: var(--auth-ink);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.known-account__mark {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  background: var(--auth-blue-soft);
  flex-shrink: 0;
}

.auth-primary {
  width: 100%;
  margin-top: 0;
  gap: 10rpx;
}

.auth-secondary {
  display: flex;
  min-height: 78rpx;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
  color: var(--auth-ink-2);
  font-size: 25rpx;
  text-align: center;
}

.auth-footnote {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: auto;
  padding-top: 34rpx;
  color: var(--auth-ink-3);
  gap: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

/* 资料确认：去掉重复预览，头像与昵称各只出现一次。 */
.auth-form-page {
  padding-top: 6rpx;
}

.form-heading {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  gap: 18rpx;
}

.form-heading__mark {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 25rpx;
  background: #f7e9e5;
  flex-shrink: 0;
}

.form-heading__body {
  min-width: 0;
  flex: 1;
}

.form-heading__title {
  color: var(--auth-ink);
  font-family: var(--font-serif);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.form-heading__copy {
  margin-top: 5rpx;
  color: var(--auth-ink-2);
  font-size: 25rpx;
  line-height: 1.55;
}

.profile-form {
  padding: 0 24rpx;
}

.profile-form__group {
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--auth-line);
}

.profile-form__group:last-child {
  border-bottom: 0;
}

.profile-form__heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.profile-form__label {
  color: var(--auth-ink);
  font-size: 27rpx;
  font-weight: 700;
}

.profile-form__hint {
  color: var(--auth-ink-3);
  font-size: 23rpx;
}

.avatar-editor {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  gap: 20rpx;
}

.avatar-editor__preview {
  position: relative;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  overflow: hidden;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 30rpx;
  flex-shrink: 0;
  color: var(--auth-ink);
  font-size: 38rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 24rpx -18rpx rgba(71, 64, 57, 0.5);
}

.avatar-editor__actions {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  flex-direction: column;
  gap: 8rpx;
}

.avatar-editor__action {
  display: flex;
  width: auto;
  min-height: 0;
  align-items: center;
  margin: 0;
  padding: 10rpx 14rpx;
  border-radius: 16rpx;
  background: var(--c-paper-2, #f1ede7);
  gap: 7rpx;
  line-height: 1.2;
}

.avatar-editor__action::after {
  border: 0;
}

.avatar-editor__action text {
  color: var(--auth-ink-2);
  font-size: 23rpx;
}

.avatar-editor__remove {
  padding: 2rpx 4rpx;
  color: var(--auth-ink-3);
  font-size: 22rpx;
}

.avatar-editor__loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(41, 45, 42, 0.52);
  color: #fff;
  font-size: 18rpx;
  font-weight: 500;
}

.profile-form__group--nickname .profile-form__label {
  display: block;
  margin-bottom: 12rpx;
}

.profile-form__input {
  width: 100%;
  height: 82rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  background: var(--c-paper-2, #f1ede7);
  box-sizing: border-box;
  color: var(--auth-ink);
  font-size: 30rpx;
  font-weight: 600;
}

.profile-form__placeholder {
  color: var(--c-muted, #837f76);
  font-size: 25rpx;
  font-weight: 400;
}

.profile-form__error {
  margin-top: 10rpx;
  color: var(--c-primary-link, #b86757);
  font-size: 23rpx;
}

.auth-form-page .auth-primary {
  margin-top: 24rpx;
}

/* 已登录：账号信息只出现一次，保留真正需要的空间与时间信息。 */
.account-page {
  padding-top: 8rpx;
}

.account-summary {
  display: flex;
  align-items: center;
  padding: 24rpx 22rpx;
  gap: 18rpx;
}

.account-summary__avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
  font-size: 38rpx;
}

.account-summary__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.account-summary__name {
  overflow: hidden;
  color: var(--auth-ink);
  font-family: var(--font-serif);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-summary__meta {
  display: flex;
  margin-top: 9rpx;
  flex-wrap: wrap;
  gap: 7rpx;
}

.account-summary__meta text {
  padding: 5rpx 11rpx;
  border-radius: 999rpx;
  background: var(--c-paper-2, #f1ede7);
  color: var(--auth-ink-2);
  font-size: 22rpx;
  line-height: 1.25;
}

.account-info {
  margin-top: 18rpx;
  padding: 0 22rpx;
}

.account-row {
  display: flex;
  min-height: 104rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--auth-line);
  gap: 14rpx;
}

.account-row:last-child {
  border-bottom: 0;
}

.account-row__icon {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  background: var(--c-paper-2, #f1ede7);
  flex-shrink: 0;
}

.account-row__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.account-row__body text:first-child {
  color: var(--auth-ink);
  font-size: 26rpx;
  font-weight: 600;
}

.account-row__body text:last-child {
  margin-top: 3rpx;
  color: var(--auth-ink-3);
  font-size: 23rpx;
}

.account-row__chevron {
  width: 10rpx;
  height: 10rpx;
  border-top: 1rpx solid #bdb4aa;
  border-right: 1rpx solid #bdb4aa;
  transform: rotate(45deg);
}

.account-action {
  width: 100%;
  margin-top: 16rpx;
}
