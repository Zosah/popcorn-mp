.date-stamp {
  display: flex;
  height: 156rpx;
  align-items: flex-end;
  padding-bottom: 26rpx;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.date-stamp__day {
  color: var(--c-accent, #5b6ee0);
  font-family: "Songti SC", "STSong", serif;
  font-size: 80rpx;
  font-weight: 500;
  letter-spacing: -10rpx;
  line-height: 0.72;
}

.date-stamp__meta {
  display: flex;
  margin-left: 30rpx;
  padding-bottom: 2rpx;
  flex-direction: column;
  color: var(--c-muted, #9497a6);
  font-size: 22rpx;
  line-height: 1.55;
}

.date-stamp__month {
  color: var(--c-text, #22242e);
  font-size: 24rpx;
  font-weight: 500;
}

.home-intro {
  padding: 34rpx 0 36rpx;
}

.home-intro__title {
  color: var(--c-text, #22242e);
  font-size: 48rpx;
  font-weight: 500;
  letter-spacing: -2rpx;
  line-height: 1.25;
}

.home-intro__copy {
  margin-top: 10rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 26rpx;
  line-height: 1.6;
}

.home-visual {
  margin-top: 2rpx;
  padding: 20rpx 0 28rpx;
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
}

.home-visual__image {
  display: block;
  width: 100%;
  height: 300rpx;
  background: var(--c-primary-soft, #eaedfc);
}

.home-visual__caption {
  display: flex;
  gap: 10rpx;
  padding-top: 18rpx;
  flex-direction: column;
}

.home-visual__title {
  color: var(--c-text, #22242e);
  font-family: "Songti SC", "STSong", serif;
  font-size: 28rpx;
  line-height: 1.45;
}

.home-visual__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.home-visual__credit {
  color: var(--c-muted, #9497a6);
  font-size: 18rpx;
  letter-spacing: 1rpx;
  line-height: 1.5;
}

.home-visual__action {
  display: inline-flex;
  align-items: center;
  gap: 7rpx;
  padding-bottom: 3rpx;
  border-bottom: 1rpx solid currentColor;
  color: var(--c-accent, #5b6ee0);
  flex-shrink: 0;
  font-size: 21rpx;
  line-height: 1.5;
}

.notice {
  padding: 28rpx 0 30rpx;
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-bottom: 1rpx solid var(--c-line-strong, #d6d5e0);
}

.notice__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--c-text-2, #5c5f6e);
  font-size: 22rpx;
}

.notice__label {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.notice__body {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 14rpx;
}

.notice__value {
  display: flex;
  align-items: baseline;
}

.notice__number {
  color: var(--c-text, #22242e);
  font-family: "Songti SC", "STSong", serif;
  font-size: 64rpx;
  font-weight: 500;
  letter-spacing: -4rpx;
  line-height: 1;
}

.notice__number--alert {
  color: var(--c-danger, #e8695c);
}

.notice__unit {
  margin-left: 14rpx;
  color: var(--c-text, #22242e);
  font-size: 26rpx;
}

.notice__action {
  padding-bottom: 4rpx;
  border-bottom: 1rpx solid currentColor;
  color: var(--c-text, #22242e);
  font-size: 22rpx;
}

.notice__copy {
  margin-top: 12rpx;
  color: var(--c-muted, #9497a6);
  font-size: 22rpx;
  line-height: 1.6;
}

.section-head {
  margin-top: 38rpx;
}

.quicklinks {
  display: flex;
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.quicklink {
  display: flex;
  height: 154rpx;
  align-items: center;
  justify-content: center;
  flex: 1;
  flex-direction: column;
}

.quicklink + .quicklink {
  border-left: 1rpx solid var(--c-line, #e7e6ee);
}

.quicklink__value {
  margin-top: 10rpx;
  color: var(--c-text, #22242e);
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1;
}

.quicklink__label {
  margin-top: 9rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 20rpx;
}

.recent-list {
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.recent-row {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  border-top: 1rpx solid var(--c-line, #e7e6ee);
}

.recent-row__date {
  width: 82rpx;
  flex-shrink: 0;
  color: var(--c-muted, #9497a6);
  font-family: "Songti SC", "STSong", serif;
  font-size: 32rpx;
}

.recent-row__body {
  display: flex;
  min-width: 0;
  flex: 1;
  padding: 20rpx 12rpx 20rpx 0;
  flex-direction: column;
}

.recent-row__title {
  overflow: hidden;
  color: var(--c-text, #22242e);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-row__meta {
  overflow: hidden;
  margin-top: 6rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-row__mark {
  display: flex;
  width: 24rpx;
  height: 24rpx;
  margin-left: 14rpx;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.recent-row--empty .recent-row__title {
  color: var(--c-text-2, #5c5f6e);
  font-weight: 400;
}

.home-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.home-foot__pet {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.home-foot__strong {
  color: var(--c-text-2, #5c5f6e);
  font-weight: 500;
}
