/* ================= 场景切换 ================= */








/* ================= 错误提示 ================= */
.home-error {
  display: flex;
  align-items: center;
  margin: -6rpx 40rpx 20rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(198, 125, 109, 0.18);
  border-radius: 24rpx;
  background: var(--c-coral-soft);
}

.home-error__body {
  display: flex;
  min-width: 0;
  margin-left: 12rpx;
  flex: 1;
  flex-direction: column;
}

.home-error__title {
  color: var(--c-text);
  font-size: 22rpx;
  font-weight: 700;
}

.home-error__copy {
  margin-top: 2rpx;
  color: var(--c-text-2);
  font-size: 19rpx;
  line-height: 1.5;
}

.home-error__action {
  margin-left: 14rpx;
  color: var(--c-primary-link);
  flex: 0 0 auto;
  font-size: 21rpx;
  font-weight: 700;
}

/* ================= 主场景卡 ================= */















































/* ================= 首页下半区重构：今天 / 家里 / 最近发生 ================= */
.home-block {
  margin: 40rpx 40rpx 0;
}

.home-block__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 6rpx 14rpx;
}

.home-block__title {
  font-family: var(--font-serif);
  color: var(--c-text, #252b27);
  font-size: 33rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.home-block__link {
  display: flex;
  align-items: center;
  color: var(--c-muted, #837f76);
  font-size: 23rpx;
  gap: 4rpx;
}

.home-block__arrow {
  font-size: 28rpx;
  line-height: 1;
}

.home-card--pressed {
  opacity: 0.82;
}

.home-row--pressed {
  background: var(--c-paper-2, #f1ede7);
}

/* 今天 */
.today-card {
  padding: 26rpx 28rpx 28rpx;
  border: 1rpx solid var(--c-line, #e9e6e1);
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 96% 4%, rgba(250, 216, 202, 0.5) 0%, rgba(250, 216, 202, 0) 46%),
    #ffffff;
  box-shadow: 0 14rpx 32rpx -26rpx rgba(92, 74, 61, 0.4);
}

.today-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.today-card__kicker {
  color: var(--c-coral, #c67d6d);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.today-card__ratio {
  color: var(--c-text-2, #5f5a53);
  font-size: 24rpx;
  font-weight: 600;
}

.today-card__title {
  display: block;
  margin-top: 14rpx;
  color: var(--c-text, #252b27);
  font-family: var(--font-serif);
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -0.6rpx;
  line-height: 1.35;
}

.today-card__copy {
  display: block;
  margin-top: 10rpx;
  color: var(--c-muted, #837f76);
  font-size: 24rpx;
  line-height: 1.6;
}

.today-card__track {
  overflow: hidden;
  height: 8rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: var(--c-paper-2, #f1ede7);
}

.today-card__fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #d9a08c 0%, #c67d6d 100%);
  transition: width 240ms ease;
}

/* 家里 */
.home-list {
  overflow: hidden;
  border: 1rpx solid var(--c-line, #e9e6e1);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 32rpx -28rpx rgba(92, 74, 61, 0.35);
}

.home-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--c-line, #e9e6e1);
  gap: 18rpx;
}

.home-row:last-child {
  border-bottom: 0;
}

.home-row__icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  flex: 0 0 72rpx;
}

.home-row__icon--inventory { background: #f8f0e2; }
.home-row__icon--pet { background: #e9f2ec; }
.home-row__icon--menu { background: #f9ece7; }

.home-row__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 5rpx;
}

.home-row__title {
  color: var(--c-text, #252b27);
  font-size: 28rpx;
  font-weight: 700;
}

.home-row__copy {
  overflow: hidden;
  color: var(--c-muted, #837f76);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-row__value {
  color: var(--c-text-2, #5f5a53);
  flex: 0 0 auto;
  font-size: 23rpx;
  font-weight: 600;
}

.home-row__chevron {
  width: 12rpx;
  height: 12rpx;
  margin-left: 2rpx;
  border-top: 2rpx solid #cfc6ba;
  border-right: 2rpx solid #cfc6ba;
  transform: rotate(45deg);
}

/* 最近发生 */
.moment-row {
  width: calc(100% + 80rpx);
  margin: 0 -40rpx;
  white-space: nowrap;
}

.moment-row__inner {
  display: inline-flex;
  padding: 2rpx 40rpx 8rpx;
  gap: 18rpx;
}

.moment-card {
  display: flex;
  width: 264rpx;
  flex-direction: column;
  gap: 8rpx;
  white-space: normal;
}

.moment-card__image {
  width: 264rpx;
  height: 190rpx;
  border-radius: 24rpx;
  background: var(--c-paper-2, #f1ede7);
}

.moment-card__image--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.moment-card__title {
  overflow: hidden;
  color: var(--c-text, #252b27);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.moment-card__meta {
  color: var(--c-muted, #837f76);
  font-size: 21rpx;
  letter-spacing: 0.2rpx;
}

.home-header-spacer {
  width: 100%;
}
