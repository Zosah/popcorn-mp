/*
 * 首页 · Figma Make 对齐版
 * 以 390px 设计稿为基准，1px = 2rpx。
 * 页面只保留一条主场景卡和一条最近动态，其他能力通过功能入口与底部导航进入。
 */
.home {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  padding: 0 0 calc(248rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 104% 2%, rgba(250, 216, 202, 0.5), transparent 25%),
    radial-gradient(circle at -8% 35%, rgba(227, 239, 230, 0.7), transparent 25%),
    linear-gradient(180deg, #fffaf5 0, #faf7f1 44%, var(--c-paper) 100%);
}

/* ================= Header ================= */
.home-header {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 40;
  background: rgba(252, 249, 244, 0.99);
  border-bottom: 1rpx solid rgba(233, 230, 225, 0.85);
  -webkit-backdrop-filter: saturate(140%) blur(18px);
  backdrop-filter: saturate(140%) blur(18px);
  display: flex;
  min-height: 81rpx;
  align-items: flex-start;
  justify-content: space-between;
  box-sizing: border-box;
  padding-bottom: 12rpx;
  padding-left: 40rpx;
}

.home-header__space {
  min-width: 0;
  padding-top: 3rpx;
  flex: 1;
}

.home-header__name-row {
  display: flex;
  align-items: center;
}

.home-header__name {
  overflow: hidden;
  max-width: 320rpx;
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-header__switch {display: flex; width: 42rpx; height: 42rpx; align-items: center; justify-content: center; margin-left: 10rpx; box-sizing: border-box;}

.home-header__date {
  display: block;
  margin-top: 7rpx;
  color: var(--c-muted);
  font-size: 20rpx;
  line-height: 1.35;
}

.home-header__actions {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  padding-top: 1rpx;
  flex: 0 0 auto;
}

.member-stack {
  display: flex;
  align-items: center;
}

.member-stack__item {
  width: 54rpx;
  height: 54rpx;
  overflow: hidden;
  border: 3rpx solid rgba(255, 250, 245, 0.96);
  border-radius: 50%;
  background: var(--c-paper-2);
  box-shadow: 0 5rpx 14rpx -9rpx rgba(87, 68, 59, 0.32);
}

.member-stack__item + .member-stack__item {
  margin-left: -16rpx;
}

.member-stack__image {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* ================= Hero ================= */
.home-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 42rpx 40rpx 24rpx;
}

.home-hero__copy {
  min-width: 0;
  flex: 1;
}

.home-hero__greeting {
  display: block;
  margin-bottom: 12rpx;
  color: var(--c-text-2);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  line-height: 1.45;
}

.home-hero__title {
  display: block;
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: -3rpx;
  line-height: 1.38;
  white-space: pre-line;
}

.days-together {
  position: relative;
  width: 160rpx;
  margin: 0 0 6rpx 18rpx;
  padding: 22rpx 0 8rpx 26rpx;
  border-left: 1rpx solid #d7d0c5;
  flex: 0 0 auto;
}

.days-together__dot {
  position: absolute;
  top: 2rpx;
  left: -6rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--c-coral);
}

.days-together__label {
  display: block;
  color: var(--c-muted);
  font-size: 16rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.45;
}

.days-together__number {
  display: block;
  margin-top: 2rpx;
  color: #7d9a8e;
  font-family: var(--font-serif);
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.days-together__caption {
  display: block;
  margin-top: 2rpx;
  color: var(--c-muted);
  font-size: 16rpx;
  line-height: 1.45;
  white-space: nowrap;
}

