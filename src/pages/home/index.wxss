.home-page {
  --home-paper: #fdfbf7;
  --home-paper-2: #f6f1e9;
  --home-ink: #2e2a28;
  --home-ink-2: #6b635c;
  --home-ink-3: #a69e96;
  --home-line: #ebe5da;
  --home-deep: #2c4a52;
  --home-blue: #5b8fb9;
  --home-green: #9bc4a6;
  --home-gold: #dfa93c;
  --home-orange: #f0a868;
  --home-pink: #f09aae;
  --home-red: #e4778c;
  --home-blue-soft: #eaf1f7;
  --home-green-soft: #eef5ef;
  --home-gold-soft: #fbf3e1;
  --home-orange-soft: #fdf0e4;
  --home-pink-soft: #fcedf0;
  padding: 0 0 calc(158rpx + env(safe-area-inset-bottom));
  background: var(--home-paper);
  color: var(--home-ink);
}

.home-hero {
  position: relative;
  height: 820rpx;
  overflow: hidden;
  border-radius: 0 0 58rpx 58rpx;
  background: linear-gradient(158deg, #ffe4ee 0%, #e9f1fc 52%, #fff7de 100%);
}

.home-hero__bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 12% 36%, rgba(255, 255, 255, 0.52) 0 4rpx, transparent 5rpx),
    radial-gradient(circle at 82% 72%, rgba(255, 255, 255, 0.42) 0 3rpx, transparent 4rpx);
  background-size: 34rpx 34rpx, 46rpx 46rpx;
  opacity: 0.72;
}

.home-hero__sun {
  position: absolute;
  top: 126rpx;
  right: -54rpx;
  width: 372rpx;
  height: 372rpx;
  border-radius: 50%;
  background: #f6d776;
  opacity: 0.92;
}

.home-hero__pink {
  position: absolute;
  top: 342rpx;
  left: -60rpx;
  width: 194rpx;
  height: 194rpx;
  border-radius: 50%;
  background: #f7a8b8;
  opacity: 0.58;
}

.home-hero__top {
  position: relative;
  z-index: 6;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 40rpx 42rpx 0;
}

.home-members {
  display: flex;
  align-items: center;
}

.home-members__stack {
  display: flex;
  align-items: center;
}

.home-member {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  overflow: hidden;
  align-items: center;
  justify-content: center;
  border: 5rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 50%;
  background: #f6f1e9;
  box-shadow: 0 5rpx 13rpx rgba(80, 60, 40, 0.12);
}

.home-member + .home-member {
  margin-left: -20rpx;
}

.home-member__image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.home-hero__actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.home-hero__action {
  display: flex;
  width: 66rpx;
  height: 66rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.62);
  box-shadow: 0 8rpx 20rpx rgba(80, 60, 40, 0.07);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.home-hero__copy {
  position: relative;
  z-index: 5;
  width: 430rpx;
  margin: 50rpx 0 0 44rpx;
}

.home-hero__eyebrow {
  display: block;
  color: var(--home-ink-2);
  font-family: Georgia, "Songti SC", serif;
  font-size: 29rpx;
  font-style: italic;
  letter-spacing: 0.8rpx;
}

.home-hero__headline {
  display: flex;
  margin-top: 10rpx;
  flex-direction: column;
  font-family: "Helvetica Neue", Arial, sans-serif;
  font-weight: 800;
  letter-spacing: -2.6rpx;
  line-height: 0.94;
  text-transform: uppercase;
}

.home-hero__word {
  position: relative;
  display: block;
  width: max-content;
}

.home-hero__word--top {
  color: var(--home-blue);
  font-size: 60rpx;
}

.home-hero__word--mid,
.home-hero__word--bottom {
  color: var(--home-ink);
  font-size: 80rpx;
}

.home-hero__word--bottom::after {
  position: absolute;
  right: -6rpx;
  bottom: 4rpx;
  left: -6rpx;
  z-index: -1;
  height: 20rpx;
  border-radius: 8rpx;
  background: rgba(246, 215, 118, 0.58);
  content: "";
}

.home-hero__intro {
  display: block;
  width: 386rpx;
  margin-top: 25rpx;
  color: #5d554e;
  font-size: 27rpx;
  line-height: 1.76;
}

.home-hero__art {
  position: absolute;
  right: -6rpx;
  bottom: 16rpx;
  z-index: 4;
  width: 310rpx;
  height: 320rpx;
  pointer-events: none;
}

.home-hero__art-halo {
  position: absolute;
  top: 26rpx;
  right: 10rpx;
  width: 256rpx;
  height: 256rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.56), rgba(255, 255, 255, 0));
}

.home-hero__illustration {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 308rpx;
  height: 308rpx;
  filter: drop-shadow(0 14rpx 24rpx rgba(120, 90, 60, 0.16));
  transform: rotate(1deg);
}

.home-hero__dots {
  position: absolute;
  bottom: 48rpx;
  left: 44rpx;
  z-index: 7;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.home-hero__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(70, 60, 52, 0.28);
}

.home-hero__dot--long {
  width: 30rpx;
  height: 10rpx;
  border-radius: 8rpx;
  background: var(--home-deep);
}

.home-stats {
  position: sticky;
  top: 0;
  z-index: 40;
  margin-top: -180rpx;
  padding: 8rpx 28rpx 24rpx;
  box-sizing: border-box;
}

.home-stats::before {
  position: absolute;
  inset: 0;
  z-index: 0;
  background: var(--home-paper);
  content: "";
  opacity: 0;
  transition: opacity 180ms ease;
}

.home-stats::after {
  position: absolute;
  top: 100%;
  right: 0;
  left: 0;
  z-index: 0;
  height: 44rpx;
  background: linear-gradient(180deg, rgba(253, 251, 247, 0.98), rgba(253, 251, 247, 0));
  content: "";
  opacity: 0;
  pointer-events: none;
  transition: opacity 180ms ease;
}

.home-stats--docked::before,
.home-stats--docked::after {
  opacity: 1;
}

.home-stats__compact {
  position: relative;
  z-index: 1;
  display: flex;
  height: 50rpx;
  align-items: baseline;
  margin-bottom: 18rpx;
  padding: 0 14rpx 0 4rpx;
  box-sizing: border-box;
  gap: 12rpx;
  opacity: 0;
  transform: translateY(8rpx);
  transition: opacity 180ms ease, transform 180ms ease;
}

.home-stats--docked .home-stats__compact {
  opacity: 1;
  transform: translateY(0);
}

.home-stats__compact-main {
  font-family: "Helvetica Neue", Arial, sans-serif;
  color: var(--home-ink);
  font-size: 33rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.home-stats__compact-sub {
  color: var(--home-ink-3);
  font-size: 24rpx;
}

.home-stats__card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 24rpx 18rpx 22rpx 28rpx;
  border: 1rpx solid rgba(235, 229, 218, 0.9);
  border-radius: 38rpx;
  background: #fff;
  box-shadow: 0 12rpx 40rpx -10rpx rgba(90, 70, 50, 0.17);
}

.home-stat {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.home-stat__number {
  color: var(--home-ink);
  font-family: "Helvetica Neue", Arial, sans-serif;
  font-size: 49rpx;
  font-weight: 700;
  letter-spacing: -1.2rpx;
  line-height: 1;
}

.home-stat__label {
  margin-top: 9rpx;
  color: var(--home-ink-3);
  font-size: 24rpx;
  line-height: 1.2;
}

.home-stats__go {
  display: flex;
  width: 82rpx;
  height: 82rpx;
  align-items: center;
  justify-content: center;
  margin-left: 6rpx;
  border-radius: 50%;
  background: var(--home-deep);
  color: #fff;
  flex: 0 0 auto;
  font-size: 39rpx;
  font-weight: 700;
}

.home-content {
  padding: 10rpx 32rpx 0;
}

.home-state {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  padding: 18rpx;
  border-radius: 28rpx;
  background: #fcebee;
  gap: 14rpx;
}

.home-state__icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.66);
  flex: 0 0 auto;
}

.home-state__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.home-state__title {
  color: var(--home-ink);
  font-size: 27rpx;
  font-weight: 600;
}

.home-state__copy {
  margin-top: 4rpx;
  color: var(--home-ink-2);
  font-size: 25rpx;
  line-height: 1.5;
}

.home-state__action {
  color: var(--home-red);
  flex: 0 0 auto;
  font-size: 26rpx;
  font-weight: 600;
}

.home-today-card {
  padding: 28rpx 28rpx 24rpx;
  border: 1rpx solid rgba(235, 229, 218, 0.72);
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 3rpx 6rpx rgba(90, 70, 50, 0.05);
}

.home-today-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.home-today-card__date {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.home-today-card__day {
  color: var(--home-ink);
  font-family: "Helvetica Neue", Arial, sans-serif;
  font-size: 65rpx;
  font-weight: 800;
  letter-spacing: -4rpx;
  line-height: 1;
}

.home-today-card__date-copy {
  display: flex;
  flex-direction: column;
}

.home-today-card__date-copy text:first-child {
  color: var(--home-ink);
  font-size: 26rpx;
  font-weight: 600;
}

.home-today-card__date-copy text:last-child {
  margin-top: 3rpx;
  color: var(--home-ink-3);
  font-size: 24rpx;
}

.home-today-card__tag {
  display: flex;
  align-items: center;
  padding: 7rpx 15rpx;
  border-radius: 999rpx;
  background: var(--home-paper-2);
  color: var(--home-ink-2);
  gap: 9rpx;
  font-size: 24rpx;
}

.home-today-card__tag-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--home-green);
}

.home-today-card__title {
  display: block;
  color: var(--home-ink);
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1.45;
}

.home-today-card__empty-title {
  display: block;
  color: var(--home-ink);
  font-size: 33rpx;
  font-weight: 700;
}

.home-today-card__copy {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #4a423c;
  font-size: 29rpx;
  line-height: 1.9;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.home-today-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--home-line);
  color: var(--home-ink-3);
  font-size: 24rpx;
  gap: 14rpx;
}

.home-today-card__action {
  color: var(--home-blue);
  flex: 0 0 auto;
  font-weight: 600;
}

.home-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 34rpx 4rpx 16rpx;
}

.home-section-head--recent {
  margin-top: 36rpx;
}

.home-section-head__title {
  font-family: "Helvetica Neue", Arial, sans-serif;
  color: var(--home-ink);
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -0.8rpx;
}

.home-section-head__meta {
  color: var(--home-ink-3);
  font-size: 24rpx;
}

.home-section-head__action {
  color: var(--home-blue);
  font-size: 24rpx;
  font-weight: 600;
}

.home-near-card {
  overflow: hidden;
  padding: 0 26rpx;
  border: 1rpx solid rgba(235, 229, 218, 0.72);
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 3rpx 6rpx rgba(90, 70, 50, 0.05);
}

.home-near-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  gap: 18rpx;
}

.home-near-row + .home-near-row {
  border-top: 1rpx solid var(--home-line);
}

.home-near-row__icon {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  flex: 0 0 auto;
}

.home-near-row__icon--orange {
  background: var(--home-orange-soft);
}

.home-near-row__icon--green {
  background: var(--home-green-soft);
}

.home-near-row__icon--gold {
  background: var(--home-gold-soft);
}

.home-near-row__icon--pink {
  background: var(--home-pink-soft);
}

.home-near-row__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.home-near-row__title {
  color: var(--home-ink);
  font-size: 30rpx;
  font-weight: 600;
}

.home-near-row__copy {
  overflow: hidden;
  margin-top: 6rpx;
  color: var(--home-ink-3);
  font-size: 24rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-near-row__right {
  display: flex;
  align-items: flex-end;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 5rpx;
}

.home-near-row__right text:first-child {
  color: var(--home-ink-2);
  font-family: "Helvetica Neue", Arial, sans-serif;
  font-size: 25rpx;
  font-weight: 600;
}

.home-near-row__right text:last-child {
  color: var(--home-blue);
  font-size: 24rpx;
  font-weight: 600;
}

.home-near-row:nth-child(2) .home-near-row__right text:last-child {
  color: var(--home-green);
}

.home-near-row:nth-child(3) .home-near-row__right text:last-child {
  color: var(--home-gold);
}

.home-near-row:nth-child(4) .home-near-row__right text:last-child {
  color: var(--home-pink);
}

.home-tools-wrap {
  margin-top: 28rpx;
}

.home-tools-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 4rpx 13rpx;
}

.home-tools-head text:first-child {
  color: var(--home-ink);
  font-size: 33rpx;
  font-weight: 800;
  letter-spacing: -0.6rpx;
}

.home-tools-head text:last-child {
  color: var(--home-ink-3);
  font-size: 23rpx;
}

.home-tools {
  display: flex;
  margin-top: 0;
  gap: 13rpx;
}

.home-tool {
  position: relative;
  display: flex;
  min-width: 0;
  align-items: center;
  padding: 18rpx 4rpx 17rpx;
  border: 1rpx solid rgba(235, 229, 218, 0.72);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 3rpx 6rpx rgba(90, 70, 50, 0.05);
  flex: 1;
  flex-direction: column;
  gap: 12rpx;
}

.home-tool__icon {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

.home-tool__icon--blue,
.home-tool__icon--primary {
  background: rgba(255, 255, 255, 0.15);
}

.home-tool__icon--green {
  background: var(--home-green-soft);
}

.home-tool__icon--gold {
  background: var(--home-gold-soft);
}

.home-tool__icon--pink {
  background: var(--home-pink-soft);
}

.home-tool__label {
  width: 100%;
  color: var(--home-ink-2);
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1;
  text-align: center;
}

.home-tool--primary {
  border-color: var(--home-deep);
  background: var(--home-deep);
  box-shadow: 0 12rpx 24rpx -10rpx rgba(44, 74, 82, 0.48);
}

.home-tool--primary .home-tool__label {
  color: #fff;
  font-weight: 700;
}

.home-tool__badge {
  position: absolute;
  top: 10rpx;
  right: 14rpx;
  display: flex;
  min-width: 28rpx;
  height: 28rpx;
  align-items: center;
  justify-content: center;
  padding: 0 7rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--home-red);
  box-shadow: 0 2rpx 6rpx rgba(228, 119, 140, 0.34);
  color: #fff;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1;
}

.home-recent-card {
  overflow: hidden;
  padding: 0 26rpx;
  border: 1rpx solid rgba(235, 229, 218, 0.72);
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 3rpx 6rpx rgba(90, 70, 50, 0.05);
}

.home-recent-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  gap: 18rpx;
}

.home-recent-row + .home-recent-row {
  border-top: 1rpx solid var(--home-line);
}

.home-recent-row__mark {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 23rpx;
  background: var(--home-blue-soft);
  flex: 0 0 auto;
}

.home-recent-row:nth-child(2) .home-recent-row__mark {
  background: var(--home-green-soft);
}

.home-recent-row:nth-child(3) .home-recent-row__mark {
  background: var(--home-gold-soft);
}

.home-recent-row__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.home-recent-row__title {
  overflow: hidden;
  color: var(--home-ink);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-recent-row__copy {
  overflow: hidden;
  margin-top: 6rpx;
  color: var(--home-ink-3);
  font-size: 24rpx;
  line-height: 1.55;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-recent-row__meta {
  margin-top: 7rpx;
  color: #b4ada7;
  font-size: 22rpx;
}

.home-recent-row__date {
  color: var(--home-ink-3);
  flex: 0 0 auto;
  font-family: "Helvetica Neue", Arial, sans-serif;
  font-size: 21rpx;
  line-height: 1.4;
  text-align: right;
}

.home-empty {
  display: flex;
  min-height: 250rpx;
  align-items: center;
  justify-content: center;
  padding: 34rpx 30rpx;
  box-sizing: border-box;
  border: 1rpx dashed #e2dbcf;
  border-radius: 36rpx;
  background: #fff;
  flex-direction: column;
  text-align: center;
}

.home-empty__mark {
  display: flex;
  width: 84rpx;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background: var(--home-blue-soft);
}

.home-empty__title {
  margin-top: 18rpx;
  color: var(--home-ink);
  font-size: 31rpx;
  font-weight: 700;
}

.home-empty__copy {
  max-width: 480rpx;
  margin-top: 8rpx;
  color: var(--home-ink-3);
  font-size: 25rpx;
  line-height: 1.65;
}

.home-empty__action {
  margin-top: 18rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--home-deep);
  color: #fff;
  font-size: 25rpx;
  font-weight: 600;
}

.home-footer-copy {
  display: block;
  margin: 36rpx 0 0;
  color: var(--home-ink-3);
  font-size: 24rpx;
  line-height: 1.7;
  text-align: center;
}

.home-section-head--pets {
  margin-top: 38rpx;
}

.home-pet-card {
  overflow: hidden;
  border: 1rpx solid rgba(235, 229, 218, 0.78);
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 3rpx 6rpx rgba(90, 70, 50, 0.05);
}

.home-pet-summary {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid var(--home-line);
  background: linear-gradient(135deg, #fff8f9 0%, #fffefa 58%, #f8f5ed 100%);
  gap: 16rpx;
}

.home-pet-summary__avatar {
  position: relative;
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 26rpx;
  background: var(--home-pink-soft);
  box-shadow: 0 9rpx 18rpx rgba(216, 117, 146, 0.12);
  flex: 0 0 auto;
}

.home-pet-summary__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 3rpx;
}

.home-pet-summary__name {
  color: var(--home-ink);
  font-size: 31rpx;
  font-weight: 800;
}

.home-pet-summary__status {
  overflow: hidden;
  color: var(--home-ink-3);
  font-size: 23rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-pet-summary__weight {
  display: flex;
  align-items: baseline;
  color: var(--home-ink);
  flex: 0 0 auto;
  gap: 4rpx;
}

.home-pet-summary__weight text:first-child {
  font-family: "Helvetica Neue", Arial, sans-serif;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.home-pet-summary__weight text:last-child {
  color: var(--home-ink-3);
  font-size: 21rpx;
}

.home-pet-feed {
  padding: 0 24rpx;
}

.home-pet-activity {
  display: flex;
  align-items: flex-start;
  padding: 21rpx 0;
  gap: 15rpx;
}

.home-pet-activity + .home-pet-activity {
  border-top: 1rpx solid var(--home-line);
}

.home-pet-activity__icon {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  border-radius: 21rpx;
  flex: 0 0 auto;
}

.home-pet-activity__icon--blue { background: var(--home-blue-soft); }
.home-pet-activity__icon--green { background: var(--home-green-soft); }
.home-pet-activity__icon--pink { background: var(--home-pink-soft); }

.home-pet-activity__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.home-pet-activity__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10rpx;
}

.home-pet-activity__title {
  overflow: hidden;
  color: var(--home-ink);
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-pet-activity__date {
  color: var(--home-ink-3);
  flex: 0 0 auto;
  font-size: 21rpx;
}

.home-pet-activity__copy {
  overflow: hidden;
  margin-top: 5rpx;
  color: var(--home-ink-2);
  font-size: 24rpx;
  line-height: 1.55;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-pet-activity__tag {
  width: max-content;
  margin-top: 7rpx;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: var(--home-paper-2);
  color: var(--home-ink-3);
  font-size: 20rpx;
}

.home-pet-activity__arrow {
  color: #cfc6bd;
  flex: 0 0 auto;
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1.2;
}

.home-pet-empty {
  display: flex;
  align-items: center;
  padding: 30rpx 26rpx;
  flex-direction: column;
  text-align: center;
}

.home-pet-empty text:first-child {
  color: var(--home-ink);
  font-size: 28rpx;
  font-weight: 700;
}

.home-pet-empty text:nth-child(2) {
  margin-top: 6rpx;
  color: var(--home-ink-3);
  font-size: 23rpx;
  line-height: 1.6;
}

.home-pet-empty view {
  margin-top: 16rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--home-deep);
  color: #fff;
  font-size: 23rpx;
  font-weight: 600;
}

.home-card--pressed,
.home-row--pressed,
.home-tool--pressed,
.home-control--pressed {
  opacity: 0.78;
  transform: scale(0.985);
}

@media (prefers-reduced-motion: reduce) {
  .home-stats,
  .home-stats__compact,
  .home-today-card,
  .home-near-row,
  .home-tool,
  .home-stats__go {
    transition: none;
  }
}
