/*
 * 首页 · Figma Make 对齐版
 * 以 390px 设计稿为基准，1px = 2rpx。
 * 页面只保留一条主场景卡和一条最近动态，其他能力通过功能入口与底部导航进入。
 */
.home {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  padding: 0 0 calc(176rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 104% 2%, rgba(250, 216, 202, 0.5), transparent 25%),
    radial-gradient(circle at -8% 35%, rgba(227, 239, 230, 0.7), transparent 25%),
    linear-gradient(180deg, #fffaf5 0, #faf7f1 44%, var(--c-paper) 100%);
}

/* ================= Header ================= */
.home-header {
  position: relative;
  z-index: 3;
  display: flex;
  min-height: 81rpx;
  align-items: flex-start;
  justify-content: space-between;
  box-sizing: border-box;
  padding-bottom: 4rpx;
  padding-left: 40rpx;
}

.home-header__space {
  min-width: 0;
  padding-top: 3rpx;
  flex: 1;
}

.home-header__name-row {
  display: flex;
  align-items: center;
}

.home-header__name {
  overflow: hidden;
  max-width: 320rpx;
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-header__chevron {
  margin-left: 10rpx;
  color: var(--c-text-2);
  font-size: 26rpx;
  line-height: 1;
}

.home-header__date {
  display: block;
  margin-top: 7rpx;
  color: var(--c-muted);
  font-size: 20rpx;
  line-height: 1.35;
}

.home-header__actions {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  padding-top: 1rpx;
  flex: 0 0 auto;
}

.member-stack {
  display: flex;
  align-items: center;
  margin-right: 18rpx;
}

.member-stack__item {
  width: 54rpx;
  height: 54rpx;
  overflow: hidden;
  border: 3rpx solid rgba(255, 250, 245, 0.96);
  border-radius: 50%;
  background: var(--c-paper-2);
  box-shadow: 0 5rpx 14rpx -9rpx rgba(87, 68, 59, 0.32);
}

.member-stack__item + .member-stack__item {
  margin-left: -16rpx;
}

.member-stack__image {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.header-bell {
  position: relative;
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  box-shadow:
    0 10rpx 24rpx -18rpx rgba(87, 68, 59, 0.36),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
}

.header-bell__dot {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid #fff;
  border-radius: 50%;
  background: var(--c-coral);
}

/* ================= Hero ================= */
.home-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 60rpx 40rpx 34rpx;
}

.home-hero__copy {
  min-width: 0;
  flex: 1;
}

.home-hero__greeting {
  display: block;
  margin-bottom: 12rpx;
  color: var(--c-text-2);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  line-height: 1.45;
}

.home-hero__title {
  display: block;
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: -3rpx;
  line-height: 1.38;
  white-space: pre-line;
}

.days-together {
  position: relative;
  width: 160rpx;
  margin: 0 0 6rpx 18rpx;
  padding: 22rpx 0 8rpx 26rpx;
  border-left: 1rpx solid #d7d0c5;
  flex: 0 0 auto;
}

.days-together__dot {
  position: absolute;
  top: 2rpx;
  left: -6rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--c-coral);
}

.days-together__label {
  display: block;
  color: var(--c-muted);
  font-size: 16rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.45;
}

.days-together__number {
  display: block;
  margin-top: 2rpx;
  color: #7d9a8e;
  font-family: var(--font-serif);
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.days-together__caption {
  display: block;
  margin-top: 2rpx;
  color: var(--c-muted);
  font-size: 16rpx;
  line-height: 1.45;
  white-space: nowrap;
}

/* ================= 功能入口 ================= */
.function-glass {
  display: grid;
  min-height: 152rpx;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin: 0 40rpx 36rpx;
  padding: 20rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 44rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.74), rgba(255, 255, 255, 0.44));
  box-shadow:
    0 20rpx 60rpx rgba(92, 74, 61, 0.06),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.95);
  box-sizing: border-box;
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
}

.function-item {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  flex-direction: column;
  gap: 10rpx;
  transition: opacity 150ms ease, transform 150ms ease, background 150ms ease;
}

.function-item--pressed {
  opacity: 0.76;
  background: rgba(255, 255, 255, 0.5);
  transform: scale(0.94);
}

.function-icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.8),
    0 8rpx 20rpx rgba(70, 60, 52, 0.06);
}

.function-icon--peach {
  background: linear-gradient(145deg, #fae4de, #f1d3cb);
}

.function-icon--mint {
  background: linear-gradient(145deg, #e6f2ec, #d8e8df);
}

.function-icon--butter {
  background: linear-gradient(145deg, #f8eed4, #efe0bd);
}

.function-icon--cream {
  background: linear-gradient(145deg, #f1e9ed, #e5dce7);
}

.function-item__label {
  overflow: hidden;
  max-width: 100%;
  color: #6f6963;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ================= 场景切换 ================= */
.scene-switch {
  display: grid;
  width: 348rpx;
  height: 68rpx;
  grid-template-columns: repeat(3, 1fr);
  margin: 0 40rpx 24rpx;
  padding: 6rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.48);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.scene-switch__item {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  color: #989189;
  font-size: 20rpx;
  font-weight: 500;
  transition: background 180ms ease, color 180ms ease, box-shadow 180ms ease, transform 120ms ease;
}

.scene-switch__item--active {
  background: #fff;
  color: var(--c-text);
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(67, 58, 50, 0.08);
}

.scene-switch__item:active {
  transform: scale(0.95);
}

/* ================= 错误提示 ================= */
.home-error {
  display: flex;
  align-items: center;
  margin: -6rpx 40rpx 20rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(198, 125, 109, 0.18);
  border-radius: 24rpx;
  background: var(--c-coral-soft);
}

.home-error__body {
  display: flex;
  min-width: 0;
  margin-left: 12rpx;
  flex: 1;
  flex-direction: column;
}

.home-error__title {
  color: var(--c-text);
  font-size: 22rpx;
  font-weight: 700;
}

.home-error__copy {
  margin-top: 2rpx;
  color: var(--c-text-2);
  font-size: 19rpx;
  line-height: 1.5;
}

.home-error__action {
  margin-left: 14rpx;
  color: var(--c-primary-link);
  flex: 0 0 auto;
  font-size: 21rpx;
  font-weight: 700;
}

/* ================= 主场景卡 ================= */
.scene-card {
  position: relative;
  display: flex;
  overflow: hidden;
  box-sizing: border-box;
  min-height: 620rpx;
  margin: 0 40rpx;
  padding: 46rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 60rpx;
  box-shadow: 0 40rpx 90rpx rgba(68, 61, 54, 0.11);
  flex-direction: column;
}

.scene-card--today {
  background: linear-gradient(145deg, #f6dcd4 0%, #f8e9df 44%, #e8dedc 100%);
}

.scene-card--home {
  background: linear-gradient(145deg, #dae9e2 0%, #e7f0e7 50%, #dce6ec 100%);
}

.scene-card--pet {
  background: linear-gradient(145deg, #e8dfed 0%, #f1e8ed 50%, #e4e6f0 100%);
}

.scene-card__orb {
  position: absolute;
  z-index: -1;
  border-radius: 50%;
  pointer-events: none;
}

.scene-card__orb--one {
  top: -110rpx;
  right: -130rpx;
  width: 380rpx;
  height: 380rpx;
  background: rgba(255, 255, 255, 0.5);
}

.scene-card__orb--two {
  bottom: -80rpx;
  left: -110rpx;
  width: 260rpx;
  height: 260rpx;
  background: rgba(255, 255, 255, 0.3);
}

.scene-card__top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.scene-icon {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.4));
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9),
    0 14rpx 36rpx rgba(89, 70, 62, 0.07);
}

.scene-count {
  padding: 12rpx 20rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.46);
  color: #756e69;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.35;
}

.scene-copy {
  position: relative;
  z-index: 1;
  display: flex;
  margin-top: 58rpx;
  flex-direction: column;
}

.scene-kicker {
  display: block;
  color: #8c7770;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  line-height: 1.4;
}

.scene-title {
  display: -webkit-box;
  overflow: hidden;
  margin: 12rpx 0;
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.38;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.scene-note {
  display: -webkit-box;
  overflow: hidden;
  max-width: 520rpx;
  color: #746e69;
  font-size: 21rpx;
  line-height: 1.65;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.scene-preview {
  position: relative;
  z-index: 1;
  display: grid;
  min-height: 84rpx;
  grid-template-columns: 48rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 16rpx;
  margin-top: auto;
  margin-bottom: 24rpx;
  padding: 16rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.56);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.46);
  box-sizing: border-box;
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
}

.scene-preview__icon {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.65);
}

.scene-preview__icon--done {
  background: #7f9b8e;
}

.scene-preview__body {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.scene-preview__title {
  overflow: hidden;
  color: var(--c-text);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scene-preview__meta {
  overflow: hidden;
  margin-top: 2rpx;
  color: #817a74;
  font-size: 17rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scene-preview__time {
  color: #817a74;
  flex: 0 0 auto;
  font-size: 17rpx;
}

.scene-action {
  position: relative;
  z-index: 1;
  display: flex;
  height: 86rpx;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: rgba(54, 56, 53, 0.84);
  box-shadow: 0 18rpx 36rpx rgba(54, 50, 47, 0.13);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  transition: transform 130ms ease, background 130ms ease, box-shadow 130ms ease;
}

.scene-action--pressed {
  background: rgba(54, 56, 53, 0.95);
  box-shadow: 0 8rpx 20rpx rgba(54, 50, 47, 0.12);
  transform: scale(0.975);
}

.scene-action__arrow {
  margin-left: 10rpx;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1;
}

/* ================= 最近动态 ================= */
.moment-strip {
  display: grid;
  min-height: 148rpx;
  grid-template-columns: 100rpx minmax(0, 1fr) 50rpx;
  align-items: center;
  gap: 22rpx;
  margin: 28rpx 40rpx 0;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 36rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.55));
  box-shadow: 0 20rpx 56rpx rgba(73, 62, 54, 0.05);
  box-sizing: border-box;
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  transition: opacity 130ms ease, transform 130ms ease;
}

.moment-strip--pressed {
  opacity: 0.82;
  transform: scale(0.985);
}

.moment-thumb {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #f1ceb7, #dce6d3);
}

.moment-thumb--photo {
  background: var(--c-paper-2);
}

.moment-thumb__photo {
  display: block;
  width: 100%;
  height: 100%;
}

.moment-thumb__sun {
  position: absolute;
  top: 16rpx;
  right: 18rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #d99577;
}

.moment-thumb__hill {
  position: absolute;
  bottom: -34rpx;
  left: -16rpx;
  width: 130rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #82a08b;
  transform: rotate(8deg);
}

.moment-strip__body {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.moment-strip__eyebrow {
  color: var(--c-coral);
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 1.2rpx;
  line-height: 1.4;
}

.moment-strip__title {
  overflow: hidden;
  margin: 4rpx 0;
  color: var(--c-text);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.moment-strip__meta {
  overflow: hidden;
  color: var(--c-muted);
  font-size: 17rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.moment-strip__arrow {
  color: #aaa39b;
  font-size: 42rpx;
  font-weight: 300;
  line-height: 1;
  text-align: center;
}

/* ================= 折叠提醒 ================= */
.folded-summary {
  display: flex;
  min-height: 100rpx;
  align-items: center;
  justify-content: space-between;
  margin: 26rpx 40rpx 0;
  padding: 18rpx 28rpx;
  border-radius: 32rpx;
  background: #f0eeea;
  box-sizing: border-box;
  transition: opacity 130ms ease, transform 130ms ease;
}

.folded-summary--pressed {
  opacity: 0.76;
  transform: scale(0.985);
}

.folded-summary__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.folded-summary__title {
  color: var(--c-text);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.45;
}

.folded-summary__meta {
  overflow: hidden;
  margin-top: 2rpx;
  color: var(--c-muted);
  font-size: 17rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.folded-summary__action {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
  color: var(--c-muted);
  flex: 0 0 auto;
  font-size: 18rpx;
}

.folded-summary__chevron {
  margin-left: 6rpx;
  font-size: 22rpx;
  line-height: 1;
}

.tap-dim {
  opacity: 0.7;
}

@media (prefers-reduced-motion: reduce) {
  .function-item,
  .scene-switch__item,
  .scene-action,
  .moment-strip,
  .folded-summary {
    transition: none;
  }
}
