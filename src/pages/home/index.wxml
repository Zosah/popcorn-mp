<view class="tab-page home-page">
  <view class="date-stamp">
    <text class="date-stamp__day">{{dateParts.day}}</text>
    <view class="date-stamp__meta">
      <text class="date-stamp__month">{{dateParts.month}}</text>
      <text class="date-stamp__weekday">{{snapshot.weekdayLabel}}</text>
    </view>
  </view>

  <view class="home-intro">
    <view class="home-intro__title">{{snapshot.salutation}}</view>
    <view class="home-intro__copy">家里的事都在这儿。</view>
    <view class="sync-row"><sync-badge state="local" text="本机 Demo · 数据只在这台手机" /></view>
  </view>

  <view class="home-visual" bindtap="onOpenJournal">
    <image class="home-visual__image" src="../../images/home-still-life.jpg" mode="aspectFill" />
    <view class="home-visual__caption">
      <text class="home-visual__title">把普通的一天，也记下来</text>
      <view class="home-visual__meta">
        <text class="home-visual__credit">公版艺术示例</text>
        <view class="home-visual__action">
          <text>去记录</text>
          <line-icon name="pen-line" size="26" tone="accent" />
        </view>
      </view>
    </view>
  </view>

  <view class="notice" bindtap="onOpenInventory">
    <view class="notice__head">
      <view class="notice__label">
        <line-icon name="circle-alert" size="28" tone="danger" />
        <text>需要看看</text>
      </view>
      <text>冰箱与储物柜</text>
    </view>
    <view class="notice__body">
      <view class="notice__value">
        <text class="notice__number {{snapshot.inventoryNoticeCount > 0 ? 'notice__number--alert' : ''}}">{{snapshot.inventoryNoticeCount}}</text>
        <text class="notice__unit">件</text>
      </view>
      <text class="notice__action">查看库存</text>
    </view>
    <view class="notice__copy">{{snapshot.inventoryNotice}}</view>
  </view>

  <view class="section-head">
    <text class="section-head__title">常用</text>
    <text class="section-head__action">今天</text>
  </view>

  <view class="quicklinks">
    <view class="quicklink" bindtap="onOpenInventory">
      <line-icon name="package" size="32" tone="accent" />
      <text class="quicklink__value">{{snapshot.inventoryItemCount}}</text>
      <text class="quicklink__label">库存</text>
    </view>
    <view class="quicklink" bindtap="onOpenPets">
      <line-icon name="paw-print" size="32" tone="accent" />
      <text class="quicklink__value">{{petCount}}</text>
      <text class="quicklink__label">宠物</text>
    </view>
    <view class="quicklink" bindtap="onOpenMenu">
      <line-icon name="utensils" size="32" tone="accent" />
      <text class="quicklink__value">{{menuCount}}</text>
      <text class="quicklink__label">菜单</text>
    </view>
    <view class="quicklink" bindtap="onOpenJournal">
      <line-icon name="book-open" size="32" tone="accent" />
      <text class="quicklink__value">{{recordCount}}</text>
      <text class="quicklink__label">记录</text>
    </view>
  </view>

  <view class="section-head">
    <text class="section-head__title">最近</text>
    <text class="section-head__action" bindtap="onOpenJournal">全部记录</text>
  </view>

  <view class="recent-list">
    <view wx:for="{{recentEntries}}" wx:key="id" class="recent-row" bindtap="onOpenJournal">
      <text class="recent-row__date">{{item.day}}</text>
      <view class="recent-row__body">
        <text class="recent-row__title">{{item.title}}</text>
        <text class="recent-row__meta">{{item.visibilityLabel}} · {{item.timeLabel}}</text>
      </view>
      <view class="recent-row__mark"><line-icon name="book-open" size="24" tone="muted" /></view>
    </view>
    <view wx:if="{{!recentEntries.length}}" class="recent-row recent-row--empty" bindtap="onOpenJournal">
      <text class="recent-row__date">—</text>
      <view class="recent-row__body">
        <text class="recent-row__title">今天还没有新的记录</text>
        <text class="recent-row__meta">写一句也好，日子会留在这里</text>
      </view>
      <view class="recent-row__mark"><line-icon name="book-open" size="24" tone="muted" /></view>
    </view>
  </view>

  <view class="home-foot">
    <view class="home-foot__pet">
      <line-icon name="paw-print" size="24" tone="accent" />
      <text><text class="home-foot__strong">{{petSnapshot.name}}</text> · {{petSnapshot.weight}} kg</text>
    </view>
    <text>{{petSnapshot.careNotice}}</text>
  </view>
</view>
