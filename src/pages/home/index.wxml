<view class="tab-page home">
  <page-loading show="{{initialLoading}}" title="正在整理今天" copy="把共同生活里的小事收在一起。" />
  <auth-preview-gate />

  <view
    class="home-header"
    style="padding-top: {{statusBarHeight + 10}}px; padding-right: {{navBarRight}}px;"
  >
    <view class="home-header__space" hover-class="tap-dim" bindtap="onOpenSpaceSwitcher" aria-label="切换空间">
      <view class="home-header__name-row">
        <text class="home-header__name">{{spaceName}}</text>
        <view class="home-header__switch"><line-icon name="chevron-down" size="22" tone="muted" /></view>
      </view>
      <text class="home-header__date">{{snapshot.dateLabel}} · {{snapshot.weekdayLabel}}</text>
    </view>

    <view class="home-header__actions">
      <view class="member-stack" aria-label="{{spaceMemberCopy}}" bindtap="onOpenProfile">
        <view wx:for="{{spaceMembers}}" wx:if="{{index < 2}}" wx:key="userId" class="member-stack__item">
          <image wx:if="{{item.avatarUrl}}" class="member-stack__image" src="{{item.avatarUrl}}" mode="aspectFill" data-index="{{index}}" binderror="onMemberAvatarError" />
          <image wx:else class="member-stack__image" src="/images/avatars/avatar-{{item.avatarTone}}.png" mode="aspectFill" />
        </view>
      </view>
    </view>
  </view>

  <view class="home-hero">
    <view class="home-hero__copy">
      <text class="home-hero__greeting">{{snapshot.salutation}}，{{greetingName}}</text>
      <text class="home-hero__title">今天，也一起\n好好生活。</text>
    </view>
    <view class="days-together">
      <view class="days-together__dot"></view>
      <text class="days-together__label">OUR DAYS</text>
      <text class="days-together__number">{{journalTotal}}</text>
      <text class="days-together__caption">篇共同记录</text>
    </view>
  </view>

  <view class="function-glass">
    <view
      wx:for="{{homeShortcuts}}"
      wx:key="id"
      class="function-item"
      hover-class="function-item--pressed"
      data-id="{{item.id}}"
      bindtap="onOpenHomeShortcut"
    >
      <view class="function-icon function-icon--{{item.tone}}">
        <line-icon name="{{item.icon}}" size="38" tone="{{item.tone}}" />
      </view>
      <text class="function-item__label">{{item.shortLabel}}</text>
    </view>
  </view>

  <view class="moment-strip" hover-class="moment-strip--pressed" bindtap="onOpenMoment">
    <view class="moment-thumb {{latestEntry && latestEntry.image ? 'moment-thumb--photo' : ''}}">
      <image wx:if="{{latestEntry && latestEntry.image && (latestEntry.image.thumbSrc || latestEntry.image.src)}}" class="moment-thumb__photo" src="{{latestEntry.image.thumbSrc || latestEntry.image.src}}" mode="aspectFill" lazy-load />
      <block wx:else>
        <view class="moment-thumb__sun"></view>
        <view class="moment-thumb__hill"></view>
      </block>
    </view>
    <view class="moment-strip__body">
      <text class="moment-strip__eyebrow">{{latestEntry ? (latestEntryIsToday ? '刚刚发生' : latestEntry.dateLabel) : '从今天开始'}}</text>
      <text class="moment-strip__title">{{latestEntry ? latestEntry.title : '写下第一件小事'}}</text>
      <text class="moment-strip__meta">{{latestEntry ? (latestEntry.authorName || '共同空间') + ' · ' + latestEntry.timeLabel : '生活记录会在这里出现'}}</text>
    </view>
    <text class="moment-strip__arrow">›</text>
  </view>

  <view class="scene-switch">
    <view class="scene-switch__item {{homeTab === 'today' ? 'scene-switch__item--active' : ''}}" data-value="today" bindtap="onSelectHomeTab">今天</view>
    <view class="scene-switch__item {{homeTab === 'home' ? 'scene-switch__item--active' : ''}}" data-value="home" bindtap="onSelectHomeTab">家里</view>
    <view class="scene-switch__item {{homeTab === 'pet' ? 'scene-switch__item--active' : ''}}" data-value="pet" bindtap="onSelectHomeTab">{{petSnapshot.name}}</view>
  </view>

  <view wx:if="{{inventoryError}}" class="home-error">
    <line-icon name="circle-alert" size="32" tone="danger" />
    <view class="home-error__body">
      <text class="home-error__title">{{hasLoadedInventory ? '库存刷新没完成' : '家庭库存暂时没连上'}}</text>
      <text class="home-error__copy">{{hasLoadedInventory ? '先保留上次的内容，稍后再试。' : inventoryError}}</text>
    </view>
    <text class="home-error__action" bindtap="onRetryInventory">重试</text>
  </view>

  <view wx:if="{{homeTab === 'today'}}" class="scene-card scene-card--today">
    <view class="scene-card__orb scene-card__orb--one"></view>
    <view class="scene-card__orb scene-card__orb--two"></view>
    <view class="scene-card__top">
      <view class="scene-icon"><line-icon name="check" size="44" tone="ink" /></view>
      <view class="scene-count">{{todoCompletedCount}} / {{todoTotalCount}}</view>
    </view>
    <view class="scene-copy">
      <text class="scene-kicker">TODAY · 一起完成</text>
      <text class="scene-title">{{todoPendingCount ? '今天还有 ' + todoPendingCount + ' 件小事' : '今天的小事都完成了'}}</text>
      <text class="scene-note">{{todoPendingCount ? '已经完成 ' + todoCompletedCount + ' 件，给今天留一点松弛感' : '把今天轻轻收好，剩下的时间留给自己'}}</text>
    </view>
    <view class="scene-preview">
      <view class="scene-preview__icon scene-preview__icon--done"><line-icon name="check" size="26" tone="white" /></view>
      <view class="scene-preview__body">
        <text class="scene-preview__title">{{todoSummary}}</text>
        <text class="scene-preview__meta">待办 · 想到就记下</text>
      </view>
      <text class="scene-preview__time">今天</text>
    </view>
    <view class="scene-action" hover-class="scene-action--pressed" bindtap="onOpenTodo">
      <text>{{todoPendingCount ? '继续待办' : '看看全部待办'}}</text>
      <text class="scene-action__arrow">›</text>
    </view>
  </view>

  <view wx:elif="{{homeTab === 'home'}}" class="scene-card scene-card--home">
    <view class="scene-card__orb scene-card__orb--one"></view>
    <view class="scene-card__orb scene-card__orb--two"></view>
    <view class="scene-card__top">
      <view class="scene-icon"><line-icon name="package" size="44" tone="green" /></view>
      <view class="scene-count">{{snapshot.inventoryItemCount}} 件</view>
    </view>
    <view class="scene-copy">
      <text class="scene-kicker">AT HOME · 家的状态</text>
      <text class="scene-title">{{snapshot.inventoryNotice}}</text>
      <text class="scene-note">{{menuSummary}}</text>
    </view>
    <view class="scene-preview">
      <view class="scene-preview__icon"><line-icon name="clock-3" size="26" tone="gold" /></view>
      <view class="scene-preview__body">
        <text class="scene-preview__title">下厨</text>
        <text class="scene-preview__meta">{{menuCount}} 道收藏 · 去挑一道今天的菜</text>
      </view>
      <text class="scene-preview__time">去看</text>
    </view>
    <view class="scene-action" hover-class="scene-action--pressed" bindtap="onOpenInventory">
      <text>查看家庭库存</text>
      <text class="scene-action__arrow">›</text>
    </view>
  </view>

  <view wx:else class="scene-card scene-card--pet">
    <view class="scene-card__orb scene-card__orb--one"></view>
    <view class="scene-card__orb scene-card__orb--two"></view>
    <view class="scene-card__top">
      <view class="scene-icon"><line-icon name="paw-print" size="44" tone="pink" /></view>
      <view class="scene-count">{{petSnapshot.weight}} kg</view>
    </view>
    <view class="scene-copy">
      <text class="scene-kicker">PET · {{petSnapshot.name}}</text>
      <text class="scene-title">{{petSnapshot.careNotice}}</text>
      <text class="scene-note">{{petSnapshot.name}}今天状态：{{petSnapshot.status}}。吃喝拉撒、体重和照护都收在这里</text>
    </view>
    <view class="scene-preview">
      <view class="scene-preview__icon"><line-icon name="paw-print" size="26" tone="pink" /></view>
      <view class="scene-preview__body">
        <text class="scene-preview__title">{{petActivities.length ? petActivities[0].title : '还没有宠物动态'}}</text>
        <text class="scene-preview__meta">{{petActivities.length ? petActivities[0].copy : '记一次体重、洗护或今天的照护'}}</text>
      </view>
      <text class="scene-preview__time">{{petActivities.length ? petActivities[0].dateLabel : '去记录'}}</text>
    </view>
    <view class="scene-action" hover-class="scene-action--pressed" bindtap="onOpenPets">
      <text>记录今日照护</text>
      <text class="scene-action__arrow">›</text>
    </view>
  </view>

  <view wx:if="{{spaceSwitcherOpen}}" class="space-sheet-mask" catchtap="onCloseSpaceSwitcher">
    <view class="space-sheet" catchtap="noop">
      <view class="space-sheet__handle"></view>
      <view class="space-sheet__head">
        <text class="space-sheet__title">切换空间</text>
        <view class="space-sheet__close" bindtap="onCloseSpaceSwitcher">关闭</view>
      </view>
      <view class="space-sheet__list">
        <view
          wx:for="{{homeSpaces}}"
          wx:key="id"
          class="space-sheet__row {{item.isActive ? 'space-sheet__row--active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSwitchHomeSpace"
        >
          <view class="space-sheet__mark"><line-icon name="house" size="27" tone="{{item.isActive ? 'ink' : 'green'}}" /></view>
          <view class="space-sheet__body">
            <text class="space-sheet__name">{{item.name}}</text>
            <text class="space-sheet__meta">{{item.roleLabel}}</text>
          </view>
          <text wx:if="{{item.isActive}}" class="space-sheet__current">当前</text>
          <view wx:elif="{{switchingSpaceId === item.id}}" class="space-sheet__spinner"></view>
          <text wx:else class="space-sheet__action">切到这里</text>
        </view>
      </view>
    </view>
  </view>

  <app-tab-bar id="app-tab-bar" active="home" />
</view>
