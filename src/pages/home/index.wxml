<view class="home-page tab-page">
  <view class="home-head">
    <view class="home-head__body">
      <view class="home-head__meta">{{snapshot.dateLabel}} · {{snapshot.weekdayLabel}}</view>
      <view class="home-head__title">我回来啦</view>
      <view class="home-head__copy">{{snapshot.salutation}}，看看今天家里发生了什么。</view>
    </view>
    <view class="settings-button" bindtap="onOpenProfile">
      <view class="settings-button__dot"></view>
      <view class="settings-button__line"></view>
      <view class="settings-button__dot settings-button__dot--right"></view>
    </view>
  </view>

  <view class="section-head">
    <view class="section-head__title">今天</view>
    <view class="section-head__action" bindtap="onOpenInventory">看看家里 <text>›</text></view>
  </view>

  <scroll-view class="today-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="today-cards">
      <view class="today-card today-card--warm" bindtap="onOpenInventory">
        <view class="today-card__top">
          <view class="bear">
            <view class="bear__ear bear__ear--left"></view>
            <view class="bear__ear bear__ear--right"></view>
            <view class="bear__face">
              <view class="bear__eye bear__eye--left"></view>
              <view class="bear__eye bear__eye--right"></view>
              <view class="bear__nose"></view>
              <view class="bear__blush bear__blush--left"></view>
              <view class="bear__blush bear__blush--right"></view>
            </view>
          </view>
          <view class="tiny-badge">{{snapshot.inventoryItemCount}}</view>
        </view>
        <view class="today-card__title">冰箱要看看</view>
        <view class="today-card__meta">{{snapshot.inventoryNotice}}</view>
        <view class="rainbow-line"><text></text><text></text><text></text><text></text></view>
      </view>

      <view class="today-card today-card--mint" bindtap="onOpenPets">
        <view class="today-card__top">
          <view class="blob">
            <view class="blob__eye blob__eye--left"></view>
            <view class="blob__eye blob__eye--right"></view>
            <view class="blob__smile"></view>
            <view class="blob__foot blob__foot--left"></view>
            <view class="blob__foot blob__foot--right"></view>
          </view>
          <view class="tiny-badge tiny-badge--mint">宠</view>
        </view>
        <view class="today-card__title">{{petSnapshot.name}}{{petSnapshot.status}}</view>
        <view class="today-card__meta">{{petSnapshot.weight}} kg · {{petSnapshot.careNotice}}</view>
        <view class="progress"><view class="progress__bar"></view></view>
      </view>
    </view>
  </scroll-view>

  <view class="section-head section-head--spaced">
    <view class="section-head__title">我们的小日子</view>
    <view class="section-head__action" bindtap="onOpenJournal">全部 <text>›</text></view>
  </view>

  <view class="dinner-card" bindtap="onOpenMenu">
    <view class="dinner-card__icon">
      <view class="bowl"><view class="bowl__steam bowl__steam--one"></view><view class="bowl__steam bowl__steam--two"></view></view>
    </view>
    <view class="dinner-card__body">
      <view class="dinner-card__label">今晚吃什么</view>
      <view class="dinner-card__title">番茄牛腩</view>
      <view class="dinner-card__meta">用掉冰箱里的番茄和土豆</view>
    </view>
    <view class="dinner-card__time">19:00 <text>›</text></view>
  </view>

  <view class="living-grid">
    <view class="living-card living-card--blue" bindtap="onOpenInventory">
      <view class="round-icon round-icon--box"><view></view></view>
      <view class="living-card__value">{{snapshot.inventoryItemCount}}<text> 件</text></view>
      <view class="living-card__title">家中库存</view>
      <view class="mini-bars"><text></text><text></text><text></text><text></text><text></text></view>
    </view>
    <view class="living-card living-card--purple" bindtap="onOpenJournal">
      <view class="round-icon round-icon--heart"><view>♥</view></view>
      <view class="living-card__value">829<text> 天</text></view>
      <view class="living-card__title">一起生活</view>
      <view class="bubble-dots"><text></text><text></text><text></text><text></text></view>
    </view>
  </view>

  <view class="memory-card" bindtap="onOpenJournal">
    <view class="memory-card__date"><text>25</text><text>AUG</text></view>
    <view class="memory-card__body">
      <view class="memory-card__label">最近的日子</view>
      <view class="memory-card__title">下班路上，买了今年第一束桂花。</view>
      <view class="memory-card__meta">由小满记录 · 对空间成员可见</view>
    </view>
    <view class="memory-card__arrow">›</view>
  </view>
</view>
