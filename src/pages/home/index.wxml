<view class="tab-page home-page">
  <view class="home-ambient home-ambient--one"></view>
  <view class="home-ambient home-ambient--two"></view>

  <view class="home-top">
    <view class="date-chip">
      <text class="date-chip__day">{{dateParts.day}}</text>
      <view class="date-chip__meta">
        <text>{{dateParts.month}}</text>
        <text>{{snapshot.weekdayLabel}}</text>
      </view>
    </view>
    <sync-badge state="{{syncState}}" text="{{syncText}}" />
  </view>

  <view wx:if="{{inventoryError}}" class="home-error glass-card">
    <view class="home-error__icon"><line-icon name="circle-alert" size="27" tone="accent" /></view>
    <view class="home-error__body">
      <text class="home-error__title">库存暂时没连上</text>
      <text class="home-error__copy">{{inventoryError}}</text>
    </view>
    <view class="home-error__retry" bindtap="onRetryInventory">再试一次</view>
  </view>

  <view class="home-hero glass-card" bindtap="onOpenJournal">
    <view class="home-hero__halo home-hero__halo--mint"></view>
    <view class="home-hero__halo home-hero__halo--violet"></view>

    <view class="home-hero__content">
      <view class="eyebrow">YOUR LITTLE DAY</view>
      <view class="home-hero__title">{{snapshot.salutation}}，<text>今天也慢慢来</text></view>
      <view class="home-hero__copy">把普通的一天轻轻收好。家里的事，都在这里。</view>
      <view class="home-hero__actions">
        <view class="home-hero__button">
          <text>写今日记录</text>
          <line-icon name="pen-line" size="25" tone="white" />
        </view>
        <text class="home-hero__count">最近 {{recordCount}} 条</text>
      </view>
    </view>

    <view class="home-hero__art">
      <view class="home-hero__art-card">
        <image class="home-hero__image" src="../../images/demo-botanical.jpg" mode="aspectFill" />
      </view>
      <view class="home-hero__stamp"><line-icon name="heart-pulse" size="24" tone="accent" /></view>
      <text class="home-hero__credit">今日小景</text>
    </view>
  </view>

  <view class="section-head">
    <text class="section-head__title">今天先看</text>
    <text class="section-head__action">轻轻提醒，不催促</text>
  </view>

  <view class="feature-grid">
    <view class="feature-card feature-card--peach glass-card" bindtap="onOpenInventory">
      <view class="feature-card__top">
        <view class="feature-icon feature-icon--peach"><line-icon name="package" size="32" tone="accent" /></view>
        <text class="feature-card__arrow">↗</text>
      </view>
      <view class="feature-card__label">家庭库存</view>
      <view class="feature-card__value">{{snapshot.inventoryItemCount}}<text>件在库</text></view>
      <view class="feature-card__copy">{{snapshot.inventoryNotice}}</view>
    </view>

    <view class="feature-card feature-card--mint glass-card" bindtap="onOpenTodo">
      <view class="feature-card__top">
        <view class="feature-icon feature-icon--mint"><line-icon name="list-todo" size="32" tone="accent" /></view>
        <view class="feature-card__bubble">{{todoPendingCount}}</view>
      </view>
      <view class="feature-card__label">待办与小计划</view>
      <view class="feature-card__value">{{todoPendingCount}}<text>件未完成</text></view>
      <view class="feature-card__copy">{{todoSummary}}</view>
    </view>
  </view>

  <view class="section-head">
    <text class="section-head__title">常用小入口</text>
    <text class="section-head__action">今天</text>
  </view>

  <view class="quicklinks glass-card">
    <view class="quicklink" bindtap="onOpenTodo">
      <view class="quicklink__icon quicklink__icon--violet"><line-icon name="list-todo" size="29" tone="accent" /></view>
      <text class="quicklink__label">待办</text>
    </view>
    <view class="quicklink" bindtap="onOpenMenu">
      <view class="quicklink__icon quicklink__icon--mint"><line-icon name="utensils" size="29" tone="accent" /></view>
      <text class="quicklink__label">菜单</text>
    </view>
    <view class="quicklink" bindtap="onOpenPets">
      <view class="quicklink__icon quicklink__icon--peach"><line-icon name="paw-print" size="29" tone="accent" /></view>
      <text class="quicklink__label">宠物</text>
    </view>
    <view class="quicklink" bindtap="onOpenJournal">
      <view class="quicklink__icon quicklink__icon--blue"><line-icon name="book-open" size="29" tone="accent" /></view>
      <text class="quicklink__label">记录</text>
    </view>
  </view>

  <view class="section-head">
    <text class="section-head__title">最近的我们</text>
    <text class="section-head__action" bindtap="onOpenJournal">全部记录 →</text>
  </view>

  <view class="recent-card glass-card">
    <view wx:for="{{recentEntries}}" wx:key="id" class="recent-row" bindtap="onOpenJournal">
      <view class="recent-row__date">
        <text>{{item.day}}</text>
        <text>{{item.monthLabel}}</text>
      </view>
      <image wx:if="{{item.image}}" class="recent-row__thumb" src="{{item.image.src}}" mode="aspectFill" />
      <view class="recent-row__body">
        <text class="recent-row__title">{{item.title}}</text>
        <text class="recent-row__meta">{{item.authorName}} · {{item.timeLabel}}</text>
      </view>
      <view class="recent-row__mark"><line-icon name="book-open" size="22" tone="muted" /></view>
    </view>
    <view wx:if="{{!recentEntries.length}}" class="recent-row recent-row--empty" bindtap="onOpenJournal">
      <view class="recent-row__date"><text>·</text><text>今天</text></view>
      <view class="recent-row__body">
        <text class="recent-row__title">今天还没有新的记录</text>
        <text class="recent-row__meta">写一句也好，日子会留在这里</text>
      </view>
      <view class="recent-row__mark"><line-icon name="book-open" size="22" tone="muted" /></view>
    </view>
  </view>

  <view class="home-foot glass-card" bindtap="onOpenPets">
    <view class="home-foot__pet">
      <view class="home-foot__avatar"><line-icon name="paw-print" size="23" tone="accent" /></view>
      <view>
        <text class="home-foot__strong">{{petSnapshot.name}} · {{petSnapshot.weight}} kg</text>
        <text>{{petSnapshot.careNotice}}</text>
      </view>
    </view>
    <text class="home-foot__action">看看它 →</text>
  </view>
</view>
