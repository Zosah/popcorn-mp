<view class="tab-page home">
  <page-loading show="{{initialLoading}}" title="正在整理今天" copy="把共同生活里的小事收在一起。" />
  <auth-preview-gate />

  <view
    id="home-header"
    class="home-header"
    style="padding-top: {{statusBarHeight + 10}}px; padding-right: {{navBarRight}}px;"
  >
    <view class="home-header__space" hover-class="tap-dim" bindtap="onOpenSpaceSwitcher" aria-label="切换空间">
      <view class="home-header__name-row">
        <text class="home-header__name">{{spaceName}}</text>
        <view class="home-header__switch"><line-icon name="system-expand" size="22" tone="muted" /></view>
      </view>
      <text class="home-header__date">{{snapshot.dateLabel}} · {{snapshot.weekdayLabel}}</text>
    </view>

    <view class="home-header__actions">
      <view class="member-stack" aria-label="{{spaceMemberCopy}}" bindtap="onOpenProfile">
        <view wx:for="{{spaceMembers}}" wx:if="{{index < 2}}" wx:key="userId" class="member-stack__item">
          <image wx:if="{{item.avatarUrl}}" class="member-stack__image" src="{{item.avatarUrl}}" mode="aspectFill" data-index="{{index}}" binderror="onMemberAvatarError" />
          <image wx:else class="member-stack__image" src="/images/avatars/avatar-{{item.avatarTone}}.png" mode="aspectFill" />
        </view>
      </view>
    </view>
  </view>

  <view class="home-header-spacer" style="height: {{headerHeight}}px"></view>

  <view class="home-hero">
    <view class="home-hero__copy">
      <text class="home-hero__greeting">{{snapshot.salutation}}，{{greetingName}}</text>
      <text class="home-hero__title">今天，也一起\n好好生活。</text>
    </view>
    <view class="days-together">
      <view class="days-together__dot"></view>
      <text class="days-together__label">OUR DAYS</text>
      <text class="days-together__number">{{togetherDays}}</text>
      <text class="days-together__caption">天 · 共同生活</text>
    </view>
  </view>

  <view class="function-glass">
    <view
      wx:for="{{homeShortcuts}}"
      wx:key="id"
      class="function-item"
      hover-class="function-item--pressed"
      data-id="{{item.id}}"
      bindtap="onOpenHomeShortcut"
    >
      <view class="function-icon function-icon--{{item.tone}}">
        <line-icon name="{{item.icon}}" size="52" tone="{{item.tone}}" active="{{true}}" />
      </view>
      <text class="function-item__label">{{item.shortLabel}}</text>
    </view>
  </view>

  <view class="home-block">
    <view class="home-block__head">
      <text class="home-block__title">今天</text>
      <view class="home-block__link" bindtap="onOpenTodo">全部待办<text class="home-block__arrow">›</text></view>
    </view>

    <view class="today-card" hover-class="home-card--pressed" bindtap="onOpenTodo">
      <view class="today-card__head">
        <text class="today-card__kicker">TODAY</text>
        <text class="today-card__ratio">完成 {{todoCompletedCount}} / {{todoTotalCount}}</text>
      </view>
      <text class="today-card__title">{{todoPendingCount ? '还有 ' + todoPendingCount + ' 件小事' : '今天的小事都完成了'}}</text>
      <text class="today-card__copy">{{todoSummary}}</text>
      <view class="today-card__track">
        <view class="today-card__fill" style="width: {{todoTotalCount ? (todoCompletedCount * 100 / todoTotalCount) : 0}}%"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{inventoryError}}" class="home-error">
    <line-icon name="system-alert" size="32" tone="danger" />
    <view class="home-error__body">
      <text class="home-error__title">{{hasLoadedInventory ? '库存刷新没完成' : '家庭库存暂时没连上'}}</text>
      <text class="home-error__copy">{{hasLoadedInventory ? '先保留上次的内容，稍后再试。' : inventoryError}}</text>
    </view>
    <text class="home-error__action" bindtap="onRetryInventory">重试</text>
  </view>

  <view class="home-block">
    <view class="home-block__head">
      <text class="home-block__title">家里</text>
    </view>

    <view class="home-list">
      <view class="home-row" hover-class="home-row--pressed" data-target="inventory" bindtap="onOpenNearby">
        <view class="home-row__icon home-row__icon--inventory">
          <line-icon name="inventory-category-other" size="34" tone="gold" />
        </view>
        <view class="home-row__body">
          <text class="home-row__title">家庭库存</text>
          <text class="home-row__copy">{{snapshot.inventoryNotice}}</text>
        </view>
        <text class="home-row__value">{{snapshot.inventoryItemCount}} 件</text>
        <view class="home-row__chevron"></view>
      </view>

      <view class="home-row" hover-class="home-row--pressed" data-target="pets" bindtap="onOpenNearby">
        <view class="home-row__icon home-row__icon--pet">
          <line-icon name="pet-tab-profile" size="34" tone="green" />
        </view>
        <view class="home-row__body">
          <text class="home-row__title">{{petSnapshot.name}} 的照护</text>
          <text class="home-row__copy">{{petSnapshot.careNotice}}</text>
        </view>
        <text class="home-row__value">{{petSnapshot.weight}} kg</text>
        <view class="home-row__chevron"></view>
      </view>

      <view class="home-row" hover-class="home-row--pressed" data-target="menu" bindtap="onOpenNearby">
        <view class="home-row__icon home-row__icon--menu">
          <line-icon name="system-clock" size="34" tone="accent" />
        </view>
        <view class="home-row__body">
          <text class="home-row__title">今晚吃什么</text>
          <text class="home-row__copy">{{menuSummary}}</text>
        </view>
        <text class="home-row__value">{{menuCount}} 道</text>
        <view class="home-row__chevron"></view>
      </view>
    </view>
  </view>

  <view class="home-block">
    <view class="home-block__head">
      <text class="home-block__title">最近发生</text>
      <view class="home-block__link" bindtap="onOpenJournal">生活记录<text class="home-block__arrow">›</text></view>
    </view>

    <scroll-view class="moment-row" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="moment-row__inner">
        <view
          wx:for="{{recentEntries}}"
          wx:key="id"
          class="moment-card"
          hover-class="home-card--pressed"
          data-id="{{item.id}}"
          bindtap="onOpenRecord"
        >
          <image wx:if="{{item.image && (item.image.thumbSrc || item.image.src)}}" class="moment-card__image" src="{{item.image.thumbSrc || item.image.src}}" mode="aspectFill" lazy-load />
          <view wx:else class="moment-card__image moment-card__image--empty">
            <line-icon name="system-image" size="30" tone="muted" />
          </view>
          <text class="moment-card__title">{{item.title}}</text>
          <text class="moment-card__meta">{{item.dateLabel}} · {{item.timeLabel}}</text>
        </view>

        <view wx:if="{{!recentEntries.length}}" class="moment-card moment-card--empty" bindtap="onOpenJournal">
          <view class="moment-card__image moment-card__image--empty">
            <line-icon name="system-image" size="30" tone="muted" />
          </view>
          <text class="moment-card__title">写下第一件小事</text>
          <text class="moment-card__meta">生活记录会出现在这里</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{spaceSwitcherOpen}}" class="space-sheet-mask" catchtap="onCloseSpaceSwitcher">
    <view class="space-sheet" catchtap="noop">
      <view class="space-sheet__handle"></view>
      <view class="space-sheet__head">
        <text class="space-sheet__title">切换空间</text>
        <view class="space-sheet__close sheet-close-icon" bindtap="onCloseSpaceSwitcher" aria-label="关闭"><line-icon name="system-close" size="26" tone="muted" /></view>
      </view>
      <view class="space-sheet__list">
        <view
          wx:for="{{homeSpaces}}"
          wx:key="id"
          class="space-sheet__row {{item.isActive ? 'space-sheet__row--active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSwitchHomeSpace"
        >
          <view class="space-sheet__mark"><line-icon name="system-space" size="27" tone="{{item.isActive ? 'ink' : 'green'}}" /></view>
          <view class="space-sheet__body">
            <text class="space-sheet__name">{{item.name}}</text>
            <text class="space-sheet__meta">{{item.roleLabel}}</text>
          </view>
          <text wx:if="{{item.isActive}}" class="space-sheet__current">当前</text>
          <view wx:elif="{{switchingSpaceId === item.id}}" class="space-sheet__spinner"></view>
          <text wx:else class="space-sheet__action">切到这里</text>
        </view>
      </view>
    </view>
  </view>

  <app-tab-bar id="app-tab-bar" active="home" />
</view>
