<view class="page-shell menu-form-page">
  <view class="recipe-head">
    <view class="recipe-head__mark"><line-icon name="soup" size="30" tone="gold" /></view>
    <view class="recipe-head__body">
      <view class="eyebrow">RECIPE NOTE</view>
      <view class="recipe-head__title">{{pageTitle}}</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="recipe-state paper-card">
    <view class="recipe-state__mark"><line-icon name="soup" size="34" tone="gold" /></view>
    <view class="recipe-state__title">正在翻菜谱本</view>
  </view>

  <view wx:elif="{{loadError}}" class="recipe-state recipe-state--error paper-card">
    <view class="recipe-state__mark"><line-icon name="circle-alert" size="34" tone="danger" /></view>
    <view class="recipe-state__title">这份菜谱暂时没打开</view>
    <view class="recipe-state__copy">{{loadError}}</view>
    <view class="recipe-state__action" bindtap="onRetryLoad">重新加载</view>
  </view>

  <block wx:else>
    <view class="recipe-card paper-card">
      <view class="recipe-field recipe-field--lead">
        <text>菜名 <text class="required">*</text></text>
        <input value="{{form.title}}" maxlength="30" placeholder="例如：番茄牛腩" placeholder-class="field-placeholder" bindinput="onTitleInput" />
      </view>
      <view class="recipe-field">
        <text>一句话介绍</text>
        <input value="{{form.description}}" maxlength="80" placeholder="什么时候会想做这道菜" placeholder-class="field-placeholder" bindinput="onDescriptionInput" />
      </view>
      <view class="recipe-field recipe-category-field">
        <text>分类</text>
        <view class="recipe-category-row">
          <picker class="recipe-category-picker" mode="selector" range="{{categoryOptions}}" range-key="name" value="{{categoryIndex}}" bindchange="onCategoryChange">
            <view class="recipe-category-value">
              <text>{{categoryOptions[categoryIndex].name || '未分类'}}</text>
              <view class="recipe-category-chevron"><line-icon name="chevron-down" size="22" tone="muted" /></view>
            </view>
          </picker>
          <view class="recipe-category-add" bindtap="onCreateCategory">+ 新分类</view>
        </view>
      </view>
      <view class="recipe-grid">
        <view class="recipe-field">
          <text>人份</text>
          <input type="number" value="{{form.servings}}" placeholder="2" placeholder-class="field-placeholder" bindinput="onServingsInput" />
        </view>
        <view class="recipe-field">
          <text>预计分钟</text>
          <input type="number" value="{{form.cookingMinutes}}" placeholder="30" placeholder-class="field-placeholder" bindinput="onMinutesInput" />
        </view>
      </view>
    </view>

    <view class="recipe-section-head"><text>成品图</text><text>一张就够</text></view>
    <view class="paper-card recipe-image-card">
      <view wx:if="{{image && image.src}}" class="recipe-image-preview" bindtap="onPreviewImage">
        <image src="{{image.src}}" mode="aspectFill" />
        <view class="recipe-image-preview__badge"><line-icon name="image" size="18" tone="white" /><text>轻触查看</text></view>
      </view>
      <view wx:elif="{{imageUploading}}" class="recipe-image-empty">
        <view class="recipe-image-empty__mark"><line-icon name="image" size="32" tone="blue" /></view>
        <text>正在上传成品图</text>
      </view>
      <view wx:else class="recipe-image-empty" bindtap="onChooseImage">
        <view class="recipe-image-empty__mark"><line-icon name="image" size="34" tone="blue" /></view>
        <text>放一张做好的样子</text>
      </view>
      <view wx:if="{{image || imageMediaId}}" class="recipe-image-tools">
        <view class="recipe-image-tools__copy">空间内可见</view>
        <view class="recipe-image-tools__remove" catchtap="onRemoveImage">移除</view>
      </view>
    </view>

    <view class="recipe-section-head"><text>做法参考图</text><text>最多 9 张</text></view>
    <view class="note-image-grid">
      <view wx:for="{{noteImages}}" wx:key="mediaId" class="note-image-item" data-index="{{index}}" bindtap="onPreviewNoteImage">
        <image src="{{item.src}}" mode="aspectFill" />
        <view class="note-image-remove" data-index="{{index}}" catchtap="onRemoveNoteImage">×</view>
      </view>
      <view wx:if="{{noteImages.length < 9}}" class="note-image-add" bindtap="onChooseNoteImages">
        <line-icon name="plus" size="28" tone="faint" />
        <text>{{noteImageUploading ? '上传中' : '添加'}}</text>
      </view>
    </view>

    <view class="recipe-section-head"><text>准备食材</text><text>{{ingredients.length}} 样</text></view>
    <view class="ingredient-list">
      <view wx:for="{{ingredients}}" wx:key="key" class="ingredient-row paper-card">
        <input class="ingredient-row__name" value="{{item.name}}" maxlength="40" placeholder="食材名" placeholder-class="field-placeholder" data-index="{{index}}" data-field="name" bindinput="onIngredientInput" />
        <view class="ingredient-stepper">
          <view class="ingredient-stepper__button" data-index="{{index}}" data-delta="-1" bindtap="onIngredientStep">−</view>
          <input class="ingredient-stepper__value" type="digit" value="{{item.quantity}}" maxlength="6" data-index="{{index}}" data-field="quantity" bindinput="onIngredientInput" />
          <view class="ingredient-stepper__button" data-index="{{index}}" data-delta="1" bindtap="onIngredientStep">＋</view>
        </view>
        <picker class="ingredient-unit-picker" mode="selector" range="{{unitOptions}}" value="{{item.unitIndex}}" data-index="{{index}}" bindchange="onIngredientUnitChange">
          <view class="ingredient-unit">
            <text>{{item.unit || '个'}}</text>
            <line-icon name="chevron-down" size="18" tone="muted" />
          </view>
        </picker>
        <view class="row-remove" data-index="{{index}}" bindtap="onRemoveIngredient">删除</view>
      </view>
      <view class="add-row" bindtap="onAddIngredient"><line-icon name="plus" size="22" tone="gold" /><text>再加一样</text></view>
    </view>

    <view class="recipe-section-head"><text>做法</text><text>一行一步</text></view>
    <view class="step-editor paper-card">
      <textarea
        value="{{stepsText}}"
        maxlength="3000"
        auto-height
        placeholder="先焯水去浮沫\n再小火慢炖，最后调味"
        placeholder-class="field-placeholder"
        bindinput="onStepsInput"
      />
      <view class="step-editor__hint">换行后会整理成步骤</view>
    </view>

    <button class="primary-button recipe-save" loading="{{saving || imageUploading || noteImageUploading}}" disabled="{{saving || imageUploading || noteImageUploading}}" bindtap="onSave">
      <line-icon name="utensils" size="24" tone="white" />
      <text>{{saveText}}</text>
    </button>
  </block>
</view>
