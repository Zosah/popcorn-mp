<view class="page-shell menu-form-page">
  <view class="recipe-head">
    <view class="recipe-head__mark"><line-icon name="soup" size="30" tone="gold" /></view>
    <view class="recipe-head__body">
      <view class="eyebrow">RECIPE NOTE</view>
      <view class="recipe-head__title">{{pageTitle}}</view>
      <view class="recipe-head__copy">把常做的一道菜收进菜谱本，下次不知道吃什么时就有答案。</view>
    </view>
  </view>

  <view class="recipe-card paper-card">
    <view class="recipe-field recipe-field--lead">
      <text>菜名 <text class="required">*</text></text>
      <input value="{{form.title}}" maxlength="30" placeholder="例如：番茄牛腩" bindinput="onTitleInput" />
    </view>
    <view class="recipe-field">
      <text>一句话介绍</text>
      <input value="{{form.description}}" maxlength="80" placeholder="什么时候会想做这道菜" bindinput="onDescriptionInput" />
    </view>
    <view class="recipe-grid">
      <view class="recipe-field">
        <text>人份</text>
        <input type="number" value="{{form.servings}}" placeholder="2" bindinput="onServingsInput" />
      </view>
      <view class="recipe-field">
        <text>预计分钟</text>
        <input type="number" value="{{form.cookingMinutes}}" placeholder="30" bindinput="onMinutesInput" />
      </view>
    </view>
  </view>

  <view class="recipe-section-head"><text>准备食材</text><text>每行一样</text></view>
  <view class="recipe-card paper-card">
    <view class="recipe-field recipe-field--stack recipe-field--last">
      <text>用 | 分隔名称、用量、来源</text>
      <textarea value="{{form.ingredientsText}}" maxlength="600" placeholder="牛腩 | 400g | 冰箱冷冻&#10;番茄 | 3 个 | 冰箱冷藏" bindinput="onIngredientsInput" />
    </view>
  </view>

  <view class="recipe-section-head"><text>做法步骤</text><text>每行一步</text></view>
  <view class="recipe-card paper-card">
    <view class="recipe-field recipe-field--stack recipe-field--last">
      <text>用 | 分隔步骤名和说明</text>
      <textarea value="{{form.stepsText}}" maxlength="900" placeholder="焯水 | 牛腩冷水下锅，煮开后洗净浮沫。&#10;炒香 | 番茄炒出汁，再放入牛腩。" bindinput="onStepsInput" />
    </view>
  </view>

  <button class="primary-button recipe-save" loading="{{saving}}" disabled="{{saving}}" bindtap="onSave">
    <line-icon name="utensils" size="24" tone="white" />
    <text>{{saveText}}</text>
  </button>
</view>
