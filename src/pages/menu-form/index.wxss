.menu-form-page {
  --recipe-paper: var(--c-paper, #f8f7f4);
  --recipe-ink: var(--c-text, #252b27);
  --recipe-ink-2: var(--c-text-2, #5f5a53);
  --recipe-ink-3: var(--c-muted, #837f76);
  --recipe-line: var(--c-line, #e9e6e1);
  --recipe-deep: var(--c-primary, #252b27);
  --recipe-gold: var(--c-warning, #a18448);
  padding: 28rpx 32rpx calc(82rpx + env(safe-area-inset-bottom));
  background: var(--recipe-paper);
  color: var(--recipe-ink);
}

.recipe-head { display: flex; align-items: center; padding: 8rpx 2rpx 26rpx; gap: 17rpx; }
.recipe-head__mark { display: flex; width: 72rpx; height: 72rpx; align-items: center; justify-content: center; border-radius: 24rpx; background: var(--c-butter-soft, #f2e8cc); flex-shrink: 0; }
.recipe-head__body { min-width: 0; flex: 1; }
.eyebrow { color: var(--recipe-gold); font-size: 18rpx; font-weight: 700; letter-spacing: 4rpx; }
.recipe-head__title { margin-top: 7rpx; font-family: var(--font-serif); font-size: 42rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1.25; }

.paper-card { border: 1rpx solid var(--recipe-line); border-radius: 28rpx; background: #ffffff; box-shadow: 0 10rpx 28rpx rgba(42, 62, 50, 0.04); }
.recipe-card { overflow: hidden; padding: 0 22rpx; }
.recipe-field { padding: 20rpx 0; border-bottom: 1rpx solid var(--recipe-line); }
.recipe-field--lead { padding-top: 24rpx; }
.recipe-field > text { display: block; color: var(--recipe-ink-3); font-size: 23rpx; font-weight: 500; letter-spacing: 0.4rpx; }
.required { color: var(--c-primary-link, #b86757); }
.recipe-field input { height: 64rpx; color: var(--recipe-ink); font-family: inherit; font-size: 30rpx; font-weight: 500; }
.field-placeholder { color: #a7a29a; font-size: 25rpx; font-weight: 400; }
.recipe-intro { display: flex; align-items: stretch; padding: 4rpx 0 20rpx; gap: 20rpx; }
.recipe-intro__fields { min-width: 0; flex: 1; }
.recipe-intro__fields .recipe-field--description { padding-bottom: 22rpx; border-bottom: 0; }
.recipe-cover { width: 196rpx; height: 196rpx; align-self: center; flex-shrink: 0; }
.recipe-cover__preview, .recipe-cover__empty {
  position: relative;
  display: flex;
  width: 100%;
  height: 100%;
  overflow: hidden;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 24rpx;
  box-sizing: border-box;
}
.recipe-cover__preview { background: #f3f0e9; box-shadow: 0 8rpx 20rpx rgba(57, 49, 40, 0.09); }
.recipe-cover__preview image { width: 100%; height: 100%; }
.recipe-cover__caption {
  position: absolute;
  top: 9rpx;
  left: 9rpx;
  display: flex;
  height: 38rpx;
  padding: 0 12rpx;
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.52);
  border-radius: 999rpx;
  background: rgba(34, 42, 37, 0.62);
  color: #fff;
  font-size: 19rpx;
  font-weight: 600;
  backdrop-filter: blur(10rpx);
}
.recipe-cover__remove {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  display: flex;
  height: 40rpx;
  padding: 0 13rpx;
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.52);
  border-radius: 999rpx;
  background: rgba(34, 42, 37, 0.68);
  color: #fff;
  font-size: 19rpx;
  font-weight: 600;
  backdrop-filter: blur(10rpx);
}
.recipe-cover__empty {
  border-style: dashed;
  border-color: #d8d2c8;
  background: linear-gradient(145deg, #fbfaf7, #f3efe7);
  color: var(--recipe-ink-3);
  flex-direction: column;
  gap: 8rpx;
  font-size: 21rpx;
}
.recipe-cover__empty--busy { background: #f1f5f3; color: var(--recipe-ink-2); }

.recipe-category-field { padding: 20rpx 0 22rpx; border-bottom: 0; }
.recipe-category-row { display: flex; align-items: center; margin-top: 7rpx; gap: 12rpx; }
.recipe-category-picker { min-width: 0; flex: 1; }
.recipe-category-value { display: flex; height: 64rpx; align-items: center; justify-content: space-between; color: var(--recipe-ink); font-size: 29rpx; font-weight: 500; }
.recipe-category-chevron {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  background: linear-gradient(145deg, #fff, #f2eee6);
  box-shadow:
    0 5rpx 13rpx rgba(72, 62, 50, 0.13),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
}
.recipe-category-add { display: flex; height: 52rpx; padding: 0 17rpx; align-items: center; border-radius: 999rpx; background: var(--c-butter-soft, #f2e8cc); color: var(--recipe-gold); font-size: 22rpx; font-weight: 600; }

.recipe-section-head { display: flex; align-items: baseline; justify-content: space-between; margin: 32rpx 4rpx 13rpx; }
.recipe-section-head text:first-child { font-size: 31rpx; font-weight: 700; letter-spacing: -0.4rpx; }
.recipe-section-head text:last-child { color: var(--recipe-ink-3); font-size: 22rpx; }
.recipe-save { width: 100%; margin-top: 32rpx; gap: 10rpx; }

.recipe-state { padding: 54rpx 34rpx; text-align: center; }
.recipe-state__mark { display: flex; width: 86rpx; height: 86rpx; margin: 0 auto 18rpx; align-items: center; justify-content: center; border-radius: 28rpx; background: var(--c-butter-soft, #f2e8cc); }
.recipe-state--error .recipe-state__mark { background: #fbe8e3; }
.recipe-state__title { font-size: 31rpx; font-weight: 700; }
.recipe-state__copy { margin-top: 10rpx; color: var(--recipe-ink-2); font-size: 25rpx; line-height: 1.65; }
.recipe-state__action { display: inline-flex; min-width: 180rpx; height: 66rpx; margin-top: 24rpx; padding: 0 28rpx; box-sizing: border-box; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--recipe-deep); color: #fff; font-size: 25rpx; font-weight: 600; }

.note-image-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.note-image-item, .note-image-add { position: relative; overflow: hidden; width: 100%; aspect-ratio: 1; border-radius: 22rpx; }
.note-image-item { background: #ece9e3; }
.note-image-item image { width: 100%; height: 100%; }
.note-image-remove { position: absolute; top: 8rpx; right: 8rpx; display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; border-radius: 50%; background: rgba(30, 30, 28, 0.66); color: #fff; font-size: 28rpx; line-height: 1; }
.note-image-add { display: flex; align-items: center; justify-content: center; border: 1rpx dashed #d7d2c8; background: rgba(255, 255, 255, 0.72); color: var(--recipe-ink-3); flex-direction: column; gap: 6rpx; font-size: 22rpx; }

.ingredient-list { display: flex; flex-direction: column; gap: 13rpx; }
.ingredient-row {
  display: flex;
  min-height: 92rpx;
  align-items: center;
  padding: 13rpx 14rpx 13rpx 20rpx;
  gap: 12rpx;
}
.ingredient-row__name {
  min-width: 0;
  height: 62rpx;
  color: var(--recipe-ink);
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
}
.ingredient-stepper {
  display: flex;
  height: 52rpx;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid var(--recipe-line);
  border-radius: 999rpx;
  background: #fbfaf7;
  flex-shrink: 0;
}
.ingredient-stepper__button {
  display: flex;
  width: 39rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  color: var(--recipe-gold);
  font-size: 26rpx;
  font-weight: 600;
}
.ingredient-stepper__value {
  width: 50rpx;
  height: 52rpx;
  color: var(--recipe-ink);
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}
.ingredient-unit-picker { flex-shrink: 0; }
.ingredient-unit {
  display: flex;
  min-width: 92rpx;
  height: 52rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 10rpx 0 14rpx;
  border: 1rpx solid var(--recipe-line);
  border-radius: 17rpx;
  background: #fbfaf7;
  box-sizing: border-box;
  color: var(--recipe-ink-2);
  gap: 4rpx;
  font-size: 23rpx;
}
.row-remove {
  display: flex;
  height: 52rpx;
  align-items: center;
  padding: 0 3rpx 0 5rpx;
  color: var(--recipe-ink-3);
  flex-shrink: 0;
  font-size: 21rpx;
}
.step-editor { padding: 22rpx 22rpx 16rpx; }
.step-editor textarea {
  width: 100%;
  min-height: 182rpx;
  color: var(--recipe-ink);
  font-size: 27rpx;
  line-height: 1.75;
}
.step-editor__hint {
  padding-top: 13rpx;
  border-top: 1rpx solid var(--recipe-line);
  color: var(--recipe-ink-3);
  font-size: 21rpx;
}
.add-row { display: flex; height: 74rpx; align-items: center; justify-content: center; border: 1rpx dashed #d9d3c7; border-radius: 24rpx; background: rgba(255, 255, 255, 0.56); color: var(--recipe-gold); gap: 7rpx; font-size: 24rpx; font-weight: 600; }
