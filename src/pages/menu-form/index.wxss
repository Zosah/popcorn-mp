.menu-form-page {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.menu-form-head {
  padding: 8rpx 0 30rpx;
}

.menu-form-head__title {
  max-width: 620rpx;
  color: var(--c-text, #22242e);
  font-size: 46rpx;
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: -2rpx;
}

.menu-form-head__copy {
  max-width: 610rpx;
  margin-top: 12rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 24rpx;
  line-height: 1.65;
}

.menu-form-page .card {
  border: 0;
  border-radius: 0;
  background: transparent;
}

.menu-form-card {
  padding: 0;
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.menu-field {
  padding: 23rpx 0;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.menu-field--last {
  border-bottom: 0;
}

.menu-field > text {
  display: block;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.menu-field input {
  height: 66rpx;
  margin-top: 5rpx;
  color: var(--c-text, #22242e);
  font-size: 29rpx;
  font-weight: 500;
}

.menu-field input::placeholder,
.menu-field textarea::placeholder {
  color: #a8abba;
  font-weight: 400;
}

.menu-field textarea {
  width: 100%;
  height: 250rpx;
  box-sizing: border-box;
  margin-top: 14rpx;
  padding: 16rpx 0 16rpx 18rpx;
  border-left: 1rpx solid var(--c-line-strong, #d6d5e0);
  color: var(--c-text, #22242e);
  font-size: 24rpx;
  line-height: 1.7;
}

.menu-form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
}

.menu-form-grid .menu-field {
  border-bottom: 0;
}

.menu-form-grid .menu-field + .menu-field {
  padding-left: 24rpx;
  border-left: 1rpx solid var(--c-line, #e7e6ee);
}

.menu-form-save {
  width: 100%;
  margin-top: 32rpx;
  gap: 10rpx;
}
