.detail-page {
  padding-bottom: calc(90rpx + env(safe-area-inset-bottom));
}

.detail-page .card {
  border: 0;
  border-radius: 0;
  background: transparent;
}

.detail-hero {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 8rpx;
  padding: 28rpx 0;
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.detail-hero__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-radius: 50%;
  color: var(--c-accent, #5b6ee0);
  flex-shrink: 0;
  font-family: "Songti SC", "STSong", serif;
  font-size: 25rpx;
  font-weight: 400;
}

.detail-hero__body {
  display: flex;
  align-items: flex-start;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.detail-hero__name {
  overflow: hidden;
  width: 100%;
  color: var(--c-text, #22242e);
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-hero__copy {
  color: var(--c-muted, #9497a6);
  font-size: 22rpx;
}

.edit-link {
  display: flex;
  align-items: center;
  gap: 7rpx;
  align-self: flex-start;
  margin-left: 12rpx;
  padding: 4rpx 0 10rpx;
  border-bottom: 1rpx solid var(--c-text, #22242e);
  color: var(--c-text, #22242e);
  font-size: 22rpx;
  font-weight: 400;
}

.info-card {
  padding: 0;
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 94rpx;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
  color: var(--c-muted, #9497a6);
  font-size: 23rpx;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-row text:last-child {
  max-width: 68%;
  color: var(--c-text, #22242e);
  font-weight: 500;
  text-align: right;
}

.note-card {
  padding: 20rpx 0 20rpx 18rpx;
  border-top: 0;
  border-bottom: 0;
  border-left: 1rpx solid var(--c-line-strong, #d6d5e0);
  color: var(--c-text-2, #5c5f6e);
  font-size: 24rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.action-grid button {
  width: 100%;
  min-height: 84rpx;
  font-size: 23rpx;
}
