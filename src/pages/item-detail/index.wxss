.detail-page {
  --detail-paper: var(--c-paper, #f8f7f4);
  --detail-ink: var(--c-text, #252b27);
  --detail-ink-2: var(--c-text-2, #5f5a53);
  --detail-ink-3: var(--c-muted, #837f76);
  --detail-line: var(--c-line, #e9e6e1);
  --detail-deep: var(--c-primary, #252b27);
  --detail-orange: #9a7250;
  --detail-red: var(--c-primary-link, #b86757);
  padding: 30rpx 36rpx calc(70rpx + env(safe-area-inset-bottom));
  background: var(--detail-paper);
  color: var(--detail-ink);
}

.detail-top {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  gap: 18rpx;
}

.detail-back {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--detail-line);
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(42, 62, 50, 0.05);
  font-family: Arial, sans-serif;
  font-size: 51rpx;
  font-weight: 300;
  line-height: 1;
  padding-bottom: 6rpx;
}

.detail-top__main {
  min-width: 0;
  flex: 1;
}

.detail-top__title {
  font-family: var(--font-serif);
  overflow: hidden;
  font-size: 39rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-top__sub {
  margin-top: 4rpx;
  color: var(--detail-ink-3);
  font-size: 24rpx;
}

.detail-edit {
  display: flex;
  height: 56rpx;
  align-items: center;
  padding: 0 19rpx;
  border: 1rpx solid var(--detail-line);
  border-radius: 999rpx;
  background: #ffffff;
  gap: 7rpx;
  color: var(--detail-ink);
  font-size: 25rpx;
  font-weight: 600;
}

.detail-hero {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 30rpx 26rpx;
  border: 1rpx solid var(--detail-line);
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(42, 62, 50, 0.04);
  gap: 22rpx;
}

.detail-hero__icon {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: var(--c-coral-soft, #f7e7e2);
  flex-shrink: 0;
}

.detail-hero__body {
  min-width: 0;
  flex: 1;
}

.detail-hero__name {
  font-size: 36rpx;
  font-weight: 700;
}

.detail-hero__meta {
  margin-top: 7rpx;
  color: var(--detail-ink-2);
  font-size: 25rpx;
}

.detail-hero__state {
  display: flex;
  align-items: flex-end;
  flex-direction: column;
  gap: 7rpx;
  color: var(--detail-ink-3);
  flex-shrink: 0;
  font-size: 23rpx;
}

.detail-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 34rpx 4rpx 14rpx;
}

.detail-section-head text:first-child {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.detail-section-head text:last-child {
  color: var(--detail-ink-3);
  font-size: 23rpx;
}

.detail-info {
  overflow: hidden;
  padding: 0 24rpx;
  border: 1rpx solid var(--detail-line);
  border-radius: 30rpx;
  background: #ffffff;
}

.detail-info__row {
  display: flex;
  min-height: 84rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--detail-line);
  gap: 24rpx;
  font-size: 27rpx;
}

.detail-info__row:last-child { border-bottom: 0; }
.detail-info__row text:first-child { color: var(--detail-ink-2); }
.detail-info__row text:last-child { font-weight: 600; text-align: right; }

.detail-note {
  padding: 24rpx;
  border: 1rpx solid var(--detail-line);
  border-radius: 28rpx;
  background: var(--c-paper-2, #f1ede7);
  color: var(--detail-ink-2);
  font-size: 27rpx;
  line-height: 1.8;
}

.detail-timeline {
  position: relative;
  padding-left: 30rpx;
}

.detail-timeline::before {
  position: absolute;
  top: 12rpx;
  bottom: 18rpx;
  left: 8rpx;
  width: 2rpx;
  background: var(--detail-line);
  content: "";
}

.detail-timeline__item {
  position: relative;
  padding: 0 0 27rpx 12rpx;
}

.detail-timeline__item:last-child { padding-bottom: 0; }

.detail-timeline__dot {
  position: absolute;
  top: 5rpx;
  left: -28rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
}

.detail-timeline__dot--orange { background: var(--detail-orange); }
.detail-timeline__dot--green { background: var(--c-sage, #668478); }

.detail-timeline__date {
  color: var(--detail-ink-3);
  font-size: 24rpx;
}

.detail-timeline__title {
  margin-top: 4rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.detail-timeline__copy {
  margin-top: 4rpx;
  color: var(--detail-ink-2);
  font-size: 25rpx;
  line-height: 1.65;
}

.detail-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.detail-action {
  display: flex;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 999rpx;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 78rpx;
}

.detail-action--consume {
  background: var(--detail-deep);
  color: #fff;
}

.detail-action--archive {
  background: var(--c-paper-2, #f1ede7);
  color: var(--detail-ink-2);
}

.detail-action--discard {
  background: var(--c-coral-soft, #f7e7e2);
  color: var(--detail-red);
}

.detail-action--restore {
  background: var(--detail-deep);
  color: #fff;
}

.detail-delete {
  height: 68rpx;
  margin-top: 16rpx;
  border: 0;
  background: transparent;
  color: var(--detail-red);
  font-size: 25rpx;
  line-height: 68rpx;
}

.detail-state {
  display: flex;
  min-height: 420rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: var(--detail-ink-3);
  font-size: 27rpx;
  text-align: center;
}

.detail-state__icon {
  display: flex;
  width: 84rpx;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: var(--c-coral-soft, #f7e7e2);
}

.detail-state__title {
  margin-top: 18rpx;
  color: var(--detail-ink);
  font-size: 31rpx;
  font-weight: 700;
}

.detail-state__copy {
  max-width: 500rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.65;
}

.detail-state__action {
  margin-top: 20rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: var(--detail-deep);
  color: #fff;
  font-size: 25rpx;
  font-weight: 600;
}
