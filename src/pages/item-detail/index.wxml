<view class="page-shell detail-page" wx:if="{{item}}">
  <view class="subpage-back" bindtap="onBack">← 返回库存</view>

  <view class="detail-hero card">
    <view class="detail-hero__icon"><line-icon name="{{item.iconName}}" size="36" tone="accent" /></view>
    <view class="detail-hero__body">
      <view class="detail-hero__name">{{item.name}}</view>
      <view class="detail-hero__copy">{{item.categoryLabel}} · {{item.locationLabel}}</view>
      <expiry-badge status="{{item.expiry.status}}" label="{{item.expiry.label}}" />
    </view>
    <view class="edit-link" bindtap="onEdit"><line-icon name="pen-line" size="20" tone="ink" /><text>编辑</text></view>
  </view>

  <view class="section-head">
    <text class="section-head__title">物品信息</text>
  </view>
  <view class="info-card card">
    <view class="info-row"><text>数量</text><text>{{item.quantity}}{{item.unit}}</text></view>
    <view class="info-row"><text>分类</text><text>{{item.categoryLabel}}</text></view>
    <view class="info-row"><text>存放位置</text><text>{{item.locationLabel}}</text></view>
    <view class="info-row"><text>有效期</text><text>{{item.expiresOn || '未设置'}}</text></view>
    <view class="info-row"><text>当前状态</text><text>{{item.statusLabel}}</text></view>
  </view>

  <block wx:if="{{item.note}}">
    <view class="section-head">
      <text class="section-head__title">备注</text>
    </view>
    <view class="note-card card">{{item.note}}</view>
  </block>

  <view class="section-head">
    <text class="section-head__title">快捷操作</text>
  </view>
  <view class="action-grid">
    <button wx:for="{{item.actions}}" wx:key="key" class="secondary-button" data-status="{{item.nextStatus}}" bindtap="onChangeStatus">{{item.label}}</button>
    <button class="danger-button" bindtap="onDelete">删除物品</button>
  </view>
</view>
