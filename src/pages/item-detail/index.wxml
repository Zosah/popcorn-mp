<app-toast visible="{{appToastVisible}}" text="{{appToastText}}" />
<view class="page-shell detail-page">
  <view wx:if="{{loading}}" class="detail-state">正在打开这件物品…</view>
  <view wx:elif="{{errorMessage}}" class="detail-state">
    <view class="detail-state__icon"><line-icon name="system-alert" size="34" tone="danger" /></view>
    <view class="detail-state__title">详情暂时没连上</view>
    <view class="detail-state__copy">{{errorMessage}}</view>
    <view class="detail-state__action" bindtap="onRetry">重新加载</view>
  </view>

  <block wx:elif="{{item}}">
    <view class="detail-top">
      <view class="detail-top__main">
        <view class="detail-top__title">{{item.name}}</view>
        <view class="detail-top__sub">{{item.categoryLabel}} · {{item.locationLabel}}</view>
      </view>
      <view class="detail-top__actions">
        <view class="detail-top__delete" bindtap="onDelete">删除</view>
        <view class="detail-edit" bindtap="onEdit">
          <line-icon name="system-edit" size="18" tone="white" />
          <text>编辑</text>
        </view>
      </view>
    </view>

    <view class="detail-hero">
      <view wx:if="{{item.imageSrc}}" class="detail-hero__icon detail-hero__icon--image" bindtap="onPreviewImage">
        <image class="detail-hero__image" src="{{item.imageSrc}}" mode="aspectFill" />
      </view>
      <view wx:elif="{{item.iconUrl}}" class="detail-hero__icon"><image class="detail-hero__icon-image" src="{{item.iconUrl}}" mode="aspectFit" /></view>
      <image
        wx:else
        class="detail-hero__icon detail-hero__icon--image"
        src="{{item.placeholder}}"
        mode="aspectFill"
      />
      <view class="detail-hero__body">
        <view class="detail-hero__name">{{item.name}}</view>
        <view class="detail-hero__meta">{{item.quantity}}{{item.unit}} · {{item.locationLabel}}</view>
      </view>
      <view class="detail-hero__state">
        <text>{{item.statusLabel}}</text>
        <expiry-badge wx:if="{{item.status === 'active'}}" status="{{item.expiry.status}}" label="{{item.expiry.label}}" />
      </view>
    </view>

    <view wx:if="{{item.generating}}" class="detail-image-hint">
      <line-icon name="system-refresh" size="20" tone="pink" />
      <text>AI 正在补充示意图，稍后自动出现</text>
    </view>
    <view wx:elif="{{item.generateFailed}}" class="detail-image-hint detail-image-hint--failed">
      <line-icon name="system-alert" size="20" tone="danger" />
      <text>示意图没生成出来，去编辑页可以重试</text>
    </view>

    <view class="detail-section-head">
      <text>物品信息</text>
      <text>放在一起就不容易忘</text>
    </view>
    <view class="detail-info">
      <view class="detail-info__row detail-info__row--qty">
        <text>数量</text>
        <view wx:if="{{item.status === 'active'}}" class="detail-info__stepper">
          <view class="detail-info__step {{adjusting ? 'detail-info__step--busy' : ''}}" data-delta="-1" bindtap="onQuickAdjust">−</view>
          <text class="detail-info__qty">{{item.quantity}}<text class="detail-info__unit">{{item.unit}}</text></text>
          <view class="detail-info__step detail-info__step--plus {{adjusting ? 'detail-info__step--busy' : ''}}" data-delta="1" bindtap="onQuickAdjust">＋</view>
        </view>
        <text wx:else>{{item.quantity}}{{item.unit}}</text>
      </view>
      <view class="detail-info__row"><text>分类</text><text>{{item.categoryLabel}}</text></view>
      <view class="detail-info__row"><text>存放位置</text><text>{{item.locationLabel}}</text></view>
      <view class="detail-info__row"><text>有效期</text><text>{{item.expiresOnLabel || '未设置'}}</text></view>
      <view class="detail-info__row"><text>当前状态</text><text>{{item.statusLabel}}</text></view>
    </view>

    <block wx:if="{{item.note}}">
      <view class="detail-section-head"><text>备注</text><text>留给之后的自己</text></view>
      <view class="detail-note">{{item.note}}</view>
    </block>

    <view class="detail-section-head"><text>处理这件东西</text><text>先做最常用的一步</text></view>
    <view class="detail-actions">
      <button wx:for="{{item.actions}}" wx:key="key" class="detail-action detail-action--{{item.key}}" data-status="{{item.nextStatus}}" bindtap="onChangeStatus">
        <line-icon name="{{item.key === 'discard' ? 'system-alert' : item.key === 'archive' ? 'inventory-status-archived' : item.key === 'restore' ? 'system-refresh' : 'system-check'}}" size="22" tone="{{item.key === 'discard' ? 'danger' : 'ink'}}" />
        <text>{{item.label}}</text>
      </button>
    </view>
    <view class="detail-section-head"><text>变化记录</text><text>谁动过、动了什么</text></view>
    <view class="detail-timeline">
      <view wx:for="{{item.timeline}}" wx:key="id" class="detail-timeline__item">
        <view class="detail-timeline__dot detail-timeline__dot--{{item.tone}}"></view>
        <view class="detail-timeline__date">{{item.label}}</view>
        <view class="detail-timeline__title">{{item.summary}}</view>
        <view wx:if="{{item.detail}}" class="detail-timeline__copy">{{item.detail}}</view>
      </view>
      <view wx:if="{{!item.timeline.length}}" class="detail-timeline__empty">还没有记录</view>
    </view>

  </block>
</view>
