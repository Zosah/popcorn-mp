<pull-refresh show="{{pullRefreshing}}" />
<template name="todo-row">
  <view class="todo-item {{done ? 'todo-item--done' : ''}}" data-id="{{id}}" bindlongpress="onLongPressItem">
    <view class="todo-item__main" data-id="{{id}}" bindtap="onEditItem">
      <view class="todo-check {{done ? 'todo-check--done' : ''}}" data-id="{{id}}" catchtap="onToggleItem">
        <line-icon wx:if="{{done}}" name="system-check" size="15" tone="white" />
      </view>
      <view class="todo-item__body">
        <view class="todo-item__title-row">
          <text class="todo-item__title">{{title}}</text>
          <text wx:if="{{tagLabel}}" class="todo-item__tag">{{tagLabel}}</text>
        </view>
        <text wx:if="{{note}}" class="todo-item__note">{{note}}</text>
        <view class="todo-item__meta">
          <text wx:if="{{dateLabel}}" class="{{overdue ? 'todo-item__date todo-item__date--late' : 'todo-item__date'}}">{{overdue ? '已过期 · ' : ''}}{{dateLabel}}</text>
          <text wx:else class="todo-item__date">未设截止日期</text>
        </view>
      </view>
    </view>
  </view>
</template>

<view class="page-shell todo-page">
  <page-loading show="{{loading && !hasLoaded}}" title="正在整理待办" copy="把想到的事轻轻收好。" />
  <auth-preview-gate />

  <view class="todo-head">
    <view class="todo-head__body">
      <text class="todo-head__title">{{pageTitle}}</text>
      <text class="todo-head__sub">{{pageCopy}}</text>
    </view>
    <view class="todo-create" hover-class="todo-create--pressed" bindtap="onCreate">
      <line-icon name="system-add" size="19" tone="ink" />
      <text>新建</text>
    </view>
  </view>

  <view wx:if="{{isPlanMode}}" class="todo-overview">
    <view class="todo-overview__top">
      <view class="todo-overview__copy">
        <text class="todo-overview__eyebrow">待完成</text>
        <view class="todo-overview__number">{{pendingCount}}<text> 件</text></view>
      </view>
      <text class="todo-overview__progress">{{completedCount}} / {{totalCount}} 已完成</text>
    </view>
    <view class="todo-overview__track"><view class="todo-overview__fill" style="width: {{progressPercent}}%;"></view></view>
  </view>

  <view wx:if="{{isPlanMode}}" class="todo-tag-section">
    <scroll-view class="todo-tags" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="todo-tags__row">
        <view
          wx:for="{{tagFilters}}"
          wx:key="value"
          class="todo-tag {{activeTag === item.value ? 'todo-tag--active' : ''}}"
          data-tag="{{item.value}}"
          bindtap="onSelectTag"
          bindlongpress="onLongPressTag"
        >
          <text>{{item.label}}</text>
          <text wx:if="{{item.count}}" class="todo-tag__count">{{item.count}}</text>
        </view>
        <view class="todo-tag todo-tag--create" bindtap="onCreateTag">
          <line-icon name="system-add" size="15" tone="muted" />
          <text>新标签</text>
        </view>
      </view>
    </scroll-view>
    <text wx:if="{{tagFilters.length > 2}}" class="todo-tag-section__hint">长按标签可重命名或删除</text>
  </view>

  <view wx:if="{{isPlanMode}}" class="todo-status">
    <text class="todo-status__summary">{{statusFilter === 'pending' ? '还有 ' + visibleCount + ' 件' : '已完成 ' + visibleCount + ' 件'}}</text>
    <view class="todo-status__switch">
      <view class="todo-status__item {{statusFilter === 'pending' ? 'todo-status__item--active' : ''}}" data-status="pending" bindtap="onSelectStatus">待完成</view>
      <view class="todo-status__item {{statusFilter === 'completed' ? 'todo-status__item--active' : ''}}" data-status="completed" bindtap="onSelectStatus">已完成</view>
    </view>
  </view>

  <view wx:if="{{loadError && allItems.length}}" class="todo-banner">
    <line-icon name="system-alert" size="20" tone="danger" />
    <text class="todo-banner__copy">这次没有刷新完整，先显示上次的内容。</text>
    <text class="todo-banner__action" bindtap="onRetryLoad">重试</text>
  </view>

  <view wx:if="{{loading && !allItems.length}}" class="todo-state">
    <view class="todo-state__mark"><line-icon name="todo-status-pending" size="34" tone="green" /></view>
    <text class="todo-state__title">正在整理待办</text>
    <text class="todo-state__copy">稍等一下，马上就好。</text>
  </view>

  <view wx:elif="{{loadError && !allItems.length}}" class="todo-state">
    <view class="todo-state__mark todo-state__mark--error"><line-icon name="system-alert" size="34" tone="danger" /></view>
    <text class="todo-state__title">暂时没有连上</text>
    <text class="todo-state__copy">{{loadError}}</text>
    <view class="todo-state__action" bindtap="onRetryLoad">重新加载</view>
  </view>

  <block wx:elif="{{isPlanMode && activeTag === '__all__' && tagGroups.length}}">
    <view wx:for="{{tagGroups}}" wx:key="key" class="todo-group">
      <view class="todo-group__head">
        <text class="todo-group__title">{{item.label}}</text>
        <text class="todo-group__count">{{item.count}}</text>
        <view class="todo-group__rule"></view>
      </view>
      <view class="todo-list">
        <template wx:for="{{item.items}}" wx:for-item="todo" wx:key="id" is="todo-row" data="{{...todo}}" />
      </view>
    </view>
  </block>

  <view wx:elif="{{flatItems.length}}" class="todo-list todo-list--flat">
    <template wx:for="{{flatItems}}" wx:key="id" is="todo-row" data="{{...item}}" />
  </view>

  <view wx:else class="todo-state">
    <view class="todo-state__mark"><line-icon name="todo-status-pending" size="34" tone="green" /></view>
    <text class="todo-state__title">{{emptyTitle}}</text>
    <text class="todo-state__copy">{{emptyCopy}}</text>
    <view class="todo-state__action" bindtap="onCreate">记下第一件事</view>
  </view>

  <app-tab-bar id="app-tab-bar" active="{{isPlanMode ? 'todo' : ''}}" />
</view>
