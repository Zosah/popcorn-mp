/*
 * 待办：标签是一级分组，TODO 是唯一内容。
 * 页面保持左对齐和清晰时间信息，不混入旅行、账单或下厨入口。
 */
.todo-page {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  padding: 34rpx 32rpx calc(178rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 105% -2%, rgba(246, 218, 209, 0.44), transparent 27%),
    radial-gradient(circle at -8% 62%, rgba(223, 236, 227, 0.34), transparent 24%),
    linear-gradient(180deg, #fffaf5 0%, #f8f6f2 52%, #f3f0ea 100%);
  color: var(--c-text);
}

.todo-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 4rpx 4rpx 24rpx;
  gap: 20rpx;
}

.todo-head__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.todo-head__title {
  font-family: var(--font-serif);
  font-size: 58rpx;
  font-weight: 760;
  letter-spacing: -1.6rpx;
  line-height: 1.18;
}

.todo-head__sub {
  margin-top: 9rpx;
  color: var(--c-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.todo-create {
  display: flex;
  min-height: 58rpx;
  align-items: center;
  margin-top: 7rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow:
    0 12rpx 30rpx -26rpx rgba(77, 65, 56, 0.52),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  color: var(--c-text-2);
  flex: 0 0 auto;
  font-size: 22rpx;
  font-weight: 680;
  gap: 5rpx;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.todo-create--pressed,
.todo-tag--create:active,
.todo-item:active {
  opacity: 0.62;
}

.todo-overview {
  padding: 22rpx 24rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 95% 5%, rgba(243, 220, 214, 0.58), transparent 42%),
    rgba(255, 255, 255, 0.72);
  box-shadow:
    0 20rpx 44rpx -40rpx rgba(83, 65, 53, 0.45),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.todo-overview__top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
}

.todo-overview__copy {
  display: flex;
  flex-direction: column;
}

.todo-overview__eyebrow {
  color: var(--c-muted);
  font-size: 21rpx;
  font-weight: 620;
}

.todo-overview__number {
  margin-top: 3rpx;
  font-family: var(--font-serif);
  font-size: 45rpx;
  font-weight: 760;
  line-height: 1.15;
}

.todo-overview__number text {
  color: var(--c-text-2);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 23rpx;
  font-weight: 580;
}

.todo-overview__progress {
  padding-bottom: 7rpx;
  color: var(--c-muted);
  font-size: 21rpx;
}

.todo-overview__track {
  overflow: hidden;
  height: 6rpx;
  margin-top: 17rpx;
  border-radius: 999rpx;
  background: rgba(188, 178, 167, 0.2);
}

.todo-overview__fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #e5bdb3, #cf9b8c);
  transition: width 220ms ease;
}

.todo-tag-section {
  margin-top: 26rpx;
}

.todo-tags {
  width: calc(100% + 64rpx);
  margin: 0 -32rpx;
  white-space: nowrap;
}

.todo-tags__row {
  display: inline-flex;
  align-items: center;
  padding: 0 32rpx 3rpx;
  gap: 10rpx;
}

.todo-tag {
  display: inline-flex;
  min-height: 55rpx;
  align-items: center;
  padding: 0 19rpx;
  border: 1rpx solid rgba(218, 209, 199, 0.9);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.68);
  color: var(--c-text-2);
  flex: 0 0 auto;
  font-size: 22rpx;
  font-weight: 620;
  gap: 7rpx;
}

.todo-tag--active {
  border-color: rgba(111, 140, 120, 0.48);
  background: #dfece5;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
  color: #425e50;
}

.todo-tag__count {
  color: var(--c-faint);
  font-size: 18rpx;
  font-weight: 580;
}

.todo-tag--active .todo-tag__count {
  color: #698476;
}

.todo-tag--create {
  border-style: dashed;
  background: rgba(255, 255, 255, 0.42);
  color: var(--c-muted);
}

.todo-tag-section__hint {
  display: block;
  margin: 8rpx 4rpx 0;
  color: var(--c-faint);
  font-size: 18rpx;
  line-height: 1.4;
}

.todo-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 29rpx 3rpx 14rpx;
  gap: 18rpx;
}

.todo-status__summary {
  color: var(--c-muted);
  font-size: 22rpx;
}

.todo-status__switch {
  display: flex;
  padding: 4rpx;
  border: 1rpx solid rgba(223, 215, 205, 0.82);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.58);
}

.todo-status__item {
  min-width: 94rpx;
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  color: var(--c-faint);
  font-size: 20rpx;
  font-weight: 640;
  line-height: 1.2;
  text-align: center;
}

.todo-status__item--active {
  background: #fff;
  box-shadow: 0 7rpx 18rpx -15rpx rgba(76, 62, 51, 0.54);
  color: var(--c-text);
}

.todo-banner {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 15rpx 17rpx;
  border: 1rpx solid rgba(190, 112, 98, 0.16);
  border-radius: 21rpx;
  background: rgba(249, 232, 227, 0.8);
  gap: 10rpx;
}

.todo-banner__copy {
  color: var(--c-text-2);
  flex: 1;
  font-size: 20rpx;
}

.todo-banner__action {
  color: var(--c-primary-link);
  font-size: 20rpx;
  font-weight: 680;
}

.todo-group + .todo-group {
  margin-top: 28rpx;
}

.todo-group__head {
  display: flex;
  align-items: center;
  padding: 0 4rpx 11rpx;
  gap: 8rpx;
}

.todo-group__title {
  color: var(--c-text);
  font-size: 27rpx;
  font-weight: 740;
  line-height: 1.3;
}

.todo-group__count {
  display: flex;
  min-width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(226, 235, 228, 0.9);
  box-sizing: border-box;
  color: #647a6c;
  font-size: 17rpx;
  font-weight: 680;
}

.todo-group__rule {
  height: 1rpx;
  margin-left: 4rpx;
  background: rgba(215, 206, 195, 0.55);
  flex: 1;
}

.todo-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.todo-list--flat {
  margin-top: 2rpx;
}

.todo-item {
  overflow: hidden;
  border: 1rpx solid rgba(226, 218, 207, 0.82);
  border-radius: 25rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow:
    0 12rpx 30rpx -31rpx rgba(82, 66, 54, 0.42),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  transition: opacity 120ms ease;
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.todo-item--done {
  background: rgba(248, 247, 243, 0.66);
  opacity: 0.7;
}

.todo-item__main {
  display: flex;
  min-height: 104rpx;
  align-items: flex-start;
  padding: 20rpx 20rpx 19rpx;
  box-sizing: border-box;
}

.todo-check {
  display: flex;
  width: 38rpx;
  height: 38rpx;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
  border: 2rpx solid #c8c0b7;
  border-radius: 50%;
  flex: 0 0 auto;
  box-sizing: border-box;
}

.todo-check--done {
  border-color: #9cb6a5;
  background: #9cb6a5;
}

.todo-item__body {
  min-width: 0;
  margin-left: 16rpx;
  flex: 1;
}

.todo-item__title-row {
  display: flex;
  min-width: 0;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.todo-item__title {
  color: var(--c-text);
  flex: 1;
  font-size: 28rpx;
  font-weight: 680;
  line-height: 1.45;
}

.todo-item--done .todo-item__title {
  color: var(--c-faint);
  text-decoration: line-through;
}

.todo-item__tag {
  max-width: 190rpx;
  overflow: hidden;
  padding: 3rpx 9rpx;
  border-radius: 999rpx;
  background: rgba(235, 228, 236, 0.82);
  color: #856f8a;
  flex: 0 1 auto;
  font-size: 17rpx;
  font-weight: 620;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-item__note {
  display: block;
  overflow: hidden;
  margin-top: 5rpx;
  color: var(--c-text-2);
  font-size: 21rpx;
  line-height: 1.55;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-item__meta {
  display: flex;
  margin-top: 7rpx;
  align-items: center;
}

.todo-item__date {
  color: var(--c-faint);
  font-size: 19rpx;
  line-height: 1.4;
}

.todo-item__date--late {
  color: #b86e7d;
}

.todo-state {
  display: flex;
  padding: 72rpx 28rpx 60rpx;
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.todo-state__mark {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 25rpx;
  background: #e4eee7;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.94);
}

.todo-state__mark--error {
  background: #f5e5e2;
}

.todo-state__title {
  margin-top: 17rpx;
  color: var(--c-text);
  font-size: 30rpx;
  font-weight: 720;
}

.todo-state__copy {
  max-width: 470rpx;
  margin-top: 7rpx;
  color: var(--c-muted);
  font-size: 23rpx;
  line-height: 1.6;
}

.todo-state__action {
  margin-top: 19rpx;
  padding: 12rpx 22rpx;
  border: 1rpx solid rgba(151, 177, 161, 0.36);
  border-radius: 999rpx;
  background: #e3eee7;
  color: #536e5e;
  font-size: 22rpx;
  font-weight: 680;
}

@media (prefers-reduced-motion: reduce) {
  .todo-overview__fill,
  .todo-item {
    transition: none;
  }
}
