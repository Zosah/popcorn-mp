/*
 * 待办与小计划 · Figma Make 对齐
 * 深墨绿进度卡是第一视觉，任务行保持轻，旅行和账单作为计划的延伸。
 */
.todo-page {
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  padding: 34rpx 36rpx calc(176rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 102% 1%, rgba(249, 219, 207, 0.48), transparent 24%),
    linear-gradient(180deg, #fffaf5 0%, #f8f7f4 50%, #f5f2ec 100%);
}

.todo-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.todo-head__body {
  min-width: 0;
  flex: 1;
}

.todo-eyebrow,
.todo-progress__eyebrow,
.todo-list-heading__eyebrow {
  display: block;
  color: var(--c-muted);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.todo-head__title {
  margin-top: 3rpx;
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.35;
}

.todo-head__sub {
  margin-top: 5rpx;
  color: var(--c-muted);
  font-size: 23rpx;
  line-height: 1.55;
}

.todo-create {
  display: flex;
  height: 62rpx;
  align-items: center;
  margin-top: 3rpx;
  margin-left: 18rpx;
  padding: 0 21rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 12rpx 26rpx -24rpx rgba(92, 74, 61, 0.45);
  flex: 0 0 auto;
  gap: 6rpx;
}

.todo-create text {
  color: var(--c-text);
  font-size: 23rpx;
  font-weight: 600;
}

.todo-progress {
  display: flex;
  min-height: 176rpx;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 27rpx 30rpx;
  border-radius: 38rpx;
  background: #252b27;
  box-shadow: 0 24rpx 50rpx -38rpx rgba(37, 43, 39, 0.72);
  box-sizing: border-box;
}

.todo-progress__body {
  min-width: 0;
  padding-right: 16rpx;
  flex: 1;
}

.todo-progress__eyebrow {
  color: #c5beb6;
}

.todo-progress__title {
  margin-top: 8rpx;
  color: #fff;
  font-family: var(--font-serif);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.6rpx;
  line-height: 1.45;
}

.todo-progress__copy {
  margin-top: 6rpx;
  color: #aaa39c;
  font-size: 22rpx;
  line-height: 1.55;
}

.todo-progress__ring {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  flex: 0 0 auto;
}

.todo-progress__inner {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #252b27;
  color: #fff;
  font-family: var(--font-serif);
  font-size: 26rpx;
  font-weight: 700;
}

.todo-progress__inner text {
  margin-left: 1rpx;
  color: #c5beb6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 16rpx;
}

.todo-tabs {
  width: calc(100% + 72rpx);
  margin: 24rpx -36rpx 0;
  white-space: nowrap;
}

.todo-tabs__row {
  display: inline-flex;
  padding: 0 36rpx 4rpx;
  gap: 10rpx;
}

.todo-tab {
  display: flex;
  height: 56rpx;
  align-items: center;
  padding: 0 20rpx;
  border: 1rpx solid var(--c-line);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.76);
  color: var(--c-muted);
  font-size: 23rpx;
  white-space: nowrap;
}

.todo-tab + .todo-tab {
  margin-left: 0;
}

.todo-tab text + text {
  margin-left: 7rpx;
  color: var(--c-faint);
  font-size: 19rpx;
}

.todo-tab--active {
  border-color: #252b27;
  background: #252b27;
  box-shadow: 0 10rpx 22rpx -20rpx rgba(37, 43, 39, 0.62);
  color: #fff;
  font-weight: 600;
}

.todo-tab--active text + text {
  color: rgba(255, 255, 255, 0.68);
}

.todo-banner {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(198, 125, 109, 0.16);
  border-radius: 24rpx;
  background: var(--c-coral-soft);
}

.todo-banner__body {
  display: flex;
  min-width: 0;
  margin-left: 12rpx;
  flex: 1;
  flex-direction: column;
}

.todo-banner__body text:first-child {
  font-size: 24rpx;
  font-weight: 700;
}

.todo-banner__body text:last-child {
  margin-top: 2rpx;
  color: var(--c-text-2);
  font-size: 21rpx;
}

.todo-banner__action {
  margin-left: 12rpx;
  color: var(--c-primary-link);
  font-size: 23rpx;
  font-weight: 700;
}

.todo-meal {
  position: relative;
  overflow: hidden;
  margin-top: 20rpx;
  padding: 23rpx 24rpx;
  border-radius: 30rpx;
  background: #f0e5d6;
}

.todo-meal::after {
  position: absolute;
  top: -80rpx;
  right: -58rpx;
  width: 210rpx;
  height: 210rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  content: "";
}

.todo-meal__head,
.todo-meal__title,
.todo-meal__actions {
  position: relative;
  z-index: 1;
}

.todo-meal__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.todo-meal__label {
  display: flex;
  align-items: center;
  color: #8d6b2e;
  font-size: 22rpx;
  font-weight: 700;
}

.todo-meal__label text {
  margin-left: 7rpx;
}

.todo-meal__shuffle {
  padding: 7rpx 15rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.58);
  color: #8d6b2e;
  font-size: 21rpx;
}

.todo-meal__title {
  margin-top: 14rpx;
  font-family: var(--font-serif);
  font-size: 34rpx;
  font-weight: 700;
}

.todo-meal__actions {
  display: flex;
  margin-top: 17rpx;
}

.todo-meal__ghost,
.todo-meal__primary {
  display: flex;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 23rpx;
  font-weight: 600;
}

.todo-meal__ghost {
  width: 132rpx;
  background: rgba(255, 255, 255, 0.56);
  color: var(--c-text-2);
}

.todo-meal__primary {
  margin-left: 11rpx;
  background: var(--c-primary);
  color: #fff;
  flex: 1;
}

.todo-list-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 31rpx 2rpx 15rpx;
}

.todo-list-heading__title {
  display: block;
  margin-top: 2rpx;
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 31rpx;
  font-weight: 700;
}

.todo-list-heading > text {
  color: var(--c-muted);
  font-size: 21rpx;
}

.todo-list-heading--section {
  margin-top: 34rpx;
}

.todo-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.todo-item {
  overflow: hidden;
  border: 1rpx solid rgba(225, 218, 208, 0.92);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 28rpx -28rpx rgba(92, 74, 61, 0.42);
}

.todo-item--done {
  opacity: 0.64;
}

.todo-item__main {
  display: flex;
  min-height: 101rpx;
  align-items: center;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
}

.todo-check {
  display: flex;
  width: 39rpx;
  height: 39rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #c8c0b7;
  border-radius: 50%;
  flex: 0 0 auto;
  box-sizing: border-box;
}

.todo-check--done {
  border-color: var(--c-sage);
  background: var(--c-sage);
}

.todo-item__body {
  min-width: 0;
  margin-left: 17rpx;
  flex: 1;
}

.todo-item__title {
  color: var(--c-text);
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.45;
}

.todo-item--done .todo-item__title {
  color: var(--c-faint);
  text-decoration: line-through;
}

.todo-item__meta {
  margin-top: 5rpx;
  color: var(--c-muted);
  font-size: 21rpx;
  line-height: 1.45;
}

.todo-item__note {
  margin-top: 5rpx;
  color: var(--c-text-2);
  font-size: 21rpx;
  line-height: 1.55;
}

.todo-item__right {
  display: flex;
  align-items: flex-end;
  margin-left: 12rpx;
  flex: 0 0 auto;
}

.todo-item__date {
  color: var(--c-faint);
  font-size: 20rpx;
  white-space: nowrap;
}

.todo-item__date--late {
  color: var(--c-primary-link);
  font-weight: 600;
}

.todo-checklist {
  margin: 0 20rpx 20rpx 76rpx;
  padding: 14rpx 16rpx;
  border-radius: 20rpx;
  background: #f4f0e9;
}

.todo-checklist__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 8rpx;
  color: var(--c-muted);
  font-size: 19rpx;
}

.todo-checklist__row {
  display: flex;
  min-height: 42rpx;
  align-items: center;
  color: var(--c-text-2);
  font-size: 21rpx;
}

.todo-checklist__row--done .todo-checklist__text {
  color: var(--c-faint);
  text-decoration: line-through;
}

.todo-checklist__check {
  display: flex;
  width: 23rpx;
  height: 23rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--c-line-strong);
  border-radius: 50%;
  flex: 0 0 auto;
}

.todo-checklist__number {
  margin-left: 8rpx;
  color: var(--c-faint);
  font-size: 18rpx;
}

.todo-checklist__text {
  margin-left: 8rpx;
  flex: 1;
}

.todo-trip {
  padding: 21rpx;
  border: 1rpx solid #dfe5d8;
  border-radius: 29rpx;
  background: #edf0e8;
}

.todo-trip__top {
  display: flex;
  align-items: center;
}

.todo-trip__icon {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 23rpx;
  background: rgba(255, 255, 255, 0.8);
  flex: 0 0 auto;
}

.todo-trip__body {
  min-width: 0;
  margin-left: 16rpx;
  flex: 1;
}

.todo-trip__tag {
  color: var(--c-sage);
  font-size: 19rpx;
  font-weight: 600;
}

.todo-trip__title {
  overflow: hidden;
  margin-top: 3rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-trip__meta {
  overflow: hidden;
  margin-top: 3rpx;
  color: var(--c-muted);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-trip__arrow,
.todo-bill__arrow {
  margin-left: 10rpx;
  color: var(--c-faint);
  font-size: 35rpx;
  font-weight: 300;
  line-height: 1;
}

.todo-trip__progress {
  height: 9rpx;
  overflow: hidden;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: rgba(80, 75, 67, 0.1);
}

.todo-trip__progress view {
  height: 100%;
  border-radius: 999rpx;
  background: var(--c-sage);
}

.todo-trip__foot {
  margin-top: 8rpx;
  color: var(--c-muted);
  font-size: 20rpx;
}

.todo-bill {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 19rpx 21rpx;
  border: 1rpx solid var(--c-line);
  border-radius: 28rpx;
  background: #fff;
}

.todo-bill__icon {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 23rpx;
  background: var(--c-butter-soft);
  flex: 0 0 auto;
}

.todo-bill__body {
  display: flex;
  min-width: 0;
  margin-left: 16rpx;
  flex: 1;
  flex-direction: column;
}

.todo-bill__body > text:first-child,
.todo-bill__body > text:last-child {
  color: var(--c-muted);
  font-size: 20rpx;
}

.todo-bill__body > view {
  margin: 2rpx 0;
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 31rpx;
  font-weight: 700;
}

.todo-state {
  display: flex;
  min-height: 320rpx;
  align-items: center;
  justify-content: center;
  padding: 42rpx 30rpx;
  border: 1rpx dashed var(--c-line-strong);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.58);
  box-sizing: border-box;
  flex-direction: column;
  text-align: center;
}

.todo-state__icon {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
}

.todo-state__icon--green { background: var(--c-sage-soft); }
.todo-state__icon--red { background: var(--c-coral-soft); }

.todo-state__title {
  margin-top: 18rpx;
  font-family: var(--font-serif);
  font-size: 31rpx;
  font-weight: 700;
}

.todo-state__copy {
  max-width: 500rpx;
  margin-top: 7rpx;
  color: var(--c-muted);
  font-size: 23rpx;
  line-height: 1.7;
}

.todo-state__action {
  margin-top: 20rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: var(--c-primary);
  color: #fff;
  font-size: 23rpx;
  font-weight: 700;
}
