.profile-page {
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  padding: 22rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 100% 0, rgba(246, 218, 205, 0.52), transparent 25%),
    radial-gradient(circle at -10% 54%, rgba(220, 235, 227, 0.42), transparent 25%),
    linear-gradient(180deg, #fffaf5 0%, #f8f6f1 62%, #f3f0ea 100%);
  box-sizing: border-box;
}

.profile-heading {
  display: flex;
  min-height: 116rpx;
  align-items: flex-start;
  justify-content: space-between;
  padding: 4rpx 4rpx 18rpx;
  gap: 20rpx;
}

.profile-heading__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.profile-heading__title {
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 66rpx;
  font-weight: 760;
  letter-spacing: -2rpx;
  line-height: 1.1;
}

.profile-heading__subtitle {
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--c-muted);
  font-size: 23rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-toolbar__settings {
  display: flex;
  min-height: 64rpx;
  align-items: center;
  margin-top: 4rpx;
  padding: 0 21rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow:
    0 16rpx 34rpx -28rpx rgba(77, 65, 56, 0.44),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
  color: var(--c-text-2);
  flex: 0 0 auto;
  gap: 8rpx;
  font-size: 23rpx;
  font-weight: 680;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.profile-toolbar__settings--pressed,
.profile-identity--pressed,
.profile-feature--pressed,
.feature-directory-head__all--pressed {
  opacity: 0.56;
}

.profile-identity {
  position: relative;
  display: flex;
  overflow: hidden;
  min-height: 174rpx;
  align-items: center;
  padding: 26rpx 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 42rpx;
  background:
    radial-gradient(circle at 92% 12%, rgba(255, 255, 255, 0.82), transparent 30%),
    linear-gradient(118deg, #f2ddd2 0%, #f4e7dc 52%, #e5eee7 100%);
  box-shadow:
    0 26rpx 58rpx -44rpx rgba(79, 63, 50, 0.42),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
  box-sizing: border-box;
  transition: opacity 120ms ease;
}

.profile-identity::after {
  position: absolute;
  width: 270rpx;
  height: 270rpx;
  border: 24rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 50%;
  content: "";
  right: -105rpx;
  top: 45rpx;
  pointer-events: none;
}

.profile-avatar {
  position: relative;
  z-index: 1;
  display: flex;
  overflow: hidden;
  width: 118rpx;
  height: 118rpx;
  align-items: center;
  justify-content: center;
  border: 5rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 37rpx;
  background: #d88672;
  box-shadow:
    0 20rpx 38rpx -28rpx rgba(102, 68, 53, 0.55),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
  color: #fffaf4;
  flex: 0 0 auto;
  font-family: var(--font-serif);
  font-size: 45rpx;
  font-weight: 760;
}

.profile-avatar__image {
  display: block;
  width: 100%;
  height: 100%;
}

.profile-avatar--sage { background: #87aa99; }
.profile-avatar--lavender,
.profile-avatar--lilac { background: #b4a4b5; }
.profile-avatar--gold,
.profile-avatar--apricot { background: #d2ae69; }
.profile-avatar--mint { background: #8db3a3; }
.profile-avatar--peach { background: #d68d7d; }
.profile-avatar--sun { background: #d4b36d; }

.profile-identity__body {
  position: relative;
  z-index: 1;
  display: flex;
  min-width: 0;
  margin-left: 23rpx;
  flex: 1;
  flex-direction: column;
}

.profile-identity__eyebrow {
  overflow: hidden;
  color: #8b7e73;
  font-size: 21rpx;
  font-weight: 560;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-identity__name {
  overflow: hidden;
  margin-top: 3rpx;
  color: #2b2d2a;
  font-family: var(--font-serif);
  font-size: 44rpx;
  font-weight: 760;
  letter-spacing: -0.8rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-identity__account {
  overflow: hidden;
  margin-top: 7rpx;
  color: #756c64;
  font-size: 22rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-identity__arrow {
  position: relative;
  z-index: 1;
  display: flex;
  width: 52rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.66);
  color: #7b7168;
  flex: 0 0 auto;
  font-size: 31rpx;
  font-weight: 300;
  line-height: 1;
}

.feature-directory-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 38rpx 6rpx 17rpx;
  gap: 18rpx;
}

.feature-directory-head__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.feature-directory-head__title {
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 40rpx;
  font-weight: 760;
  line-height: 1.2;
}

.feature-directory-head__subtitle {
  overflow: hidden;
  margin-top: 4rpx;
  color: var(--c-faint);
  font-size: 21rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-directory-head__all {
  display: flex;
  min-height: 51rpx;
  align-items: center;
  padding: 0 17rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.63);
  color: var(--c-text-2);
  flex: 0 0 auto;
  gap: 4rpx;
  font-size: 21rpx;
  font-weight: 650;
}

.feature-directory-head__all-arrow {
  color: #afa69c;
  font-size: 25rpx;
  font-weight: 300;
}

.profile-category-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.profile-category {
  position: relative;
  display: flex;
  overflow: hidden;
  min-width: 0;
  min-height: 252rpx;
  padding: 21rpx 18rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  box-sizing: border-box;
  flex-direction: column;
}

.profile-category::after {
  position: absolute;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  content: "";
  right: -42rpx;
  top: -46rpx;
  pointer-events: none;
}

.profile-category--orange { background: linear-gradient(145deg, #f4ddd4, #f3e4dc); }
.profile-category--green { background: linear-gradient(145deg, #dcebe2, #e8f0e9); }
.profile-category--blue { background: linear-gradient(145deg, #dce8e7, #e6eeeb); }
.profile-category--pink { background: linear-gradient(145deg, #e9e1eb, #eee8ef); }

.profile-category__head {
  position: relative;
  z-index: 1;
  display: flex;
  min-height: 62rpx;
  flex-direction: column;
}

.profile-category__title {
  color: #32332f;
  font-family: var(--font-serif);
  font-size: 29rpx;
  font-weight: 760;
  line-height: 1.25;
}

.profile-category__description {
  overflow: hidden;
  margin-top: 2rpx;
  color: rgba(77, 73, 67, 0.66);
  font-size: 19rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-category__items {
  position: relative;
  z-index: 1;
  display: flex;
  margin-top: 13rpx;
  flex-direction: column;
  gap: 8rpx;
}

.profile-feature {
  display: flex;
  min-width: 0;
  min-height: 67rpx;
  align-items: center;
  padding: 8rpx 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.58);
  box-sizing: border-box;
  gap: 9rpx;
  transition: opacity 120ms ease;
}

.profile-feature__icon {
  display: flex;
  width: 46rpx;
  height: 46rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 15rpx;
  flex: 0 0 auto;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.profile-feature__icon--blue { background: #dce7e5; }
.profile-feature__icon--green { background: #dfeae2; }
.profile-feature__icon--gold { background: #efe3c7; }
.profile-feature__icon--pink { background: #e8e0ea; }
.profile-feature__icon--orange { background: #f0ded5; }

.profile-feature__title {
  overflow: hidden;
  color: #3b3a36;
  flex: 1;
  font-size: 25rpx;
  font-weight: 690;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-feature__arrow {
  color: rgba(69, 64, 59, 0.38);
  flex: 0 0 auto;
  font-size: 25rpx;
  font-weight: 300;
  line-height: 1;
}

@media (max-width: 350px) {
  .profile-category {
    padding-right: 14rpx;
    padding-left: 14rpx;
  }

  .profile-feature {
    padding-right: 8rpx;
    padding-left: 8rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .profile-identity,
  .profile-feature {
    transition: none;
  }
}
