.profile-page {
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  padding: 0 0 calc(188rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 101% 2%, rgba(248, 219, 207, 0.62), transparent 25%),
    radial-gradient(circle at -8% 38%, rgba(225, 238, 232, 0.56), transparent 24%),
    linear-gradient(180deg, #fffaf5 0%, #f8f6f1 52%, #f4f1eb 100%);
  box-sizing: border-box;
}

.profile-heading {
  display: flex;
  min-height: 156rpx;
  align-items: flex-start;
  justify-content: space-between;
  padding-right: 38rpx;
  padding-bottom: 28rpx;
  padding-left: 38rpx;
  box-sizing: border-box;
  gap: 24rpx;
}

.profile-heading__copy {
  display: flex;
  min-width: 0;
  padding-top: 2rpx;
  flex: 1;
  flex-direction: column;
}

.profile-heading__eyebrow {
  color: #9a8e82;
  font-size: 19rpx;
  font-weight: 650;
  letter-spacing: 4rpx;
  line-height: 1.35;
}

.profile-heading__title {
  margin-top: 7rpx;
  color: #252b27;
  font-family: var(--font-serif);
  font-size: 68rpx;
  font-weight: 760;
  letter-spacing: -2rpx;
  line-height: 1.08;
}

.profile-settings {
  display: flex;
  min-width: 126rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  margin-top: 0;
  padding: 0 19rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.76);
  box-shadow:
    0 18rpx 44rpx -34rpx rgba(83, 67, 54, 0.5),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
  color: #4c4a45;
  box-sizing: border-box;
  flex: 0 0 auto;
  gap: 9rpx;
  font-size: 23rpx;
  font-weight: 680;
  backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx);
  transition: opacity 120ms ease, transform 120ms ease;
}

.profile-settings--pressed {
  opacity: 0.66;
  transform: scale(0.97);
}

/* 空间身份卡 */
.profile-space-card {
  position: relative;
  overflow: hidden;
  margin: 0 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 48rpx;
  background:
    radial-gradient(circle at 97% 8%, rgba(255, 255, 255, 0.74), transparent 27%),
    linear-gradient(118deg, #f1d9d3 0%, #f4e7df 48%, #e4eee7 100%);
  box-shadow:
    0 30rpx 70rpx -54rpx rgba(91, 69, 54, 0.5),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
  box-sizing: border-box;
}

.profile-space-card__orb {
  position: absolute;
  width: 286rpx;
  height: 286rpx;
  border: 30rpx solid rgba(255, 255, 255, 0.26);
  border-radius: 50%;
  right: -86rpx;
  top: -94rpx;
  pointer-events: none;
}

.profile-space-card__orb::after {
  position: absolute;
  width: 164rpx;
  height: 164rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  content: "";
  left: 31rpx;
  top: 31rpx;
}

.profile-space-card__main {
  position: relative;
  z-index: 1;
  display: flex;
  min-height: 212rpx;
  align-items: center;
  padding: 33rpx 27rpx 31rpx 33rpx;
  box-sizing: border-box;
  transition: opacity 120ms ease;
}

.profile-space-card__main--pressed {
  opacity: 0.66;
}

.profile-space-mark {
  position: relative;
  display: flex;
  overflow: visible;
  width: 112rpx;
  height: 112rpx;
  align-items: center;
  justify-content: center;
  border: 5rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 35rpx;
  background: #c97c69;
  box-shadow:
    0 20rpx 40rpx -28rpx rgba(102, 61, 46, 0.58),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.62);
  color: #fffaf5;
  flex: 0 0 auto;
  font-family: var(--font-serif);
  font-size: 46rpx;
  font-weight: 760;
}

.profile-space-mark--sage { background: #759687; }
.profile-space-mark--lavender,
.profile-space-mark--lilac { background: #a794a9; }
.profile-space-mark--gold,
.profile-space-mark--apricot { background: #c39a54; }
.profile-space-mark--mint { background: #789f8e; }
.profile-space-mark--peach { background: #c97c69; }
.profile-space-mark--sun { background: #c4a05c; }

.profile-space-mark__image {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 29rpx;
}

.profile-space-mark__dot {
  position: absolute;
  width: 19rpx;
  height: 19rpx;
  border: 4rpx solid #f2e5df;
  border-radius: 50%;
  background: #719283;
  right: -7rpx;
  bottom: 3rpx;
}

.profile-space-card__copy {
  display: flex;
  overflow: hidden;
  min-width: 0;
  margin-left: 26rpx;
  flex: 1;
  flex-direction: column;
}

.profile-space-card__eyebrow {
  overflow: hidden;
  color: #7d7168;
  font-size: 21rpx;
  font-weight: 560;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-space-card__title {
  overflow: hidden;
  margin-top: 5rpx;
  color: #292c28;
  font-family: var(--font-serif);
  font-size: 45rpx;
  font-weight: 760;
  letter-spacing: -1rpx;
  line-height: 1.18;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-space-card__meta {
  overflow: hidden;
  margin-top: 12rpx;
  color: #665f58;
  font-size: 22rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-space-card__arrow {display: flex; width: 66rpx; height: 66rpx; align-items: center; justify-content: center; margin-left: 16rpx; color: #7c736b; flex: 0 0 auto; font-size: 38rpx; font-weight: 300; line-height: 1;}

.profile-space-stats {
  position: relative;
  z-index: 1;
  display: grid;
  min-height: 106rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr)) 1.18fr;
  align-items: stretch;
  margin: 0 17rpx 17rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 35rpx;
  background: rgba(255, 255, 255, 0.62);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.profile-space-stat {
  position: relative;
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
  padding: 16rpx 4rpx;
  box-sizing: border-box;
  flex-direction: column;
}

.profile-space-stat::after {
  position: absolute;
  width: 1rpx;
  height: 45rpx;
  background: rgba(85, 75, 66, 0.14);
  content: "";
  right: 0;
  top: 50%;
  transform: translateY(-50%);
}

.profile-space-stat__value {
  color: #2c2e2a;
  font-size: 32rpx;
  font-weight: 760;
  line-height: 1.15;
}

.profile-space-stat__label {
  overflow: hidden;
  max-width: 100%;
  margin-top: 5rpx;
  color: #837a71;
  font-size: 19rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-space-invite {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 8rpx;
  color: #423f3a;
  box-sizing: border-box;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  transition: opacity 120ms ease;
}

.profile-space-invite--pressed {
  opacity: 0.55;
}

/* 分区标题 */
.profile-section {
  padding: 45rpx 38rpx 0;
}

.profile-section--plans {
  padding-top: 43rpx;
}

.profile-section__head {
  display: flex;
  min-height: 70rpx;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20rpx;
  gap: 18rpx;
}

.profile-section__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.profile-section__eyebrow {
  color: #c07868;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  line-height: 1.3;
}

.profile-section__title {
  margin-top: 3rpx;
  color: #252b27;
  font-family: var(--font-serif);
  font-size: 44rpx;
  font-weight: 760;
  letter-spacing: -1rpx;
  line-height: 1.16;
}

/* 一起生活：2×2 功能卡 */
.profile-feature-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.profile-feature-card {
  position: relative;
  display: flex;
  overflow: hidden;
  min-width: 0;
  min-height: 158rpx;
  align-items: center;
  padding: 22rpx 17rpx 22rpx 21rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 34rpx;
  box-sizing: border-box;
  gap: 13rpx;
  transition: opacity 120ms ease, transform 120ms ease;
}

.profile-feature-card::after {
  position: absolute;
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  content: "";
  right: -37rpx;
  top: -37rpx;
  pointer-events: none;
}

.profile-feature-card--coral { background: linear-gradient(145deg, #f4dedb, #f6e7e2); }
.profile-feature-card--gold { background: linear-gradient(145deg, #f4ead3, #f7efd9); }
.profile-feature-card--sage { background: linear-gradient(145deg, #dfece6, #e9f1ec); }
.profile-feature-card--lilac { background: linear-gradient(145deg, #e9e2ed, #f0eaf2); }
.profile-feature-card--blue { background: linear-gradient(145deg, #dfecee, #e9f1f2); }

.profile-feature-card--pressed {
  opacity: 0.66;
  transform: scale(0.985);
}

.profile-feature-card__icon {display: flex; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; flex: 0 0 auto;}

.profile-feature-card__copy {
  display: flex;
  overflow: hidden;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.profile-feature-card__title {
  overflow: hidden;
  color: #34342f;
  font-size: 26rpx;
  font-weight: 740;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-feature-card__meta {
  overflow: hidden;
  margin-top: 4rpx;
  color: rgba(78, 73, 67, 0.62);
  font-size: 19rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-feature-card__arrow {
  position: relative;
  z-index: 1;
  color: rgba(78, 71, 64, 0.4);
  flex: 0 0 auto;
  font-size: 27rpx;
  font-weight: 300;
  line-height: 1;
}

/* 让日子有期待：与 Daily 同一套卡片语言，避免横向滑动。 */
.profile-plan-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.profile-plan-card {
  position: relative;
  display: flex;
  overflow: hidden;
  min-width: 0;
  min-height: 226rpx;
  padding: 23rpx 23rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 37rpx;
  box-sizing: border-box;
  flex-direction: column;
  transition: opacity 120ms ease, transform 120ms ease;
}

.profile-plan-card::after {
  position: absolute;
  width: 158rpx;
  height: 158rpx;
  border: 20rpx solid rgba(255, 255, 255, 0.17);
  border-radius: 50%;
  content: "";
  right: -70rpx;
  top: -70rpx;
  pointer-events: none;
}

.profile-plan-card--coral { background: linear-gradient(145deg, #f2ddd8, #f6e8e2); }
.profile-plan-card--gold { background: linear-gradient(145deg, #f3e7ca, #f7efd9); }
.profile-plan-card--sage { background: linear-gradient(145deg, #dfebe5, #e9f1ec); }
.profile-plan-card--lilac { background: linear-gradient(145deg, #e9e2ed, #f0eaf2); }
.profile-plan-card--blue { background: linear-gradient(145deg, #dce9ec, #e8f0f2); }

.profile-plan-card--pressed {
  opacity: 0.66;
  transform: scale(0.985);
}

.profile-plan-card__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.profile-plan-card__icon {display: flex; width: 72rpx; height: 72rpx; align-items: center; justify-content: center;}

.profile-plan-card__arrow {display: flex; width: 48rpx; height: 48rpx; align-items: center; justify-content: center; color: rgba(71, 65, 59, 0.46); font-size: 29rpx; font-weight: 300; line-height: 1;}

.profile-plan-card__title {
  overflow: hidden;
  margin-top: auto;
  padding-top: 24rpx;
  color: #34342f;
  font-size: 29rpx;
  font-weight: 740;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-plan-card__meta {
  overflow: hidden;
  margin-top: 5rpx;
  color: rgba(77, 72, 66, 0.64);
  font-size: 20rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 功能总入口：文本型延伸，不再重复一张功能卡。 */
.profile-directory {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  margin: 35rpx 38rpx 0;
  padding: 12rpx 20rpx;
  background: transparent;
  box-sizing: border-box;
  gap: 8rpx;
  transition: opacity 120ms ease;
}

.profile-directory::before,
.profile-directory::after {
  width: 46rpx;
  height: 1rpx;
  background: rgba(127, 118, 108, 0.24);
  content: "";
}

.profile-directory--pressed {
  opacity: 0.5;
}

.profile-directory__label {
  color: #766f67;
  font-size: 22rpx;
  font-weight: 630;
  letter-spacing: 1.5rpx;
  line-height: 1.4;
}

.profile-directory__arrow {
  margin-top: -2rpx;
  color: #a69d93;
  font-size: 28rpx;
  font-weight: 300;
  line-height: 1;
}

@media (max-width: 350px) {
  .profile-heading,
  .profile-section {
    padding-right: 30rpx;
    padding-left: 30rpx;
  }

  .profile-space-card,
  .profile-directory {
    margin-right: 28rpx;
    margin-left: 28rpx;
  }

  .profile-feature-card {
    padding-right: 13rpx;
    padding-left: 16rpx;
  }

  .profile-feature-card__icon {width: 58rpx; height: 58rpx;}
}

@media (prefers-reduced-motion: reduce) {
  .profile-settings,
  .profile-space-card__main,
  .profile-feature-card,
  .profile-plan-card,
  .profile-directory {
    transition: none;
  }
}
