.profile-head {
  padding: 8rpx 0 34rpx;
}

.profile-head__title {
  color: var(--c-text, #22242e);
  font-size: 48rpx;
  font-weight: 500;
  letter-spacing: -2rpx;
  line-height: 1.3;
}

.profile-head__copy {
  max-width: 610rpx;
  margin-top: 12rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 24rpx;
  line-height: 1.65;
}

.profile-page .card {
  border: 0;
  border-radius: 0;
  background: transparent;
}

.identity {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.identity__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-radius: 50%;
  background: transparent;
  color: var(--c-accent, #5b6ee0);
  flex-shrink: 0;
  font-family: "Songti SC", "STSong", serif;
  font-size: 32rpx;
  font-weight: 400;
}

.identity__body {
  min-width: 0;
  margin-left: 22rpx;
  flex: 1;
}

.identity__name {
  color: var(--c-text, #22242e);
  font-size: 30rpx;
  font-weight: 500;
}

.identity__meta {
  margin-top: 4rpx;
  color: var(--c-muted, #9497a6);
  font-size: 22rpx;
}

.rows {
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 0;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.row:last-child {
  border-bottom: 0;
}

.row__icon {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  margin-right: 20rpx;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.row__body {
  min-width: 0;
  flex: 1;
  padding: 22rpx 0;
}

.row__title {
  color: var(--c-text, #22242e);
  font-size: 27rpx;
  font-weight: 500;
}

.row__meta {
  margin-top: 5rpx;
  color: var(--c-muted, #9497a6);
  font-size: 22rpx;
  line-height: 1.5;
}

.row__tag {
  margin-right: 16rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.row__chevron {
  width: 10rpx;
  height: 10rpx;
  flex-shrink: 0;
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-right: 1rpx solid var(--c-line-strong, #d6d5e0);
  transform: rotate(45deg);
}

.profile-garden {
  display: flex;
  align-items: stretch;
  gap: 26rpx;
  margin-top: 44rpx;
  padding: 22rpx 0 24rpx;
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.profile-garden__copy {
  display: flex;
  min-width: 0;
  padding: 6rpx 0;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
}

.profile-garden__copy text:first-child {
  color: var(--c-text, #22242e);
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  line-height: 1.55;
}

.profile-garden__copy text:last-child {
  color: var(--c-muted, #9497a6);
  font-size: 18rpx;
  letter-spacing: 1rpx;
  line-height: 1.5;
}

.profile-garden__image {
  display: block;
  width: 146rpx;
  height: 196rpx;
  background: var(--c-primary-soft, #eaedfc);
  flex-shrink: 0;
}

.profile-foot {
  display: flex;
  align-items: center;
  margin-top: 44rpx;
  color: #a8abba;
  flex-direction: column;
  font-family: "Songti SC", "STSong", serif;
  font-size: 20rpx;
  line-height: 1.8;
}
