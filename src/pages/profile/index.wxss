/*
 * 我的 · 身份、共同空间与少量长期设置。
 * 不展示内部角色、同步状态和调试能力，避免个人页变成系统设置面板。
 */
.profile-page {
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  padding: 38rpx 34rpx calc(176rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 104% 0%, rgba(248, 218, 205, 0.38), transparent 24%),
    linear-gradient(180deg, #fffaf5 0%, #f8f7f4 50%, #f4f1eb 100%);
  box-sizing: border-box;
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 12rpx 4rpx 46rpx;
  border-bottom: 1rpx solid rgba(215, 207, 197, 0.58);
  transition: opacity 120ms ease;
}

.profile-card--pressed {
  opacity: 0.72;
}

.profile-avatar {
  display: flex;
  overflow: hidden;
  width: 124rpx;
  height: 124rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 50%;
  background: #ead7cc;
  box-shadow: 0 17rpx 34rpx -29rpx rgba(92, 74, 61, 0.52);
  color: #8b5f52;
  flex: 0 0 auto;
  font-family: var(--font-serif);
  font-size: 43rpx;
  font-weight: 700;
}

.profile-avatar__image {
  display: block;
  width: 100%;
  height: 100%;
}

.profile-avatar--sage { background: #dce7df; color: #527064; }
.profile-avatar--lavender,
.profile-avatar--lilac { background: #e8e3eb; color: #6f6177; }
.profile-avatar--gold,
.profile-avatar--apricot { background: #efe0c8; color: #8c6d36; }

.profile-card__body {
  min-width: 0;
  margin-left: 22rpx;
  flex: 1;
}

.profile-card__name {
  overflow: hidden;
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -0.6rpx;
  line-height: 1.32;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-card__meta {
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--c-muted);
  font-size: 24rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-card__edit {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  border: 1rpx solid rgba(213, 205, 195, 0.9);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  flex: 0 0 auto;
}

.profile-card__login {
  display: flex;
  min-height: 62rpx;
  align-items: center;
  margin-left: 14rpx;
  padding: 0 19rpx 0 23rpx;
  border-radius: 999rpx;
  background: var(--c-primary);
  color: #fff;
  flex: 0 0 auto;
  font-size: 23rpx;
  font-weight: 650;
  gap: 5rpx;
}

.profile-card__login-arrow {
  color: rgba(255, 255, 255, 0.66);
  font-size: 32rpx;
  font-weight: 300;
}

.space-card {
  position: relative;
  display: flex;
  overflow: hidden;
  align-items: center;
  margin-top: 30rpx;
  padding: 28rpx 24rpx;
  border-radius: 34rpx;
  background: #252b27;
  box-shadow: 0 26rpx 48rpx -40rpx rgba(37, 43, 39, 0.88);
  box-sizing: border-box;
  transition: opacity 120ms ease;
}

.space-card::after {
  position: absolute;
  top: -104rpx;
  right: -58rpx;
  width: 246rpx;
  height: 246rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 50%;
  content: "";
  pointer-events: none;
}

.space-card--pressed {
  opacity: 0.84;
}

.space-card__mark {
  position: relative;
  z-index: 1;
  display: flex;
  width: 84rpx;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.09);
  flex: 0 0 auto;
}

.space-card__body {
  position: relative;
  z-index: 1;
  min-width: 0;
  margin-left: 20rpx;
  flex: 1;
}

.space-card__label {
  display: block;
  color: #999c96;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1.7rpx;
  line-height: 1.4;
}

.space-card__title {
  overflow: hidden;
  margin-top: 4rpx;
  color: #fff;
  font-family: var(--font-serif);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.space-card__meta {
  overflow: hidden;
  margin-top: 5rpx;
  color: #bbbdb7;
  font-size: 22rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.space-card__arrow {
  position: relative;
  z-index: 1;
  margin-left: 14rpx;
  color: #8f938c;
  font-size: 40rpx;
  font-weight: 300;
}

.settings-block {
  margin-top: 46rpx;
}

.settings-block__label {
  padding: 0 7rpx;
  color: var(--c-faint);
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 2.4rpx;
  line-height: 1.45;
}

.settings-list {
  overflow: hidden;
  margin-top: 14rpx;
  border: 1rpx solid rgba(225, 218, 208, 0.9);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.82);
}

.settings-row {
  display: flex;
  min-height: 108rpx;
  align-items: center;
  margin: 0 23rpx;
  border-bottom: 1rpx solid var(--c-line);
  box-sizing: border-box;
  transition: opacity 120ms ease;
}

.settings-row:last-child {
  border-bottom: 0;
}

.settings-row--pressed {
  opacity: 0.56;
}

.settings-row__title {
  margin-left: 18rpx;
  color: var(--c-text);
  flex: 1;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.45;
}

.settings-row__arrow {
  color: var(--c-faint);
  font-size: 38rpx;
  font-weight: 300;
}
