/*
 * 我的：身份、共同空间与完整功能目录。
 * 设置集中在右上角，正文只保留用户真正需要浏览和进入的内容。
 */
.profile-page {
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  padding: 24rpx 34rpx calc(176rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 103% 0%, rgba(242, 217, 204, 0.42), transparent 24%),
    linear-gradient(180deg, #fffaf5 0%, #f7f5f1 54%, #f3f0ea 100%);
  box-sizing: border-box;
}

.profile-toolbar {
  display: flex;
  min-height: 64rpx;
  align-items: center;
  justify-content: space-between;
}

.profile-toolbar__brand {
  color: var(--c-faint);
  font-family: var(--font-serif);
  font-size: 25rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.profile-toolbar__settings {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(219, 211, 201, 0.9);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
}

.profile-toolbar__settings--pressed {
  opacity: 0.56;
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 25rpx 4rpx 35rpx;
  border-bottom: 1rpx solid rgba(215, 207, 197, 0.54);
  transition: opacity 120ms ease;
}

.profile-card--pressed {
  opacity: 0.72;
}

.profile-avatar {
  display: flex;
  overflow: hidden;
  width: 120rpx;
  height: 120rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 50%;
  background: #ead7cc;
  box-shadow: 0 17rpx 34rpx -29rpx rgba(92, 74, 61, 0.52);
  color: #8b5f52;
  flex: 0 0 auto;
  font-family: var(--font-serif);
  font-size: 42rpx;
  font-weight: 700;
}

.profile-avatar__image {
  display: block;
  width: 100%;
  height: 100%;
}

.profile-avatar--sage { background: #dce7df; color: #527064; }
.profile-avatar--lavender,
.profile-avatar--lilac { background: #e8e3eb; color: #6f6177; }
.profile-avatar--gold,
.profile-avatar--apricot { background: #efe0c8; color: #8c6d36; }

.profile-card__body {
  min-width: 0;
  margin-left: 22rpx;
  flex: 1;
}

.profile-card__name {
  overflow: hidden;
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 44rpx;
  font-weight: 720;
  letter-spacing: -0.6rpx;
  line-height: 1.32;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-card__meta {
  overflow: hidden;
  margin-top: 7rpx;
  color: var(--c-muted);
  font-size: 24rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-card__edit {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  border: 1rpx solid rgba(213, 205, 195, 0.9);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  flex: 0 0 auto;
}

.profile-card__login {
  display: flex;
  min-height: 62rpx;
  align-items: center;
  margin-left: 14rpx;
  padding: 0 19rpx 0 23rpx;
  border-radius: 999rpx;
  background: var(--c-primary);
  color: #fff;
  flex: 0 0 auto;
  font-size: 23rpx;
  font-weight: 650;
  gap: 5rpx;
}

.profile-card__login-arrow {
  color: rgba(255, 255, 255, 0.66);
  font-size: 32rpx;
  font-weight: 300;
}

.space-card {
  position: relative;
  display: flex;
  overflow: hidden;
  align-items: center;
  margin-top: 24rpx;
  padding: 27rpx 24rpx;
  border-radius: 34rpx;
  background: #252b27;
  box-shadow: 0 26rpx 48rpx -40rpx rgba(37, 43, 39, 0.88);
  box-sizing: border-box;
  transition: opacity 120ms ease;
}

.space-card::after {
  position: absolute;
  top: -104rpx;
  right: -58rpx;
  width: 246rpx;
  height: 246rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 50%;
  content: "";
  pointer-events: none;
}

.space-card--pressed {
  opacity: 0.84;
}

.space-card__mark {
  position: relative;
  z-index: 1;
  display: flex;
  width: 82rpx;
  height: 82rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.09);
  flex: 0 0 auto;
}

.space-card__body {
  position: relative;
  z-index: 1;
  min-width: 0;
  margin-left: 20rpx;
  flex: 1;
}

.space-card__label {
  display: block;
  color: #999c96;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1.5rpx;
  line-height: 1.4;
}

.space-card__title {
  overflow: hidden;
  margin-top: 3rpx;
  color: #fff;
  font-family: var(--font-serif);
  font-size: 35rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.space-card__meta {
  overflow: hidden;
  margin-top: 4rpx;
  color: #bbbdb7;
  font-size: 22rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.space-card__arrow {
  position: relative;
  z-index: 1;
  margin-left: 14rpx;
  color: #8f938c;
  font-size: 40rpx;
  font-weight: 300;
}

.feature-directory-head {
  display: flex;
  align-items: baseline;
  margin-top: 48rpx;
  padding: 0 6rpx;
  gap: 15rpx;
}

.feature-directory-head__title {
  color: var(--c-text);
  font-family: var(--font-serif);
  font-size: 42rpx;
  font-weight: 750;
  line-height: 1.3;
}

.feature-directory-head__copy {
  color: var(--c-muted);
  font-size: 22rpx;
  line-height: 1.45;
}

.profile-feature-group {
  margin-top: 30rpx;
}

.profile-feature-group__head {
  display: flex;
  align-items: baseline;
  padding: 0 7rpx 11rpx;
  gap: 13rpx;
}

.profile-feature-group__title {
  color: var(--c-text);
  font-size: 31rpx;
  font-weight: 720;
  line-height: 1.35;
}

.profile-feature-group__description {
  color: var(--c-faint);
  font-size: 21rpx;
  line-height: 1.4;
}

.profile-feature-group__list {
  overflow: hidden;
  padding: 0 23rpx;
  border: 1rpx solid rgba(225, 218, 208, 0.84);
  border-radius: 31rpx;
  background: rgba(255, 255, 255, 0.8);
  box-shadow:
    0 18rpx 44rpx -40rpx rgba(92, 74, 61, 0.34),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
}

.profile-feature-row {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--c-line);
  gap: 17rpx;
  transition: opacity 120ms ease;
}

.profile-feature-row:last-child {
  border-bottom: 0;
}

.profile-feature-row--pressed {
  opacity: 0.56;
}

.profile-feature-row__icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 18rpx;
  flex: 0 0 auto;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
}

.profile-feature-row__icon--blue { background: #e5ece9; }
.profile-feature-row__icon--green { background: #e4eee7; }
.profile-feature-row__icon--gold { background: #f2e8ce; }
.profile-feature-row__icon--pink { background: #eee7ec; }
.profile-feature-row__icon--orange { background: #f3e5df; }

.profile-feature-row__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 3rpx;
}

.profile-feature-row__title {
  overflow: hidden;
  color: var(--c-text);
  font-size: 29rpx;
  font-weight: 680;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-feature-row__description {
  overflow: hidden;
  color: var(--c-muted);
  font-size: 22rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-feature-row__arrow {
  color: #beb7ae;
  flex: 0 0 auto;
  font-size: 38rpx;
  font-weight: 300;
}
