<view class="tab-page profile-page">
  <view class="profile-top">
    <view class="profile-top__title">我的</view>
    <view class="profile-top__more" bindtap="onOpenAuth">•••</view>
  </view>

  <view class="profile-identity {{isLoggedIn ? '' : 'profile-identity--guest'}}" bindtap="onOpenAuth">
    <view class="profile-identity__avatar profile-identity__avatar--{{avatarTone}}">{{avatarText}}</view>
    <view class="profile-identity__body">
      <view class="profile-identity__name">{{displayName}}</view>
      <view class="profile-identity__meta">{{identityMeta}}</view>
      <view class="profile-identity__tags">
        <text>{{identityBadge}}</text>
        <text>{{spaceName}}</text>
      </view>
    </view>
    <view class="profile-identity__edit">{{isLoggedIn ? '编辑' : '登录'}}</view>
  </view>

  <view class="profile-progress" bindtap="onOpenTodo">
    <view class="profile-progress__ring" style="background: conic-gradient(#6f9f7d {{todoProgress}}%, #ebe5da 0);">
      <view class="profile-progress__inner">{{todoProgress}}%</view>
    </view>
    <view class="profile-progress__body">
      <view class="profile-progress__title">我的待办进度</view>
      <view class="profile-progress__copy">{{todoLoading ? '正在同步最新进度' : todoCompletedCount + ' / ' + todoTotalCount + ' 项已完成'}}</view>
      <view class="profile-progress__summary">{{todoSummary}}</view>
    </view>
    <view class="profile-progress__arrow">›</view>
  </view>

  <view class="profile-section-head">
    <text>共同空间</text>
    <text bindtap="onOpenSpace">管理</text>
  </view>
  <view class="profile-space" bindtap="onOpenSpace">
    <view class="profile-space__icon"><line-icon name="house" size="31" tone="blue" /></view>
    <view class="profile-space__body">
      <view class="profile-space__name">{{spaceName}}</view>
      <view class="profile-space__meta">{{spaceMembersCopy}}</view>
    </view>
    <view class="profile-space__arrow">›</view>
  </view>

  <view class="profile-section-head"><text>设置</text><text>按自己的节奏</text></view>
  <view class="profile-settings">
    <view class="profile-row" bindtap="onOpenAuth">
      <view class="profile-row__icon profile-row__icon--blue"><line-icon name="user-round" size="26" tone="blue" /></view>
      <view class="profile-row__body"><text>账号与登录</text><text>{{accountMeta}}</text></view>
      <view class="profile-row__tag">{{accountTag}}</view>
      <view class="profile-row__arrow">›</view>
    </view>
    <view class="profile-row" bindtap="onOpenReminders">
      <view class="profile-row__icon profile-row__icon--pink"><line-icon name="bell" size="26" tone="pink" /></view>
      <view class="profile-row__body"><text>提醒设置</text><text>临期、宠物、每周回顾</text></view>
      <view class="profile-row__arrow">›</view>
    </view>
    <view class="profile-row" bindtap="onOpenInvite">
      <view class="profile-row__icon profile-row__icon--gold"><line-icon name="users" size="26" tone="gold" /></view>
      <view class="profile-row__body"><text>成员与邀请</text><text>{{spaceName}} · 邀请家人一起生活</text></view>
      <view class="profile-row__arrow">›</view>
    </view>
    <view class="profile-row" bindtap="onOpenSpace">
      <view class="profile-row__icon profile-row__icon--grey"><line-icon name="lock" size="25" tone="muted" /></view>
      <view class="profile-row__body"><text>隐私与可见范围</text><text>默认只对空间成员可见</text></view>
      <view class="profile-row__arrow">›</view>
    </view>
  </view>

  <view class="profile-demo">
    <view class="profile-demo__head"><text class="profile-demo__dot"></text><text>Demo · 数据存本机</text></view>
    <view class="profile-demo__copy">库存、待办和记录已支持服务同步；菜单、宠物和提醒目前仍是本机示例。</view>
    <view wx:if="{{showResetDemo}}" class="profile-demo__actions">
      <view class="profile-demo__ghost" bindtap="onOpenInvite">邀请体验</view>
      <view class="profile-demo__danger" bindtap="onResetDemo">重置 Demo 数据</view>
    </view>
  </view>
</view>
