<view class="tab-page profile-page">
  <view class="profile-head">
    <view class="profile-head__title">这个家，有我们在</view>
    <view class="profile-head__copy">个人信息归个人，家里的事留在共同空间里。</view>
    <view class="sync-row"><sync-badge state="local" text="Demo 身份 · 当前未连接服务端" /></view>
  </view>

  <view class="identity card">
    <view class="identity__avatar">满</view>
    <view class="identity__body">
      <view class="identity__name">时刻在体验官</view>
      <view class="identity__meta">空间 Owner · Demo 身份</view>
    </view>
  </view>

  <view class="section-head">
    <text class="section-head__title">我的空间</text>
    <text class="section-head__action">1 个</text>
  </view>
  <view class="rows card">
    <view class="row" bindtap="onOpenSpace">
      <view class="row__icon"><line-icon name="house" size="32" tone="muted" /></view>
      <view class="row__body">
        <view class="row__title">{{spaceName}}</view>
        <view class="row__meta">2 位成员 · 家庭库存 · 共同记录</view>
      </view>
      <view class="row__chevron"></view>
    </view>
  </view>

  <view class="section-head">
    <text class="section-head__title">我的安排</text>
    <text class="section-head__action">{{todoPendingCount ? todoPendingCount + ' 件待做' : '已清空'}}</text>
  </view>
  <view class="rows card">
    <view class="row" bindtap="onOpenTodo">
      <view class="row__icon"><line-icon name="list-todo" size="32" tone="muted" /></view>
      <view class="row__body">
        <view class="row__title">待办与小计划</view>
        <view class="row__meta">{{todoSummary}}</view>
      </view>
      <view class="row__chevron"></view>
    </view>
  </view>

  <view class="section-head">
    <text class="section-head__title">设置</text>
  </view>
  <view class="rows card">
    <view class="row" bindtap="onOpenReminders">
      <view class="row__icon"><line-icon name="bell" size="32" tone="muted" /></view>
      <view class="row__body">
        <view class="row__title">到期提醒</view>
        <view class="row__meta">有物品三天内到期时提醒</view>
      </view>
      <view class="row__tag">即将支持</view>
      <view class="row__chevron"></view>
    </view>
    <view class="row" bindtap="onOpenInvite">
      <view class="row__icon"><line-icon name="ticket" size="32" tone="muted" /></view>
      <view class="row__body">
        <view class="row__title">使用邀请码加入</view>
        <view class="row__meta">体验邀请校验与加入空间</view>
      </view>
      <view class="row__chevron"></view>
    </view>
    <view class="row" bindtap="onResetDemo">
      <view class="row__icon"><line-icon name="rotate-ccw" size="32" tone="muted" /></view>
      <view class="row__body">
        <view class="row__title">恢复 Demo 初始数据</view>
        <view class="row__meta">清空本机修改，重新载入全部示例</view>
      </view>
      <view class="row__chevron"></view>
    </view>
  </view>

  <view class="profile-garden">
    <view class="profile-garden__copy">
      <text>让家里的事，慢慢长出来。</text>
      <text>公版植物版画 · 示例</text>
    </view>
    <image class="profile-garden__image" src="../../images/demo-botanical.jpg" mode="aspectFill" />
  </view>

  <view class="profile-foot">
    <text>时刻在</text>
    <text>{{version}}</text>
  </view>
</view>
