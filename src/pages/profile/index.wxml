<view class="tab-page profile-page">
  <page-loading show="{{initialLoading}}" title="正在准备你的空间" copy="登录状态和共同生活数据马上就好。" />
  <auth-preview-gate />

  <view class="profile-toolbar">
    <view
      class="profile-toolbar__settings"
      hover-class="profile-toolbar__settings--pressed"
      aria-role="button"
      aria-label="打开设置"
      bindtap="onOpenSettings"
    >
      <line-icon name="settings" size="23" tone="ink" />
      <text>设置</text>
    </view>
  </view>

  <view class="profile-identity" hover-class="profile-identity--pressed" bindtap="onOpenAuth">
    <view class="profile-avatar profile-avatar--{{avatarTone}}">
      <image wx:if="{{avatarUrl}}" class="profile-avatar__image" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
      <text wx:else>{{avatarText}}</text>
    </view>

    <view class="profile-identity__body">
      <text class="profile-identity__name">{{displayName}}</text>
      <text class="profile-identity__account">{{accountLabel}}</text>
    </view>

    <view class="profile-identity__arrow">›</view>
  </view>

  <view class="feature-directory-head">
    <text class="feature-directory-head__title">功能</text>
  </view>

  <view class="profile-directory">
    <view
      wx:for="{{featureGroups}}"
      wx:key="key"
      class="profile-category profile-category--{{item.category.tone}}"
    >
      <view class="profile-category__head">
        <text class="profile-category__title">{{item.category.title}}</text>
        <text class="profile-category__description">{{item.category.description}}</text>
      </view>

      <view class="profile-category__items">
        <view
          wx:for="{{item.items}}"
          wx:for-item="feature"
          wx:key="id"
          class="profile-feature"
          hover-class="profile-feature--pressed"
          data-id="{{feature.id}}"
          bindtap="onOpenFeature"
        >
          <view class="profile-feature__icon profile-feature__icon--{{feature.tone}}">
            <line-icon name="{{feature.icon}}" size="27" tone="{{feature.tone}}" />
          </view>
          <text class="profile-feature__title">{{feature.label}}</text>
          <text class="profile-feature__arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <app-tab-bar active="profile" />
</view>
