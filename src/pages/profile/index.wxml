<view class="tab-page profile-page">
  <page-loading show="{{initialLoading}}" title="正在准备你的空间" copy="登录状态和共同生活数据马上就好。" />
  <auth-preview-gate />

  <view class="profile-toolbar">
    <text class="profile-toolbar__brand">时刻见</text>
    <view
      class="profile-toolbar__settings"
      hover-class="profile-toolbar__settings--pressed"
      aria-role="button"
      aria-label="打开设置"
      bindtap="onOpenSettings"
    >
      <line-icon name="settings" size="31" tone="ink" />
    </view>
  </view>

  <view class="profile-card" hover-class="profile-card--pressed" bindtap="onOpenAuth">
    <view class="profile-avatar profile-avatar--{{avatarTone}}">
      <image wx:if="{{avatarUrl}}" class="profile-avatar__image" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
      <text wx:else>{{avatarText}}</text>
    </view>

    <view class="profile-card__body">
      <view class="profile-card__name">{{displayName}}</view>
      <view class="profile-card__meta">{{profileMeta}}</view>
    </view>

    <view wx:if="{{isLoggedIn}}" class="profile-card__edit" aria-label="编辑个人资料">
      <line-icon name="pen-line" size="24" tone="ink" />
    </view>
    <view wx:else class="profile-card__login">
      <text>微信登录</text>
      <text class="profile-card__login-arrow">›</text>
    </view>
  </view>

  <view class="space-card" hover-class="space-card--pressed" bindtap="onOpenSpace">
    <view class="space-card__mark">
      <line-icon name="house" size="34" tone="white" />
    </view>
    <view class="space-card__body">
      <text class="space-card__label">共同空间</text>
      <view class="space-card__title">{{spaceName}}</view>
      <view class="space-card__meta">{{spaceMeta}}</view>
    </view>
    <text class="space-card__arrow">›</text>
  </view>

  <view class="feature-directory-head">
    <text class="feature-directory-head__title">功能</text>
    <text class="feature-directory-head__copy">按用途整理，点开就能用。</text>
  </view>

  <view wx:for="{{featureGroups}}" wx:key="key" class="profile-feature-group">
    <view class="profile-feature-group__head">
      <text class="profile-feature-group__title">{{item.category.title}}</text>
      <text class="profile-feature-group__description">{{item.category.description}}</text>
    </view>

    <view class="profile-feature-group__list">
      <view
        wx:for="{{item.items}}"
        wx:for-item="feature"
        wx:key="id"
        class="profile-feature-row"
        hover-class="profile-feature-row--pressed"
        data-id="{{feature.id}}"
        bindtap="onOpenFeature"
      >
        <view class="profile-feature-row__body">
          <text class="profile-feature-row__title">{{feature.label}}</text>
          <text class="profile-feature-row__description">{{feature.description}}</text>
        </view>
        <text class="profile-feature-row__arrow">›</text>
      </view>
    </view>
  </view>

  <app-tab-bar active="profile" />
</view>
