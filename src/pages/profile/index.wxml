<view class="tab-page profile-page">
  <page-loading show="{{initialLoading}}" title="正在打开你的空间" copy="把共同生活轻轻收在一起。" />
  <auth-preview-gate />

  <view
    class="profile-heading"
    style="padding-top: {{headerTop}}px;"
  >
    <view class="profile-heading__copy">
      <text class="profile-heading__eyebrow">PERSONAL SPACE</text>
      <text class="profile-heading__title">我的</text>
    </view>
    <view
      class="profile-settings"
      hover-class="profile-settings--pressed"
      aria-role="button"
      aria-label="打开设置"
      bindtap="onOpenSettings"
    >
      <line-icon name="system-settings" size="30" tone="ink" />
      <text>设置</text>
    </view>
  </view>

  <view class="profile-space-card">
    <view class="profile-space-card__orb"></view>
    <view
      class="profile-space-card__main"
      hover-class="profile-space-card__main--pressed"
      aria-role="button"
      aria-label="查看共同空间"
      bindtap="onOpenSpace"
    >
      <view class="profile-space-mark profile-space-mark--{{avatarTone}}">
        <image wx:if="{{avatarUrl}}" class="profile-space-mark__image" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
        <text wx:else>{{avatarText}}</text>
        <view wx:if="{{isLoggedIn}}" class="profile-space-mark__dot"></view>
      </view>

      <view class="profile-space-card__copy">
        <text class="profile-space-card__eyebrow">{{spaceEyebrow}}</text>
        <text class="profile-space-card__title">{{isLoggedIn ? spaceName : '登录后，一起生活'}}</text>
        <text class="profile-space-card__meta">{{spaceRelationship}}</text>
      </view>

      <view class="profile-space-card__arrow">›</view>
    </view>

    <view class="profile-space-stats">
      <view class="profile-space-stat">
        <text class="profile-space-stat__value">{{memberCount}}</text>
        <text class="profile-space-stat__label">成员</text>
      </view>
      <view class="profile-space-stat">
        <text class="profile-space-stat__value">{{todoCompleted}}</text>
        <text class="profile-space-stat__label">已完成</text>
      </view>
      <view class="profile-space-stat">
        <text class="profile-space-stat__value">{{journalTotal}}</text>
        <text class="profile-space-stat__label">生活记录</text>
      </view>
      <view
        class="profile-space-invite"
        hover-class="profile-space-invite--pressed"
        catchtap="onInvite"
      >
        <line-icon name="system-members" size="34" tone="ink" />
        <text>{{isLoggedIn ? '邀请' : '登录'}}</text>
      </view>
    </view>
  </view>

  <view class="profile-section">
    <view class="profile-section__head">
      <view class="profile-section__copy">
        <text class="profile-section__eyebrow">DAILY</text>
        <text class="profile-section__title">一起生活</text>
      </view>
    </view>

    <view class="profile-feature-grid">
      <view
        wx:for="{{dailyFeatures}}"
        wx:key="id"
        class="profile-feature-card profile-feature-card--{{item.cardTone}}"
        hover-class="profile-feature-card--pressed"
        data-id="{{item.id}}"
        bindtap="onOpenFeature"
      >
        <view class="profile-feature-card__icon">
          <line-icon name="{{item.icon}}" size="64" tone="{{item.tone}}" active="{{true}}" />
        </view>
        <view class="profile-feature-card__copy">
          <text class="profile-feature-card__title">{{item.title}}</text>
          <text class="profile-feature-card__meta">{{item.subtitle}}</text>
        </view>
        <text class="profile-feature-card__arrow">›</text>
      </view>
    </view>
  </view>

  <view class="profile-section profile-section--plans">
    <view class="profile-section__head">
      <view class="profile-section__copy">
        <text class="profile-section__eyebrow">PLANS</text>
        <text class="profile-section__title">让日子有期待</text>
      </view>
    </view>

    <view class="profile-plan-grid">
      <view
        wx:for="{{planFeatures}}"
        wx:key="id"
        class="profile-plan-card profile-plan-card--{{item.cardTone}}"
        hover-class="profile-plan-card--pressed"
        data-id="{{item.id}}"
        bindtap="onOpenFeature"
      >
        <view class="profile-plan-card__top">
          <view class="profile-plan-card__icon">
            <line-icon name="{{item.icon}}" size="64" tone="{{item.tone}}" active="{{true}}" />
          </view>
          <view class="profile-plan-card__arrow">›</view>
        </view>
        <text class="profile-plan-card__title">{{item.title}}</text>
        <text class="profile-plan-card__meta">{{item.subtitle}}</text>
      </view>
    </view>
  </view>

  <view
    class="profile-directory"
    hover-class="profile-directory--pressed"
    bindtap="onOpenFeatureList"
  >
    <text class="profile-directory__label">查看更多</text>
    <text class="profile-directory__arrow">›</text>
  </view>

  <app-tab-bar id="app-tab-bar" active="profile" />
</view>
