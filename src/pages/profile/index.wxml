<view class="tab-page profile-page">
  <page-loading show="{{initialLoading}}" title="正在准备你的空间" copy="登录状态和共同生活数据马上就好。" />
  <auth-preview-gate />

  <view class="profile-card" hover-class="profile-card--pressed" bindtap="onOpenAuth">
    <view class="profile-avatar profile-avatar--{{avatarTone}}">
      <image wx:if="{{avatarUrl}}" class="profile-avatar__image" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
      <text wx:else>{{avatarText}}</text>
    </view>

    <view class="profile-card__body">
      <view class="profile-card__name">{{displayName}}</view>
      <view class="profile-card__meta">{{profileMeta}}</view>
    </view>

    <view wx:if="{{isLoggedIn}}" class="profile-card__edit" aria-label="编辑个人资料">
      <line-icon name="pen-line" size="24" tone="ink" />
    </view>
    <view wx:else class="profile-card__login">
      <text>微信登录</text>
      <text class="profile-card__login-arrow">›</text>
    </view>
  </view>

  <view class="space-card" hover-class="space-card--pressed" bindtap="onOpenSpace">
    <view class="space-card__mark">
      <line-icon name="house" size="36" tone="white" />
    </view>
    <view class="space-card__body">
      <text class="space-card__label">共同空间</text>
      <view class="space-card__title">{{spaceName}}</view>
      <view class="space-card__meta">{{spaceMeta}}</view>
    </view>
    <text class="space-card__arrow">›</text>
  </view>

  <view class="settings-block">
    <view class="settings-block__label">功能与设置</view>
    <view class="settings-list">
      <view class="settings-row" hover-class="settings-row--pressed" bindtap="onOpenFeatureList">
        <line-icon name="book-open" size="27" tone="muted" />
        <view class="settings-row__body">
          <text class="settings-row__title">功能清单</text>
          <text class="settings-row__meta">查看全部功能</text>
        </view>
        <text class="settings-row__arrow">›</text>
      </view>
      <view class="settings-row" hover-class="settings-row--pressed" bindtap="onOpenFeatureSettings">
        <line-icon name="list-todo" size="27" tone="muted" />
        <view class="settings-row__body">
          <text class="settings-row__title">功能配置</text>
          <text class="settings-row__meta">首页与底栏</text>
        </view>
        <text class="settings-row__arrow">›</text>
      </view>
      <view class="settings-row" hover-class="settings-row--pressed" bindtap="onOpenReminders">
        <line-icon name="bell" size="27" tone="muted" />
        <view class="settings-row__body">
          <text class="settings-row__title">提醒设置</text>
          <text class="settings-row__meta">通知与订阅</text>
        </view>
        <text class="settings-row__arrow">›</text>
      </view>
    </view>
  </view>

  <app-tab-bar active="profile" />
</view>
