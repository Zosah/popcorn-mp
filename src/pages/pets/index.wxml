<view class="pets-page">
  <page-loading show="{{loading && !hasLoaded}}" title="正在看看毛孩子" copy="把照护、日常和喜欢的东西慢慢收好。" />
  <auth-preview-gate />

  <block wx:if="{{hasActivePet}}">
    <view class="pet-hero pet-hero--bg-{{profile.backgroundKey}} {{profile.backgroundUrl ? 'pet-hero--custom' : ''}}">
      <image wx:if="{{profile.backgroundUrl}}" class="pet-hero__bg" src="{{profile.backgroundUrl}}" mode="aspectFill" />
      <view class="pet-hero__veil"></view>

      <view class="pet-hero__topbar">
        <view class="pet-glass-button" bindtap="onOpenCalendar" aria-label="打开照护月历">
          <line-icon name="system-calendar" size="31" tone="ink" />
        </view>
        <view class="pet-hero__actions">
          <view class="pet-glass-button" bindtap="onAddPetWithConfirm" aria-label="添加宠物">
            <line-icon name="system-add" size="30" tone="ink" />
          </view>
        </view>
      </view>

      <view class="pet-hero__main">
        <view class="pet-hero__copy">
          <text class="pet-eyebrow">我们的伙伴</text>
          <view class="pet-hero__name-row" bindtap="onChoosePet">
            <text class="pet-hero__name">{{profile.name}}</text>
            <view wx:if="{{petTabs.length > 1}}" class="pet-hero__switch"><line-icon name="system-expand" size="26" tone="ink" /></view>
          </view>
          <view class="pet-hero__sub">{{profile.breed}} · {{ageLabel}}</view>
          <view class="pet-hero__status-list" catchtap="onOpenStatusManager">
            <view wx:for="{{profile.statusNotes}}" wx:key="id" class="pet-hero__status">{{item.content}}</view>
            <view wx:if="{{!profile.statusNotes.length}}" class="pet-hero__status pet-hero__status--empty">＋ 最近状态</view>
          </view>
        </view>

        <view class="pet-portrait" bindtap="onOpenAvatarPreview">
          <image wx:if="{{profile.avatarUrl}}" class="pet-portrait__image" src="{{profile.avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
          <block wx:elif="{{profile.species === 'cat'}}">
            <view class="pet-cat__ear pet-cat__ear--left"></view>
            <view class="pet-cat__ear pet-cat__ear--right"></view>
            <view class="pet-cat__face">
              <view class="pet-cat__eye pet-cat__eye--left"></view>
              <view class="pet-cat__eye pet-cat__eye--right"></view>
              <view class="pet-cat__nose"></view>
              <view class="pet-cat__whisker pet-cat__whisker--left"></view>
              <view class="pet-cat__whisker pet-cat__whisker--right"></view>
            </view>
          </block>
          <view wx:else class="pet-portrait__initial">{{profileInitial}}</view>
        </view>
      </view>

      <view class="pet-hero__background-action" catchtap="onOpenBackgroundPicker">
        <line-icon name="system-image" size="20" tone="pink" />
        <text>更换背景</text>
      </view>

      <view class="pet-stats">
        <view bindtap="onToggleWeightUnit"><view class="pet-stats__value">{{latestWeight}}<text>{{weightUnitLabel}}</text></view><view class="pet-stats__label">当前体重 · 点击切换</view></view>
        <view><view class="pet-stats__value">{{companionDays}}</view><view class="pet-stats__label">天陪伴日</view></view>
        <view><view class="pet-stats__value">{{growthTimeline.length}}</view><view class="pet-stats__label">条成长记录</view></view>
      </view>
    </view>

    <view class="pet-nav">
      <view class="pet-nav__item {{activeSection === 'daily' ? 'pet-nav__item--active' : ''}}" data-value="daily" bindtap="onSwitchSection">
        <line-icon name="pet-tab-daily" size="34" tone="{{activeSection === 'daily' ? 'color' : 'muted'}}" />
        <text>日常</text>
      </view>
      <view class="pet-nav__item {{activeSection === 'supplies' ? 'pet-nav__item--active' : ''}}" data-value="supplies" bindtap="onSwitchSection">
        <line-icon name="pet-tab-supplies" size="34" tone="{{activeSection === 'supplies' ? 'color' : 'muted'}}" />
        <text>用品</text>
      </view>
      <view class="pet-nav__item {{activeSection === 'care' ? 'pet-nav__item--active' : ''}}" data-value="care" bindtap="onSwitchSection">
        <line-icon name="pet-tab-care" size="34" tone="{{activeSection === 'care' ? 'color' : 'muted'}}" />
        <text>护理</text>
      </view>
      <view class="pet-nav__item {{activeSection === 'profile' ? 'pet-nav__item--active' : ''}}" data-value="profile" bindtap="onSwitchSection">
        <line-icon name="pet-tab-profile" size="34" tone="{{activeSection === 'profile' ? 'color' : 'muted'}}" />
        <text>档案</text>
      </view>
    </view>

    <view class="pet-content">
      <block wx:if="{{profileSectionActive}}">
        <view class="profile-facts-card">
          <picker class="profile-fact" mode="date" value="{{profile.birthday}}" end="{{todayDate}}" data-field="birthday" bindchange="onProfileDateChange">
            <view class="profile-fact__label-line"><line-icon name="pet-care-birthday" size="25" tone="color" /><text class="profile-fact__label">出生</text></view>
            <text class="profile-fact__value">{{birthdayLabel}}</text>
            <text wx:if="{{birthdayElapsedLabel}}" class="profile-fact__elapsed">{{birthdayElapsedLabel}}</text>
          </picker>
          <picker class="profile-fact" mode="date" value="{{profile.homeOn}}" end="{{todayDate}}" data-field="homeOn" bindchange="onProfileDateChange">
            <view class="profile-fact__label-line"><line-icon name="pet-care-homecoming" size="25" tone="color" /><text class="profile-fact__label">到家</text></view>
            <text class="profile-fact__value">{{homeOnLabel}}</text>
            <text wx:if="{{homeOnElapsedLabel}}" class="profile-fact__elapsed">{{homeOnElapsedLabel}}</text>
          </picker>
          <picker class="profile-fact" mode="date" value="{{profile.neuteredOn}}" end="{{todayDate}}" data-field="neuteredOn" bindchange="onProfileDateChange">
            <view class="profile-fact__label-line"><line-icon name="pet-care-neuter" size="25" tone="color" /><text class="profile-fact__label">绝育</text></view>
            <text class="profile-fact__value {{profile.neuteredOn ? '' : 'profile-fact__value--empty'}}">{{neuteredOnLabel}}</text>
            <text wx:if="{{neuteredOnElapsedLabel}}" class="profile-fact__elapsed">{{neuteredOnElapsedLabel}}</text>
          </picker>
        </view>

        <view class="pet-section-head pet-section-head--plain">
          <view><text class="pet-section-head__title">体重</text></view>
          <view bindtap="onRecordWeight">记体重</view>
        </view>
        <view class="pet-weight">
          <view class="pet-weight__head"><view><text>{{latestWeight}} {{weightUnitLabel}}</text><text>{{weightTrendLabel}}</text></view><text>近 {{weightPoints.length}} 次</text></view>
          <view wx:if="{{weightPoints.length}}" class="pet-weight__chart">
            <view wx:for="{{weightPoints}}" wx:key="id" class="pet-weight__column {{item.active ? 'pet-weight__column--active' : ''}}" data-id="{{item.id}}" bindtap="onOpenWeightRecord"><text class="pet-weight__value">{{item.value}}</text><view class="pet-weight__track"><view class="pet-weight__bar" style="height: {{item.height}}%;"></view></view><text class="pet-weight__date">{{item.dateLabel}}</text></view>
          </view>
          <view wx:else class="pet-weight__empty">记下第一次体重，之后会在这里看到变化</view>
        </view>

        <view class="pet-section-head pet-section-head--plain">
          <view><text class="pet-section-head__title">成长记录</text></view>
          <view bindtap="onAddGrowthRecord">新增</view>
        </view>
        <view class="pet-filter-bar">
          <view wx:for="{{growthFilters}}" wx:key="value" class="pet-filter-chip {{growthFilter === item.value ? 'pet-filter-chip--active' : ''}}" data-value="{{item.value}}" bindtap="onSelectGrowthFilter">{{item.label}}</view>
        </view>
        <view wx:if="{{growthTimelineFiltered.length}}" class="daily-timeline growth-timeline">
          <view wx:for="{{growthTimelineVisible}}" wx:key="id" class="daily-timeline__row" data-id="{{item.id}}" data-type="{{item.type}}" data-event-id="{{item.eventId}}" data-weight-id="{{item.weightId}}" bindtap="onOpenGrowthRecord">
            <view class="daily-timeline__rail">
              <view class="daily-timeline__dot"><line-icon name="{{item.iconName}}" size="32" tone="color" /></view>
              <view class="daily-timeline__line"></view>
            </view>
            <view class="daily-timeline__body">
              <view class="daily-timeline__meta"><text>{{item.yearLabel}}年{{item.dateLabel}}</text><text>{{item.elapsedLabel === '今天' ? '今天' : item.elapsedLabel + '前'}}</text></view>
              <view class="daily-timeline__badges"><text class="daily-timeline__action daily-timeline__action--{{item.type}}">{{item.label}}</text><text class="daily-timeline__status">{{item.content}}</text></view>
              <text wx:if="{{item.note}}" class="daily-timeline__note">{{item.note}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{growthTimelineFiltered.length > 5}}" class="timeline-more" bindtap="onToggleGrowthTimeline">{{growthTimelineExpanded ? '收起' : '查看更早记录'}}<text>{{growthTimelineExpanded ? '↑' : '↓'}}</text></view>
        <view wx:if="{{!growthTimelineFiltered.length}}" class="pet-empty-line">这一类还没有记录</view>

        <view class="profile-danger-zone"><view><text>删除档案</text><text>档案、照护和用品记录会一起移除</text></view><button bindtap="onDeletePet">删除</button></view>
      </block>

      <block wx:elif="{{activeSection === 'care'}}">
        <view class="pet-toolbar">
          <view bindtap="onOpenCalendar">月历</view>
        </view>
        <view class="care-list">
          <view wx:for="{{careCards}}" wx:key="type" class="care-row care-row--{{item.status}}">
            <view class="care-row__icon"><line-icon name="{{item.iconName}}" size="38" tone="color" /></view>
            <view class="care-row__body">
              <view class="care-row__title">{{item.title}}</view>
              <view wx:if="{{item.lastOn}}" class="care-row__elapsed">上次 {{item.lastOnLabel}} · 已过 <text>{{item.elapsedLabel}}</text></view>
              <view wx:else class="care-row__elapsed">还没有记录</view>
              <view wx:if="{{item.nextOn}}" class="care-row__plan">下次 {{item.nextOn}}</view>
            </view>
            <button class="care-row__action" data-type="{{item.type}}" bindtap="onRecordCare"><line-icon name="system-add" size="22" tone="pink" /><text>记一下</text></button>
          </view>
        </view>
        <view class="pet-section-head pet-section-head--plain">
          <view><text class="pet-section-head__title">护理记录</text></view>
          <view bindtap="onAddCareEvent">新增</view>
        </view>
        <view class="pet-filter-bar pet-filter-bar--care">
          <view wx:for="{{careFilters}}" wx:key="value" class="pet-filter-chip {{careFilter === item.value ? 'pet-filter-chip--active' : ''}}" data-value="{{item.value}}" bindtap="onSelectCareFilter">{{item.label}}</view>
        </view>
        <view wx:if="{{careTimelineFiltered.length}}" class="daily-timeline care-timeline">
          <view wx:for="{{careTimelineVisible}}" wx:key="id" class="daily-timeline__row" data-id="{{item.id}}" bindtap="onOpenEvent">
            <view class="daily-timeline__rail">
              <view class="daily-timeline__dot"><line-icon name="{{item.iconName}}" size="32" tone="color" /></view>
              <view class="daily-timeline__line"></view>
            </view>
            <view class="daily-timeline__body">
              <view class="daily-timeline__meta"><text>{{item.yearLabel}}年{{item.dateLabel}}</text><text>{{item.elapsedLabel === '今天' ? '今天' : item.elapsedLabel + '前'}}</text></view>
              <view class="daily-timeline__badges"><text class="daily-timeline__action daily-timeline__action--{{item.type}}">{{item.label}}</text><text class="daily-timeline__status">{{item.content}}</text></view>
              <text wx:if="{{item.note}}" class="daily-timeline__note">{{item.note}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{careTimelineFiltered.length > 5}}" class="timeline-more" bindtap="onToggleCareTimeline">{{careTimelineExpanded ? '收起' : '查看更早记录'}}<text>{{careTimelineExpanded ? '↑' : '↓'}}</text></view>
        <view wx:if="{{!careTimelineFiltered.length}}" class="pet-empty-line">这一类还没有护理记录</view>
      </block>

      <block wx:elif="{{activeSection === 'daily'}}">
        <view class="daily-grid">
          <view wx:for="{{dailySummary}}" wx:key="type" class="daily-card" data-type="{{item.type}}" bindtap="onAddDailyLog">
            <view class="daily-card__visual"><line-icon name="{{item.iconName}}" size="38" tone="color" /></view>
            <view class="daily-card__body"><text class="daily-card__title">{{item.label}}</text><text class="daily-card__status">{{item.metaLabel}}</text></view>
            <text class="daily-card__add">＋</text>
          </view>
        </view>
        <view id="daily-history" class="daily-recent">
          <view class="pet-section-head pet-section-head--plain">
            <view><text class="pet-section-head__title">日常记录</text></view>
            <view class="daily-head-actions"><text wx:if="{{dailyHistory.length}}">{{dailyHistory.length}} 条</text><view class="daily-head-record" bindtap="onOpenDailyRecord">＋ 记录</view></view>
          </view>
          <view wx:if="{{dailyHistoryVisible.length}}" class="daily-timeline">
            <view wx:for="{{dailyHistoryVisible}}" wx:key="id" class="daily-timeline__row" data-id="{{item.id}}" bindlongpress="onDailyLogLongPress">
              <view class="daily-timeline__rail">
                <view class="daily-timeline__dot"><line-icon name="{{item.iconName}}" size="32" tone="color" /></view>
                <view class="daily-timeline__line"></view>
              </view>
              <view class="daily-timeline__body">
                <view class="daily-timeline__meta"><text>{{item.yearLabel}}{{item.dateLabel}} {{item.timeLabel}}</text><text>{{item.elapsedLabel === '刚刚' ? '刚刚' : item.elapsedLabel + '前'}}</text></view>
                <view class="daily-timeline__badges"><text class="daily-timeline__action daily-timeline__action--{{item.type}}">{{item.actionLabel}}</text><text class="daily-timeline__status">{{item.statusLabel}}</text></view>
                <text wx:if="{{item.note}}" class="daily-timeline__note">{{item.note}}</text>
              </view>
            </view>
          </view>
          <view wx:if="{{dailyHistory.length > 5}}" class="timeline-more" bindtap="onToggleDailyHistory">{{dailyHistoryExpanded ? '收起' : '查看更早记录'}}<text>{{dailyHistoryExpanded ? '↑' : '↓'}}</text></view>
          <view wx:if="{{!dailyHistoryVisible.length}}" class="pet-empty-line">还没有日常记录，点右上角记下第一条</view>
        </view>
      </block>

      <block wx:else>
        <view class="pet-section-head pet-section-head--plain"><view><text class="pet-section-head__title">用品清单</text></view><view bindtap="onAddSupply">＋ 添加</view></view>
        <view wx:if="{{currentSupplies.length}}" class="current-supplies-wrap">
          <scroll-view class="current-supplies" scroll-x enhanced show-scrollbar="{{false}}"><view class="current-supplies__row"><view wx:for="{{currentSupplies}}" wx:key="id" class="current-supply" data-id="{{item.id}}" bindtap="onEditSupply"><text class="current-supply__label current-supply__label--{{item.preference}}">{{item.preferenceHearts}} {{item.preferenceLabel}}</text><view class="current-supply__title-line"><text class="supply-category-label supply-category-label--{{item.category}}">{{item.categoryLabel}}</text><view class="current-supply__name">{{item.name}}</view></view><view class="current-supply__note">{{item.note || '用着不错'}}</view></view></view></scroll-view>
        </view>
        <scroll-view class="supply-filter" scroll-x enhanced show-scrollbar="{{false}}"><view class="supply-filter__row"><view wx:for="{{supplyCategories}}" wx:key="value" class="supply-filter__item {{selectedSupplyCategory === item.value ? 'supply-filter__item--active' : ''}}" data-value="{{item.value}}" bindtap="onSelectSupplyCategory">{{item.label}}</view></view></scroll-view>
        <view class="supply-list">
          <view wx:for="{{supplies}}" wx:key="id" class="supply-row" data-id="{{item.id}}" bindtap="onEditSupply">
            <view class="supply-row__index">{{index + 1}}</view>
            <image wx:if="{{item.mediaThumbUrl || item.mediaUrl}}" class="supply-row__image" src="{{item.mediaThumbUrl || item.mediaUrl}}" mode="aspectFill" data-id="{{item.id}}" catchtap="onPreviewSupplyImage" />
            <view wx:else class="supply-row__icon"><line-icon name="{{item.iconName}}" size="52" tone="color" /></view>
            <view class="supply-row__body">
              <view class="supply-row__title-line">
                <text class="supply-category-label supply-category-label--{{item.category}}">{{item.categoryLabel}}</text>
                <text class="supply-row__brand">{{item.brand || '未记品牌'}}</text>
                <text class="supply-row__title">{{item.name}}</text>
              </view>
              <text wx:if="{{item.note}}" class="supply-row__note">{{item.note}}</text>
            </view>
            <view class="supply-preference supply-preference--{{item.preference}}">
              <text class="supply-preference__hearts">{{item.preferenceHearts}}</text>
              <text>{{item.preferenceLabel}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{!supplies.length}}" class="pet-empty-line" bindtap="onAddSupply">还没有用品，先记一件家里正在用的东西</view>
      </block>
    </view>

    <view wx:if="{{statusManagerOpen}}" class="pet-sheet-mask" catchtap="onCloseStatusManager">
      <view class="pet-sheet pet-sheet--status" catchtap="noop">
        <view class="pet-sheet__handle"></view>
        <view class="pet-sheet__head">
          <view><text class="pet-eyebrow">最近状态</text><text class="pet-sheet__title">此刻的{{profile.name}}</text></view>
          <view bindtap="onCloseStatusManager">关闭</view>
        </view>
        <view class="status-note-list">
          <view wx:for="{{profile.statusNotes}}" wx:key="id" class="status-note-row">
            <view class="status-note-row__content">{{item.content}}</view>
            <view class="status-note-row__actions">
              <text data-id="{{item.id}}" data-version="{{item.version}}" bindtap="onEditStatus">编辑</text>
              <text class="status-note-row__delete" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="onRemoveStatusNote">删除</text>
            </view>
          </view>
          <view wx:if="{{!profile.statusNotes.length}}" class="status-note-empty">还没有最近状态，写一条放在名字下面</view>
        </view>
        <view wx:if="{{statusEditingId || profile.statusNotes.length < 2}}" class="status-note-form">
          <textarea value="{{statusDraft}}" maxlength="60" auto-height placeholder="例如：今天胃口不错" bindinput="onStatusDraftInput" placeholder-class="app-input-placeholder" />
          <view class="status-note-form__footer">
            <text>{{statusEditingId ? '正在编辑已有状态' : profile.statusNotes.length + ' / 2'}}</text>
            <button loading="{{statusSaving}}" disabled="{{statusSaving}}" bindtap="onSaveStatusNote">{{statusEditingId ? '保存修改' : '添加状态'}}</button>
          </view>
        </view>
        <view wx:else class="status-note-limit">已记录 2 条最近状态，点击上方内容编辑，或删除后再添加。</view>
        <view wx:if="{{dailyHistory.length}}" class="status-latest-entry" bindtap="onOpenLatestDailyRecord">最近记录：{{dailyHistory[0].statusLabel}}<text>去看看 ›</text></view>
      </view>
    </view>

    <view wx:if="{{weightEditorOpen}}" class="pet-sheet-mask" catchtap="onCloseWeightEditor">
      <view class="pet-sheet pet-sheet--weight" catchtap="noop">
        <view class="pet-sheet__handle"></view>
        <view class="pet-sheet__head">
          <view><text class="pet-eyebrow">体重记录</text><text class="pet-sheet__title">{{weightEditorMode === 'edit' ? '调整这次记录' : '称一称，记下来'}}</text></view>
          <view bindtap="onCloseWeightEditor">关闭</view>
        </view>
        <view class="weight-editor-unit-row">
          <view class="weight-editor-unit {{weightDraftUnit === 'jin' ? 'weight-editor-unit--active' : ''}}" data-value="jin" bindtap="onWeightDraftUnitSelect">斤</view>
          <view class="weight-editor-unit {{weightDraftUnit === 'kg' ? 'weight-editor-unit--active' : ''}}" data-value="kg" bindtap="onWeightDraftUnitSelect">公斤</view>
        </view>
        <view class="weight-editor-input">
          <input type="digit" value="{{weightDraftValue}}" maxlength="8" placeholder="{{weightDraftUnit === 'jin' ? '例如 8.4' : '例如 4.2'}}" bindinput="onWeightDraftInput" placeholder-class="app-input-placeholder" />
          <text>{{weightDraftUnit === 'jin' ? '斤' : 'kg'}}</text>
        </view>
        <picker mode="date" value="{{weightDraftDate}}" bindchange="onWeightDateChange">
          <view class="weight-editor-date"><text>记录日期</text><text>{{weightDraftDate}} ›</text></view>
        </picker>
        <button class="pet-sheet__primary" loading="{{weightSaving}}" disabled="{{weightSaving}}" bindtap="onSaveWeight">{{weightEditorMode === 'edit' ? '保存修改' : '记下体重'}}</button>
        <view wx:if="{{weightEditorMode === 'edit'}}" class="weight-editor-delete" bindtap="onDeleteWeight">删除这条体重记录</view>
      </view>
    </view>

    <view wx:if="{{dailyEditorOpen}}" class="pet-sheet-mask" catchtap="onCloseDailyEditor">
      <view class="pet-sheet pet-sheet--daily" catchtap="noop">
        <view class="pet-sheet__handle"></view>
        <view class="pet-sheet__head daily-editor__head">
          <view class="daily-editor__heading">
            <view class="daily-editor__icon"><line-icon name="{{dailyEditor.iconName}}" size="40" tone="color" /></view>
            <text class="pet-sheet__title">{{dailyEditor.title}}</text>
          </view>
          <view bindtap="onCloseDailyEditor" aria-label="关闭">关闭</view>
        </view>
        <view wx:if="{{dailyEditor.freeform}}" class="daily-editor__field daily-editor__field--freeform">
          <text>{{dailyEditor.detailLabel}}</text>
          <textarea class="daily-editor__textarea" value="{{dailyEditor.detail}}" maxlength="500" auto-height placeholder="{{dailyEditor.detailPlaceholder}}" bindinput="onDailyDetailInput" placeholder-class="app-input-placeholder" />
        </view>
        <block wx:else>
          <view class="daily-editor__section">
            <text class="daily-editor__label">{{dailyEditor.choiceLabel}}</text>
            <view class="choice-row">
              <view wx:for="{{dailyEditor.choices}}" wx:key="value" class="choice-chip {{dailyEditor.choice === item.value ? 'choice-chip--active' : ''}}" data-value="{{item.value}}" bindtap="onDailyChoiceSelect">{{item.label}}</view>
            </view>
          </view>
          <view class="daily-editor__field">
            <text>{{dailyEditor.detailLabel}}</text>
            <input value="{{dailyEditor.detail}}" maxlength="60" placeholder="{{dailyEditor.detailPlaceholder}}" bindinput="onDailyDetailInput" placeholder-class="app-input-placeholder" />
          </view>
        </block>
        <view class="daily-editor__section daily-editor__time-section">
          <text class="daily-editor__label">记录时间</text>
          <view class="daily-time-row">
            <picker class="daily-time-picker" mode="date" value="{{dailyEditor.recordedDate}}" bindchange="onDailyDateChange">
              <view class="daily-time-picker__value">
                <text>日期</text>
                <view>{{dailyEditor.recordedDate}}</view>
              </view>
            </picker>
            <picker class="daily-time-picker daily-time-picker--clock" mode="time" value="{{dailyEditor.recordedTime}}" bindchange="onDailyTimeChange">
              <view class="daily-time-picker__value">
                <text>时间</text>
                <view>{{dailyEditor.recordedTime}}</view>
              </view>
            </picker>
          </view>
          <text class="daily-time-hint">可以补录以前发生的事，默认是现在</text>
        </view>
        <button class="pet-sheet__primary" loading="{{dailySaving}}" disabled="{{dailySaving}}" bindtap="onSaveDailyLog">{{dailyEditorEditingId ? '保存修改' : dailyEditor.freeform ? '保存记录' : '记下这次' + dailyEditor.title}}</button>
      </view>
    </view>

    <view wx:if="{{avatarPreviewOpen}}" class="pet-modal" catchtap="onCloseAvatarPreview">
      <view class="avatar-preview" catchtap="noop">
        <view class="avatar-preview__visual">
          <image wx:if="{{avatarPreviewUrl || profile.avatarUrl}}" src="{{avatarPreviewUrl || profile.avatarUrl}}" mode="aspectFill" />
          <block wx:elif="{{profile.species === 'cat'}}"><view class="avatar-preview__initial">猫</view></block>
          <view wx:else class="avatar-preview__initial">{{profileInitial}}</view>
        </view>
        <view class="avatar-preview__close" catchtap="onCloseAvatarPreview" aria-label="关闭"><text>×</text></view>
        <view class="avatar-preview__name">{{profile.name}}</view>
        <view class="avatar-preview__copy">更换时可按 1:1 裁切</view>
        <button class="avatar-preview__button" bindtap="onChooseAvatar">{{uploadingAvatar ? '处理中…' : profile.avatarUrl ? '更换照片' : '添加照片'}}</button>
      </view>
    </view>

    <view wx:if="{{backgroundPickerOpen}}" class="pet-sheet-mask" catchtap="onCloseBackgroundPicker">
      <view class="pet-sheet pet-sheet--background" catchtap="noop">
        <view class="pet-sheet__handle"></view>
        <view class="pet-sheet__head"><view><text class="pet-eyebrow">宠物背景</text><text class="pet-sheet__title">给{{profile.name}}换个心情</text></view><view bindtap="onCloseBackgroundPicker">关闭</view></view>
        <text class="background-section-label">系统背景</text>
        <view class="background-options">
          <view wx:for="{{backgroundOptions}}" wx:key="key" class="background-option background-option--{{item.key}} {{item.selected ? 'background-option--selected' : ''}}" data-key="{{item.key}}" bindtap="onSelectBackgroundTheme"><view class="background-option__swatch"></view><text>{{item.label}}</text><line-icon wx:if="{{item.selected}}" name="system-check" size="15" tone="green" /></view>
        </view>
        <view wx:if="{{backgroundHistoryOptions.length}}" class="background-history">
          <text class="background-section-label">用过的照片</text>
          <scroll-view class="background-history__scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="background-history__row">
              <view wx:for="{{backgroundHistoryOptions}}" wx:key="mediaId" class="background-history__item {{item.selected ? 'background-history__item--selected' : ''}}" data-media-id="{{item.mediaId}}" bindtap="onSelectBackgroundHistory">
                <image src="{{item.url}}" mode="aspectFill" />
                <view class="background-history__meta"><text>{{item.usedAtLabel}}</text><line-icon wx:if="{{item.selected}}" name="system-check" size="14" tone="green" /></view>
              </view>
            </view>
          </scroll-view>
        </view>
        <button class="pet-sheet__primary" bindtap="onChooseBackground">{{uploadingBackground ? '正在上传…' : '上传新的背景图'}}</button>
        <view class="pet-sheet__hint">换回系统背景也不会丢掉用过的照片。</view>
      </view>
    </view>

    <view wx:if="{{supplyEditorOpen}}" class="pet-sheet-mask" catchtap="onCloseSupplyEditor">
      <view class="pet-sheet pet-sheet--supply" catchtap="noop">
        <view class="pet-sheet__handle"></view>
        <view class="pet-sheet__head"><view><text class="pet-eyebrow">{{supplyEditorMode === 'edit' ? '编辑用品' : '新增用品'}}</text><text class="pet-sheet__title">{{supplyEditorMode === 'edit' ? '补充这件用品的信息' : '记下值得记住的体验'}}</text></view><view bindtap="onCloseSupplyEditor">关闭</view></view>
        <scroll-view class="supply-editor-scroll" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="supply-editor-section"><text class="supply-editor-label">类型</text><view class="choice-row"><view wx:for="{{supplyEditorCategories}}" wx:key="value" class="choice-chip {{supplyDraft.category === item.value ? 'choice-chip--active' : ''}}" data-value="{{item.value}}" bindtap="onSupplyCategorySelect">{{item.label}}</view></view></view>
          <view wx:if="{{supplyDraft.category === 'custom'}}" class="supply-field"><text>自定义类型</text><input value="{{supplyDraft.categoryLabel}}" maxlength="32" placeholder="例如：玩具、护理" data-field="categoryLabel" bindinput="onSupplyFieldInput" placeholder-class="app-input-placeholder" /></view>
          <view class="supply-field"><text>名称</text><input value="{{supplyDraft.name}}" maxlength="60" placeholder="例如：鸡肉主食罐" data-field="name" bindinput="onSupplyFieldInput" placeholder-class="app-input-placeholder" /></view>
          <view class="supply-field"><text>品牌</text><input value="{{supplyDraft.brand}}" maxlength="40" placeholder="选填" data-field="brand" bindinput="onSupplyFieldInput" placeholder-class="app-input-placeholder" /></view>
          <view class="supply-editor-section"><text class="supply-editor-label">偏好</text><view class="choice-row"><view wx:for="{{supplyPreferenceOptions}}" wx:key="value" class="choice-chip choice-chip--{{item.value}} {{supplyDraft.preference === item.value ? 'choice-chip--active' : ''}}" data-value="{{item.value}}" bindtap="onSupplyPreferenceSelect">{{item.hearts}} {{item.label}}</view></view></view>
          <view class="supply-field"><text>备注</text><input value="{{supplyDraft.note}}" maxlength="200" placeholder="口味、使用感受，选填" data-field="note" bindinput="onSupplyFieldInput" placeholder-class="app-input-placeholder" /></view>
          <view class="supply-editor-section">
            <text class="supply-editor-label">图片</text>
            <block wx:if="{{supplyDraft.mediaThumbUrl || supplyDraft.mediaUrl}}">
              <view class="supply-editor-image"><image src="{{supplyDraft.mediaThumbUrl || supplyDraft.mediaUrl}}" mode="aspectFill" bindtap="onPreviewSupplyEditorImage" /></view>
              <view class="supply-editor-image-actions">
                <text bindtap="onPreviewSupplyEditorImage">查看</text>
                <text bindtap="onEditSupplyImage">编辑</text>
                <text bindtap="onChooseSupplyImage">更换</text>
                <text class="is-danger" bindtap="onRemoveSupplyImage">移除</text>
              </view>
            </block>
            <view wx:else class="supply-image-picker" bindtap="onChooseSupplyImage"><line-icon name="system-camera" size="22" tone="green" /><text>选填，上传一张实物图</text></view>
          </view>
          <button class="pet-sheet__primary" loading="{{supplySaving}}" disabled="{{supplySaving}}" bindtap="onSaveSupply">{{supplyEditorMode === 'edit' ? '保存修改' : '保存用品'}}</button>
        </scroll-view>
      </view>
    </view>
  </block>

  <view wx:else class="pet-empty-state">
    <view class="pet-empty-state__art"><view class="pet-empty-state__ear pet-empty-state__ear--left"></view><view class="pet-empty-state__ear pet-empty-state__ear--right"></view><view class="pet-empty-state__face"><line-icon name="pet-supply-custom" size="36" tone="color" /></view></view>
    <text class="pet-eyebrow">毛孩子的家</text>
    <view class="pet-empty-state__title">{{loading ? '正在同步宠物照护…' : '还没有宠物档案'}}</view>
    <view wx:if="{{errorText}}" class="pet-empty-state__copy">{{errorText}}</view>
    <view wx:else class="pet-empty-state__copy">添加第一只伙伴，把疫苗、体重、日常和喜欢的东西慢慢记下来。</view>
    <button wx:if="{{errorText}}" class="pet-empty-state__button" bindtap="onRetry">重新加载</button>
    <button wx:elif="{{!loading}}" class="pet-empty-state__button" bindtap="onAddPet">添加第一只伙伴</button>
  </view>

  <app-tab-bar id="app-tab-bar" active="pets" />
</view>
