<view class="page-shell pets-page">
  <view class="subpage-back" bindtap="onBack">← 返回家</view>

  <view class="pets-head">
    <view class="pets-head__meta">PET LIFE · 我们的家</view>
    <view class="pets-head__title">{{profile.name}}的每一天</view>
    <view class="pets-head__copy">从第一次到家，到今天吃什么、用什么，把照护和偏好慢慢积累下来。</view>
  </view>

  <scroll-view class="pet-switcher" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="pet-switcher__row">
      <view wx:for="{{petTabs}}" wx:key="id" class="pet-switcher__item {{item.selected ? 'pet-switcher__item--active' : ''}}" data-id="{{item.id}}" bindtap="onSwitchPet">
        <view>{{item.initial}}</view>
        <text>{{item.name}}</text>
        <text>{{item.speciesLabel}}</text>
      </view>
      <view class="pet-switcher__add" bindtap="onAddPet"><text>＋</text><text>添加宠物</text></view>
    </view>
  </scroll-view>

  <view class="pet-profile">
    <view class="pet-avatar pet-avatar--{{profile.species}}">
      <block wx:if="{{profile.species === 'cat'}}">
        <view class="pet-ear pet-ear--left"></view>
        <view class="pet-ear pet-ear--right"></view>
      </block>
      <text>{{profileInitial}}</text>
    </view>
    <view class="pet-profile__body">
      <text>{{profile.name}}</text>
      <text>{{profile.breed}} · {{profile.sex === 'female' ? '女生' : '男生'}} · {{ageLabel}}</text>
    </view>
    <view class="pet-profile__status">{{profile.status}}</view>
  </view>

  <view class="pet-sections">
    <view class="pet-sections__item {{activeSection === 'profile' ? 'pet-sections__item--active' : ''}}" data-value="profile" bindtap="onSwitchSection">档案</view>
    <view class="pet-sections__item {{activeSection === 'care' ? 'pet-sections__item--active' : ''}}" data-value="care" bindtap="onSwitchSection">照护</view>
    <view class="pet-sections__item {{activeSection === 'supplies' ? 'pet-sections__item--active' : ''}}" data-value="supplies" bindtap="onSwitchSection">吃喝拉撒</view>
  </view>

  <block wx:if="{{activeSection === 'profile'}}">
    <view class="pet-section-head">
      <view><text>基本档案</text><text>三个重要的日子</text></view>
      <view bindtap="onToggleProfileEditor">{{editingProfile ? '取消' : '编辑'}}</view>
    </view>

    <view class="milestone-grid">
      <view class="milestone milestone--warm"><text>{{birthdayLabel}}</text><text>出生</text></view>
      <view class="milestone milestone--blue"><text>{{homeOnLabel}}</text><text>到家</text></view>
      <view class="milestone milestone--mint"><text>{{neuteredOnLabel}}</text><text>{{profile.neuteredOn ? '绝育' : '未绝育'}}</text></view>
    </view>

    <view wx:if="{{editingProfile}}" class="profile-editor">
      <view class="profile-field">
        <text>出生日期</text>
        <picker mode="date" value="{{profileDraft.birthday}}" bindchange="onBirthdayChange"><view>{{profileDraft.birthday || '选择日期'}} ›</view></picker>
      </view>
      <view class="profile-field">
        <text>到家日期</text>
        <picker mode="date" value="{{profileDraft.homeOn}}" bindchange="onHomeDateChange"><view>{{profileDraft.homeOn || '选择日期'}} ›</view></picker>
      </view>
      <view class="profile-field">
        <text>是否绝育</text>
        <switch checked="{{profileDraft.neuteredOn}}" color="#27c78d" bindchange="onNeuteredToggle" />
      </view>
      <view wx:if="{{profileDraft.neuteredOn}}" class="profile-field">
        <text>绝育日期</text>
        <picker mode="date" value="{{profileDraft.neuteredOn}}" bindchange="onNeuteredDateChange"><view>{{profileDraft.neuteredOn}} ›</view></picker>
      </view>
      <button class="primary-button profile-editor__save" bindtap="onSaveProfile">保存档案</button>
    </view>

    <view class="pet-section-head">
      <view><text>体重变化</text><text>记录身体的小变化</text></view>
      <view bindtap="onRecordWeight">＋ 记录</view>
    </view>
    <view class="weight-card">
      <view class="weight-card__value"><text>{{latestWeight}}</text><text>kg</text></view>
      <view class="weight-chart"><view wx:for="{{weightBars}}" wx:key="index"><text style="height: {{item}}%;"></text></view></view>
      <view class="weight-card__hint">最近 {{weightBars.length}} 次记录</view>
    </view>

    <view class="pet-section-head">
      <view><text>成长时间线</text><text>疫苗、绝育、洗护、生病、就诊与外出</text></view>
      <view bindtap="onAddEvent">＋ 记录</view>
    </view>
    <view class="pet-timeline">
      <view wx:for="{{timeline}}" wx:key="id" class="timeline-row" data-id="{{item.id}}" bindtap="onOpenEvent">
        <view class="timeline-row__mark">{{item.iconText}}</view>
        <view class="timeline-row__body"><text>{{item.title}}</text><text>{{item.detailText || item.typeLabel}}</text></view>
        <view class="timeline-row__date">{{item.occurredOn}}</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{activeSection === 'care'}}">
    <view class="care-intro">
      <view class="care-intro__mark">循</view>
      <view><text>持续记录，不靠记忆</text><text>体内驱虫按 90 天、体外驱虫按 30 天生成下一次日期。</text></view>
    </view>

    <view class="pet-section-head"><view><text>内外驱周期</text><text>完成一次，自动向后推算</text></view><view bindtap="onOpenCalendar">查看月历</view></view>
    <view class="care-cycle-list">
      <view wx:for="{{careCards}}" wx:key="type" class="care-cycle care-cycle--{{item.status}}">
        <view class="care-cycle__top"><text>{{item.title}}</text><text>{{item.intervalLabel}}</text></view>
        <view class="care-cycle__status">{{item.statusLabel}}</view>
        <view class="care-cycle__meta"><text>上次：{{item.lastOn || '未记录'}}</text><text>下次：{{item.nextOn || '待记录后生成'}}</text></view>
        <button data-type="{{item.type}}" bindtap="onCompleteCare">今天完成一次</button>
      </view>
    </view>

    <view class="pet-section-head">
      <view><text>最近照护</text><text>医疗信息仅作生活记录</text></view>
      <view bindtap="onAddEvent">＋ 其他事件</view>
    </view>
    <view class="pet-timeline">
      <view wx:for="{{careTimeline}}" wx:key="id" class="timeline-row" data-id="{{item.id}}" bindtap="onOpenEvent">
        <view class="timeline-row__mark timeline-row__mark--care">{{item.iconText}}</view>
        <view class="timeline-row__body"><text>{{item.title}}</text><text>{{item.detailText || item.typeLabel}}</text></view>
        <view class="timeline-row__date">{{item.occurredOn}}</view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="pet-section-head">
      <view><text>今天吃喝拉撒</text><text>点一下，就记一条</text></view>
    </view>
    <view class="daily-grid">
      <view wx:for="{{dailySummary}}" wx:key="type" class="daily-card {{item.done ? 'daily-card--done' : ''}}" data-type="{{item.type}}" bindtap="onAddDailyLog">
        <view class="daily-card__top"><text>{{item.iconText}}</text><text>{{item.count ? item.count + ' 次' : '未记'}}</text></view>
        <view class="daily-card__title">{{item.label}}</view>
        <view class="daily-card__summary">{{item.latestSummary}}</view>
        <view class="daily-card__time">{{item.latestTime}} · ＋记录</view>
      </view>
    </view>

    <view wx:if="{{recentDailyLogs.length}}" class="daily-recent">
      <view class="daily-recent__head"><text>今天的记录</text><text>{{recentDailyLogs.length}} 条</text></view>
      <view wx:for="{{recentDailyLogs}}" wx:key="id" class="daily-log-row">
        <view class="daily-log-row__icon">{{item.iconText}}</view>
        <view class="daily-log-row__body"><text>{{item.summary}}</text><text>{{item.typeLabel}}</text></view>
        <view class="daily-log-row__time">{{item.timeLabel}}</view>
      </view>
    </view>

    <view class="pet-section-head">
      <view><text>正在吃与正在用</text><text>当前主粮、零食和猫砂配置</text></view>
      <view bindtap="onAddSupply">＋ 添加</view>
    </view>
    <view class="current-supplies">
      <view wx:for="{{currentSupplies}}" wx:key="id" class="current-supply">
        <view class="current-supply__label">{{item.categoryLabel}}</view>
        <view class="current-supply__name">{{item.name}}</view>
        <view class="current-supply__note">{{item.note || '正在使用'}}</view>
      </view>
    </view>

    <view class="pet-section-head"><view><text>用品集合</text><text>吃过、爱吃、种草与拔草</text></view></view>
    <scroll-view class="supply-filter" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="supply-filter__row">
        <view wx:for="{{supplyCategories}}" wx:key="value" class="supply-filter__item {{selectedSupplyCategory === item.value ? 'supply-filter__item--active' : ''}}" data-value="{{item.value}}" bindtap="onSelectSupplyCategory">{{item.label}}</view>
      </view>
    </scroll-view>

    <view class="supply-list">
      <view wx:for="{{supplies}}" wx:key="id" class="supply-row" data-id="{{item.id}}" bindtap="onChangeSupplyStatus">
        <view class="supply-row__icon">{{item.iconText}}</view>
        <view class="supply-row__body"><text>{{item.name}}</text><text>{{item.categoryLabel}} · {{item.note || item.recordedOn}}</text></view>
        <view class="supply-row__status supply-row__status--{{item.status}}">{{item.statusLabel}}</view>
      </view>
    </view>
    <view class="supply-tip">点击集合中的条目，可以随时改成正在用、爱吃、吃过、种草或拔草。</view>
  </block>

  <view class="demo-note">宠物档案、事件、体重与用品集合保存在当前设备。医疗内容只作生活记录，不构成诊疗建议。</view>
</view>
