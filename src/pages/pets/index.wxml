<view class="page-shell pets-page">
  <view class="pets-top">
    <view class="pets-top__main">
      <view class="pets-top__title">宠物照护</view>
      <view class="pets-top__sub">{{petTabs.length}} 位伙伴 · {{profile.name}}</view>
    </view>
    <view class="pets-add" bindtap="onAddPet">
      <line-icon name="plus" size="22" tone="white" />
      <text>添加</text>
    </view>
  </view>

  <scroll-view class="pet-tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="pet-tabs__row">
      <view class="pet-tab {{activeSection === 'profile' ? 'pet-tab--active' : ''}}" data-value="profile" bindtap="onSwitchSection">档案</view>
      <view class="pet-tab {{activeSection === 'care' ? 'pet-tab--active' : ''}}" data-value="care" bindtap="onSwitchSection">照护</view>
      <view class="pet-tab {{activeSection === 'calendar' ? 'pet-tab--active' : ''}}" data-value="calendar" bindtap="onSwitchSection">月历</view>
      <view class="pet-tab {{activeSection === 'daily' ? 'pet-tab--active' : ''}}" data-value="daily" bindtap="onSwitchSection">日常</view>
      <view class="pet-tab {{activeSection === 'supplies' ? 'pet-tab--active' : ''}}" data-value="supplies" bindtap="onSwitchSection">用品</view>
    </view>
  </scroll-view>

  <block wx:if="{{activeSection === 'profile'}}">
    <scroll-view class="pet-switcher" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="pet-switcher__row">
        <view wx:for="{{petTabs}}" wx:key="id" class="pet-switcher__item {{item.selected ? 'pet-switcher__item--active' : ''}}" data-id="{{item.id}}" bindtap="onSwitchPet">
          <view class="pet-switcher__avatar">{{item.initial}}</view>
          <text>{{item.name}}</text>
        </view>
        <view class="pet-switcher__add" bindtap="onAddPet">
          <line-icon name="plus" size="22" tone="pink" />
          <text>新伙伴</text>
        </view>
      </view>
    </scroll-view>

    <view class="pet-profile-card">
      <view class="pet-profile-card__top">
        <view class="pet-avatar pet-avatar--{{profile.species}}">
          <block wx:if="{{profile.species === 'cat'}}">
            <view class="pet-ear pet-ear--left"></view>
            <view class="pet-ear pet-ear--right"></view>
          </block>
          <text>{{profileInitial}}</text>
        </view>
        <view class="pet-profile-card__body">
          <view class="pet-profile-card__name">{{profile.name}}</view>
          <view class="pet-profile-card__meta">{{profile.breed}} · {{profile.sex === 'female' ? '女生' : '男生'}} · {{ageLabel}}</view>
          <view class="pet-profile-card__status"><text></text>{{profile.status}}</view>
        </view>
        <view class="pet-profile-card__weight"><text>{{latestWeight}}</text><text>kg</text></view>
      </view>
      <view class="pet-milestones">
        <view class="pet-milestone"><text>{{birthdayLabel}}</text><text>出生</text><view class="pet-milestone__dot pet-milestone__dot--green"></view></view>
        <view class="pet-milestone"><text>{{homeOnLabel}}</text><text>到家</text><view class="pet-milestone__dot pet-milestone__dot--gold"></view></view>
        <view class="pet-milestone"><text>{{neuteredOnLabel}}</text><text>{{profile.neuteredOn ? '绝育' : '未绝育'}}</text><view class="pet-milestone__dot pet-milestone__dot--pink"></view></view>
      </view>
    </view>

    <view class="pet-section-head">
      <text>体重变化</text>
      <view bindtap="onRecordWeight">＋ 记录</view>
    </view>
    <view class="pet-weight">
      <view class="pet-weight__chart">
        <view wx:for="{{weightPoints}}" wx:key="index" class="pet-weight__column {{item.active ? 'pet-weight__column--active' : ''}}">
          <text class="pet-weight__value">{{item.value}}</text>
          <view class="pet-weight__track">
            <view class="pet-weight__bar" style="height: {{item.height}}%;"></view>
          </view>
          <text class="pet-weight__date">{{item.dateLabel}}</text>
        </view>
      </view>
      <view class="pet-weight__hint">最近 {{weightPoints.length}} 次 · 当前 {{latestWeight}} kg · {{weightTrendLabel}}</view>
    </view>

    <view class="pet-section-head">
      <text>成长时间线</text>
      <view bindtap="onAddEvent">＋ 事件</view>
    </view>
    <view class="pet-timeline">
      <view wx:for="{{timeline}}" wx:key="id" class="pet-timeline__row" data-id="{{item.id}}" bindtap="onOpenEvent">
        <view class="pet-timeline__dot"></view>
        <view class="pet-timeline__date">{{item.occurredOn}}</view>
        <view class="pet-timeline__title">{{item.title}}</view>
        <view class="pet-timeline__copy">{{item.detailText || item.typeLabel}}</view>
      </view>
    </view>

    <view class="pet-section-head">
      <text>生活照片</text>
      <text>示例插画</text>
    </view>
    <view class="pet-visual">
      <image class="pet-visual__image" src="../../images/demo-cat-dreaming.jpg" mode="aspectFill" />
      <view class="pet-visual__caption">陪伴不是大事，是每天的小事</view>
    </view>

    <view class="pet-section-head">
      <text>基本档案</text>
      <view bindtap="onToggleProfileEditor">{{editingProfile ? '取消编辑' : '编辑档案'}}</view>
    </view>
    <view wx:if="{{editingProfile}}" class="profile-editor">
      <view class="profile-field"><text>出生日期</text><picker mode="date" value="{{profileDraft.birthday}}" bindchange="onBirthdayChange"><view>{{profileDraft.birthday || '选择日期'}} ›</view></picker></view>
      <view class="profile-field"><text>到家日期</text><picker mode="date" value="{{profileDraft.homeOn}}" bindchange="onHomeDateChange"><view>{{profileDraft.homeOn || '选择日期'}} ›</view></picker></view>
      <view class="profile-field"><text>是否绝育</text><switch checked="{{profileDraft.neuteredOn}}" color="#2c4a52" bindchange="onNeuteredToggle" /></view>
      <view wx:if="{{profileDraft.neuteredOn}}" class="profile-field"><text>绝育日期</text><picker mode="date" value="{{profileDraft.neuteredOn}}" bindchange="onNeuteredDateChange"><view>{{profileDraft.neuteredOn}} ›</view></picker></view>
      <button class="profile-editor__save" bindtap="onSaveProfile">保存档案</button>
    </view>
  </block>

  <block wx:elif="{{activeSection === 'care'}}">
    <view class="pet-intro">
      <view class="pet-intro__icon pet-intro__icon--pink"><line-icon name="heart-pulse" size="27" tone="pink" /></view>
      <view><text>持续记录，不靠记忆</text><text>体内驱虫按 90 天、体外驱虫按 30 天生成下一次日期。</text></view>
    </view>

    <view class="pet-section-head"><text>内外驱周期</text><view bindtap="onOpenCalendar">查看月历</view></view>
    <view class="care-list">
      <view wx:for="{{careCards}}" wx:key="type" class="care-card care-card--{{item.status}}">
        <view class="care-card__top"><text>{{item.title}}</text><text>{{item.intervalLabel}}</text></view>
        <view class="care-card__status">{{item.statusLabel}}</view>
        <view class="care-card__meta"><text>上次 {{item.lastOn || '未记录'}}</text><text>下次 {{item.nextOn || '待记录'}}</text></view>
        <button data-type="{{item.type}}" bindtap="onCompleteCare">今天完成一次</button>
      </view>
    </view>

    <view class="pet-section-head"><text>最近照护</text><view bindtap="onAddEvent">＋ 其他事件</view></view>
    <view class="pet-timeline">
      <view wx:for="{{careTimeline}}" wx:key="id" class="pet-timeline__row" data-id="{{item.id}}" bindtap="onOpenEvent">
        <view class="pet-timeline__dot pet-timeline__dot--pink"></view>
        <view class="pet-timeline__date">{{item.occurredOn}}</view>
        <view class="pet-timeline__title">{{item.title}}</view>
        <view class="pet-timeline__copy">{{item.detailText || item.typeLabel}}</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{activeSection === 'calendar'}}">
    <view class="pet-calendar-card">
      <view class="pet-calendar-card__eyebrow">CARE CALENDAR</view>
      <view class="pet-calendar-card__title">{{profile.name}}的照护月历</view>
      <view class="pet-calendar-card__copy">历史记录、下次计划和内外驱推算放在同一张月历里。</view>
      <view class="pet-calendar-card__stats">
        <view><text>{{careTimeline.length}}</text><text>最近照护记录</text></view>
        <view><text>{{careCards.length}}</text><text>周期提醒</text></view>
      </view>
      <view class="pet-calendar-card__button" bindtap="onOpenCalendar">打开完整月历</view>
    </view>
    <view class="pet-section-head"><text>最近的日期</text><view bindtap="onAddEvent">＋ 记录事件</view></view>
    <view class="pet-timeline">
      <view wx:for="{{careTimeline}}" wx:key="id" class="pet-timeline__row" data-id="{{item.id}}" bindtap="onOpenEvent">
        <view class="pet-timeline__dot"></view>
        <view class="pet-timeline__date">{{item.occurredOn}}</view>
        <view class="pet-timeline__title">{{item.title}}</view>
        <view class="pet-timeline__copy">{{item.detailText || item.typeLabel}}</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{activeSection === 'daily'}}">
    <view class="pet-section-head"><text>今天吃喝拉撒</text><text>点一下，就记一条</text></view>
    <view class="daily-grid">
      <view wx:for="{{dailySummary}}" wx:key="type" class="daily-card {{item.done ? 'daily-card--done' : ''}}" data-type="{{item.type}}" bindtap="onAddDailyLog">
        <view class="daily-card__top"><view class="daily-card__icon"><line-icon name="{{item.iconName}}" size="27" tone="green" /></view><text>{{item.count ? item.count + ' 次' : '未记'}}</text></view>
        <view class="daily-card__title">{{item.label}}</view>
        <view class="daily-card__summary">{{item.latestSummary}}</view>
        <view class="daily-card__time">{{item.latestTime}} · ＋记录</view>
      </view>
    </view>

    <view wx:if="{{recentDailyLogs.length}}" class="daily-recent">
      <view class="pet-section-head"><text>今天的记录</text><text>{{recentDailyLogs.length}} 条</text></view>
      <view class="daily-list">
        <view wx:for="{{recentDailyLogs}}" wx:key="id" class="daily-row">
          <view class="daily-row__icon"><line-icon name="{{item.iconName}}" size="23" tone="green" /></view>
          <view class="daily-row__body"><text>{{item.summary}}</text><text>{{item.typeLabel}}</text></view>
          <view class="daily-row__time">{{item.timeLabel}}</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="pet-section-head"><text>正在吃与正在用</text><view bindtap="onAddSupply">＋ 添加</view></view>
    <scroll-view class="current-supplies" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="current-supplies__row">
        <view wx:for="{{currentSupplies}}" wx:key="id" class="current-supply">
          <view class="current-supply__label">{{item.categoryLabel}}</view>
          <view class="current-supply__name">{{item.name}}</view>
          <view class="current-supply__note">{{item.note || '正在使用'}}</view>
        </view>
      </view>
    </scroll-view>

    <view class="pet-section-head"><text>用品集合</text><text>{{supplies.length}} 项</text></view>
    <scroll-view class="supply-filter" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="supply-filter__row">
        <view wx:for="{{supplyCategories}}" wx:key="value" class="supply-filter__item {{selectedSupplyCategory === item.value ? 'supply-filter__item--active' : ''}}" data-value="{{item.value}}" bindtap="onSelectSupplyCategory">{{item.label}}</view>
      </view>
    </scroll-view>
    <view class="supply-list">
      <view wx:for="{{supplies}}" wx:key="id" class="supply-row" data-id="{{item.id}}" bindtap="onChangeSupplyStatus">
        <view class="supply-row__icon"><line-icon name="{{item.iconName}}" size="26" tone="gold" /></view>
        <view class="supply-row__body"><text>{{item.name}}</text><text>{{item.categoryLabel}} · {{item.note || item.recordedOn}}</text></view>
        <view class="supply-row__status supply-row__status--{{item.status}}">{{item.statusLabel}}</view>
      </view>
    </view>
    <view class="supply-tip">点击条目，可以改成正在用、爱吃、吃过、种草或拔草。</view>
  </block>
  <app-tab-bar active="pets" />
</view>
