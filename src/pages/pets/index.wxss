.pets-page {
  --pet-paper: #fdfbf7;
  --pet-ink: #2e2a28;
  --pet-ink-2: #6b635c;
  --pet-ink-3: #a69e96;
  --pet-line: #ebe5da;
  --pet-deep: #2c4a52;
  --pet-pink: #d87592;
  --pet-green: #6f9f7d;
  padding: 28rpx 36rpx calc(70rpx + env(safe-area-inset-bottom));
  background: var(--pet-paper);
  color: var(--pet-ink);
}

.pets-top { display: flex; align-items: center; min-height: 88rpx; gap: 17rpx; }
.pets-back { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border: 1rpx solid var(--pet-line); border-radius: 50%; background: #fffefa; box-shadow: 0 8rpx 18rpx rgba(82, 65, 48, 0.05); font-family: Arial, sans-serif; font-size: 51rpx; font-weight: 300; line-height: 1; padding-bottom: 6rpx; }
.pets-top__main { min-width: 0; flex: 1; }
.pets-top__title { font-size: 40rpx; font-weight: 700; letter-spacing: -0.8rpx; }
.pets-top__sub { margin-top: 4rpx; color: var(--pet-ink-3); font-size: 24rpx; }
.pets-add { display: flex; height: 60rpx; align-items: center; padding: 0 20rpx; border-radius: 999rpx; background: var(--pet-deep); color: #fff; gap: 6rpx; font-size: 26rpx; font-weight: 600; }

.pet-tabs { width: calc(100% + 72rpx); margin: 22rpx -36rpx 0; border-bottom: 1rpx solid var(--pet-line); white-space: nowrap; }
.pet-tabs__row { display: inline-flex; padding: 0 36rpx; gap: 42rpx; }
.pet-tab { position: relative; padding: 11rpx 0 18rpx; color: var(--pet-ink-3); font-size: 27rpx; white-space: nowrap; }
.pet-tab--active { color: var(--pet-ink); font-weight: 700; }
.pet-tab--active::after { position: absolute; right: 0; bottom: -1rpx; left: 0; height: 4rpx; border-radius: 4rpx; background: var(--pet-deep); content: ""; }

.pet-switcher { width: calc(100% + 72rpx); margin: 24rpx 0 0 -36rpx; white-space: nowrap; }
.pet-switcher__row { display: inline-flex; align-items: flex-start; padding: 0 36rpx 5rpx; gap: 25rpx; }
.pet-switcher__item { display: flex; width: 84rpx; align-items: center; flex-direction: column; gap: 7rpx; color: var(--pet-ink-3); font-size: 23rpx; }
.pet-switcher__avatar { display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border: 3rpx solid transparent; border-radius: 50%; background: #fcedf0; color: var(--pet-pink); font-size: 29rpx; font-weight: 700; }
.pet-switcher__item--active .pet-switcher__avatar { border-color: var(--pet-pink); background: #fffefa; box-shadow: 0 0 0 4rpx #fcedf0; }
.pet-switcher__item--active { color: var(--pet-ink); font-weight: 700; }
.pet-switcher__add { display: flex; width: 84rpx; align-items: center; flex-direction: column; gap: 8rpx; color: var(--pet-ink-3); font-size: 22rpx; }

.pet-profile-card { margin-top: 22rpx; padding: 24rpx 23rpx 20rpx; border: 1rpx solid var(--pet-line); border-radius: 30rpx; background: #fffefa; box-shadow: 0 10rpx 28rpx rgba(82, 65, 48, 0.04); }
.pet-profile-card__top { display: flex; align-items: center; gap: 17rpx; }
.pet-avatar { position: relative; display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; border-radius: 25rpx; background: #fcedf0; color: var(--pet-pink); flex-shrink: 0; font-size: 35rpx; font-weight: 700; }
.pet-ear { position: absolute; top: -8rpx; width: 25rpx; height: 30rpx; background: #fcedf0; transform: rotate(45deg); }
.pet-ear--left { left: 9rpx; border-radius: 8rpx 3rpx 8rpx 3rpx; }
.pet-ear--right { right: 9rpx; border-radius: 3rpx 8rpx 3rpx 8rpx; transform: rotate(-45deg); }
.pet-profile-card__body { min-width: 0; flex: 1; }
.pet-profile-card__name { font-size: 36rpx; font-weight: 700; letter-spacing: -0.6rpx; }
.pet-profile-card__meta { margin-top: 4rpx; color: var(--pet-ink-3); font-size: 23rpx; }
.pet-profile-card__status { display: flex; align-items: center; margin-top: 8rpx; color: var(--pet-green); font-size: 23rpx; gap: 7rpx; }
.pet-profile-card__status text { width: 9rpx; height: 9rpx; border-radius: 50%; background: var(--pet-green); }
.pet-profile-card__weight { display: flex; align-items: baseline; flex-shrink: 0; color: var(--pet-pink); gap: 3rpx; }
.pet-profile-card__weight text:first-child { font-family: "Helvetica Neue", Arial, sans-serif; font-size: 45rpx; font-weight: 700; letter-spacing: -1rpx; }
.pet-profile-card__weight text:last-child { color: var(--pet-ink-3); font-size: 22rpx; }

.pet-milestones { display: flex; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid var(--pet-line); }
.pet-milestone { position: relative; display: flex; flex: 1; align-items: center; flex-direction: column; gap: 4rpx; }
.pet-milestone text:first-child { font-family: "Helvetica Neue", Arial, sans-serif; font-size: 29rpx; font-weight: 700; }
.pet-milestone text:nth-child(2) { color: var(--pet-ink-3); font-size: 21rpx; }
.pet-milestone__dot { position: absolute; top: -25rpx; width: 7rpx; height: 7rpx; border-radius: 50%; }
.pet-milestone__dot--green { background: var(--pet-green); }
.pet-milestone__dot--gold { background: #c28b23; }
.pet-milestone__dot--pink { background: var(--pet-pink); }

.pet-section-head { display: flex; align-items: baseline; justify-content: space-between; margin: 33rpx 4rpx 13rpx; }
.pet-section-head > text:first-child { font-size: 33rpx; font-weight: 700; letter-spacing: -0.5rpx; }
.pet-section-head > text:last-child, .pet-section-head > view { color: var(--pet-ink-3); font-size: 23rpx; }
.pet-section-head > view { color: var(--pet-deep); font-weight: 600; }

.pet-weight { padding: 20rpx 21rpx 16rpx; border: 1rpx solid var(--pet-line); border-radius: 30rpx; background: #fffefa; }
.pet-weight__chart { display: flex; height: 176rpx; align-items: flex-end; gap: 24rpx; }
.pet-weight__column { display: flex; height: 100%; min-width: 0; align-items: center; flex: 1; flex-direction: column; gap: 7rpx; }
.pet-weight__value { color: var(--pet-ink-2); font-family: "Helvetica Neue", Arial, sans-serif; font-size: 22rpx; font-weight: 600; }
.pet-weight__column--active .pet-weight__value { color: var(--pet-pink); }
.pet-weight__track { display: flex; width: 52rpx; min-height: 0; align-items: flex-end; flex: 1; border-radius: 999rpx; background: #fbf3f4; }
.pet-weight__bar { width: 100%; min-height: 14rpx; border-radius: 999rpx; background: linear-gradient(180deg, #f3a9bb, #f9d5dd); }
.pet-weight__column--active .pet-weight__bar { background: linear-gradient(180deg, #d87592, #f3a9bb); }
.pet-weight__date { color: var(--pet-ink-3); font-size: 20rpx; }
.pet-weight__hint { margin-top: 11rpx; padding-top: 12rpx; border-top: 1rpx solid var(--pet-line); color: var(--pet-ink-3); font-size: 22rpx; text-align: center; }

.pet-timeline { position: relative; padding-left: 29rpx; }
.pet-timeline::before { position: absolute; top: 8rpx; bottom: 12rpx; left: 6rpx; width: 2rpx; background: var(--pet-line); content: ""; }
.pet-timeline__row { position: relative; padding: 0 0 24rpx 6rpx; }
.pet-timeline__row:last-child { padding-bottom: 0; }
.pet-timeline__dot { position: absolute; top: 7rpx; left: -29rpx; width: 14rpx; height: 14rpx; border: 3rpx solid #fffefa; border-radius: 50%; background: var(--pet-green); box-shadow: 0 0 0 2rpx #eef5ef; }
.pet-timeline__dot--pink { background: var(--pet-pink); box-shadow: 0 0 0 2rpx #fcedf0; }
.pet-timeline__date { color: var(--pet-ink-3); font-size: 22rpx; }
.pet-timeline__title { margin-top: 3rpx; font-size: 28rpx; font-weight: 700; }
.pet-timeline__copy { margin-top: 3rpx; color: var(--pet-ink-2); font-size: 24rpx; line-height: 1.65; }

.pet-visual { position: relative; height: 290rpx; overflow: hidden; border-radius: 30rpx; }
.pet-visual__image { width: 100%; height: 100%; }
.pet-visual__caption { position: absolute; right: 0; bottom: 0; left: 0; padding: 38rpx 22rpx 19rpx; background: linear-gradient(180deg, transparent, rgba(33, 29, 27, 0.62)); color: #fff; font-size: 26rpx; font-weight: 600; }

.profile-editor { padding: 18rpx 21rpx 22rpx; border: 1rpx solid var(--pet-line); border-radius: 30rpx; background: #fffefa; }
.profile-field { display: flex; min-height: 75rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--pet-line); font-size: 26rpx; }
.profile-field:last-of-type { border-bottom: 0; }
.profile-field picker { color: var(--pet-ink-2); }
.profile-editor__save { height: 68rpx; margin-top: 16rpx; border: 0; border-radius: 999rpx; background: var(--pet-deep); color: #fff; font-size: 26rpx; font-weight: 700; line-height: 68rpx; }

.pet-intro { display: flex; align-items: center; margin-top: 24rpx; padding: 20rpx; border-radius: 26rpx; background: #fcedf0; gap: 14rpx; }
.pet-intro__icon { display: flex; width: 56rpx; height: 56rpx; align-items: center; justify-content: center; border-radius: 18rpx; background: rgba(255, 255, 255, 0.7); flex-shrink: 0; }
.pet-intro > view:last-child { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 3rpx; }
.pet-intro > view:last-child text:first-child { font-size: 26rpx; font-weight: 700; }
.pet-intro > view:last-child text:last-child { color: var(--pet-ink-2); font-size: 22rpx; line-height: 1.5; }

.care-list { display: flex; flex-direction: column; gap: 13rpx; }
.care-card { padding: 20rpx 21rpx; border: 1rpx solid var(--pet-line); border-radius: 27rpx; background: #fffefa; }
.care-card--overdue { background: #fcebee; }
.care-card--due-soon { background: #fbf3e1; }
.care-card__top { display: flex; align-items: center; justify-content: space-between; }
.care-card__top text:first-child { font-size: 28rpx; font-weight: 700; }
.care-card__top text:last-child { color: var(--pet-ink-3); font-size: 22rpx; }
.care-card__status { margin-top: 7rpx; color: var(--pet-pink); font-size: 24rpx; font-weight: 600; }
.care-card__meta { display: flex; margin-top: 9rpx; color: var(--pet-ink-2); font-size: 22rpx; gap: 19rpx; }
.care-card button { height: 58rpx; margin-top: 15rpx; border: 0; border-radius: 999rpx; background: var(--pet-deep); color: #fff; font-size: 24rpx; font-weight: 600; line-height: 58rpx; }

.pet-calendar-card { margin-top: 24rpx; padding: 27rpx 24rpx; border-radius: 30rpx; background: #eaf1f7; }
.pet-calendar-card__eyebrow { color: #4b7fa7; font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx; }
.pet-calendar-card__title { margin-top: 8rpx; font-size: 36rpx; font-weight: 700; }
.pet-calendar-card__copy { margin-top: 7rpx; color: var(--pet-ink-2); font-size: 24rpx; line-height: 1.65; }
.pet-calendar-card__stats { display: flex; margin-top: 22rpx; }
.pet-calendar-card__stats view { display: flex; flex: 1; flex-direction: column; gap: 3rpx; }
.pet-calendar-card__stats text:first-child { color: #4b7fa7; font-family: "Helvetica Neue", Arial, sans-serif; font-size: 38rpx; font-weight: 700; }
.pet-calendar-card__stats text:last-child { color: var(--pet-ink-3); font-size: 22rpx; }
.pet-calendar-card__button { display: flex; height: 66rpx; align-items: center; justify-content: center; margin-top: 22rpx; border-radius: 999rpx; background: var(--pet-deep); color: #fff; font-size: 26rpx; font-weight: 700; }

.daily-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.daily-card { padding: 18rpx; border: 1rpx solid var(--pet-line); border-radius: 26rpx; background: #fffefa; }
.daily-card--done { background: #eef5ef; }
.daily-card__top { display: flex; align-items: center; justify-content: space-between; }
.daily-card__icon { display: flex; width: 49rpx; height: 49rpx; align-items: center; justify-content: center; border-radius: 16rpx; background: #eef5ef; }
.daily-card__top > text { color: var(--pet-ink-3); font-size: 21rpx; }
.daily-card__title { margin-top: 10rpx; font-size: 27rpx; font-weight: 700; }
.daily-card__summary { overflow: hidden; margin-top: 4rpx; color: var(--pet-ink-2); font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.daily-card__time { margin-top: 8rpx; color: var(--pet-green); font-size: 21rpx; }
.daily-recent { margin-top: 2rpx; }
.daily-list { overflow: hidden; border: 1rpx solid var(--pet-line); border-radius: 27rpx; background: #fffefa; }
.daily-row { display: flex; min-height: 77rpx; align-items: center; padding: 0 18rpx; border-bottom: 1rpx solid var(--pet-line); gap: 12rpx; }
.daily-row:last-child { border-bottom: 0; }
.daily-row__icon { display: flex; width: 46rpx; height: 46rpx; align-items: center; justify-content: center; border-radius: 15rpx; background: #eef5ef; }
.daily-row__body { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.daily-row__body text:first-child { overflow: hidden; font-size: 25rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.daily-row__body text:last-child { margin-top: 2rpx; color: var(--pet-ink-3); font-size: 21rpx; }
.daily-row__time { color: var(--pet-ink-3); font-size: 21rpx; }

.current-supplies { width: calc(100% + 72rpx); margin-left: -36rpx; white-space: nowrap; }
.current-supplies__row { display: inline-flex; padding: 0 36rpx 5rpx; gap: 12rpx; }
.current-supply { width: 196rpx; padding: 18rpx; border: 1rpx solid var(--pet-line); border-radius: 24rpx; background: #fffefa; white-space: normal; }
.current-supply__label { color: var(--pet-ink-3); font-size: 21rpx; }
.current-supply__name { overflow: hidden; margin-top: 6rpx; font-size: 26rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.current-supply__note { overflow: hidden; margin-top: 3rpx; color: var(--pet-ink-2); font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.supply-filter { width: calc(100% + 72rpx); margin-left: -36rpx; white-space: nowrap; }
.supply-filter__row { display: inline-flex; padding: 0 36rpx 5rpx; gap: 10rpx; }
.supply-filter__item { display: flex; height: 52rpx; align-items: center; padding: 0 18rpx; border: 1rpx solid var(--pet-line); border-radius: 999rpx; background: #fffefa; color: var(--pet-ink-2); font-size: 23rpx; }
.supply-filter__item--active { border-color: #2e2a28; background: #2e2a28; color: #fff; font-weight: 600; }
.supply-list { overflow: hidden; margin-top: 14rpx; border: 1rpx solid var(--pet-line); border-radius: 27rpx; background: #fffefa; }
.supply-row { display: flex; min-height: 82rpx; align-items: center; padding: 0 18rpx; border-bottom: 1rpx solid var(--pet-line); gap: 12rpx; }
.supply-row:last-child { border-bottom: 0; }
.supply-row__icon { display: flex; width: 50rpx; height: 50rpx; align-items: center; justify-content: center; border-radius: 16rpx; background: #fbf3e1; }
.supply-row__body { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.supply-row__body text:first-child { font-size: 26rpx; font-weight: 600; }
.supply-row__body text:last-child { margin-top: 2rpx; color: var(--pet-ink-3); font-size: 21rpx; }
.supply-row__status { padding: 7rpx 10rpx; border-radius: 999rpx; background: #f6f1e9; color: var(--pet-ink-3); font-size: 20rpx; }
.supply-row__status--current { background: #eef5ef; color: var(--pet-green); }
.supply-row__status--loved { background: #fcedf0; color: var(--pet-pink); }
.supply-tip { margin: 16rpx 8rpx 0; color: var(--pet-ink-3); font-size: 21rpx; line-height: 1.6; text-align: center; }
