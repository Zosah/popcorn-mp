.pets-page {
  padding-bottom: calc(90rpx + env(safe-area-inset-bottom));
}

.pets-head {
  padding: 8rpx 0 30rpx;
}

.pets-head__title {
  color: var(--c-text, #22242e);
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: -2rpx;
}

.pets-head__copy {
  max-width: 620rpx;
  margin-top: 12rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 24rpx;
  line-height: 1.65;
}

.pet-switcher {
  width: calc(100% + 48rpx);
  margin: 0 0 22rpx;
  white-space: nowrap;
}

.pet-switcher__row {
  display: inline-flex;
  align-items: stretch;
  gap: 0;
  padding: 0 48rpx 0 0;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.pet-switcher__item,
.pet-switcher__add {
  position: relative;
  display: flex;
  width: 176rpx;
  min-height: 78rpx;
  padding: 12rpx 18rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: center;
}

.pet-switcher__item--active::after {
  position: absolute;
  right: 18rpx;
  bottom: -1rpx;
  left: 18rpx;
  height: 1rpx;
  background: var(--c-text, #22242e);
  content: "";
}

.pet-switcher__item > view {
  display: none;
}

.pet-switcher__item > text:nth-child(2) {
  color: var(--c-muted, #9497a6);
  font-size: 23rpx;
  font-weight: 400;
}

.pet-switcher__item--active > text:nth-child(2) {
  color: var(--c-text, #22242e);
  font-weight: 500;
}

.pet-switcher__item > text:last-child {
  margin-top: 4rpx;
  color: var(--c-muted, #9497a6);
  font-size: 19rpx;
}

.pet-switcher__add {
  border-left: 1rpx solid var(--c-line, #e7e6ee);
  align-items: center;
  flex-direction: row;
  gap: 8rpx;
}

.pet-switcher__add > text:last-child {
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
  font-weight: 400;
}

.pet-profile {
  display: flex;
  align-items: center;
  min-height: 132rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
  border-radius: 0;
  background: transparent;
}

.pet-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-radius: 50%;
  background: transparent;
  color: var(--c-accent, #5b6ee0);
  flex-shrink: 0;
  font-family: "Songti SC", "STSong", serif;
  font-size: 29rpx;
  font-weight: 400;
}

.pet-avatar--dog,
.pet-avatar--other {
  background: transparent;
}

.pet-ear {
  display: none;
}

.pet-avatar text {
  position: relative;
  z-index: 1;
}

.pet-profile__body {
  min-width: 0;
  flex: 1;
  margin-left: 22rpx;
}

.pet-profile__body text {
  display: block;
  color: var(--c-text, #22242e);
  font-size: 30rpx;
  font-weight: 500;
}

.pet-profile__body text + text {
  margin-top: 6rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
  font-weight: 400;
}

.pet-profile__status {
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: var(--c-success, #4fa87d);
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 400;
}

.pet-visual {
  display: flex;
  align-items: stretch;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.pet-visual__image {
  display: block;
  width: 292rpx;
  height: 224rpx;
  background: var(--c-primary-soft, #eaedfc);
  flex-shrink: 0;
}

.pet-visual__caption {
  display: flex;
  min-width: 0;
  padding: 6rpx 0 4rpx;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
}

.pet-visual__caption text:first-child {
  color: var(--c-text, #22242e);
  font-family: "Songti SC", "STSong", serif;
  font-size: 29rpx;
  letter-spacing: -1rpx;
  line-height: 1.5;
}

.pet-visual__caption text:last-child {
  color: var(--c-muted, #9497a6);
  font-size: 18rpx;
  letter-spacing: 1rpx;
  line-height: 1.55;
}

.pet-sections {
  grid-template-columns: 1fr 1fr 1.3fr;
  margin-top: 24rpx;
}

.pet-sections .segmented__item {
  height: 68rpx;
  gap: 7rpx;
  font-size: 22rpx;
}

.pet-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 42rpx;
  padding: 0 0 14rpx;
}

.pet-section-head view:first-child text {
  display: block;
  color: var(--c-text, #22242e);
  font-size: 27rpx;
  font-weight: 500;
}

.pet-section-head view:first-child text + text {
  margin-top: 5rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
  font-weight: 400;
}

.pet-section-head > view:last-child:not(:first-child) {
  display: flex;
  align-items: center;
  gap: 6rpx;
  border-bottom: 1rpx solid var(--c-text, #22242e);
  color: var(--c-text, #22242e);
  font-size: 21rpx;
  font-weight: 400;
  line-height: 1.8;
}

.milestone-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.milestone {
  display: flex;
  align-items: center;
  min-height: 94rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  flex-direction: column;
  justify-content: center;
}

.milestone + .milestone {
  border-left: 1rpx solid var(--c-line, #e7e6ee);
}

.milestone text:first-child {
  color: var(--c-text, #22242e);
  font-family: "Songti SC", "STSong", serif;
  font-size: 28rpx;
  font-weight: 400;
}

.milestone text:last-child {
  margin-top: 6rpx;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
  font-weight: 400;
}

.milestone--warm,
.milestone--blue,
.milestone--mint {
  border-top: 0;
}

.profile-editor {
  margin-top: 18rpx;
  padding: 0;
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
  border-radius: 0;
  background: transparent;
}

.profile-field {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.profile-field > text {
  color: var(--c-muted, #9497a6);
  font-size: 22rpx;
}

.profile-field picker {
  margin-left: auto;
  color: var(--c-text, #22242e);
  font-size: 22rpx;
}

.profile-field switch {
  margin-left: auto;
  transform: scale(0.78);
  transform-origin: right center;
}

.profile-editor__save {
  width: 100%;
  min-height: 76rpx;
  margin: 20rpx 0;
  font-size: 23rpx;
}

.weight-card {
  display: flex;
  align-items: flex-end;
  min-height: 164rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
  border-radius: 0;
  background: transparent;
}

.weight-card__value {
  width: 128rpx;
}

.weight-card__value text:first-child {
  color: var(--c-accent, #5b6ee0);
  font-family: "Songti SC", "STSong", serif;
  font-size: 48rpx;
  font-weight: 400;
}

.weight-card__value text:last-child {
  margin-left: 6rpx;
  color: var(--c-muted, #9497a6);
  font-size: 19rpx;
}

.weight-chart {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  height: 104rpx;
  flex: 1;
}

.weight-chart view {
  display: flex;
  align-items: flex-end;
  height: 100%;
  flex: 1;
}

.weight-chart text {
  display: block;
  width: 100%;
  border-radius: 0;
  background: var(--c-line-strong, #d6d5e0);
}

.weight-card__hint {
  margin-left: 14rpx;
  color: var(--c-muted, #9497a6);
  font-size: 18rpx;
  writing-mode: vertical-rl;
}

.pet-timeline {
  overflow: hidden;
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.timeline-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 0;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.timeline-row:last-child {
  border-bottom: 0;
}

.timeline-row__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--c-accent, #5b6ee0);
  flex-shrink: 0;
}

.timeline-row__mark--care {
  background: transparent;
  color: var(--c-success, #4fa87d);
}

.timeline-row__body {
  min-width: 0;
  flex: 1;
}

.timeline-row__body text {
  display: block;
  overflow: hidden;
  color: var(--c-text, #22242e);
  font-size: 23rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timeline-row__body text + text {
  margin-top: 5rpx;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
  font-weight: 400;
}

.timeline-row__date {
  color: var(--c-muted, #9497a6);
  flex-shrink: 0;
  font-size: 19rpx;
}

.care-intro {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 28rpx;
  padding: 4rpx 0 4rpx 18rpx;
  border-left: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-radius: 0;
  background: transparent;
}

.care-intro__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-radius: 50%;
  background: transparent;
  color: var(--c-text-2, #5c5f6e);
  flex-shrink: 0;
  font-family: "Songti SC", "STSong", serif;
  font-size: 16rpx;
}

.care-intro text {
  display: block;
  color: var(--c-text, #22242e);
  font-size: 23rpx;
  font-weight: 500;
}

.care-intro text + text {
  margin-top: 6rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
  font-weight: 400;
  line-height: 1.6;
}

.care-cycle-list {
  display: block;
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.care-cycle {
  padding: 24rpx 0;
  border: 0;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
  border-radius: 0;
  background: transparent;
}

.care-cycle:last-child {
  border-bottom: 0;
}

.care-cycle__top {
  display: flex;
  justify-content: space-between;
}

.care-cycle__top text:first-child {
  color: var(--c-text, #22242e);
  font-size: 26rpx;
  font-weight: 500;
}

.care-cycle__top text:last-child {
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
}

.care-cycle__status {
  margin-top: 12rpx;
  color: var(--c-success, #4fa87d);
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 400;
}

.care-cycle--due-soon .care-cycle__status {
  color: var(--c-warning, #e0a038);
}

.care-cycle--overdue .care-cycle__status {
  color: var(--c-danger, #e8695c);
}

.care-cycle--unrecorded .care-cycle__status {
  color: var(--c-muted, #9497a6);
}

.care-cycle__meta {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
}

.care-cycle button {
  width: auto;
  min-height: 62rpx;
  margin: 16rpx 0 0;
  padding: 0 24rpx;
  border: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-radius: 999rpx;
  background: transparent;
  color: var(--c-text, #22242e);
  font-size: 21rpx;
  font-weight: 400;
  line-height: 62rpx;
}

.daily-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.daily-card {
  min-height: 184rpx;
  padding: 22rpx 20rpx 22rpx 0;
  border: 0;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
  border-radius: 0;
  background: transparent;
  box-sizing: border-box;
}

.daily-card:nth-child(even) {
  padding-right: 0;
  padding-left: 20rpx;
  border-left: 1rpx solid var(--c-line, #e7e6ee);
}

.daily-card:nth-last-child(-n + 2) {
  border-bottom: 0;
}

.daily-card--done {
  border-color: var(--c-line, #e7e6ee);
  background: transparent;
}

.daily-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.daily-card__icon {
  display: flex;
  width: 28rpx;
  height: 28rpx;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.daily-card__top > text {
  color: var(--c-muted, #9497a6);
  font-size: 18rpx;
}

.daily-card__top > text:last-child {
  color: var(--c-muted, #9497a6);
  font-size: 18rpx;
}

.daily-card__title {
  margin-top: 12rpx;
  color: var(--c-text, #22242e);
  font-size: 24rpx;
  font-weight: 500;
}

.daily-card__summary {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--c-text-2, #5c5f6e);
  font-size: 20rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.daily-card__time {
  margin-top: 11rpx;
  color: var(--c-muted, #9497a6);
  font-size: 19rpx;
}

.daily-recent {
  margin-top: 18rpx;
  overflow: hidden;
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
  border-radius: 0;
  background: transparent;
}

.daily-recent__head {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0 10rpx;
  color: var(--c-text, #22242e);
  font-size: 21rpx;
  font-weight: 500;
}

.daily-recent__head text:last-child {
  color: var(--c-muted, #9497a6);
  font-size: 19rpx;
  font-weight: 400;
}

.daily-log-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 84rpx;
  padding: 0;
  border-top: 1rpx solid var(--c-line, #e7e6ee);
}

.daily-log-row__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border-radius: 0;
  background: transparent;
  color: var(--c-success, #4fa87d);
  flex-shrink: 0;
  font-family: "Songti SC", "STSong", serif;
  font-size: 16rpx;
}

.daily-log-row__body {
  min-width: 0;
  flex: 1;
}

.daily-log-row__body text {
  display: block;
  overflow: hidden;
  color: var(--c-text, #22242e);
  font-size: 21rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.daily-log-row__body text + text {
  margin-top: 3rpx;
  color: var(--c-muted, #9497a6);
  font-size: 18rpx;
  font-weight: 400;
}

.daily-log-row__time {
  color: var(--c-muted, #9497a6);
  flex-shrink: 0;
  font-size: 18rpx;
}

.current-supplies {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.current-supply {
  min-height: 146rpx;
  padding: 22rpx 20rpx 22rpx 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-sizing: border-box;
}

.current-supply:nth-child(2) {
  padding-right: 0;
  padding-left: 20rpx;
  border-left: 1rpx solid var(--c-line, #e7e6ee);
  background: transparent;
}

.current-supply__label {
  color: var(--c-muted, #9497a6);
  font-size: 19rpx;
}

.current-supply__name {
  margin-top: 10rpx;
  color: var(--c-text, #22242e);
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.4;
}

.current-supply__note {
  margin-top: 7rpx;
  color: var(--c-muted, #9497a6);
  font-size: 19rpx;
  line-height: 1.5;
}

.supply-filter {
  width: 100%;
  white-space: nowrap;
}

.supply-filter__row {
  display: inline-flex;
  gap: 26rpx;
  padding: 0 0 14rpx;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.supply-filter__item {
  position: relative;
  padding: 0 0 10rpx;
  border-radius: 0;
  background: transparent;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.supply-filter__item--active {
  background: transparent;
  color: var(--c-text, #22242e);
  font-weight: 500;
}

.supply-filter__item--active::after {
  position: absolute;
  right: 0;
  bottom: -15rpx;
  left: 0;
  height: 1rpx;
  background: var(--c-text, #22242e);
  content: "";
}

.supply-list {
  overflow: hidden;
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
  border-radius: 0;
  background: transparent;
}

.supply-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 106rpx;
  padding: 0;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.supply-row:last-child {
  border-bottom: 0;
}

.supply-row__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 0;
  background: transparent;
  color: var(--c-accent, #5b6ee0);
  flex-shrink: 0;
  font-family: "Songti SC", "STSong", serif;
  font-size: 17rpx;
  font-weight: 400;
}

.supply-row__body {
  min-width: 0;
  flex: 1;
}

.supply-row__body text {
  display: block;
  overflow: hidden;
  color: var(--c-text, #22242e);
  font-size: 23rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.supply-row__body text + text {
  margin-top: 5rpx;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
  font-weight: 400;
}

.supply-row__status {
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: var(--c-muted, #9497a6);
  flex-shrink: 0;
  font-size: 19rpx;
}

.supply-row__status--current {
  background: transparent;
  color: var(--c-success, #4fa87d);
}

.supply-row__status--loved {
  background: transparent;
  color: var(--c-accent, #5b6ee0);
}

.supply-row__status--wishlist {
  background: transparent;
  color: var(--c-warning, #e0a038);
}

.supply-row__status--dropped {
  background: transparent;
  color: var(--c-muted, #9497a6);
}

.supply-tip {
  margin-top: 16rpx;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
  line-height: 1.6;
}

.demo-note {
  margin-top: 32rpx;
  padding: 18rpx 0 0 18rpx;
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  border-left: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-radius: 0;
  background: transparent;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
