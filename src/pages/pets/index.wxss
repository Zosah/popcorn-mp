.pets-page { padding-bottom: calc(70rpx + env(safe-area-inset-bottom)); }
.pets-head { padding: 8rpx 6rpx 28rpx; }
.pets-head__meta { color: #23ba83; font-size: 18rpx; font-weight: 800; letter-spacing: 1rpx; }
.pets-head__title { margin-top: 11rpx; color: #18255f; font-size: 50rpx; font-weight: 850; }
.pets-head__copy { width: 94%; margin-top: 12rpx; color: #929bc0; font-size: 22rpx; line-height: 1.6; }

.pet-switcher { width: calc(100% + 30rpx); margin: 0 0 18rpx; white-space: nowrap; }
.pet-switcher__row { display: inline-flex; align-items: stretch; gap: 12rpx; padding: 2rpx 30rpx 12rpx 0; }
.pet-switcher__item, .pet-switcher__add { display: grid; grid-template-columns: 54rpx auto; grid-template-rows: 28rpx 25rpx; column-gap: 12rpx; width: 188rpx; min-height: 82rpx; padding: 14rpx 17rpx; border: 2rpx solid transparent; border-radius: 28rpx; background: #fff; box-sizing: border-box; }
.pet-switcher__item--active { border-color: #79a0f1; background: #f5f7ff; box-shadow: 0 8rpx 20rpx rgba(79, 100, 174, 0.1); }
.pet-switcher__item > view, .pet-switcher__add > text:first-child { display: flex; grid-row: 1 / 3; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 19rpx; background: #eaf9f2; color: #22b980; font-size: 19rpx; font-weight: 850; }
.pet-switcher__item > text:nth-child(2) { color: #26336b; font-size: 21rpx; font-weight: 800; }
.pet-switcher__item > text:last-child { color: #9aa3c2; font-size: 15rpx; }
.pet-switcher__add { border: 2rpx dashed #d6dcec; background: transparent; }
.pet-switcher__add > text:first-child { background: #eef2ff; color: #6684dd; font-size: 25rpx; }
.pet-switcher__add > text:last-child { grid-row: 1 / 3; align-self: center; color: #7182b5; font-size: 18rpx; font-weight: 750; }

.pet-profile { display: flex; align-items: center; min-height: 154rpx; padding: 0 24rpx; border-radius: 40rpx; background: #fff; box-shadow: 0 16rpx 36rpx rgba(58, 72, 128, 0.08); }
.pet-avatar { position: relative; display: flex; align-items: center; justify-content: center; width: 88rpx; height: 78rpx; border-radius: 32rpx; background: #27ca90; color: #fff; font-size: 29rpx; font-weight: 850; }
.pet-avatar--dog { background: #ff956f; }
.pet-avatar--other { background: #7d91e2; }
.pet-ear { position: absolute; top: -12rpx; width: 34rpx; height: 34rpx; border-radius: 10rpx 24rpx 8rpx 24rpx; background: #27ca90; transform: rotate(35deg); }
.pet-ear--left { left: 5rpx; }
.pet-ear--right { right: 5rpx; transform: scaleX(-1) rotate(35deg); }
.pet-avatar text { position: relative; z-index: 1; }
.pet-profile__body { min-width: 0; flex: 1; margin-left: 20rpx; }
.pet-profile__body text { display: block; color: #253269; font-size: 28rpx; font-weight: 800; }
.pet-profile__body text + text { margin-top: 7rpx; color: #99a2c3; font-size: 18rpx; font-weight: 500; }
.pet-profile__status { padding: 8rpx 13rpx; border-radius: 16rpx; background: #eafaf3; color: #20b77f; font-size: 17rpx; font-weight: 750; }

.pet-sections { display: grid; grid-template-columns: 1fr 1fr 1.35fr; gap: 8rpx; margin-top: 24rpx; padding: 8rpx; border-radius: 28rpx; background: #e9edf7; }
.pet-sections__item { display: flex; align-items: center; justify-content: center; height: 70rpx; border-radius: 21rpx; color: #8e97b8; font-size: 21rpx; font-weight: 750; transition: background-color 160ms ease, color 160ms ease; }
.pet-sections__item--active { background: #fff; color: #5e7dd7; box-shadow: 0 7rpx 18rpx rgba(74, 88, 145, 0.09); }

.pet-section-head { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 40rpx; padding: 0 6rpx 15rpx; }
.pet-section-head view:first-child text { display: block; color: #1e2b63; font-size: 30rpx; font-weight: 800; }
.pet-section-head view:first-child text + text { margin-top: 5rpx; color: #9aa3c4; font-size: 18rpx; font-weight: 500; }
.pet-section-head > view:last-child:not(:first-child) { color: #6683dd; font-size: 21rpx; font-weight: 750; }

.milestone-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.milestone { display: flex; align-items: center; min-height: 118rpx; border-radius: 30rpx; flex-direction: column; justify-content: center; }
.milestone text:first-child { color: #d7654f; font-size: 26rpx; font-weight: 850; }
.milestone text:last-child { margin-top: 7rpx; color: #a67770; font-size: 17rpx; font-weight: 650; }
.milestone--warm { background: #fff0eb; }
.milestone--blue { background: #edf2ff; }
.milestone--blue text:first-child { color: #6684dd; }
.milestone--blue text:last-child { color: #8798c8; }
.milestone--mint { background: #eaf9f2; }
.milestone--mint text:first-child { color: #22b980; }
.milestone--mint text:last-child { color: #79a497; }

.profile-editor { margin-top: 15rpx; padding: 12rpx 24rpx 24rpx; border-radius: 34rpx; background: #fff; }
.profile-field { display: flex; align-items: center; min-height: 92rpx; border-bottom: 1rpx solid #eef0f7; }
.profile-field > text { color: #27346b; font-size: 22rpx; font-weight: 750; }
.profile-field picker { margin-left: auto; color: #7582aa; font-size: 21rpx; }
.profile-field switch { margin-left: auto; transform: scale(0.82); transform-origin: right center; }
.profile-editor__save { width: 100%; min-height: 78rpx; margin-top: 20rpx; font-size: 24rpx; }

.weight-card { display: flex; align-items: flex-end; min-height: 158rpx; padding: 24rpx 26rpx; border-radius: 36rpx; background: #fff; }
.weight-card__value { width: 132rpx; }
.weight-card__value text:first-child { color: #18255f; font-size: 48rpx; font-weight: 850; }
.weight-card__value text:last-child { margin-left: 6rpx; color: #9aa3c4; font-size: 18rpx; font-weight: 700; }
.weight-chart { display: flex; align-items: flex-end; gap: 12rpx; height: 100rpx; flex: 1; }
.weight-chart view { display: flex; align-items: flex-end; height: 100%; flex: 1; }
.weight-chart text { display: block; width: 100%; border-radius: 13rpx 13rpx 6rpx 6rpx; background: linear-gradient(#80a4f1, #dce5ff); }
.weight-card__hint { margin-left: 14rpx; color: #a0a8c5; font-size: 15rpx; writing-mode: vertical-rl; }

.pet-timeline { overflow: hidden; border-radius: 36rpx; background: #fff; }
.timeline-row { display: flex; align-items: center; gap: 15rpx; min-height: 108rpx; padding: 0 20rpx; border-bottom: 1rpx solid #eef0f7; }
.timeline-row:last-child { border-bottom: 0; }
.timeline-row__mark { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 20rpx; background: #fff0ea; color: #ef7958; flex-shrink: 0; font-size: 20rpx; font-weight: 850; }
.timeline-row__mark--care { background: #eaf9f2; color: #22b980; }
.timeline-row__body { min-width: 0; flex: 1; }
.timeline-row__body text { display: block; overflow: hidden; color: #27346b; font-size: 23rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.timeline-row__body text + text { margin-top: 5rpx; color: #9ba4c5; font-size: 17rpx; font-weight: 500; }
.timeline-row__date { color: #9ba4c3; flex-shrink: 0; font-size: 16rpx; }

.care-intro { display: flex; align-items: center; gap: 17rpx; margin-top: 28rpx; padding: 22rpx; border-radius: 32rpx; background: #eef9f4; }
.care-intro__mark { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 20rpx; background: #29c990; color: #fff; flex-shrink: 0; font-weight: 850; }
.care-intro text { display: block; color: #315e60; font-size: 22rpx; font-weight: 750; }
.care-intro text + text { margin-top: 6rpx; color: #79a09a; font-size: 17rpx; font-weight: 500; line-height: 1.5; }
.care-cycle-list { display: grid; gap: 15rpx; }
.care-cycle { padding: 25rpx; border-radius: 36rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(58, 72, 128, 0.06); }
.care-cycle__top { display: flex; justify-content: space-between; }
.care-cycle__top text:first-child { color: #26336b; font-size: 27rpx; font-weight: 800; }
.care-cycle__top text:last-child { padding: 6rpx 11rpx; border-radius: 14rpx; background: #eef2ff; color: #7188ce; font-size: 15rpx; font-weight: 700; }
.care-cycle__status { margin-top: 18rpx; color: #22b980; font-size: 32rpx; font-weight: 850; }
.care-cycle--due-soon .care-cycle__status { color: #ed8a54; }
.care-cycle--overdue .care-cycle__status { color: #db6268; }
.care-cycle--unrecorded .care-cycle__status { color: #939cbd; }
.care-cycle__meta { display: flex; gap: 16rpx; margin-top: 11rpx; color: #98a1c1; font-size: 17rpx; }
.care-cycle button { width: 100%; margin-top: 20rpx; border-radius: 23rpx; background: #edf9f3; color: #24b77f; font-size: 21rpx; font-weight: 750; }

.daily-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 13rpx; }
.daily-card { min-height: 190rpx; padding: 21rpx; border: 2rpx dashed #dce1f0; border-radius: 32rpx; background: rgba(255, 255, 255, 0.58); box-sizing: border-box; }
.daily-card--done { border-style: solid; border-color: transparent; background: #fff; box-shadow: 0 10rpx 28rpx rgba(58, 72, 128, 0.06); }
.daily-card__top { display: flex; align-items: center; justify-content: space-between; }
.daily-card__top text:first-child { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 15rpx; background: #edf2ff; color: #6684dd; font-size: 17rpx; font-weight: 850; }
.daily-card--done .daily-card__top text:first-child { background: #eaf9f2; color: #22b980; }
.daily-card__top text:last-child { color: #9ca4c0; font-size: 15rpx; font-weight: 700; }
.daily-card__title { margin-top: 14rpx; color: #27346b; font-size: 25rpx; font-weight: 800; }
.daily-card__summary { margin-top: 6rpx; overflow: hidden; color: #929bbd; font-size: 17rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.daily-card__time { margin-top: 12rpx; color: #6f87ce; font-size: 16rpx; font-weight: 700; }
.daily-recent { margin-top: 15rpx; overflow: hidden; border-radius: 34rpx; background: #fff; }
.daily-recent__head { display: flex; justify-content: space-between; padding: 22rpx 22rpx 12rpx; color: #27346b; font-size: 20rpx; font-weight: 800; }
.daily-recent__head text:last-child { color: #9ca4c0; font-size: 16rpx; font-weight: 650; }
.daily-log-row { display: flex; align-items: center; gap: 13rpx; min-height: 88rpx; padding: 0 22rpx; border-top: 1rpx solid #eef0f7; }
.daily-log-row__icon { display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; border-radius: 16rpx; background: #eef9f4; color: #22b980; flex-shrink: 0; font-size: 16rpx; font-weight: 850; }
.daily-log-row__body { min-width: 0; flex: 1; }
.daily-log-row__body text { display: block; overflow: hidden; color: #2b376e; font-size: 21rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.daily-log-row__body text + text { margin-top: 3rpx; color: #9ba4c3; font-size: 15rpx; font-weight: 500; }
.daily-log-row__time { color: #8d97b7; flex-shrink: 0; font-size: 16rpx; }

.current-supplies { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.current-supply { min-height: 150rpx; padding: 23rpx; border-radius: 34rpx; background: #fff; box-sizing: border-box; }
.current-supply:first-child { background: #fff1eb; }
.current-supply:nth-child(2) { background: #edf9f4; }
.current-supply__label { color: #9a8b91; font-size: 17rpx; font-weight: 700; }
.current-supply__name { margin-top: 12rpx; color: #27346b; font-size: 25rpx; font-weight: 800; line-height: 1.35; }
.current-supply__note { margin-top: 8rpx; color: #959ebd; font-size: 16rpx; line-height: 1.45; }
.supply-filter { width: 100%; white-space: nowrap; }
.supply-filter__row { display: inline-flex; gap: 10rpx; padding: 0 2rpx 15rpx; }
.supply-filter__item { padding: 14rpx 21rpx; border-radius: 22rpx; background: #fff; color: #929abc; font-size: 19rpx; font-weight: 700; }
.supply-filter__item--active { background: #668ff0; color: #fff; }
.supply-list { overflow: hidden; border-radius: 36rpx; background: #fff; }
.supply-row { display: flex; align-items: center; gap: 15rpx; min-height: 112rpx; padding: 0 20rpx; border-bottom: 1rpx solid #eef0f7; }
.supply-row:last-child { border-bottom: 0; }
.supply-row__icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 20rpx; background: #eef2ff; color: #6684dd; flex-shrink: 0; font-size: 19rpx; font-weight: 850; }
.supply-row__body { min-width: 0; flex: 1; }
.supply-row__body text { display: block; overflow: hidden; color: #27346b; font-size: 23rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.supply-row__body text + text { margin-top: 5rpx; color: #9ba4c5; font-size: 17rpx; font-weight: 500; }
.supply-row__status { padding: 7rpx 11rpx; border-radius: 14rpx; background: #eef2ff; color: #6684dd; flex-shrink: 0; font-size: 15rpx; font-weight: 750; }
.supply-row__status--current { background: #eaf9f2; color: #22b980; }
.supply-row__status--loved { background: #fff0eb; color: #ef7958; }
.supply-row__status--wishlist { background: #f4edff; color: #8a6bd3; }
.supply-row__status--dropped { background: #f0f1f6; color: #9097ad; }
.supply-tip { margin-top: 14rpx; color: #9aa3c1; font-size: 17rpx; line-height: 1.55; text-align: center; }
.demo-note { margin-top: 28rpx; padding: 20rpx; border-radius: 28rpx; background: #eef2ff; color: #8290b8; font-size: 18rpx; line-height: 1.6; text-align: center; }
