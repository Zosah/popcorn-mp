/* 护理与成长共用日常时间线结构 */
.growth-timeline,
.care-timeline {
  padding-top: 4rpx;
}
.growth-timeline .daily-timeline__row,
.care-timeline .daily-timeline__row {
  align-items: stretch;
}
.growth-timeline .daily-timeline__line,
.care-timeline .daily-timeline__line {
  top: 43rpx;
  bottom: -27rpx;
  left: 23rpx;
  width: 2rpx;
  background: linear-gradient(180deg, rgba(179, 112, 126, 0.68), rgba(218, 179, 188, 0.42));
}

.pet-filter-bar {
  display: flex;
  align-items: center;
  margin: 0 0 18rpx;
