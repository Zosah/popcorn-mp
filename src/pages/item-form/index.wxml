<view class="page-shell item-form-page">
  <view class="form-hero">
    <view class="form-hero__icon"><line-icon name="inventory-category-other" size="30" tone="orange" /></view>
    <view class="form-hero__body">
      <view class="eyebrow">HOME INVENTORY</view>
      <view class="form-hero__title">{{itemId ? '改一改这条记录' : '记一件家里的东西'}}</view>
      <view class="form-hero__copy">名称最重要，其余信息想起来再补也可以。</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="form-state paper-card">正在打开这件物品…</view>
  <view wx:elif="{{loadError}}" class="form-state form-state--error paper-card">
    <view class="form-state__icon"><line-icon name="system-alert" size="34" tone="danger" /></view>
    <view class="form-state__title">物品信息暂时没连上</view>
    <view class="form-state__copy">{{loadError}}</view>
    <view class="form-state__action" bindtap="onRetryLoad">重新加载</view>
  </view>

  <block wx:else>
    <view class="form-section paper-card">
      <view class="form-field form-field--lead">
        <text class="form-label">物品名称 <text class="form-required">*</text></text>
        <input class="form-input form-input--lead" value="{{form.name}}" maxlength="40" placeholder="例如：鲜牛奶" bindinput="onNameInput" placeholder-class="app-input-placeholder" />
      </view>

      <view class="form-photo-row">
        <view class="form-photo-row__copy">
          <text class="form-label">物品图片</text>
          <text class="form-photo-row__hint">一张就够，之后更容易认出来</text>
        </view>
        <view wx:if="{{image && image.src}}" class="form-photo" bindtap="onPreviewImage">
          <image class="form-photo__image" src="{{image.thumbSrc || image.src}}" mode="aspectFill" />
          <view class="form-photo__edit" catchtap="onEditImage">编辑</view>
          <view class="form-photo__remove" catchtap="onRemoveImage">×</view>
        </view>
        <view wx:elif="{{imageUploading}}" class="form-photo form-photo--empty form-photo--busy">
          <line-icon name="system-image" size="28" tone="blue" />
          <text>上传中</text>
        </view>
        <view wx:else class="form-photo form-photo--empty" bindtap="onChooseImage">
          <line-icon name="system-image" size="30" tone="blue" />
          <text>添加图片</text>
        </view>
      </view>
    </view>

    <view class="form-section paper-card">
      <view class="form-block">
        <view class="form-block__head">
          <text class="form-label">分类</text>
          <text class="form-hint">决定列表里的标签颜色</text>
        </view>
        <view class="chip-grid chip-grid--three">
          <view wx:for="{{categoryOptions}}" wx:key="value" class="chip {{form.category === item.value ? 'chip--active' : ''}}" data-value="{{item.value}}" bindtap="onSelectCategory">
            <line-icon name="{{item.iconName}}" size="26" tone="{{form.category === item.value ? 'white' : 'color'}}" />
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="form-block form-block--last">
        <view class="form-block__head">
          <text class="form-label">存放位置</text>
          <text class="form-hint">找不到就直接选其他</text>
        </view>
        <view class="chip-grid chip-grid--two">
          <view wx:for="{{locationOptions}}" wx:key="value" class="chip {{form.location === item.value ? 'chip--active' : ''}}" data-value="{{item.value}}" bindtap="onSelectLocation">
            <line-icon name="{{item.iconName}}" size="26" tone="{{form.location === item.value ? 'white' : 'color'}}" />
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="form-section paper-card">
      <view class="form-block">
        <view class="form-block__head">
          <text class="form-label">数量</text>
          <text class="form-hint">用完一件就减一件</text>
        </view>
        <view class="qty-row">
          <view class="stepper">
            <view class="stepper__btn" data-delta="-1" bindtap="onStepQuantity">−</view>
            <input class="stepper__value" type="digit" value="{{form.quantity}}" bindinput="onQuantityInput" />
            <view class="stepper__btn" data-delta="1" bindtap="onStepQuantity">＋</view>
          </view>
          <text class="qty-unit-label">单位 · {{form.unit}}</text>
        </view>
        <view class="unit-row">
          <view wx:for="{{unitOptions}}" wx:key="*this" class="unit-chip {{form.unit === item ? 'unit-chip--active' : ''}}" data-value="{{item}}" bindtap="onSelectUnit">{{item}}</view>
        </view>
      </view>
    </view>

    <view class="form-section paper-card">
      <view class="form-switch-row">
        <view class="form-switch-row__copy">
          <view class="form-label">设置有效期</view>
          <view class="form-hint">开启后会出现在临期提醒中</view>
        </view>
        <switch checked="{{hasExpiry}}" color="#252b27" bindchange="onExpiryToggle" />
      </view>

      <view wx:if="{{hasExpiry}}" class="form-block">
        <view class="form-block__head">
          <text class="form-label">有效期</text>
          <text class="form-hint">先点一个常用时长，再按需改</text>
        </view>
        <view class="preset-row">
          <view wx:for="{{expiryPresets}}" wx:key="days" class="preset" data-days="{{item.days}}" bindtap="onQuickExpiry">{{item.label}}</view>
        </view>
        <picker mode="date" value="{{form.expiresOn}}" bindchange="onExpiryChange">
          <view class="form-picker form-picker--date">
            <text>{{form.expiresOn || '选择日期'}}</text>
            <line-icon name="system-calendar" size="23" tone="blue" />
          </view>
        </picker>
      </view>

      <view class="form-block form-block--last">
        <view class="form-block__head">
          <text class="form-label">备注</text>
          <text class="form-hint">可选</text>
        </view>
        <textarea class="form-textarea" value="{{form.note}}" maxlength="200" placeholder="写点容易忘记的信息" bindinput="onNoteInput" placeholder-class="app-input-placeholder" />
      </view>
    </view>

    <view class="form-footer">
      <button class="primary-button form-submit" loading="{{saving || imageUploading}}" disabled="{{saving || imageUploading}}" bindtap="onSave">
        <line-icon name="{{itemId ? 'system-edit' : 'system-add'}}" size="24" tone="white" />
        <text>{{itemId ? '保存修改' : '添加到库存'}}</text>
      </button>
    </view>
  </block>
</view>
