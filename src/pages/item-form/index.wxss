.item-form-page {
  --form-paper: var(--c-paper, #f8f7f4);
  --form-ink: var(--c-text, #252b27);
  --form-ink-2: var(--c-text-2, #5f5a53);
  --form-ink-3: var(--c-muted, #837f76);
  --form-line: var(--c-line, #e9e6e1);
  --form-deep: var(--c-primary, #252b27);
  padding: 28rpx 36rpx calc(188rpx + env(safe-area-inset-bottom));
  background: var(--form-paper);
  color: var(--form-ink);
}

.form-hero { display: flex; align-items: flex-start; padding: 10rpx 2rpx 28rpx; gap: 18rpx; }
.form-hero__icon { display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border-radius: 24rpx; background: var(--c-coral-soft, #f7e7e2); flex-shrink: 0; }
.form-hero__body { min-width: 0; flex: 1; }
.form-hero__title {
  font-family: var(--font-serif); margin-top: 8rpx; font-size: 45rpx; font-weight: 700; letter-spacing: -1.5rpx; line-height: 1.3; }
.form-hero__copy { margin-top: 9rpx; color: var(--form-ink-2); font-size: 26rpx; line-height: 1.65; }

.eyebrow { color: #b47539; font-size: 20rpx; font-weight: 700; letter-spacing: 4rpx; }
.paper-card { border: 1rpx solid var(--form-line); border-radius: 30rpx; background: #ffffff; box-shadow: 0 12rpx 30rpx rgba(42, 62, 50, 0.04); }
.form-section { overflow: hidden; margin-bottom: 18rpx; padding: 0 22rpx; }
.form-field { padding: 20rpx 0; border-bottom: 1rpx solid var(--form-line); }
.form-field--lead { padding-top: 24rpx; }
.form-field--last, .form-grid--compact .form-field { border-bottom: 0; }
.form-grid { display: grid; border-bottom: 1rpx solid var(--form-line); grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; }
.form-grid .form-field { border-bottom: 0; }
.form-label { display: block; color: var(--form-ink-3); font-size: 23rpx; font-weight: 500; letter-spacing: 0.5rpx; }
.form-required { color: var(--c-primary-link, #b86757); }
.form-input { height: 62rpx; color: var(--form-ink); font-size: 31rpx; font-weight: 600; }
.form-input--lead { height: 70rpx; font-size: 35rpx; }
.form-input::placeholder, .form-textarea::placeholder { color: var(--c-muted, #837f76); font-weight: 400; }
.form-picker { display: flex; min-height: 64rpx; align-items: center; justify-content: space-between; gap: 12rpx; }
.form-picker__selection { display: flex; min-width: 0; align-items: center; gap: 9rpx; }
.form-picker__selection text { overflow: hidden; font-size: 27rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.form-picker__arrow { color: var(--c-faint, #a29b91); font-size: 38rpx; }
.form-picker--date { color: var(--form-deep); font-size: 28rpx; font-weight: 600; }
.form-switch-row { display: flex; min-height: 100rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--form-line); gap: 20rpx; }
.form-switch-row__copy { flex: 1; }
.form-hint { margin-top: 4rpx; color: var(--form-ink-3); font-size: 23rpx; }
.form-switch-row switch { transform: scale(0.76); transform-origin: right center; }
.form-textarea { width: 100%; height: 150rpx; box-sizing: border-box; margin-top: 8rpx; padding: 13rpx 2rpx; color: var(--form-ink); font-size: 27rpx; line-height: 1.7; }
.form-footer { position: fixed; right: 0; bottom: 0; left: 0; padding: 18rpx 36rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(226, 231, 223, 0.9); background: rgba(253, 251, 247, 0.96); }
.form-submit { width: 100%; gap: 10rpx; }
.form-state { display: flex; margin-top: 8rpx; padding: 54rpx 26rpx; align-items: center; flex-direction: column; color: var(--form-ink-3); font-size: 25rpx; text-align: center; }
.form-state--error { background: #fff9f8; }
.form-state__icon { display: flex; width: 78rpx; height: 78rpx; align-items: center; justify-content: center; border-radius: 25rpx; background: var(--c-coral-soft, #f7e7e2); }
.form-state__title { margin-top: 16rpx; color: var(--form-ink); font-size: 29rpx; font-weight: 700; }
.form-state__copy { max-width: 520rpx; margin-top: 7rpx; line-height: 1.6; }
.form-state__action { margin-top: 18rpx; padding: 13rpx 22rpx; border-radius: 999rpx; background: var(--form-deep); color: #fff; font-size: 24rpx; font-weight: 600; }
