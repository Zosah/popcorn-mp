.form-page {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.page-head {
  padding: 8rpx 0 32rpx;
}

.page-head__title {
  color: var(--c-text, #22242e);
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: -2rpx;
}

.page-head__copy {
  max-width: 610rpx;
  margin-top: 12rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 24rpx;
  line-height: 1.6;
}

.form-page .card {
  border: 0;
  border-radius: 0;
  background: transparent;
}

.form-card {
  padding: 0;
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.form-card--optional {
  margin-top: 36rpx;
  border-top-color: var(--c-line, #e7e6ee);
}

.field {
  padding: 25rpx 0;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.field--name {
  padding-top: 27rpx;
}

.field:last-child,
.field--last {
  border-bottom: 0;
}

.field__label {
  display: block;
  color: var(--c-muted, #9497a6);
  font-size: 22rpx;
  font-weight: 400;
}

.required {
  color: var(--c-danger, #e8695c);
}

.field__input,
.picker-value {
  height: 66rpx;
  margin-top: 5rpx;
  color: var(--c-text, #22242e);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 66rpx;
}

.field__input::placeholder {
  color: #a8abba;
  font-weight: 400;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value > text {
  color: var(--c-line-strong, #d6d5e0);
  font-size: 32rpx;
  font-weight: 400;
}

.picker-value__selection {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.picker-value__selection text {
  color: var(--c-text, #22242e);
}

.picker-value--date {
  color: var(--c-accent, #5b6ee0);
}

.field-grid {
  display: flex;
  gap: 34rpx;
}

.field-grid--last .field {
  border-bottom: 0;
}

.field--half {
  width: 0;
  flex: 1;
}

.field--quantity {
  flex: 2;
}

.field--unit {
  flex: 1;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 108rpx;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.switch-row__hint {
  margin-top: 5rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.switch-row switch,
.field switch {
  transform: scale(0.78);
  transform-origin: right center;
}

.field--expiry {
  border-bottom: 0;
}

.field--note {
  padding-bottom: 24rpx;
  border-bottom: 0;
}

.field__textarea {
  width: 100%;
  height: 160rpx;
  box-sizing: border-box;
  margin-top: 12rpx;
  padding: 16rpx 0 16rpx 18rpx;
  border: 0;
  border-left: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-radius: 0;
  background: transparent;
  color: var(--c-text, #22242e);
  font-size: 25rpx;
  line-height: 1.65;
}

.form-footer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx 48rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--c-line, #e7e6ee);
  background: rgba(246, 244, 249, 0.97);
}

.form-footer .primary-button {
  width: 100%;
  gap: 10rpx;
}
