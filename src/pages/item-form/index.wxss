.form-page { padding-bottom: 180rpx; }
.intro { padding: 14rpx 6rpx 28rpx; }
.intro__eyebrow { color: #a2aacb; font-size: 18rpx; font-weight: 700; }
.intro__title { margin-top: 8rpx; color: #18255f; font-size: 50rpx; font-weight: 850; line-height: 1.35; }
.intro__copy { margin-top: 9rpx; color: #929bc0; font-size: 22rpx; }
.form-card { margin-top: 20rpx; padding: 8rpx 26rpx; }
.field { padding: 24rpx 0; border-bottom: 1rpx solid #eef0f7; }
.field--last { border-bottom: 0; }
.field__label { display: block; color: #59658e; font-size: 22rpx; font-weight: 750; }
.required { color: #ff6f70; }
.field__input,
.picker-value { height: 58rpx; margin-top: 9rpx; color: #202d64; font-size: 29rpx; font-weight: 650; line-height: 58rpx; }
.picker-value { display: flex; align-items: center; justify-content: space-between; }
.picker-value text { color: #b4bad1; font-size: 34rpx; }
.picker-value--date { color: #607fde; }
.field-grid { display: flex; gap: 26rpx; }
.field--half { width: 0; flex: 1; }
.field--quantity { flex: 2; }
.field--unit { flex: 1; }
.switch-row { display: flex; align-items: center; justify-content: space-between; padding: 27rpx 0; border-bottom: 1rpx solid #eef0f7; }
.switch-row__hint { margin-top: 6rpx; color: #a2aac8; font-size: 20rpx; }
.field__textarea { width: 100%; height: 150rpx; box-sizing: border-box; margin-top: 15rpx; padding: 18rpx; border: 0; border-radius: 24rpx; background: #f4f6fb; color: #28356b; font-size: 25rpx; }
.form-footer { position: fixed; right: 0; bottom: 0; left: 0; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background: rgba(245, 246, 252, 0.96); }
