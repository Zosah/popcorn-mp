.item-form-page {
  --form-paper: var(--c-paper, #f8f7f4);
  --form-ink: var(--c-text, #252b27);
  --form-ink-2: var(--c-text-2, #5f5a53);
  --form-ink-3: var(--c-muted, #837f76);
  --form-line: var(--c-line, #e9e6e1);
  --form-deep: var(--c-primary, #252b27);
  padding: 28rpx 36rpx calc(188rpx + env(safe-area-inset-bottom));
  background: var(--c-paper-grad);
  background-attachment: fixed;
  color: var(--form-ink);
}

.form-hero { display: flex; align-items: flex-start; padding: 10rpx 2rpx 28rpx; gap: 18rpx; }
.form-hero__icon {display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; flex-shrink: 0;}
.form-hero__body { min-width: 0; flex: 1; }
.form-hero__title {
  font-family: var(--font-serif); margin-top: 8rpx; font-size: 45rpx; font-weight: 700; letter-spacing: -1.5rpx; line-height: 1.3; }
.form-hero__copy { margin-top: 9rpx; color: var(--form-ink-2); font-size: 26rpx; line-height: 1.65; }

.eyebrow { color: #b47539; font-size: 20rpx; font-weight: 700; letter-spacing: 4rpx; }
.paper-card { border: 1rpx solid var(--form-line); border-radius: 30rpx; background: #ffffff; box-shadow: 0 12rpx 30rpx rgba(42, 62, 50, 0.04); }
.form-section { overflow: hidden; margin-bottom: 18rpx; padding: 0 22rpx; }
.form-field { padding: 20rpx 0; border-bottom: 1rpx solid var(--form-line); }
.form-field--lead { padding-top: 24rpx; }
.form-field--last, .form-grid--compact .form-field { border-bottom: 0; }
.form-photo-row { display: flex; min-height: 174rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--form-line); gap: 24rpx; }
.form-photo-row__copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 8rpx; }
.form-photo-row__hint { color: var(--form-ink-3); font-size: 24rpx; line-height: 1.55; }
.form-photo { position: relative; display: flex; width: 136rpx; height: 136rpx; align-items: center; justify-content: center; overflow: hidden; border-radius: 26rpx; flex-shrink: 0; }
.form-photo__image { width: 100%; height: 100%; }
.form-photo__remove { position: absolute; top: 8rpx; right: 8rpx; display: flex; width: 42rpx; height: 42rpx; align-items: center; justify-content: center; border: 2rpx solid rgba(255, 255, 255, 0.88); border-radius: 50%; background: rgba(37, 43, 39, 0.58); color: #fff; font-family: Arial, sans-serif; font-size: 31rpx; line-height: 1; }
.form-photo__edit { position: absolute; right: 9rpx; bottom: 9rpx; padding: 5rpx 11rpx; border-radius: 999rpx; background: rgba(255, 255, 255, 0.9); color: #8a5961; font-size: 18rpx; font-weight: 600; line-height: 1.35; }
.form-photo--empty { border: 2rpx dashed #d9d3c9; background: var(--c-paper-2, #f5f0e9); color: var(--form-ink-3); flex-direction: column; gap: 7rpx; font-size: 21rpx; }
.form-photo--busy { color: var(--form-ink-2); }
.form-grid { display: grid; border-bottom: 1rpx solid var(--form-line); grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; }
.form-grid .form-field { border-bottom: 0; }
.form-label { display: block; color: var(--form-ink-3); font-size: 23rpx; font-weight: 500; letter-spacing: 0.5rpx; }
.form-required { color: var(--c-primary-link, #b86757); }
.form-input { height: 62rpx; color: var(--form-ink); font-size: 31rpx; font-weight: 600; }
.form-input--lead { height: 70rpx; font-size: 35rpx; }
.form-input::placeholder, .form-textarea::placeholder { color: var(--c-muted, #837f76); font-weight: 400; }
.form-picker { display: flex; min-height: 64rpx; align-items: center; justify-content: space-between; gap: 12rpx; }
.form-picker__selection { display: flex; min-width: 0; align-items: center; gap: 9rpx; }
.form-picker__selection text { overflow: hidden; font-size: 27rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.form-picker__arrow { color: var(--c-faint, #a29b91); font-size: 38rpx; }
.form-picker--date {
  margin-top: 4rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--form-line);
  border-radius: 20rpx;
  background: var(--c-paper-2, #f5f0e9);
  color: var(--form-deep);
  font-size: 28rpx;
  font-weight: 700;
}
.form-switch-row { display: flex; min-height: 100rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--form-line); gap: 20rpx; }
.form-switch-row__copy { flex: 1; }
.form-hint { margin-top: 4rpx; color: var(--form-ink-3); font-size: 23rpx; }
.form-switch-row switch { transform: scale(0.76); transform-origin: right center; }
.form-textarea { width: 100%; height: 150rpx; box-sizing: border-box; margin-top: 8rpx; padding: 13rpx 2rpx; color: var(--form-ink); font-size: 27rpx; line-height: 1.7; }
.form-footer { position: fixed; right: 0; bottom: 0; left: 0; padding: 18rpx 36rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(226, 231, 223, 0.9); background: rgba(253, 251, 247, 0.96); }
.form-submit { width: 100%; gap: 10rpx; }
.form-state { display: flex; margin-top: 8rpx; padding: 54rpx 26rpx; align-items: center; flex-direction: column; color: var(--form-ink-3); font-size: 25rpx; text-align: center; }
.form-state--error { background: #fff9f8; }
.form-state__icon {display: flex; width: 78rpx; height: 78rpx; align-items: center; justify-content: center;}
.form-state__title { margin-top: 16rpx; color: var(--form-ink); font-size: 29rpx; font-weight: 700; }
.form-state__copy { max-width: 520rpx; margin-top: 7rpx; line-height: 1.6; }
.form-state__action { margin-top: 18rpx; padding: 13rpx 22rpx; border-radius: 999rpx; background: var(--form-deep); color: #fff; font-size: 24rpx; font-weight: 600; }

/* ===== 编辑体验 v2：分区卡片 + 芯片选择 + 数量步进 ===== */
.form-block {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--form-line);
}

.form-block--last {
  border-bottom: 0;
}

.form-block__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.chip-grid {
  display: grid;
  gap: 12rpx;
}

.chip-grid--three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.chip-grid--two {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.chip {
  display: flex;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  border: 1rpx solid var(--form-line);
  border-radius: 22rpx;
  background: var(--c-paper-2, #f5f0e9);
  color: var(--form-ink-2);
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  transition: background 160ms ease, color 160ms ease;
}

.chip text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip--active {
  border-width: 2rpx;
  border-style: solid;
  font-weight: 700;
}

/* 选中态用各自品类的浅色，不再整片墨黑 */
.chip--food { border-color: #efe1cd; background: #fbf4e9; color: #8b6238; }
.chip--food.chip--active { border-color: #d8b184; background: #f7e8d3; color: #7f5628; }
.chip--drink { border-color: #dbe7ef; background: #f2f8fb; color: #4f6f86; }
.chip--drink.chip--active { border-color: #a8c3d4; background: #e4eff6; color: #3f6178; }
.chip--frozen { border-color: #dbe9eb; background: #f2f9fa; color: #4c727a; }
.chip--frozen.chip--active { border-color: #a3c6cc; background: #e3f1f4; color: #3f656d; }
.chip--seasoning { border-color: #efe0cd; background: #fcf4e9; color: #90602d; }
.chip--seasoning.chip--active { border-color: #d5ab7d; background: #f8e8d4; color: #7f5325; }
.chip--daily { border-color: #e3e8d5; background: #f7faef; color: #63724e; }
.chip--daily.chip--active { border-color: #bcc8a5; background: #edf2e2; color: #576646; }
.chip--medicine { border-color: #f0dcd7; background: #fdf3f1; color: #99564a; }
.chip--medicine.chip--active { border-color: #dcaea5; background: #fae7e2; color: #8f463a; }
.chip--pet { border-color: #dcebe5; background: #f3faf7; color: #4f6f61; }
.chip--pet.chip--active { border-color: #a3c6b6; background: #e6f3ee; color: #446356; }
.chip--other { border-color: #e9e2d8; background: #faf7f2; color: #6f6a61; }
.chip--other.chip--active { border-color: #cabfae; background: #f2ede6; color: #605b52; }
.chip--loc { border-color: #e4e9dd; background: #f9faf4; color: #5f6a55; }
.chip--loc.chip--active { border-color: #a9c9bb; background: #e9f4ef; color: #4d6f61; }

.qty-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.qty-unit-label {
  color: var(--form-ink-3);
  font-size: 23rpx;
}

.stepper {
  display: flex;
  height: 88rpx;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid var(--form-line);
  border-radius: 24rpx;
  background: var(--c-paper-2, #f5f0e9);
  flex: 0 0 auto;
}

.stepper__btn {
  display: flex;
  width: 76rpx;
  height: 100%;
  align-items: center;
  justify-content: center;
  color: var(--form-ink);
  font-size: 38rpx;
  font-weight: 600;
}

.stepper__btn:active {
  background: rgba(37, 43, 39, 0.06);
}

.stepper__value {
  width: 110rpx;
  height: 100%;
  border-right: 1rpx solid var(--form-line);
  border-left: 1rpx solid var(--form-line);
  background: #fff;
  color: var(--form-ink);
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.unit-row {
  display: flex;
  margin-top: 14rpx;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.unit-chip {
  padding: 9rpx 18rpx;
  border: 1rpx solid var(--form-line);
  border-radius: 999rpx;
  background: #fff;
  color: var(--form-ink-2);
  font-size: 23rpx;
}

.unit-chip--active {
  border-color: #e0b2a9;
  background: #fbeae6;
  color: #a85a4c;
  font-weight: 700;
}

.preset-row {
  display: flex;
  margin-bottom: 14rpx;
  flex-wrap: wrap;
  gap: 10rpx;
}

.preset {
  padding: 10rpx 20rpx;
  border: 1rpx solid #ecd9cf;
  border-radius: 999rpx;
  background: #fdf4f1;
  color: #9a5f58;
  font-size: 23rpx;
  font-weight: 600;
}

.preset:active {
  background: var(--c-primary-soft, #f7e7e2);
  color: #9a5f58;
}

/* 主按钮：珊瑚渐变，不再用墨黑 */
.form-submit {
  border: 0;
  background: linear-gradient(135deg, #d18d7c 0%, #bb6d5d 100%);
  box-shadow: 0 18rpx 32rpx -20rpx rgba(184, 103, 87, 0.8);
}
