<view class="travel-detail-page">
  <page-loading show="{{loading && !trip}}" title="正在展开这趟行程" copy="把时间和随身物品一起带回来。" />
  <auth-preview-gate />

  <view wx:if="{{loadError && !trip}}" class="td-state td-state--error">
    <view class="td-state__mark"><line-icon name="system-alert" size="42" tone="orange" /></view>
    <text class="td-state__title">这趟行程还没打开</text>
    <text class="td-state__copy">{{loadError}}</text>
    <view class="td-state__action" bindtap="onRetryLoad">再试一次</view>
  </view>

  <block wx:elif="{{trip}}">
    <view class="td-hero td-hero--{{trip.status}}">
      <view class="td-hero__scene" aria-hidden="true">
        <view class="td-hero__sun"></view>
        <view class="td-hero__cloud td-hero__cloud--one"></view>
        <view class="td-hero__cloud td-hero__cloud--two"></view>
        <view class="td-hero__route"></view>
        <view class="td-hero__plane"><line-icon name="feature-travel" size="42" tone="blue" active="{{true}}" /></view>
        <view class="td-hero__stamp">{{trip.status === 'traveling' ? 'NOW' : trip.status === 'ended' ? 'KEEP' : 'NEXT'}}</view>
      </view>

      <view class="td-hero__head">
        <text class="td-hero__status">{{trip.statusLabel}}</text>
        <text class="td-hero__duration">{{trip.durationLabel}}</text>
      </view>
      <text class="td-hero__title">{{trip.title}}</text>
      <view class="td-hero__destination">
        <line-icon name="travel-tab-plan" size="23" tone="green" />
        <text>{{trip.destination}}</text>
      </view>
      <view class="td-hero__date">
        <line-icon name="system-calendar" size="23" tone="muted" />
        <text>{{trip.dateRange}}</text>
      </view>
      <view class="td-hero__actions">
        <view class="td-hero__action" bindtap="onEdit">
          <line-icon name="system-edit" size="23" tone="ink" />
          <text>调整安排</text>
        </view>
        <view class="td-hero__action" bindtap="onCopy">
          <line-icon name="system-refresh" size="23" tone="accent" />
          <text>复制出行</text>
        </view>
      </view>
    </view>

    <view class="td-packing">
      <view class="td-section-head">
        <view>
          <text class="td-section-head__title">随身清单</text>
          <text class="td-section-head__copy">{{trip.unpackedCount ? '还有 ' + trip.unpackedCount + ' 件待装' : trip.itemCount ? '都装好了，可以安心出发' : '把这次要带的东西记下来'}}</text>
        </view>
        <view class="td-section-head__count">{{trip.packedCount}} / {{trip.itemCount}}</view>
      </view>

      <view class="td-progress">
        <view class="td-progress__track">
          <view class="td-progress__fill" style="width: {{trip.packingPercent}}%;"></view>
        </view>
        <text class="td-progress__label">{{trip.packingPercent}}%</text>
      </view>

      <view wx:if="{{trip.items.length}}" class="td-items">
        <view
          wx:for="{{trip.items}}"
          wx:key="id"
          class="td-item {{item.packed ? 'td-item--packed' : ''}} {{activeItemId === item.id ? 'td-item--busy' : ''}}"
          data-id="{{item.id}}"
          bindtap="onToggleItem"
        >
          <view class="td-item__check {{item.packed ? 'td-item__check--done' : ''}}">
            <line-icon wx:if="{{item.packed}}" name="system-check" size="20" tone="white" />
          </view>
          <view class="td-item__body">
            <text class="td-item__name">{{item.name}}</text>
            <text class="td-item__state">{{item.stateLabel}}</text>
          </view>
          <view class="td-item__remove" data-id="{{item.id}}" catchtap="onRemoveItem">移除</view>
        </view>
      </view>

      <view wx:else class="td-items-empty">
        <view class="td-items-empty__mark"><line-icon name="travel-tab-packing" size="38" tone="gold" /></view>
        <view class="td-items-empty__body">
          <text class="td-items-empty__title">清单还是空的</text>
          <text class="td-items-empty__copy">从常用清单带入，或者在下面随手加一件。</text>
        </view>
      </view>

      <view class="td-item-tools">
        <view class="td-item-tool td-item-tool--primary" bindtap="onOpenTemplates">
          <line-icon name="travel-object-item" size="24" tone="green" />
          <text>从必备清单带入</text>
        </view>
        <view class="td-item-tool" bindtap="onFocusQuickAdd">
          <line-icon name="system-add" size="22" tone="accent" />
          <text>添加物品</text>
        </view>
      </view>

      <view class="td-quick-add {{quickAddFocused ? 'td-quick-add--focus' : ''}}">
        <input
          class="td-quick-add__input"
          value="{{quickAddName}}"
          maxlength="60"
          placeholder="再记一件，例如：雨伞"
          focus="{{quickAddFocused}}"
          confirm-type="done"
          bindinput="onQuickAddInput"
          bindfocus="onFocusQuickAdd"
          bindblur="onQuickAddBlur"
          bindconfirm="onAddItem"
          placeholder-class="app-input-placeholder"
        />
        <view class="td-quick-add__button {{mutating ? 'td-quick-add__button--busy' : ''}}" bindtap="onAddItem">
          <line-icon name="system-add" size="22" tone="white" />
        </view>
      </view>
    </view>

    <view wx:if="{{trip.note}}" class="td-note">
      <view class="td-note__head">
        <view class="td-note__mark"><line-icon name="journal-note-other" size="22" tone="gold" /></view>
        <text>行程备注</text>
      </view>
      <text class="td-note__copy">{{trip.note}}</text>
    </view>

    <view class="td-footer">
      <view class="td-footer__copy">
        <text>这趟行程</text>
        <text>{{trip.itemCount}} 件随身物品 · 版本 {{trip.version}}</text>
      </view>
      <view class="td-footer__delete" bindtap="onDelete">删除行程</view>
    </view>
  </block>

  <view wx:if="{{templateSheetOpen}}" class="td-sheet-mask" catchtap="onCloseTemplates">
    <view class="td-sheet" catchtap="noop">
      <view class="td-sheet__handle"></view>
      <view class="td-sheet__head">
        <view>
          <text class="td-sheet__eyebrow">少漏一件是一件</text>
          <text class="td-sheet__title">带入必备清单</text>
        </view>
        <view class="td-sheet__close" bindtap="onCloseTemplates">关闭</view>
      </view>

      <view wx:if="{{templateLoading}}" class="td-sheet__loading">
        <view></view><view></view><view></view>
        <text>正在取回你的清单</text>
      </view>

      <view wx:elif="{{templateError}}" class="td-sheet__empty">
        <line-icon name="system-alert" size="34" tone="orange" />
        <text>{{templateError}}</text>
        <view class="td-sheet__retry" bindtap="onOpenTemplates">再试一次</view>
      </view>

      <view wx:elif="{{templates.length}}" class="td-template-list">
        <view
          wx:for="{{templates}}"
          wx:key="id"
          class="td-template {{selectedTemplateId === item.id ? 'td-template--active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSelectTemplate"
        >
          <view class="td-template__radio {{selectedTemplateId === item.id ? 'td-template__radio--active' : ''}}">
            <view wx:if="{{selectedTemplateId === item.id}}"></view>
          </view>
          <view class="td-template__body">
            <view class="td-template__title-row">
              <text class="td-template__title">{{item.title}}</text>
              <text wx:if="{{item.isDefault}}" class="td-template__default">默认</text>
            </view>
            <text class="td-template__preview">{{item.itemPreview}}</text>
            <text class="td-template__count">{{item.itemCount}} 件物品</text>
          </view>
        </view>
      </view>

      <view wx:else class="td-sheet__empty">
        <view class="td-sheet__empty-mark"><line-icon name="travel-tab-packing" size="38" tone="gold" /></view>
        <text>还没有必备清单</text>
        <text class="td-sheet__empty-copy">回到旅行页的“必备清单”里整理一份，下次就能一键带入。</text>
      </view>

      <view class="td-sheet__foot">
        <view class="td-sheet__hint">带入后只会复制到这次行程，不会改动原清单。</view>
        <view class="td-sheet__submit {{!selectedTemplateId || importingTemplate ? 'td-sheet__submit--disabled' : ''}}" bindtap="onImportTemplate">
          {{importingTemplate ? '带入中…' : '带入这次行程'}}
        </view>
      </view>
    </view>
  </view>
</view>
