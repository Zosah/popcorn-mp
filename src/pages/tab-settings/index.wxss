.tab-settings-page {
  --settings-paper: #fdfbf7;
  --settings-ink: #2e2a28;
  --settings-ink-2: #6b635c;
  --settings-ink-3: #a69e96;
  --settings-line: #ebe5da;
  --settings-deep: #2c4a52;
  min-height: 100vh;
  padding: 30rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--settings-paper);
  color: var(--settings-ink);
}

.tab-settings-hero {
  position: relative;
  display: flex;
  min-height: 248rpx;
  overflow: hidden;
  padding: 32rpx 30rpx;
  box-sizing: border-box;
  border-radius: 38rpx;
  background: linear-gradient(145deg, #fce9ef 0%, #edf4fb 55%, #fff8e2 100%);
}

.tab-settings-hero__copy {
  position: relative;
  z-index: 2;
  display: flex;
  width: 68%;
  flex-direction: column;
}

.tab-settings-hero__eyebrow {
  color: #b97689;
  font-family: Georgia, "Songti SC", serif;
  font-size: 22rpx;
  font-style: italic;
  letter-spacing: 1rpx;
}

.tab-settings-hero__title {
  margin-top: 12rpx;
  font-size: 41rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  line-height: 1.28;
}

.tab-settings-hero__intro {
  margin-top: 12rpx;
  color: var(--settings-ink-2);
  font-size: 25rpx;
  line-height: 1.65;
}

.tab-settings-hero__art {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  width: 216rpx;
  height: 216rpx;
}

.tab-settings-hero__sun {
  position: absolute;
  top: 20rpx;
  right: 16rpx;
  width: 142rpx;
  height: 142rpx;
  border-radius: 50%;
  background: rgba(246, 215, 118, 0.78);
}

.tab-settings-hero__paw,
.tab-settings-hero__house {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  background: rgba(255, 254, 250, 0.72);
  box-shadow: 0 12rpx 24rpx rgba(80, 60, 40, 0.09);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

.tab-settings-hero__paw {
  right: 8rpx;
  bottom: 8rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  transform: rotate(7deg);
}

.tab-settings-hero__house {
  top: 26rpx;
  left: 2rpx;
  width: 78rpx;
  height: 78rpx;
  border-radius: 25rpx;
  transform: rotate(-8deg);
}

.tab-settings-preview {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid var(--settings-line);
  border-radius: 32rpx;
  background: #fffefa;
  box-shadow: 0 12rpx 28rpx rgba(82, 65, 48, 0.05);
}

.tab-settings-preview__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.tab-settings-preview__head text:first-child {
  font-size: 28rpx;
  font-weight: 700;
}

.tab-settings-preview__head text:last-child {
  color: var(--settings-ink-3);
  font-size: 22rpx;
}

.tab-settings-preview__bar {
  display: flex;
  height: 102rpx;
  align-items: center;
  margin-top: 17rpx;
  padding: 8rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(235, 229, 218, 0.82);
  border-radius: 32rpx;
  background: rgba(253, 251, 247, 0.82);
}

.tab-settings-preview__item {
  display: flex;
  min-width: 0;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  border-radius: 25rpx;
  color: var(--settings-ink-2);
  flex: 1;
  gap: 6rpx;
  font-size: 23rpx;
  font-weight: 600;
}

.tab-settings-preview__icon {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
}

.tab-settings-preview__icon--blue { background: #eaf1f7; }
.tab-settings-preview__icon--green { background: #eef5ef; }
.tab-settings-preview__icon--gold { background: #fbf3e1; }
.tab-settings-preview__icon--pink { background: #fcedf0; }
.tab-settings-preview__icon--orange { background: #fdf0e4; }

.tab-settings-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 34rpx 4rpx 14rpx;
}

.tab-settings-section-head text:first-child {
  font-size: 32rpx;
  font-weight: 800;
}

.tab-settings-section-head text:last-child {
  color: var(--settings-ink-3);
  font-size: 22rpx;
}

.tab-settings-slots {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tab-settings-slot {
  display: flex;
  align-items: center;
  padding: 18rpx 18rpx 18rpx 20rpx;
  border: 1rpx solid var(--settings-line);
  border-radius: 28rpx;
  background: #fffefa;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tab-settings-slot--active {
  border-color: rgba(44, 74, 82, 0.38);
  box-shadow: 0 0 0 3rpx rgba(44, 74, 82, 0.06);
}

.tab-settings-slot__label {
  width: 100%;
  color: var(--settings-ink-3);
  font-size: 21rpx;
}

.tab-settings-slot__main {
  display: flex;
  min-width: 0;
  align-items: center;
  flex: 1;
  gap: 13rpx;
}

.tab-settings-slot__icon,
.tab-settings-option__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.tab-settings-slot__icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
}

.tab-settings-slot__icon--blue,
.tab-settings-option__icon--blue { background: #eaf1f7; }
.tab-settings-slot__icon--green,
.tab-settings-option__icon--green { background: #eef5ef; }
.tab-settings-slot__icon--gold,
.tab-settings-option__icon--gold { background: #fbf3e1; }
.tab-settings-slot__icon--pink,
.tab-settings-option__icon--pink { background: #fcedf0; }
.tab-settings-slot__icon--orange,
.tab-settings-option__icon--orange { background: #fdf0e4; }

.tab-settings-slot__body {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 3rpx;
}

.tab-settings-slot__body text:first-child {
  font-size: 28rpx;
  font-weight: 700;
}

.tab-settings-slot__body text:last-child {
  overflow: hidden;
  color: var(--settings-ink-3);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-settings-slot__edit {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f6f1e9;
  color: var(--settings-deep);
  flex: 0 0 auto;
  font-size: 22rpx;
  font-weight: 600;
}

.tab-settings-options {
  overflow: hidden;
  border: 1rpx solid var(--settings-line);
  border-radius: 30rpx;
  background: #fffefa;
}

.tab-settings-option {
  display: flex;
  min-height: 98rpx;
  align-items: center;
  padding: 16rpx 18rpx;
  border-bottom: 1rpx solid var(--settings-line);
  gap: 14rpx;
}

.tab-settings-option:last-child {
  border-bottom: 0;
}

.tab-settings-option--selected {
  background: #f5f8f4;
}

.tab-settings-option--disabled {
  opacity: 0.48;
}

.tab-settings-option__icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
}

.tab-settings-option__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 3rpx;
}

.tab-settings-option__title-row {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.tab-settings-option__title-row text:first-child {
  font-size: 28rpx;
  font-weight: 700;
}

.tab-settings-option__tag {
  padding: 3rpx 9rpx;
  border-radius: 999rpx;
  background: #eef5ef;
  color: #5d8869;
  font-size: 19rpx;
}

.tab-settings-option__copy {
  overflow: hidden;
  color: var(--settings-ink-3);
  font-size: 22rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-settings-option__check {
  display: flex;
  width: 38rpx;
  height: 38rpx;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.tab-settings-note {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
  padding: 17rpx 18rpx;
  border-radius: 24rpx;
  background: #fbf3e1;
  gap: 10rpx;
}

.tab-settings-note text {
  color: #876d3b;
  flex: 1;
  font-size: 22rpx;
  line-height: 1.6;
}


.tab-settings-candidate-group + .tab-settings-candidate-group {
  margin-top: 24rpx;
}

.tab-settings-candidate-group__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 6rpx 10rpx;
}

.tab-settings-candidate-group__head text:first-child {
  color: var(--settings-ink);
  font-size: 27rpx;
  font-weight: 700;
}

.tab-settings-candidate-group__head text:last-child {
  color: var(--settings-ink-3);
  font-size: 21rpx;
}
