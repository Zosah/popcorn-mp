<view class="page-shell journal-detail-page">
  <view wx:if="{{loading && !entry}}" class="journal-state paper-card">
    <view class="journal-state__mark"><line-icon name="notebook-tabs" size="36" tone="blue" /></view>
    <view class="journal-state__title">正在翻开这段记录</view>
    <view class="journal-state__copy">稍等一下，马上就好。</view>
  </view>

  <view wx:elif="{{loadError && !entry}}" class="journal-state journal-state--error paper-card">
    <view class="journal-state__mark"><line-icon name="circle-alert" size="36" tone="danger" /></view>
    <view class="journal-state__title">这条记录暂时没打开</view>
    <view class="journal-state__copy">{{loadError}}</view>
    <view class="journal-state__action" bindtap="onRetryLoad">重新加载</view>
  </view>

  <block wx:elif="{{entry}}">
    <view class="journal-head">
      <view class="journal-head__mark"><line-icon name="{{entry.kind === 'note' ? 'file-text' : 'pen-line'}}" size="30" tone="blue" /></view>
      <view class="journal-head__body">
        <view class="eyebrow">A MOMENT TO KEEP</view>
        <view class="journal-head__meta">{{entry.authorName}} {{entry.kind === 'note' ? '归档于' : '写于'}} {{entry.dateLabel}} {{entry.timeLabel}}</view>
        <view class="journal-head__title">{{entry.title}}</view>
        <view class="journal-head__footer">
          <view class="journal-head__visibility"><line-icon name="{{entry.visibility === 'private' ? 'lock' : 'users'}}" size="20" tone="muted" /><text>{{entry.visibilityLabel}}</text></view>
          <text class="journal-head__kind">{{entry.kindLabel}}</text>
        </view>
      </view>
    </view>

    <view class="paper-card journal-paper">
      <block wx:if="{{entry.image && entry.image.src}}">
        <view class="journal-photo" bindtap="onPreviewImage">
          <image class="journal-photo__image" src="{{entry.image.src}}" mode="aspectFill" lazy-load />
          <view class="journal-photo__hint"><line-icon name="image" size="19" tone="white" /><text>轻触查看原图</text></view>
        </view>
        <view wx:if="{{entry.image.caption}}" class="journal-caption">{{entry.image.caption}}</view>
      </block>

      <view class="journal-copy">{{entry.content || (entry.kind === 'note' ? '这份记录暂时没有更多文字。' : '这一刻没有留下更多文字。')}}</view>

      <view class="journal-meta">
        <view class="journal-meta__row"><text>类型</text><text>{{entry.kindLabel}}</text></view>
        <view wx:if="{{entry.categoryLabel}}" class="journal-meta__row"><text>归档</text><text>{{entry.categoryLabel}}</text></view>
        <view class="journal-meta__row"><text>记录于</text><text>{{entry.dateLabel}} {{entry.timeLabel}}</text></view>
        <view wx:if="{{entry.updatedAt}}" class="journal-meta__row"><text>状态</text><text>内容已更新</text></view>
      </view>
    </view>

    <view class="journal-actions">
      <button class="primary-button" disabled="{{deleting}}" bindtap="onEdit"><line-icon name="pen-line" size="23" tone="white" /><text>编辑记录</text></button>
      <button class="danger-button journal-delete" loading="{{deleting}}" disabled="{{deleting}}" bindtap="onDelete"><line-icon name="circle-alert" size="22" tone="danger" /><text>删除记录</text></button>
    </view>

    <view class="journal-sync"><sync-badge state="{{syncState}}" text="{{syncText}}" /></view>
  </block>
</view>
