.journal-detail-page {
  --journal-deep: var(--c-primary, #252b27);
  --journal-blue-soft: var(--c-sage-soft, #e2eee9);
  --journal-ink: var(--c-text, #252b27);
  --journal-ink-2: var(--c-text-2, #5f5a53);
  --journal-ink-3: var(--c-muted, #837f76);
  --journal-line: var(--c-line, #e9e6e1);
  padding: 28rpx 36rpx calc(104rpx + env(safe-area-inset-bottom));
  background: var(--c-paper, #f8f7f4);
  color: var(--journal-ink);
}

.paper-card { box-sizing: border-box; border: 1rpx solid var(--journal-line); border-radius: 30rpx; background: #ffffff; box-shadow: 0 12rpx 30rpx rgba(42, 62, 50, 0.045); }
.journal-head { display: flex; align-items: flex-start; padding: 8rpx 2rpx 30rpx; gap: 18rpx; }
.journal-head__mark { display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border-radius: 24rpx; background: var(--journal-blue-soft); flex-shrink: 0; }
.journal-head__body { min-width: 0; flex: 1; }
.journal-head__meta { margin-top: 8rpx; color: var(--journal-ink-3); font-size: 22rpx; line-height: 1.55; }
.journal-head__title {
  font-family: var(--font-serif); margin-top: 9rpx; color: var(--journal-ink); font-size: 46rpx; font-weight: 700; line-height: 1.32; letter-spacing: -1.5rpx; }
.journal-head__footer { display: flex; align-items: center; justify-content: space-between; margin-top: 15rpx; gap: 14rpx; }
.journal-head__visibility { display: flex; align-items: center; color: var(--journal-ink-3); gap: 6rpx; font-size: 22rpx; }
.journal-head__kind { padding: 6rpx 12rpx; border-radius: 999rpx; background: var(--journal-blue-soft); color: #547e9d; font-size: 21rpx; }

.journal-paper { overflow: hidden; padding: 18rpx; }
.journal-photo { position: relative; overflow: hidden; width: 100%; height: 430rpx; border-radius: 23rpx; background: #e9e4dc; }
.journal-photo__image { display: block; width: 100%; height: 100%; }
.journal-photo__hint { position: absolute; right: 14rpx; bottom: 14rpx; display: flex; align-items: center; padding: 8rpx 13rpx; border-radius: 999rpx; background: rgba(46, 42, 40, 0.66); color: #fff; gap: 6rpx; font-size: 21rpx; }
.journal-caption { margin: 10rpx 5rpx 2rpx; color: var(--journal-ink-3); font-size: 22rpx; line-height: 1.55; text-align: right; }
.journal-copy { min-height: 150rpx; padding: 27rpx 20rpx 30rpx; color: var(--journal-ink); font-size: 29rpx; line-height: 1.9; white-space: pre-wrap; }
.journal-copy::before { display: block; width: 42rpx; height: 4rpx; margin-bottom: 16rpx; border-radius: 999rpx; background: #b8cfdf; content: ""; }
.journal-meta { overflow: hidden; border: 1rpx solid #eee8de; border-radius: 22rpx; background: var(--c-paper, #f8f7f4); }
.journal-meta__row { display: flex; align-items: center; justify-content: space-between; min-height: 74rpx; padding: 0 18rpx; border-bottom: 1rpx solid #eee8de; color: var(--journal-ink-3); font-size: 23rpx; gap: 18rpx; }
.journal-meta__row:last-child { border-bottom: 0; }
.journal-meta__row text:last-child { max-width: 68%; color: var(--journal-ink-2); font-weight: 500; text-align: right; }

.journal-actions { margin-top: 26rpx; }
.journal-actions button { width: 100%; gap: 9rpx; }
.journal-delete { margin-top: 13rpx; }
.journal-sync { display: flex; justify-content: center; margin-top: 18rpx; }

.journal-state { display: flex; margin-top: 16rpx; padding: 56rpx 28rpx; align-items: center; flex-direction: column; text-align: center; }
.journal-state__mark { display: flex; width: 84rpx; height: 84rpx; align-items: center; justify-content: center; border-radius: 27rpx; background: var(--journal-blue-soft); }
.journal-state--error .journal-state__mark { background: var(--c-coral-soft, #f7e7e2); }
.journal-state__title { margin-top: 16rpx; color: var(--journal-ink); font-size: 29rpx; font-weight: 700; }
.journal-state__copy { max-width: 500rpx; margin-top: 7rpx; color: var(--journal-ink-3); font-size: 24rpx; line-height: 1.6; }
.journal-state__action { margin-top: 18rpx; padding: 12rpx 22rpx; border-radius: 999rpx; background: var(--journal-deep); color: #fff; font-size: 23rpx; font-weight: 600; }
