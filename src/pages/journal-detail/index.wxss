.journal-detail-page {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.journal-detail-head {
  padding: 8rpx 0 30rpx;
  border-bottom: 1rpx solid var(--c-line-strong, #d6d5e0);
}

.journal-detail-eyebrow {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.journal-detail-title {
  margin-top: 20rpx;
  color: var(--c-text, #22242e);
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: -2rpx;
}

.journal-detail-visibility {
  display: flex;
  align-items: center;
  gap: 7rpx;
  margin-top: 16rpx;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
}

.journal-detail-photo {
  position: relative;
  overflow: hidden;
  width: 100%;
  height: 430rpx;
  margin-top: 28rpx;
  border: 7rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 30rpx;
  background: #ece8e1;
  box-shadow: 0 16rpx 38rpx rgba(89, 76, 111, 0.12);
}

.journal-detail-image {
  display: block;
  width: 100%;
  height: 100%;
  filter: saturate(0.62) contrast(0.96) sepia(0.05);
}

.journal-detail-photo__hint {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  display: flex;
  align-items: center;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(37, 34, 49, 0.56);
  color: #fff;
  gap: 7rpx;
  font-size: 18rpx;
  backdrop-filter: blur(10rpx);
}

.journal-detail-caption {
  margin-top: 10rpx;
  padding-right: 4rpx;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
  line-height: 1.5;
  text-align: right;
}

.journal-detail-copy {
  min-height: 150rpx;
  padding: 28rpx 0 34rpx 20rpx;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
  border-left: 1rpx solid var(--c-line-strong, #d6d5e0);
  color: var(--c-text, #22242e);
  font-size: 26rpx;
  line-height: 1.85;
  white-space: pre-wrap;
}

.journal-detail-meta {
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.journal-detail-meta__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.journal-detail-meta__row text:last-child {
  color: var(--c-text-2, #5c5f6e);
}

.journal-detail-actions {
  margin-top: 30rpx;
}

.journal-detail-actions button {
  width: 100%;
  gap: 10rpx;
}

.journal-detail-delete {
  margin-top: 14rpx;
}

.journal-detail-sync {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

.journal-detail-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 66rpx 34rpx;
  color: var(--c-muted, #8a8693);
  text-align: center;
}

.journal-detail-state > view {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(139, 121, 183, 0.12);
  color: var(--c-accent, #8b79b7);
  font-weight: 600;
}
