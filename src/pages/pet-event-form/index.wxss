.pet-event-form {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.event-head {
  padding: 8rpx 0 32rpx;
}

.event-head__title {
  color: var(--c-text, #22242e);
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: -2rpx;
}

.event-head__copy {
  max-width: 610rpx;
  margin-top: 12rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 24rpx;
  line-height: 1.65;
}

.pet-event-form .card {
  border: 0;
  border-radius: 0;
  background: transparent;
}

.event-form-card {
  overflow: hidden;
  padding: 0;
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.event-field {
  display: flex;
  align-items: center;
  min-height: 94rpx;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.event-field:last-child,
.event-field--last {
  border-bottom: 0;
}

.event-field > text,
.event-field > view:first-child > text:first-child {
  color: var(--c-muted, #9497a6);
  font-size: 22rpx;
  font-weight: 400;
}

.event-field picker {
  margin-left: auto;
  color: var(--c-text, #22242e);
  font-size: 22rpx;
  font-weight: 500;
}

.event-field__picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.event-field switch {
  margin-left: auto;
  transform: scale(0.78);
  transform-origin: right center;
}

.event-field > view:first-child > text {
  display: block;
}

.event-field > view:first-child > text + text {
  margin-top: 4rpx;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
  font-weight: 400;
}

.event-field--stack {
  align-items: stretch;
  padding: 22rpx 0;
  flex-direction: column;
}

.event-field--stack input {
  height: 68rpx;
  margin-top: 7rpx;
  padding: 0;
  border: 0;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
  border-radius: 0;
  background: transparent;
  box-sizing: border-box;
  color: var(--c-text, #22242e);
  font-size: 27rpx;
}

.event-field--stack input::placeholder {
  color: #a8abba;
}

.event-field--stack textarea {
  width: auto;
  min-height: 138rpx;
  margin-top: 10rpx;
  padding: 14rpx 0 14rpx 18rpx;
  border: 0;
  border-left: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-radius: 0;
  background: transparent;
  box-sizing: border-box;
  color: var(--c-text, #22242e);
  font-size: 24rpx;
  line-height: 1.65;
}

.event-save {
  width: 100%;
  margin-top: 30rpx;
  gap: 10rpx;
}

.event-note {
  margin-top: 18rpx;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
  text-align: center;
}
