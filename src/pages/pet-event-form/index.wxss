.pet-event-form { padding-bottom: 90rpx; }
.event-head { padding: 12rpx 6rpx 28rpx; }
.event-head text { display: block; }
.event-head text:first-child { color: #24b880; font-size: 18rpx; font-weight: 800; letter-spacing: 2rpx; }
.event-head text:nth-child(2) { margin-top: 12rpx; color: #18255f; font-size: 45rpx; font-weight: 850; }
.event-head text:last-child { margin-top: 12rpx; color: #929bc0; font-size: 21rpx; line-height: 1.55; }
.event-form-card { overflow: hidden; padding: 6rpx 24rpx; border-radius: 38rpx; background: #fff; }
.event-field { display: flex; align-items: center; min-height: 96rpx; border-bottom: 1rpx solid #eef0f7; }
.event-field:last-child { border-bottom: 0; }
.event-field > text, .event-field > view:first-child > text:first-child { color: #27346b; font-size: 22rpx; font-weight: 750; }
.event-field picker, .event-field switch { margin-left: auto; color: #7481aa; font-size: 21rpx; }
.event-field switch { transform: scale(0.82); transform-origin: right center; }
.event-field > view:first-child > text { display: block; }
.event-field > view:first-child > text + text { margin-top: 4rpx; color: #a1a9c5; font-size: 16rpx; font-weight: 500; }
.event-field--stack { align-items: stretch; padding: 20rpx 0; flex-direction: column; }
.event-field--stack input { height: 70rpx; margin-top: 10rpx; padding: 0 18rpx; border-radius: 20rpx; background: #f5f6fb; color: #28356d; font-size: 22rpx; }
.event-field--stack textarea { width: auto; min-height: 130rpx; margin-top: 12rpx; padding: 17rpx; border-radius: 22rpx; background: #f5f6fb; box-sizing: border-box; color: #28356d; font-size: 21rpx; }
.event-save { width: 100%; margin-top: 24rpx; }
.event-note { margin-top: 18rpx; color: #98a1be; font-size: 17rpx; text-align: center; }
