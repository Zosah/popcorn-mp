<view class="page-shell pet-event-form">
  <view wx:if="{{loadErrorText}}" class="event-state event-state--error" bindtap="onRetry">
    <line-icon name="circle-alert" size="34" tone="danger" />
    <view class="event-state__copy"><text>表单暂时没有准备好</text><text>{{loadErrorText}}</text></view>
    <text class="event-state__action">重试</text>
  </view>

  <view wx:elif="{{loading}}" class="event-state">
    <line-icon name="clock-3" size="32" tone="muted" />
    <text>正在同步宠物与事件资料…</text>
  </view>

  <block wx:else>
  <view class="event-hero">
    <view class="event-hero__mark"><line-icon name="heart-pulse" size="30" tone="pink" /></view>
    <view class="event-hero__body">
      <view class="eyebrow">记录一件事</view>
      <view class="event-hero__title">{{pageTitle}}</view>
      <view class="event-hero__copy">把发生的事放进{{petName || '它'}}的时间线，下次安排可以以后再定。</view>
    </view>
  </view>

  <view class="paper-card event-card">
    <view class="event-grid">
      <view class="event-field">
        <text class="event-label">事件类型</text>
        <picker range="{{eventTypeLabels}}" value="{{eventTypeIndex}}" bindchange="onTypeChange">
          <view class="event-picker">
            <view class="event-picker__value"><line-icon name="{{eventTypeIconNames[eventTypeIndex]}}" size="21" tone="pink" /><text>{{eventTypeLabels[eventTypeIndex]}}</text></view>
            <text class="event-picker__arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="event-field">
        <text class="event-label">发生日期</text>
        <picker mode="date" value="{{form.occurredOn}}" bindchange="onDateChange">
          <view class="event-picker">
            <view class="event-picker__value"><line-icon name="calendar-days" size="21" tone="pink" /><text>{{form.occurredOn}}</text></view>
            <text class="event-picker__arrow">›</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="event-field event-field--stack">
      <text class="event-label">标题 <text class="event-required">*</text></text>
      <input class="event-input event-input--lead" value="{{form.title}}" maxlength="40" placeholder="发生了什么" bindinput="onTitleInput" placeholder-class="app-input-placeholder" />
    </view>

    <view class="event-field event-field--stack event-field--last">
      <text class="event-label">详细备注</text>
      <textarea class="event-textarea" value="{{form.note}}" maxlength="300" placeholder="过程、结果、注意事项" bindinput="onNoteInput" placeholder-class="app-input-placeholder" />
    </view>
  </view>

  <view class="event-section-head"><view><text>补充信息</text><text>想起来再补也可以</text></view></view>

  <view class="paper-card event-card">
    <view class="event-field event-field--stack">
      <text class="event-label">医院 / 门店 / 地点</text>
      <input class="event-input" value="{{form.provider}}" maxlength="60" placeholder="可选" bindinput="onProviderInput" placeholder-class="app-input-placeholder" />
    </view>
    <view class="event-field event-field--stack">
      <text class="event-label">费用</text>
      <input class="event-input" type="digit" value="{{form.cost}}" placeholder="可选，例如 280" bindinput="onCostInput" placeholder-class="app-input-placeholder" />
    </view>
    <view class="event-switch">
      <view class="event-switch__copy"><text>安排下次日期</text><text>可选，由你决定什么时候再看这件事</text></view>
      <switch checked="{{hasNextDate}}" color="#d49aa5" bindchange="onNextToggle" />
    </view>
    <view wx:if="{{hasNextDate}}" class="event-field event-field--stack event-field--last">
      <text class="event-label">计划日期</text>
      <picker mode="date" value="{{form.nextOn}}" bindchange="onNextDateChange">
        <view class="event-picker event-picker--date">
          <view class="event-picker__value"><line-icon name="calendar-days" size="21" tone="pink" /><text>{{form.nextOn || '选择日期'}}</text></view>
          <text class="event-picker__arrow">›</text>
        </view>
      </picker>
    </view>
  </view>

  <view wx:if="{{errorText}}" class="event-save-error"><line-icon name="circle-alert" size="20" tone="danger" /><text>{{errorText}}</text></view>
  <button class="event-save" loading="{{saving}}" disabled="{{saving}}" bindtap="onSave"><line-icon name="pen-line" size="23" tone="pink" /><text>{{saving ? '正在保存' : saveText}}</text></button>
  <view class="event-note"><line-icon name="circle-alert" size="17" tone="muted" /><text>医疗信息只作家庭生活记录，不构成诊疗建议。</text></view>
  </block>
</view>
