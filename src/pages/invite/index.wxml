<view class="invite-page">
  <view class="subpage-back" bindtap="onBack">← 暂不加入</view>

  <view class="invite-head">
    <view class="invite-head__eyebrow">AN INVITATION HOME</view>
    <view class="invite-head__title">{{statusTitle}}</view>
    <view class="invite-head__copy">{{statusCopy}}</view>
  </view>

  <view wx:if="{{status === 'available' || status === 'accepted'}}" class="home-ticket">
    <view class="home-ticket__top">
      <view class="home-ticket__mark">家</view>
      <view class="home-ticket__number">SPACE 01</view>
    </view>
    <view class="home-ticket__label">你将加入</view>
    <view class="home-ticket__name">{{spaceName}}</view>
    <view class="home-ticket__inviter">
      <view class="home-ticket__avatar">满</view>
      <view>
        <text>时刻在体验官</text>
        <text>邀请你共同记录家里的小事</text>
      </view>
    </view>
    <view class="home-ticket__code">邀请码 · {{code}}</view>
  </view>

  <view class="code-card">
    <view class="code-card__label">邀请码</view>
    <view class="code-card__input-row">
      <input value="{{codeInput}}" maxlength="8" placeholder="例如 SHIKEZAI" placeholder-class="code-card__placeholder" bindinput="onCodeInput" />
      <view bindtap="onValidate">确认</view>
    </view>
    <view wx:if="{{status === 'invalid'}}" class="code-card__error">邀请码应为 SHIKEZAI，或 SKZ 开头的 8 位字符。</view>
  </view>

  <button wx:if="{{canAccept}}" class="primary-button invite-action" bindtap="onAccept">加入 {{spaceName}}</button>
  <button wx:elif="{{status === 'accepted'}}" class="secondary-button invite-action" bindtap="onGoHome">回到我们的家</button>

  <view class="demo-note">
    <view class="demo-note__mark">DEMO</view>
    <view>
      <text>这次加入只保存在当前设备</text>
      <text>真实版本会由服务端校验 7 天有效期、单次使用状态和空间成员权限。</text>
    </view>
  </view>
</view>
