<view class="invite-page">
  <view class="subpage-back" bindtap="onBack">← 暂不加入</view>

  <view class="invite-head">
    <view class="invite-head__title">{{statusTitle}}</view>
    <view class="invite-head__copy">{{statusCopy}}</view>
  </view>

  <view wx:if="{{status === 'available' || status === 'accepted'}}" class="home-ticket">
    <view class="home-ticket__top">
      <view class="home-ticket__mark"><line-icon name="house" size="24" tone="white" /></view>
      <view class="home-ticket__number">共同空间</view>
    </view>
    <view class="home-ticket__label">你将加入</view>
    <view class="home-ticket__name">{{spaceName}}</view>
    <view class="home-ticket__inviter">
      <view class="home-ticket__avatar home-ticket__avatar--{{inviterAvatarTone}}">{{inviterAvatar}}</view>
      <view>
        <text>{{inviterName}}</text>
        <text>邀请你共同记录家里的小事</text>
      </view>
    </view>
    <view class="home-ticket__code">邀请码 · {{code}}<text wx:if="{{expiresLabel}}"> · {{expiresLabel}}</text></view>
  </view>

  <view class="code-card card">
    <view class="code-card__label"><line-icon name="ticket" size="23" tone="muted" /><text>邀请码</text></view>
    <view class="code-card__input-row">
      <input value="{{codeInput}}" maxlength="10" placeholder="例如 7K3M9Q2XAB" placeholder-class="code-card__placeholder" bindinput="onCodeInput" />
      <view bindtap="onValidate">确认</view>
    </view>
    <view wx:if="{{status === 'invalid'}}" class="code-card__error">请检查邀请码是否完整，真实邀请码为 10 位字符。</view>
  </view>

  <view wx:if="{{status === 'empty' || status === 'invalid'}}" class="invite-vignette">
    <image class="invite-vignette__image" src="../../images/ink-letter.png" mode="aspectFit" />
    <view class="invite-vignette__copy">
      <text>一封邀请，写给一起生活的人。</text>
      <text>公版手札 · 插图示例</text>
    </view>
  </view>

  <button wx:if="{{canAccept}}" class="primary-button invite-action" loading="{{isSubmitting}}" bindtap="onAccept"><line-icon name="plus" size="24" tone="white" /><text>加入 {{spaceName}}</text></button>
  <button wx:elif="{{status === 'accepted'}}" class="secondary-button invite-action" bindtap="onGoHome"><line-icon name="house" size="24" tone="ink" /><text>回到我们的家</text></button>

  <view class="demo-note">
    <view class="demo-note__mark"><line-icon name="lock" size="22" tone="muted" /></view>
    <view>
      <text>{{isDemoMode ? '这次加入只保存在当前设备' : '邀请由服务端校验'}}</text>
      <text>{{isDemoMode ? '真实版本会由服务端校验 7 天有效期、单次使用状态和空间成员权限。' : '服务端会在事务中校验 7 天有效期、单次使用状态和空间成员权限。'}}</text>
    </view>
  </view>
</view>
