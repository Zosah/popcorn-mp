.invite-page {
  min-height: 100vh;
  padding: 28rpx 32rpx calc(76rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 100% 0, rgba(236, 220, 209, 0.52), transparent 34%),
    radial-gradient(circle at 0 34%, rgba(224, 235, 228, 0.46), transparent 30%),
    #fbf8f3;
  box-sizing: border-box;
  color: #292c28;
}

.invite-hero {
  position: relative;
  overflow: hidden;
  min-height: 280rpx;
  padding: 35rpx 31rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 42rpx;
  background:
    linear-gradient(135deg, rgba(255, 248, 243, 0.94), rgba(248, 238, 231, 0.82)),
    #fffaf6;
  box-shadow:
    0 28rpx 68rpx -54rpx rgba(75, 56, 43, 0.52),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  box-sizing: border-box;
}

.invite-hero__mesh {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.invite-hero__mesh--one {
  top: -100rpx;
  right: -42rpx;
  width: 260rpx;
  height: 260rpx;
  background: radial-gradient(circle, rgba(230, 182, 170, 0.3), rgba(230, 182, 170, 0));
}

.invite-hero__mesh--two {
  right: 96rpx;
  bottom: -105rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(198, 219, 207, 0.35), rgba(198, 219, 207, 0));
}

.invite-hero__eyebrow {
  position: relative;
  color: #b46d5e;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.invite-hero__title {
  position: relative;
  max-width: 500rpx;
  margin-top: 13rpx;
  color: #292c28;
  font-family: "Songti SC", "STSong", serif;
  font-size: 54rpx;
  font-weight: 760;
  letter-spacing: -1.5rpx;
  line-height: 1.22;
}

.invite-hero__copy {
  position: relative;
  max-width: 470rpx;
  margin-top: 12rpx;
  color: #736b63;
  font-size: 26rpx;
  line-height: 1.62;
}

.invite-hero__marks {
  position: absolute;
  right: 27rpx;
  bottom: 27rpx;
  display: flex;
  align-items: flex-end;
  gap: 2rpx;
  transform: rotate(-5deg);
}

.invite-hero__mark {
  display: flex;
  width: 70rpx;
  height: 70rpx;
  align-items: center;
  justify-content: center;
}

.invite-hero__mark--small { transform: translateY(6rpx) rotate(9deg); }

.invite-ticket {
  position: relative;
  overflow: hidden;
  margin-top: 22rpx;
  padding: 28rpx 29rpx 25rpx;
  border: 1rpx solid rgba(234, 200, 194, 0.82);
  border-radius: 38rpx;
  background:
    radial-gradient(circle at 100% 0, rgba(239, 198, 190, 0.38), transparent 34%),
    linear-gradient(145deg, rgba(255, 251, 249, 0.98), rgba(252, 239, 237, 0.94));
  box-shadow:
    0 24rpx 54rpx -48rpx rgba(132, 73, 67, 0.5),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
}

.invite-ticket::before,
.invite-ticket::after {
  position: absolute;
  top: 76%;
  width: 30rpx;
  height: 30rpx;
  border: 1rpx solid rgba(234, 200, 194, 0.82);
  border-radius: 50%;
  background: #fbf8f3;
  content: "";
}

.invite-ticket::before { left: -18rpx; }
.invite-ticket::after { right: -18rpx; }

.invite-ticket__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.invite-ticket__label {
  color: #b46d5e;
  font-size: 21rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.invite-ticket__seal {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  background: rgba(255, 255, 255, 0.65);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.invite-ticket__space {
  margin-top: 20rpx;
  color: #2b2e2a;
  font-family: "Songti SC", "STSong", serif;
  font-size: 50rpx;
  font-weight: 760;
  letter-spacing: -1rpx;
  line-height: 1.28;
}

.invite-ticket__inviter {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  gap: 14rpx;
}

.invite-ticket__avatar {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  overflow: hidden;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 21rpx;
  color: #2b2e2a;
  flex-shrink: 0;
  font-family: "Songti SC", "STSong", serif;
  font-size: 27rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx -20rpx rgba(67, 49, 40, 0.58);
}

.invite-ticket__avatar--image { display: block; object-fit: cover; }
.invite-ticket__avatar--lavender { background: #dce5e9; }
.invite-ticket__avatar--mint { background: #dfece5; }
.invite-ticket__avatar--peach { background: #efd7d2; }
.invite-ticket__avatar--sun { background: #f1e6c9; }

.invite-ticket__inviter-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.invite-ticket__inviter-copy text:first-child {
  color: #353833;
  font-size: 26rpx;
  font-weight: 700;
}

.invite-ticket__inviter-copy text:last-child {
  margin-top: 3rpx;
  color: #a16458;
  font-size: 22rpx;
}

.invite-ticket__divider {
  margin: 23rpx 0 17rpx;
  border-top: 1rpx dashed rgba(184, 119, 105, 0.26);
}

.invite-ticket__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.invite-ticket__code {
  color: #9f5d50;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.invite-ticket__expiry {
  color: #8e8177;
  font-size: 20rpx;
  text-align: right;
}

.join-readiness {
  display: flex;
  align-items: center;
  margin-top: 21rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.6);
  box-shadow: 0 16rpx 38rpx -38rpx rgba(64, 50, 41, 0.42);
  gap: 15rpx;
}

.join-readiness__icon {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  background: rgba(250, 235, 231, 0.88);
  flex-shrink: 0;
}

.join-readiness__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.join-readiness__copy text:first-child {
  color: #343733;
  font-size: 25rpx;
  font-weight: 700;
}

.join-readiness__copy text:last-child {
  margin-top: 4rpx;
  color: #81776f;
  font-size: 22rpx;
  line-height: 1.5;
}

.invite-code-card {
  margin-top: 22rpx;
  padding: 23rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.7);
  box-shadow: 0 20rpx 44rpx -42rpx rgba(66, 51, 42, 0.4);
}

.invite-code-card__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.invite-code-card__icon {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: rgba(249, 232, 228, 0.88);
}

.invite-code-card__head > view:last-child text { display: block; }
.invite-code-card__head > view:last-child text:first-child {
  color: #353833;
  font-size: 26rpx;
  font-weight: 700;
}
.invite-code-card__head > view:last-child text:last-child {
  margin-top: 2rpx;
  color: #91877e;
  font-size: 21rpx;
}

.invite-code-card__row {
  display: flex;
  align-items: center;
  margin-top: 17rpx;
  gap: 12rpx;
}

.invite-code-card__row input {
  min-width: 0;
  height: 80rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e8dfda;
  border-radius: 22rpx;
  background: #f7f2ed;
  box-sizing: border-box;
  color: #30332f;
  flex: 1;
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  letter-spacing: 3rpx;
}

.invite-code-card__placeholder {
  color: #aaa098;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 24rpx;
  letter-spacing: 0;
}

.invite-code-card__submit {
  display: flex;
  width: 112rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 22rpx;
  background: #f1ddd8;
  color: #a45e51;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.invite-code-card__submit::after { border: 0; }
.invite-code-card__error {
  display: block;
  margin-top: 11rpx;
  color: #b45f50;
  font-size: 22rpx;
  line-height: 1.5;
}

.invite-story {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 16rpx 19rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.56);
  gap: 20rpx;
}

.invite-story__image {
  width: 126rpx;
  height: 178rpx;
  flex-shrink: 0;
  transform: rotate(-1.5deg);
}

.invite-story__copy { min-width: 0; flex: 1; }
.invite-story__copy text { display: block; }
.invite-story__copy text:first-child {
  color: #383a36;
  font-family: "Songti SC", "STSong", serif;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.52;
}
.invite-story__copy text:last-child {
  margin-top: 8rpx;
  color: #8a8077;
  font-size: 21rpx;
  line-height: 1.58;
}

.invite-primary {
  display: flex;
  width: 100%;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  margin: 24rpx 0 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #cf8b7c 0%, #b86757 58%, #ad5f51 100%);
  box-shadow:
    0 24rpx 44rpx -28rpx rgba(166, 82, 68, 0.7),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
  box-sizing: border-box;
  color: #ffffff;
  gap: 10rpx;
  font-size: 29rpx;
  font-weight: 700;
  letter-spacing: 0.3rpx;
  line-height: 1;
  transition: opacity 120ms ease, transform 120ms ease;
}

.invite-primary::after { border: 0; }
.invite-primary--pressed { opacity: 0.9; transform: scale(0.988); }

.invite-primary__arrow {
  display: flex;
  width: 39rpx;
  height: 39rpx;
  align-items: center;
  justify-content: center;
  margin-left: 3rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1;
}

.invite-secondary {
  display: flex;
  width: 100%;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  margin: 24rpx 0 0;
  padding: 0;
  border: 1rpx solid rgba(188, 111, 96, 0.19);
  border-radius: 31rpx;
  background: rgba(255, 249, 246, 0.92);
  color: #9f5e51;
  gap: 10rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1;
}

.invite-secondary::after { border: 0; }

.invite-footnote {
  margin-top: 16rpx;
  color: #958a81;
  font-size: 21rpx;
  line-height: 1.55;
  text-align: center;
}
