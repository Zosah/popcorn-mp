.todo-form-page {
  padding-top: 28rpx;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.todo-form-head {
  padding: 29rpx 27rpx 27rpx;
  border-radius: 38rpx;
  background: linear-gradient(140deg, rgba(255, 255, 255, 0.84), rgba(232, 243, 255, 0.62) 52%, rgba(231, 247, 239, 0.72));
}

.todo-form-head__mark {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 17rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.68);
  box-shadow: 0 8rpx 20rpx rgba(68, 61, 76, 0.08);
}

.todo-form-head__title {
  max-width: 620rpx;
  color: var(--c-text, #292737);
  font-size: 43rpx;
  font-weight: 600;
  letter-spacing: -2rpx;
  line-height: 1.3;
}

.todo-form-head__copy {
  max-width: 610rpx;
  margin-top: 10rpx;
  color: var(--c-text-2, #615f70);
  font-size: 20rpx;
  line-height: 1.65;
}

.kind-picker {
  margin-top: 21rpx;
}

.kind-picker__row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 11rpx;
}

.kind-option {
  display: flex;
  min-height: 82rpx;
  align-items: center;
  justify-content: flex-start;
  padding: 0 14rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.80);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.50);
  color: var(--c-text-2, #615f70);
  gap: 8rpx;
  font-size: 18rpx;
  white-space: nowrap;
}

.kind-option--active {
  border-color: rgba(116, 106, 174, 0.22);
  background: linear-gradient(145deg, rgba(241, 238, 255, 0.98), rgba(229, 247, 241, 0.82));
  box-shadow: 0 10rpx 24rpx rgba(68, 61, 76, 0.08);
  color: var(--c-primary-deep, #665c9c);
  font-weight: 600;
}

.kind-hint {
  display: inline-flex;
  margin: 10rpx 0 19rpx;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.44);
  color: var(--c-muted, #8a8693);
  font-size: 17rpx;
}

.todo-form-card {
  padding: 7rpx 12rpx;
  border-radius: 34rpx;
}

.todo-field {
  margin: 8rpx 0;
  padding: 16rpx 17rpx 13rpx;
  border: 1rpx solid rgba(87, 80, 93, 0.06);
  border-radius: 23rpx;
  background: rgba(247, 246, 252, 0.78);
}

.todo-field--last {
  margin-bottom: 8rpx;
}

.todo-field > text,
.todo-field--stack > text {
  display: block;
  color: var(--c-muted, #8a8693);
  font-size: 18rpx;
}

.todo-field input {
  height: 57rpx;
  margin-top: 2rpx;
  color: var(--c-text, #292737);
  font-size: 26rpx;
  font-weight: 600;
}

.todo-field input::placeholder,
.todo-field textarea::placeholder {
  color: #aaa7b8;
  font-weight: 400;
}

.todo-field textarea {
  width: 100%;
  min-height: 96rpx;
  box-sizing: border-box;
  margin-top: 9rpx;
  padding: 0;
  color: var(--c-text, #292737);
  font-size: 21rpx;
  line-height: 1.65;
}

.todo-form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.todo-form-grid .todo-field {
  margin: 8rpx 0;
}

.todo-form-tip {
  margin: 4rpx 0 10rpx;
  padding: 13rpx 15rpx;
  border-radius: 19rpx;
  background: rgba(255, 244, 226, 0.62);
  color: var(--c-muted, #8a8693);
  font-size: 17rpx;
}

.todo-form-tip--action {
  display: flex;
  align-items: flex-start;
  gap: 13rpx;
}

.todo-form-tip--action text:first-child {
  flex: 1;
  line-height: 1.55;
}

.todo-form-tip--action text:last-child {
  padding: 5rpx 9rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.62);
  color: var(--c-primary-deep, #665c9c);
  flex-shrink: 0;
  white-space: nowrap;
}

.meal-options {
  display: flex;
  margin-top: 10rpx;
  gap: 8rpx;
}

.meal-option {
  display: flex;
  height: 51rpx;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.45);
  color: var(--c-muted, #8a8693);
  font-size: 18rpx;
}

.meal-option--active {
  border-color: rgba(116, 106, 174, 0.20);
  background: rgba(240, 237, 247, 0.88);
  color: var(--c-primary-deep, #665c9c);
  font-weight: 600;
}

.todo-field--date {
  position: relative;
}

.todo-date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.todo-date-picker > view {
  display: flex;
  flex-direction: column;
}

.todo-date-picker > view > text:first-child {
  color: var(--c-muted, #8a8693);
  font-size: 18rpx;
}

.todo-date-picker > view > text:last-child {
  margin-top: 3rpx;
  color: var(--c-faint, #b7b2bb);
  font-size: 24rpx;
  font-weight: 600;
}

.todo-date-picker > view > .todo-date-picker__value {
  color: var(--c-text, #292737);
}

.todo-date-picker__action {
  padding: 7rpx 11rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.60);
  color: var(--c-primary-deep, #665c9c);
  font-size: 17rpx;
}

.todo-date-clear {
  display: inline-block;
  margin-top: 8rpx;
  padding-bottom: 2rpx;
  border-bottom: 1rpx solid rgba(87, 80, 93, 0.18);
  color: var(--c-muted, #8a8693);
  font-size: 17rpx;
}

.todo-form-save {
  width: 100%;
  margin-top: 25rpx;
  gap: 9rpx;
  box-shadow: 0 18rpx 40rpx rgba(91, 75, 188, 0.25);
}

.todo-form-delete {
  margin-top: 23rpx;
  color: var(--c-danger, #b96f78);
  font-size: 19rpx;
  line-height: 1.5;
  text-align: center;
}

.todo-form-state {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  color: var(--c-muted, #8a8693);
  font-size: 20rpx;
}

.todo-form-state text {
  flex: 1;
}

.todo-form-state > view:last-child {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.70);
  color: var(--c-primary-deep, #665c9c);
  flex-shrink: 0;
}
