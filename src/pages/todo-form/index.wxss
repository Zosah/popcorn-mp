.todo-form-page {
  --todo-deep: var(--c-primary, #252b27);
  --todo-green: var(--c-sage, #668478);
  --todo-green-soft: var(--c-sage-soft, #e2eee9);
  --todo-ink: var(--c-text, #252b27);
  --todo-ink-2: var(--c-text-2, #5f5a53);
  --todo-ink-3: var(--c-muted, #837f76);
  --todo-line: var(--c-line, #e9e6e1);
  padding: 28rpx 36rpx calc(104rpx + env(safe-area-inset-bottom));
  background: var(--c-paper, #f8f7f4);
  color: var(--todo-ink);
}
.todo-hero { display: flex; align-items: flex-start; padding: 8rpx 2rpx 27rpx; gap: 18rpx; }
.todo-hero__mark { display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border-radius: 24rpx; background: var(--todo-green-soft); flex-shrink: 0; }
.todo-hero__body { min-width: 0; flex: 1; }
.todo-hero__title {
  font-family: var(--font-serif); margin-top: 8rpx; color: var(--todo-ink); font-size: 45rpx; font-weight: 700; line-height: 1.3; letter-spacing: -1.4rpx; }
.todo-hero__copy { margin-top: 9rpx; color: var(--todo-ink-2); font-size: 25rpx; line-height: 1.6; }

.paper-card { box-sizing: border-box; border: 1rpx solid var(--todo-line); border-radius: 30rpx; background: #ffffff; box-shadow: 0 12rpx 30rpx rgba(42, 62, 50, 0.045); }
.kind-section { margin-bottom: 18rpx; }
.kind-section__head { display: flex; align-items: baseline; justify-content: space-between; margin: 0 4rpx 11rpx; gap: 18rpx; }
.kind-section__head text:first-child { color: var(--todo-ink); font-size: 29rpx; font-weight: 700; }
.kind-section__head text:last-child { overflow: hidden; color: var(--todo-ink-3); font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.kind-picker { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; }
.kind-option { display: flex; min-height: 92rpx; align-items: center; padding: 13rpx 12rpx; box-sizing: border-box; border: 1rpx solid rgba(226, 231, 223, 0.9); border-radius: 23rpx; background: #fbf7f1; flex-direction: column; gap: 7rpx; text-align: center; }
.kind-option--0 { background: #f7f1e9; }
.kind-option--1 { background: #eef5f0; }
.kind-option--2 { background: var(--c-coral-soft, #f7e7e2); }
.kind-option--3 { background: var(--c-butter-soft, #f2e8cc); }
.kind-option--4 { background: var(--c-coral-soft, #f7e7e2); }
.kind-option--active { border-color: #8eb5a0; background: var(--c-sage-soft, #e2eee9); box-shadow: inset 0 0 0 1rpx rgba(45, 74, 58, 0.06); }
.kind-option__mark { display: flex; width: 43rpx; height: 43rpx; align-items: center; justify-content: center; border-radius: 14rpx; background: rgba(255, 255, 255, 0.74); }
.kind-option text { color: var(--todo-ink-2); font-size: 21rpx; line-height: 1.35; }
.kind-option--active text { color: var(--todo-deep); font-weight: 700; }

.todo-paper { overflow: hidden; padding: 0 22rpx; }
.todo-field { padding: 20rpx 0; border-bottom: 1rpx solid var(--todo-line); }
.todo-field--lead { padding-top: 23rpx; }
.todo-field--last { border-bottom: 0; }
.todo-label { display: block; color: var(--todo-ink-3); font-size: 23rpx; font-weight: 500; letter-spacing: 0.4rpx; }
.todo-required { color: var(--c-primary-link, #b86757); }
.todo-input { height: 62rpx; margin-top: 3rpx; color: var(--todo-ink); font-size: 29rpx; font-weight: 600; }
.todo-input--lead { height: 70rpx; font-size: 34rpx; }
.todo-input::placeholder, .todo-textarea::placeholder { color: var(--c-muted, #837f76); font-weight: 400; }
.todo-textarea { width: 100%; min-height: 100rpx; box-sizing: border-box; margin-top: 9rpx; padding: 14rpx 16rpx; border-radius: 20rpx; background: var(--c-paper-2, #f1ede7); color: var(--todo-ink); font-size: 27rpx; line-height: 1.72; }
.todo-textarea--checklist { min-height: 150rpx; }
.todo-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22rpx; border-bottom: 1rpx solid var(--todo-line); }
.todo-grid .todo-field { border-bottom: 0; }
.todo-grid .todo-field + .todo-field { padding-left: 20rpx; border-left: 1rpx solid var(--todo-line); }
.todo-hint { margin: 0 2rpx 18rpx; padding: 13rpx 15rpx; border-radius: 18rpx; background: #f8f2e7; color: var(--todo-ink-3); font-size: 21rpx; line-height: 1.55; }
.todo-hint--action { display: flex; align-items: flex-start; gap: 12rpx; }
.todo-hint--action text:first-child { flex: 1; }
.todo-hint--action text:last-child { padding: 5rpx 10rpx; border-radius: 999rpx; background: #ffffff; color: var(--todo-deep); flex-shrink: 0; font-weight: 600; }
.meal-options { display: flex; margin-top: 10rpx; gap: 8rpx; }
.meal-option { display: flex; min-width: 92rpx; height: 54rpx; align-items: center; justify-content: center; padding: 0 14rpx; border: 1rpx solid var(--todo-line); border-radius: 999rpx; background: var(--c-paper, #f8f7f4); color: var(--todo-ink-3); font-size: 22rpx; }
.meal-option--active { border-color: var(--c-sage, #668478); background: var(--c-sage-soft, #e2eee9); color: var(--todo-deep); font-weight: 700; }

.todo-field--date { padding-bottom: 16rpx; }
.todo-date { display: flex; min-height: 72rpx; align-items: center; gap: 12rpx; }
.todo-date__mark { display: flex; width: 52rpx; height: 52rpx; align-items: center; justify-content: center; border-radius: 17rpx; background: var(--todo-green-soft); flex-shrink: 0; }
.todo-date__body { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.todo-date__body text:first-child { color: var(--todo-ink-3); font-size: 22rpx; }
.todo-date__body text:last-child { margin-top: 2rpx; color: var(--c-muted, #837f76); font-size: 27rpx; font-weight: 600; }
.todo-date__body .todo-date__value { color: var(--todo-ink); }
.todo-date__action { padding: 7rpx 10rpx; border-radius: 999rpx; background: var(--c-paper-2, #f1ede7); color: var(--todo-deep); font-size: 21rpx; }
.todo-date-clear { display: inline-block; margin-top: 6rpx; color: var(--todo-ink-3); font-size: 21rpx; text-decoration: underline; }
.todo-field__tip { display: block; margin-top: 7rpx; color: var(--todo-ink-3); font-size: 21rpx; }

.todo-save { width: 100%; margin-top: 27rpx; gap: 9rpx; }
.todo-delete { margin-top: 20rpx; color: #c46f7f; font-size: 23rpx; text-align: center; }
.todo-state { display: flex; margin-top: 8rpx; padding: 54rpx 28rpx; align-items: center; flex-direction: column; text-align: center; }
.todo-state__mark { display: flex; width: 80rpx; height: 80rpx; align-items: center; justify-content: center; border-radius: 26rpx; background: var(--todo-green-soft); }
.todo-state--error .todo-state__mark { background: var(--c-coral-soft, #f7e7e2); }
.todo-state__title { margin-top: 16rpx; color: var(--todo-ink); font-size: 29rpx; font-weight: 700; }
.todo-state__copy { max-width: 500rpx; margin-top: 7rpx; color: var(--todo-ink-3); font-size: 24rpx; line-height: 1.6; }
.todo-state__action { margin-top: 18rpx; padding: 12rpx 22rpx; border-radius: 999rpx; background: var(--todo-deep); color: #fff; font-size: 23rpx; font-weight: 600; }
