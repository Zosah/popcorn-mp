.todo-form-page {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.todo-form-head {
  padding: 8rpx 0 30rpx;
}

.todo-form-head__mark {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  border: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-radius: 50%;
  background: var(--c-primary-soft, #eaedfc);
}

.todo-form-head__title {
  max-width: 620rpx;
  color: var(--c-text, #22242e);
  font-family: "Songti SC", "STSong", serif;
  font-size: 46rpx;
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: -2rpx;
}

.todo-form-head__copy {
  max-width: 610rpx;
  margin-top: 12rpx;
  color: var(--c-text-2, #5c5f6e);
  font-size: 24rpx;
  line-height: 1.65;
}

.kind-picker {
  margin-top: 2rpx;
}

.kind-picker__row {
  display: flex;
  padding-bottom: 10rpx;
  flex-wrap: wrap;
  gap: 10rpx;
}

.kind-option {
  display: flex;
  height: 62rpx;
  align-items: center;
  padding: 0 18rpx;
  border: 1rpx solid var(--c-line, #e7e6ee);
  border-radius: 999rpx;
  color: var(--c-text-2, #5c5f6e);
  gap: 7rpx;
  font-size: 21rpx;
  white-space: nowrap;
}

.kind-option--active {
  border-color: var(--c-accent, #5b6ee0);
  background: var(--c-surface, #fff);
  color: var(--c-accent, #5b6ee0);
  font-weight: 500;
}

.kind-hint {
  margin: 4rpx 0 20rpx;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
}

.todo-form-card {
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.todo-field {
  padding: 23rpx 0;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.todo-field--last {
  border-bottom: 0;
}

.todo-field > text,
.todo-field--stack > text {
  display: block;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.todo-field input {
  height: 66rpx;
  margin-top: 5rpx;
  color: var(--c-text, #22242e);
  font-size: 29rpx;
  font-weight: 500;
}

.todo-field input::placeholder,
.todo-field textarea::placeholder {
  color: #a8abba;
  font-weight: 400;
}

.todo-field textarea {
  width: 100%;
  min-height: 108rpx;
  box-sizing: border-box;
  margin-top: 14rpx;
  padding: 14rpx 0 14rpx 18rpx;
  border-left: 1rpx solid var(--c-line-strong, #d6d5e0);
  color: var(--c-text, #22242e);
  font-size: 24rpx;
  line-height: 1.7;
}

.todo-form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.todo-form-grid .todo-field {
  border-bottom: 0;
}

.todo-form-grid .todo-field + .todo-field {
  padding-left: 24rpx;
  border-left: 1rpx solid var(--c-line, #e7e6ee);
}

.todo-form-tip {
  padding: 12rpx 0 16rpx;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
  color: var(--c-muted, #9497a6);
  font-size: 19rpx;
}

.todo-form-tip--action {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.todo-form-tip--action text:first-child {
  flex: 1;
  line-height: 1.55;
}

.todo-form-tip--action text:last-child {
  padding-bottom: 2rpx;
  border-bottom: 1rpx solid var(--c-accent, #5b6ee0);
  color: var(--c-accent, #5b6ee0);
  flex-shrink: 0;
  white-space: nowrap;
}

.meal-options {
  display: flex;
  margin-top: 14rpx;
  gap: 10rpx;
}

.meal-option {
  display: flex;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border: 1rpx solid var(--c-line, #e7e6ee);
  border-radius: 999rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.meal-option--active {
  border-color: var(--c-text, #22242e);
  color: var(--c-text, #22242e);
}

.todo-field--date {
  position: relative;
}

.todo-date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.todo-date-picker > view {
  display: flex;
  flex-direction: column;
}

.todo-date-picker > view > text:first-child {
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.todo-date-picker > view > text:last-child {
  margin-top: 5rpx;
  color: var(--c-faint, #a8abba);
  font-size: 27rpx;
  font-weight: 500;
}

.todo-date-picker > view > .todo-date-picker__value {
  color: var(--c-text, #22242e);
}

.todo-date-picker__action {
  color: var(--c-text, #22242e);
  font-size: 21rpx;
}

.todo-date-clear {
  display: inline-block;
  margin-top: 11rpx;
  padding-bottom: 2rpx;
  border-bottom: 1rpx solid var(--c-line-strong, #d6d5e0);
  color: var(--c-muted, #9497a6);
  font-size: 19rpx;
}

.todo-form-save {
  width: 100%;
  margin-top: 32rpx;
  gap: 9rpx;
}

.todo-form-delete {
  margin-top: 30rpx;
  color: var(--c-danger, #e8695c);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}
