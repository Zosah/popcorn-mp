.todo-form-page {
  --todo-deep: var(--c-primary, #252b27);
  --todo-green: var(--c-sage, #668478);
  --todo-green-soft: var(--c-sage-soft, #e2eee9);
  --todo-ink: var(--c-text, #252b27);
  --todo-ink-2: var(--c-text-2, #5f5a53);
  --todo-ink-3: var(--c-muted, #837f76);
  --todo-line: var(--c-line, #e9e6e1);
  min-height: 100vh;
  padding: 28rpx 34rpx calc(104rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 100% 0, rgba(245, 219, 209, 0.36), transparent 25%),
    linear-gradient(180deg, #fffaf5 0%, #f7f4ef 100%);
  box-sizing: border-box;
  color: var(--todo-ink);
}

.todo-hero {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 2rpx 27rpx;
  gap: 18rpx;
}

.todo-hero__mark {
  display: flex;
  width: 74rpx;
  height: 74rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 24rpx;
  background: var(--todo-green-soft);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  flex-shrink: 0;
}

.todo-hero__body {
  min-width: 0;
  flex: 1;
}

.todo-hero__title {
  margin-top: 2rpx;
  color: var(--todo-ink);
  font-family: var(--font-serif);
  font-size: 46rpx;
  font-weight: 730;
  letter-spacing: -1.4rpx;
  line-height: 1.3;
}

.todo-hero__copy {
  margin-top: 8rpx;
  color: var(--todo-ink-2);
  font-size: 24rpx;
  line-height: 1.55;
}

.paper-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow:
    0 24rpx 52rpx -48rpx rgba(67, 55, 45, 0.48),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx);
}

.todo-paper {
  overflow: hidden;
  padding: 0 22rpx;
}

.todo-field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--todo-line);
}

.todo-field--lead {
  padding-top: 23rpx;
}

.todo-field--last {
  border-bottom: 0;
}

.todo-label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.todo-label {
  display: block;
  color: var(--todo-ink-3);
  font-size: 23rpx;
  font-weight: 550;
  letter-spacing: 0.3rpx;
}

.todo-label__optional {
  color: #aaa29a;
  font-size: 20rpx;
}

.todo-required {
  color: var(--c-primary-link, #b86757);
}

.todo-input {
  height: 62rpx;
  margin-top: 3rpx;
  color: var(--todo-ink);
  font-size: 29rpx;
  font-weight: 620;
}

.todo-input--lead {
  height: 70rpx;
  font-size: 34rpx;
}

.todo-input::placeholder,
.todo-textarea::placeholder,
.tag-input::placeholder {
  color: var(--c-muted, #837f76);
  font-weight: 400;
}

.tag-input-wrap {
  display: flex;
  height: 66rpx;
  align-items: center;
  margin-top: 9rpx;
  padding: 0 15rpx;
  border: 1rpx solid rgba(220, 213, 203, 0.78);
  border-radius: 19rpx;
  background: rgba(247, 243, 237, 0.82);
  gap: 9rpx;
}

.tag-input {
  min-width: 0;
  height: 62rpx;
  color: var(--todo-ink);
  flex: 1;
  font-size: 27rpx;
}

.tag-input__clear {
  padding: 6rpx 9rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  color: var(--todo-ink-3);
  flex: 0 0 auto;
  font-size: 20rpx;
}

.tag-suggestions {
  width: 100%;
  margin-top: 11rpx;
  white-space: nowrap;
}

.tag-suggestions__row {
  display: inline-flex;
  padding-right: 22rpx;
  gap: 8rpx;
}

.tag-suggestion {
  padding: 8rpx 15rpx;
  border: 1rpx solid rgba(218, 211, 201, 0.76);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: var(--todo-ink-2);
  font-size: 21rpx;
  line-height: 1.35;
}

.tag-suggestion--active {
  border-color: rgba(121, 152, 132, 0.68);
  background: var(--todo-green-soft);
  color: #4f6f61;
  font-weight: 680;
}

.todo-textarea {
  width: 100%;
  min-height: 100rpx;
  box-sizing: border-box;
  margin-top: 9rpx;
  padding: 14rpx 16rpx;
  border-radius: 20rpx;
  background: var(--c-paper-2, #f1ede7);
  color: var(--todo-ink);
  font-size: 27rpx;
  line-height: 1.72;
}

.todo-textarea--checklist {
  min-height: 150rpx;
}

.todo-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
  border-bottom: 1rpx solid var(--todo-line);
}

.todo-grid .todo-field {
  border-bottom: 0;
}

.todo-grid .todo-field + .todo-field {
  padding-left: 20rpx;
  border-left: 1rpx solid var(--todo-line);
}

.todo-hint {
  margin: 0 2rpx 18rpx;
  padding: 13rpx 15rpx;
  border-radius: 18rpx;
  background: #f8f2e7;
  color: var(--todo-ink-3);
  font-size: 21rpx;
  line-height: 1.55;
}

.todo-hint--action {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.todo-hint--action text:first-child {
  flex: 1;
}

.todo-hint--action text:last-child {
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--todo-deep);
  flex-shrink: 0;
  font-weight: 600;
}

.meal-options {
  display: flex;
  margin-top: 10rpx;
  gap: 8rpx;
}

.meal-option {
  display: flex;
  min-width: 92rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  border: 1rpx solid var(--todo-line);
  border-radius: 999rpx;
  background: var(--c-paper, #f8f7f4);
  color: var(--todo-ink-3);
  font-size: 22rpx;
}

.meal-option--active {
  border-color: var(--c-sage, #668478);
  background: var(--c-sage-soft, #e2eee9);
  color: var(--todo-deep);
  font-weight: 700;
}

.todo-field--date {
  padding-bottom: 16rpx;
}

.todo-date {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  gap: 12rpx;
}

.todo-date__mark {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  background: var(--todo-green-soft);
  flex-shrink: 0;
}

.todo-date__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.todo-date__body text:first-child {
  color: var(--todo-ink-3);
  font-size: 22rpx;
}

.todo-date__body text:last-child {
  margin-top: 2rpx;
  color: var(--c-muted, #837f76);
  font-size: 27rpx;
  font-weight: 600;
}

.todo-date__body .todo-date__value {
  color: var(--todo-ink);
}

.todo-date__action {
  padding: 7rpx 10rpx;
  border-radius: 999rpx;
  background: var(--c-paper-2, #f1ede7);
  color: var(--todo-deep);
  font-size: 21rpx;
}

.todo-date-clear {
  display: inline-block;
  margin-top: 6rpx;
  color: var(--todo-ink-3);
  font-size: 21rpx;
  text-decoration: underline;
}

.todo-field__tip {
  display: block;
  margin-top: 7rpx;
  color: var(--todo-ink-3);
  font-size: 21rpx;
}

.todo-save {
  width: 100%;
  margin-top: 27rpx;
  gap: 9rpx;
}

.todo-delete {
  margin-top: 20rpx;
  color: #c46f7f;
  font-size: 23rpx;
  text-align: center;
}

.todo-state {
  display: flex;
  margin-top: 8rpx;
  padding: 54rpx 28rpx;
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.todo-state__mark {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background: var(--todo-green-soft);
}

.todo-state--error .todo-state__mark {
  background: var(--c-coral-soft, #f7e7e2);
}

.todo-state__title {
  margin-top: 16rpx;
  color: var(--todo-ink);
  font-size: 29rpx;
  font-weight: 700;
}

.todo-state__copy {
  max-width: 500rpx;
  margin-top: 7rpx;
  color: var(--todo-ink-3);
  font-size: 24rpx;
  line-height: 1.6;
}

.todo-state__action {
  margin-top: 18rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: var(--todo-deep);
  color: #fff;
  font-size: 23rpx;
  font-weight: 600;
}
