<view class="app-tab-shell" role="navigation" aria-label="底部导航">
  <view class="app-tab-bar">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="app-tab-item {{visualActiveId === item.id ? 'app-tab-item--active' : ''}} {{pendingId === item.id ? 'app-tab-item--pending' : ''}}"
      hover-class="app-tab-item--pressed"
      data-id="{{item.id}}"
      bindtap="onSelect"
    >
      <view class="app-tab-item__icon">
        <line-icon name="{{item.icon}}" size="44" tone="{{visualActiveId === item.id ? 'ink' : 'muted'}}" />
      </view>
      <text class="app-tab-item__label">{{item.label}}</text>
    </view>
  </view>
</view>
