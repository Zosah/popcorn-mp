.app-tab-shell {
  position: fixed;
  right: 22rpx;
  bottom: calc(4rpx + env(safe-area-inset-bottom));
  left: 22rpx;
  z-index: 900;
  pointer-events: none;
}

.app-tab-bar {
  display: flex;
  height: 92rpx;
  align-items: center;
  padding: 7rpx 9rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 32rpx;
  background: rgba(255, 254, 250, 0.98);
  box-shadow:
    0 12rpx 28rpx -12rpx rgba(63, 52, 42, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.94);
  pointer-events: auto;
}

.app-tab-item {
  position: relative;
  display: flex;
  min-width: 0;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  color: #8d8580;
  flex: 1;
  gap: 7rpx;
  transition: background 160ms ease, color 160ms ease, transform 120ms ease;
}

.app-tab-item--active {
  background: #f3eee5;
  color: #2e2a28;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
}

.app-tab-item--pending {
  opacity: 0.82;
}

.app-tab-item--pressed {
  opacity: 0.75;
  transform: scale(0.97);
}

.app-tab-item__icon {
  display: flex;
  width: 38rpx;
  height: 38rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  flex: 0 0 auto;
}

.app-tab-item__icon--blue { background: #eaf1f7; }
.app-tab-item__icon--green { background: #eef5ef; }
.app-tab-item__icon--gold { background: #fbf3e1; }
.app-tab-item__icon--pink { background: #fcedf0; }
.app-tab-item__icon--orange { background: #fdf0e4; }

.app-tab-item__label {
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@media (prefers-reduced-motion: reduce) {
  .app-tab-item {
    transition: none;
  }
}
