/* 底部导航：五项悬浮胶囊，轻毛玻璃与单层选中态。 */
.app-tab-shell {
  position: fixed;
  right: 22rpx;
  bottom: calc(14rpx + env(safe-area-inset-bottom));
  left: 22rpx;
  z-index: 900;
  padding: 7rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow:
    0 18rpx 48rpx rgba(74, 62, 52, 0.13),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
  backdrop-filter: blur(24rpx) saturate(150%);
  -webkit-backdrop-filter: blur(24rpx) saturate(150%);
  transform: translateZ(0);
}

.app-tab-bar {
  display: flex;
  height: 94rpx;
  align-items: stretch;
  padding: 3rpx;
  box-sizing: border-box;
  gap: 2rpx;
}

.app-tab-item {
  position: relative;
  display: flex;
  min-width: 0;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 33rpx;
  color: var(--c-faint, #a29b91);
  flex: 1;
  flex-direction: column;
  gap: 1rpx;
  transition:
    color 120ms ease,
    opacity 120ms ease,
    transform 120ms ease;
}

.app-tab-item--active {
  color: var(--c-primary, #252b27);
  background: rgba(102, 132, 120, 0.1);
}

.app-tab-item__icon {
  display: flex;
  width: 54rpx;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: transparent;
  flex: 0 0 auto;
  transition: background 120ms ease, transform 120ms ease;
}

.app-tab-item__label {
  overflow: hidden;
  color: inherit;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.app-tab-item--active .app-tab-item__label {
  font-weight: 700;
}

.app-tab-item--pending .app-tab-item__icon {
  transform: scale(0.94);
}

.app-tab-item--pressed {
  opacity: 0.68;
  transform: scale(0.97);
}

@media (prefers-reduced-motion: reduce) {
  .app-tab-item,
  .app-tab-item__icon {
    transition: none;
  }
}
