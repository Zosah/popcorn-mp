/* 全局轻提示：无图标、单行、宽度随文字自适应 */
.app-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  z-index: 3000;
  display: flex;
  max-width: 82vw;
  align-items: center;
  padding: 20rpx 34rpx;
  border-radius: 22rpx;
  background: rgba(38, 36, 33, 0.92);
  box-shadow: 0 18rpx 46rpx -22rpx rgba(20, 18, 16, 0.65);
  transform: translate(-50%, -50%);
  animation: app-toast-in 0.16s ease-out;
}

.app-toast__text {
  color: #fffaf3;
  font-size: 25rpx;
  line-height: 1.35;
  text-align: center;
  white-space: nowrap;
}

@keyframes app-toast-in {
  from {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.94);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}
