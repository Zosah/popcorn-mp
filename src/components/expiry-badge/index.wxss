.badge {
  display: inline-flex;
  height: 42rpx;
  align-items: center;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 0.2rpx;
  white-space: nowrap;
}

.badge--expired {
  background: var(--c-danger-soft, #f7e7e2);
  color: var(--c-danger, #b86757);
}

.badge--today,
.badge--urgent {
  background: var(--c-warning-soft, #f2e8cc);
  color: #94661f;
}

.badge--soon {
  background: #f5ecd8;
  color: #94661f;
}

.badge--normal {
  background: var(--c-success-soft, #e2eee9);
  color: #4f6d61;
}

.badge--none {
  background: var(--c-paper-2, #f1ede7);
  color: var(--c-muted, #837f76);
}
