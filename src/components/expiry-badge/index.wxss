.badge {
  display: inline-flex;
  align-items: center;
  font-size: 25rpx;
  font-weight: 400;
  white-space: nowrap;
}

.badge--expired {
  color: var(--c-danger, #e8695c);
}

.badge--today,
.badge--urgent {
  color: var(--c-warning, #e0a038);
}

.badge--soon {
  color: #c98a2e;
}

.badge--normal {
  color: var(--c-success, #4fa87d);
}

.badge--none {
  color: var(--c-muted, #9497a6);
}
