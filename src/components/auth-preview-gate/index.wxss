.auth-gate {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 30rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(31, 36, 33, 0.3);
  backdrop-filter: blur(14rpx);
  -webkit-backdrop-filter: blur(14rpx);
}

.auth-gate__card {
  position: relative;
  width: 100%;
  max-width: 676rpx;
  padding: 44rpx 40rpx 26rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 46rpx;
  background: #fffaf6;
  box-shadow:
    0 42rpx 110rpx -34rpx rgba(31, 36, 33, 0.5),
    inset 0 1rpx 0 rgba(255, 255, 255, 1);
  box-sizing: border-box;
  animation: auth-gate-in 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.auth-gate__card::before {
  position: absolute;
  top: -250rpx;
  right: -180rpx;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(247, 231, 226, 0.7) 0%, rgba(247, 231, 226, 0) 68%);
  content: "";
  pointer-events: none;
}

.auth-gate__close {
  position: absolute;
  z-index: 1;
  top: 26rpx;
  right: 26rpx;
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  opacity: 0.72;
  transition: opacity 140ms ease, transform 140ms ease;
}

.auth-gate__close--pressed {
  opacity: 0.4;
  transform: scale(0.92);
}

.auth-gate__mark {
  position: relative;
  display: flex;
  width: 128rpx;
  height: 128rpx;
  align-items: center;
  justify-content: flex-start;
}

.auth-gate__content {
  position: relative;
  margin-top: 26rpx;
}

.auth-gate__title,
.auth-gate__copy {
  display: block;
}

.auth-gate__title {
  color: #252b27;
  font-family: "Songti SC", "STSong", serif;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.28;
  letter-spacing: -1rpx;
}

.auth-gate__copy {
  max-width: 520rpx;
  margin-top: 14rpx;
  color: #68635c;
  font-size: 28rpx;
  line-height: 1.6;
}

.auth-gate__privacy {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  color: #938c82;
  font-size: 24rpx;
  line-height: 1.4;
  gap: 10rpx;
}

.auth-gate__login {
  position: relative;
  display: flex;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #cf8b7c 0%, #b86757 58%, #ad5f51 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1;
  box-shadow:
    0 20rpx 42rpx -25rpx rgba(166, 82, 68, 0.7),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
}

.auth-gate__login::after {
  border: 0;
}

.auth-gate__login:active {
  opacity: 0.9;
  transform: scale(0.992);
}

.auth-gate__preview {
  padding: 24rpx 0 4rpx;
  color: #817a70;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
}

@keyframes auth-gate-in {
  from { opacity: 0; transform: translateY(38rpx) scale(0.985); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .auth-gate__card {
    animation: none;
  }
}
