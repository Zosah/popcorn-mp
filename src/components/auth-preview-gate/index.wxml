<view wx:if="{{visible}}" class="auth-gate" catchtouchmove="noop" catchtap="noop">
  <view class="auth-gate__card" catchtap="noop">
    <view
      class="auth-gate__close"
      hover-class="auth-gate__close--pressed"
      bindtap="dismiss"
      aria-label="关闭登录提示"
    >
      <line-icon name="system-close" size="38" tone="muted" />
    </view>

    <view class="auth-gate__mark">
      <line-icon name="feature-journal" size="128" active="{{true}}" />
    </view>

    <view class="auth-gate__content">
      <text class="auth-gate__title">{{force ? '登录后继续' : '登录后，一起记录'}}</text>
      <text class="auth-gate__copy">{{force ? '这一步需要登录后才能保存。' : '先看看也可以，想保存时再登录。'}}</text>
      <view class="auth-gate__privacy">
        <line-icon name="system-lock" size="26" tone="muted" />
        <text>登录后即可保存并共享记录</text>
      </view>
    </view>

    <button class="auth-gate__login" bindtap="goLogin">登录并继续</button>
    <view wx:if="{{!force}}" class="auth-gate__preview" bindtap="dismiss">暂时看看</view>
  </view>
</view>
