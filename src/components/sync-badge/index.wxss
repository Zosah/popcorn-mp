.sync-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 11rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.46);
  color: var(--c-muted, #8a8693);
  font-size: 17rpx;
  font-weight: 400;
  line-height: 1.4;
}

.sync-badge__dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 7rpx;
  border-radius: 50%;
  background: var(--c-muted, #8a8693);
  box-shadow: 0 0 0 4rpx rgba(149, 146, 164, 0.10);
}

.sync-badge--synced {
  color: var(--c-success, #638f80);
}

.sync-badge--synced .sync-badge__dot {
  background: var(--c-success, #638f80);
  box-shadow: 0 0 0 4rpx rgba(75, 169, 141, 0.10);
}

.sync-badge--pending {
  color: var(--c-warning, #b98552);
}

.sync-badge--pending .sync-badge__dot {
  background: var(--c-warning, #b98552);
  box-shadow: 0 0 0 4rpx rgba(217, 156, 63, 0.10);
}
