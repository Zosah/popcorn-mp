.sync-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 11rpx;
  border: 1rpx solid var(--c-line, #ebe5da);
  border-radius: 999rpx;
  background: rgba(246, 241, 233, 0.72);
  color: var(--c-muted, #8d8580);
  font-size: 17rpx;
  font-weight: 400;
  line-height: 1.4;
}

.sync-badge__dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 7rpx;
  border-radius: 50%;
  background: var(--c-muted, #8d8580);
  box-shadow: 0 0 0 4rpx rgba(141, 133, 128, 0.10);
}

.sync-badge--synced {
  color: var(--c-success, #6f9f7d);
}

.sync-badge--synced .sync-badge__dot {
  background: var(--c-success, #6f9f7d);
  box-shadow: 0 0 0 4rpx rgba(111, 159, 125, 0.12);
}

.sync-badge--pending {
  color: var(--c-warning, #b78024);
}

.sync-badge--pending .sync-badge__dot {
  background: var(--c-warning, #b78024);
  box-shadow: 0 0 0 4rpx rgba(183, 128, 36, 0.12);
}
