.sync-badge {
  display: inline-flex;
  align-items: center;
  padding: 0;
  background: transparent;
  color: var(--c-muted, #9497a6);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 1.5;
}

.sync-badge__dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: var(--c-muted, #9497a6);
}

.sync-badge--synced {
  color: var(--c-success, #4fa87d);
}

.sync-badge--synced .sync-badge__dot {
  background: var(--c-success, #4fa87d);
}

.sync-badge--pending {
  color: var(--c-warning, #e0a038);
}

.sync-badge--pending .sync-badge__dot {
  background: var(--c-warning, #e0a038);
}
