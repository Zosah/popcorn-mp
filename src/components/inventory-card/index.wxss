.row {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--c-line, #e7e6ee);
}

.row:last-child {
  border-bottom: 0;
}

.row__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.row__main {
  min-width: 0;
  flex: 1;
  padding: 20rpx 0;
}

.row__name {
  overflow: hidden;
  color: var(--c-text, #22242e);
  font-size: 27rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row__meta {
  overflow: hidden;
  margin-top: 6rpx;
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row__right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 18rpx;
}

.row__history {
  color: var(--c-muted, #9497a6);
  font-size: 21rpx;
}

.row__chevron {
  width: 10rpx;
  height: 10rpx;
  margin-left: 16rpx;
  border-top: 1rpx solid var(--c-line-strong, #d6d5e0);
  border-right: 1rpx solid var(--c-line-strong, #d6d5e0);
  transform: rotate(45deg);
}
