.row {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  border-bottom: 1rpx solid #e2e7df;
}

.row:last-child {
  border-bottom: 0;
}

.row__icon {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #f6ebe2;
  flex-shrink: 0;
}

.row__main {
  min-width: 0;
  margin-left: 16rpx;
  flex: 1;
  padding: 18rpx 0;
}

.row__name {
  overflow: hidden;
  color: var(--c-text, #232a24);
  font-size: 31rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row__meta {
  overflow: hidden;
  margin-top: 5rpx;
  color: var(--c-muted, #5b665d);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row__right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.row__history {
  color: var(--c-muted, #5b665d);
  font-size: 23rpx;
}

.row__chevron {
  width: 10rpx;
  height: 10rpx;
  margin-left: 15rpx;
  border-top: 1.5rpx solid #c6bdb4;
  border-right: 1.5rpx solid #c6bdb4;
  transform: rotate(45deg);
}
