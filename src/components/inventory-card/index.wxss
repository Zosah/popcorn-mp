.row {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  border-bottom: 1rpx solid rgba(87, 80, 93, 0.09);
}

.row:last-child {
  border-bottom: 0;
}

.row__icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: rgba(240, 237, 247, 0.68);
  flex-shrink: 0;
}

.row__main {
  min-width: 0;
  margin-left: 16rpx;
  flex: 1;
  padding: 17rpx 0;
}

.row__name {
  overflow: hidden;
  color: var(--c-text, #292737);
  font-size: 25rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row__meta {
  overflow: hidden;
  margin-top: 5rpx;
  color: var(--c-muted, #8a8693);
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row__right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.row__history {
  color: var(--c-muted, #8a8693);
  font-size: 18rpx;
}

.row__chevron {
  width: 9rpx;
  height: 9rpx;
  margin-left: 13rpx;
  border-top: 1rpx solid var(--c-faint, #b7b2bb);
  border-right: 1rpx solid var(--c-faint, #b7b2bb);
  transform: rotate(45deg);
}
