/* 库存行：与宠物用品清单同一套层级（缩略图 / 名称 / 标签 / 右侧状态） */
.row {
  display: flex;
  min-height: 148rpx;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--c-line, #e9e6e1);
  gap: 16rpx;
}

/* 时间放在标签下方，字号更小、颜色更淡，不抢主信息 */
.row__meta {
  display: flex;
  align-items: center;
  margin-top: 2rpx;
  gap: 6rpx;
}

.row__meta-date,
.row__meta-dot,
.row__meta-hint {
  color: var(--c-faint, #a29b91);
  font-size: 20rpx;
  line-height: 1.3;
}

.row__meta--danger .row__meta-date,
.row__meta--danger .row__meta-dot,
.row__meta--danger .row__meta-hint { color: #c0564a; }

.row__meta--warn .row__meta-date,
.row__meta--warn .row__meta-dot,
.row__meta--warn .row__meta-hint { color: #c98a3f; }

.row__meta--soon .row__meta-date,
.row__meta--soon .row__meta-dot,
.row__meta--soon .row__meta-hint { color: #7d8f6a; }

/* 快速调整库存：右侧步进器 */
.row__stepper {
  display: flex;
  align-items: center;
  padding: 4rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f7ece2, #efe8dd);
  gap: 2rpx;
  flex: 0 0 auto;
}

.row__step {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #fbf1e6, #f3e3d4);
  color: #9a5f4b;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
}

.row__step--plus {
  background: linear-gradient(135deg, #7d9a8d, #5c7a6f);
  color: #fffbf6;
}

.row__step--busy {
  opacity: 0.45;
}

.row__qty {
  display: flex;
  min-width: 62rpx;
  align-items: baseline;
  justify-content: center;
  gap: 2rpx;
}

.row__qty-value {
  color: var(--c-text, #252b27);
  font-size: 27rpx;
  font-weight: 700;
}

.row__qty-unit {
  color: var(--c-muted, #837f76);
  font-size: 18rpx;
}

.row__history {
  display: flex;
  align-items: flex-end;
  flex-direction: column;
  gap: 4rpx;
  flex: 0 0 auto;
}

.row__history-label {
  color: var(--c-muted, #837f76);
  font-size: 20rpx;
}

.row:last-child {
  border-bottom: 0;
}

.row__thumb {
  position: relative;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--c-paper-2, #f1ede7);
  flex: 0 0 96rpx;
}

.row__thumb--image {
  background: transparent;
}

/* 没有图片时的默认底：按品类给一层柔和色，不再是空白方块 */
.row__thumb--food { background: #f7ecdd; }
.row__thumb--drink { background: #e7eff4; }
.row__thumb--frozen { background: #e5eff1; }
.row__thumb--seasoning { background: #f6e9db; }
.row__thumb--daily { background: #eef1e7; }
.row__thumb--medicine { background: #f8e7e3; }
.row__thumb--pet { background: #e3efe9; }
.row__thumb--other { background: #f1ede7; }

.row__image {
  width: 100%;
  height: 100%;
}

/* 彩色图标铺满 96rpx 的可视区，四周留一点呼吸位 */
.row__icon {
  width: 76rpx;
  height: 76rpx;
}

.row__initial {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}

.row__main {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.row__name {
  overflow: hidden;
  color: var(--c-text, #252b27);
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: -0.3rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row__tags {
  display: flex;
  min-width: 0;
  align-items: center;
  flex-wrap: nowrap;
  gap: 8rpx;
}

.row__tag {
  overflow: hidden;
  max-width: 190rpx;
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  background: var(--c-paper-2, #f1ede7);
  color: var(--c-text-2, #5f5a53);
  font-size: 21rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row__tag--qty {
  background: var(--c-primary-soft, #f7e7e2);
  color: #9a5f58;
  font-weight: 700;
}

/* 分类标签：按品类分色，和宠物用品的 label 同一套语气 */
.row__tag--food { background: #f6ecdf; color: #9a7250; }
.row__tag--drink { background: #e6eef3; color: #5b7d94; }
.row__tag--frozen { background: #e4eef0; color: #5b7f86; }
.row__tag--seasoning { background: #f5e8db; color: #a4703f; }
.row__tag--daily { background: #edf0e6; color: #6f7d5c; }
.row__tag--medicine { background: var(--c-danger-soft, #f7e7e2); color: #a8564a; }
.row__tag--pet { background: var(--c-sage-soft, #e2eee9); color: #557366; }
.row__tag--other { background: #f1ede7; color: #837f76; }

.row__right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 10rpx;
}

.row__history {
  color: var(--c-muted, #837f76);
  font-size: 22rpx;
}

.row__chevron {
  width: 12rpx;
  height: 12rpx;
  margin-left: 4rpx;
  border-top: 2rpx solid #cfc6ba;
  border-right: 2rpx solid #cfc6ba;
  transform: rotate(45deg);
}

/* 生成中：缩略图右上角一颗呼吸点 */
.row__pulse {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #c67d6d;
  box-shadow: 0 0 0 4rpx rgba(198, 125, 109, 0.22);
  animation: row-pulse 1.6s ease-in-out infinite;
}

@keyframes row-pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.1); }
}
