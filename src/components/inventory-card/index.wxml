<view class="row" bindtap="onTap">
  <view class="row__thumb row__thumb--{{item.category}} {{item.imageSrc ? 'row__thumb--image' : ''}}">
    <image wx:if="{{item.imageSrc}}" class="row__image" src="{{item.imageSrc}}" mode="aspectFill" />
    <line-icon wx:else name="{{item.iconName}}" size="46" tone="gold" />
  </view>

  <view class="row__main">
    <text class="row__name">{{item.name}}</text>
    <view class="row__tags">
      <text class="row__tag row__tag--qty">{{item.quantity}}{{item.unit}}</text>
      <text class="row__tag">{{item.locationLabel}}</text>
      <text class="row__tag row__tag--{{item.category}}">{{item.categoryLabel}}</text>
    </view>
  </view>

  <view class="row__right">
    <expiry-badge wx:if="{{item.status === 'active'}}" status="{{item.expiry.status}}" label="{{item.expiry.label}}" />
    <view wx:else class="row__history">{{item.lifecycleLabel}}</view>
    <view class="row__chevron"></view>
  </view>
</view>
