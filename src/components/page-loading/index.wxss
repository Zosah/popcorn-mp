.page-loading {
  position: fixed;
  z-index: 950;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 82% 14%, rgba(250, 216, 202, 0.7), transparent 30%),
    radial-gradient(circle at 12% 78%, rgba(226, 238, 233, 0.82), transparent 34%),
    #f8f7f4;
}

.page-loading__paper {
  display: flex;
  width: 100%;
  max-width: 520rpx;
  align-items: center;
  padding: 48rpx 40rpx 42rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 28rpx 80rpx -42rpx rgba(92, 74, 61, 0.34);
  box-sizing: border-box;
  flex-direction: column;
  backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx);
}

.page-loading__mark {
  position: relative;
  width: 116rpx;
  height: 100rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(198, 125, 109, 0.18);
  border-radius: 30rpx;
  background: linear-gradient(150deg, #fffaf5, #f4eee8);
  box-shadow: inset 0 1rpx 0 #fff;
  animation: page-loading-breathe 1.8s ease-in-out infinite;
}

.page-loading__sun {
  position: absolute;
  top: 18rpx;
  right: 20rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #c67d6d;
  box-shadow: 0 0 0 8rpx rgba(198, 125, 109, 0.1);
}

.page-loading__line {
  position: absolute;
  left: 22rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: #668478;
}

.page-loading__line--one {
  top: 29rpx;
  width: 34rpx;
}

.page-loading__line--two {
  top: 48rpx;
  width: 70rpx;
  background: #c9a764;
}

.page-loading__line--three {
  top: 67rpx;
  width: 52rpx;
  background: #c9b9aa;
}

.page-loading__title {
  color: #252b27;
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

.page-loading__copy {
  margin-top: 8rpx;
  color: #837f76;
  font-size: 23rpx;
  line-height: 1.5;
}

.page-loading__dots {
  display: flex;
  margin-top: 26rpx;
  gap: 9rpx;
}

.page-loading__dots view {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #c67d6d;
  animation: page-loading-dot 1.25s ease-in-out infinite;
}

.page-loading__dots view:nth-child(2) {
  animation-delay: 120ms;
}

.page-loading__dots view:nth-child(3) {
  animation-delay: 240ms;
}

@keyframes page-loading-breathe {
  0%, 100% { transform: translateY(0) rotate(-1deg); }
  50% { transform: translateY(-5rpx) rotate(1deg); }
}

@keyframes page-loading-dot {
  0%, 70%, 100% { opacity: 0.3; transform: translateY(0); }
  35% { opacity: 1; transform: translateY(-5rpx); }
}

@media (prefers-reduced-motion: reduce) {
  .page-loading__mark,
  .page-loading__dots view {
    animation: none;
  }
}
